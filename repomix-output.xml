<file path="src/components/onboarding/helper.ts">
export const formatUserDataString = (steps: any[], answers: any): string => {
    return steps
        .filter((step: any) => (step.type === 'question' || step.id === "choose_college") && answers[step.id])
        .map((step: any) => {
            let output = `Question: ${step.question}\n`;
            if (step.subtitle) {
                output += `Subtitle: ${step.subtitle}\n`;
            }
            output += `User Answer: ${answers[step.id] || "N/A"}\n`;
            return output;
        })
        .join("\n");
};
</file>

