<file path="src/services/EnhancedAudioRecordingService.ts">
import { useAudioRecorder } from "@siteed/expo-audio-studio";
import { useState, useCallback, useRef, useEffect, useMemo } from "react";
import { AppState, AppStateStatus } from "react-native";
import Toast from "react-native-toast-message";
import * as FileSystem from "expo-file-system";
import { concatenateWavFiles, WavFileInfo } from "@/utils/wavConcatenation";
import { recordingBackupService } from "@/services/RecordingBackupService";
import { posthogClient } from "@/utils/posthog";

// -----------------------------------------------------------------------------
// Types (external API unchanged)
// -----------------------------------------------------------------------------
interface CustomAudioConfig {
  sampleRate: number;
  channels: number;
  encoding: "pcm_16bit";
  outputFormat: "wav";
  autoResumeAfterInterruption: boolean;
  enableRecordingInBackground: boolean;
  keepAwake: boolean;

  enableProcessing: boolean;
  interval: number;
  pointsPerSecond: number;
  algorithm: "rms";
  features: { energy: boolean; rms: boolean };

  enableCompressedOutput?: boolean;
  compression?: {
    format: "aac" | "opus";
    bitrate: number;
  };

  onAudioStream: (event: any) => void;
  onRecordingInterrupted: (event: {
    reason: string;
    isPaused: boolean;
  }) => void;
  onRecordingStatusUpdate: (status: CustomRecordingStatus) => void;

  outputPath?: string;
}

interface CustomRecordingStatus {
  isRecording?: boolean;
  durationMs?: number;
  isPaused?: boolean;
}

export interface RecordingSegment {
  id: string;
  filePath: string;
  duration: number;
  startTime: number;
  endTime: number;
}

export interface EnhancedRecordingState {
  isRecording: boolean;
  isPaused: boolean;
  duration: number;
  segments: RecordingSegment[];
  currentSegmentId: string | null;
  isInterrupted: boolean;
  interruptionReason: string | null;
  lastRecordingUri: string | null;
  currentAudioLevel: number;
  currentSessionId: string | null;
}

export interface UseEnhancedAudioRecorderResult {
  recordingState: EnhancedRecordingState;
  startRecording: () => Promise<void>;
  stopRecording: () => Promise<string | null>;
  pauseRecording: () => Promise<void>;
  resumeRecording: () => Promise<void>;
  discardRecording: () => Promise<void>;
  getConsolidatedAudioFile: () => Promise<string | null>;
  getCurrentSessionId: () => string | null;
}

// -----------------------------------------------------------------------------
// Constants — keep format consistent across record & concat
// -----------------------------------------------------------------------------
const SAMPLE_RATE = 16000;
const CHANNELS = 1;
const AUTO_SEGMENT_INTERVAL = 30_000; // 30s

// -----------------------------------------------------------------------------
// Hook
// -----------------------------------------------------------------------------
export function useEnhancedAudioRecorder(): UseEnhancedAudioRecorderResult {
  const [recordingState, setRecordingState] = useState<EnhancedRecordingState>({
    isRecording: false,
    isPaused: false,
    duration: 0,
    segments: [],
    currentSegmentId: null,
    isInterrupted: false,
    interruptionReason: null,
    lastRecordingUri: null,
    currentAudioLevel: 0,
    currentSessionId: null,
  });

  // time & session refs
  const startTimeRef = useRef<number>(0);
  const totalDurationRef = useRef<number>(0);
  const segmentStartTimeRef = useRef<number>(0);
  const wasRecordingBeforeInterruption = useRef<boolean>(false);

  const isActivelyRecording = useRef<boolean>(false);
  const currentSessionIdRef = useRef<string | null>(null);
  const currentSegmentIdRef = useRef<string | null>(null);

  // timers
  const timerIntervalRef = useRef<NodeJS.Timeout | null>(null);
  const autoSegmentTimerRef = useRef<NodeJS.Timeout | null>(null);

  // UI meter
  const lastAudioUpdateTime = useRef<number>(0);

  // ---------------------------------------------------------------------------
  // Helpers
  // ---------------------------------------------------------------------------
  const ensureRecordingsDirectory = useCallback(async () => {
    const recordingsDir = `${FileSystem.documentDirectory}recordings/`;
    const dirInfo = await FileSystem.getInfoAsync(recordingsDir);
    if (!dirInfo.exists) {
      await FileSystem.makeDirectoryAsync(recordingsDir, {
        intermediates: true,
      });
    }
  }, []);

  const generateSegmentId = useCallback(
    () => `segment_${Date.now()}_${Math.random().toString(36).slice(2, 11)}`,
    []
  );

  const generateOutputPath = useCallback(
    (segmentId: string) =>
      `${FileSystem.documentDirectory}recordings/${segmentId}.wav`,
    []
  );

  const startTimer = useCallback(() => {
    if (timerIntervalRef.current) clearInterval(timerIntervalRef.current);
    timerIntervalRef.current = setInterval(() => {
      const now = Date.now();
      const currentSegmentDuration = now - segmentStartTimeRef.current;
      const totalDuration = totalDurationRef.current + currentSegmentDuration;
      setRecordingState((prev) => ({ ...prev, duration: totalDuration }));
    }, 100);
  }, []);

  const stopTimer = useCallback(() => {
    if (timerIntervalRef.current) {
      clearInterval(timerIntervalRef.current);
      timerIntervalRef.current = null;
    }
  }, []);

  const startAutoSegmentTimer = useCallback(() => {
    if (autoSegmentTimerRef.current) clearInterval(autoSegmentTimerRef.current);
    autoSegmentTimerRef.current = setInterval(async () => {
      if (AppState.currentState !== "active") return;
      if (recordingState.isRecording && !recordingState.isPaused) {
        await createNewSegment();
      }
    }, AUTO_SEGMENT_INTERVAL);
  }, [recordingState.isRecording, recordingState.isPaused]);

  const stopAutoSegmentTimer = useCallback(() => {
    if (autoSegmentTimerRef.current) {
      clearInterval(autoSegmentTimerRef.current);
      autoSegmentTimerRef.current = null;
    }
  }, []);

  // ---------------------------------------------------------------------------
  // Audio config — NO JS PCM, use event.rms, and disable compressed output
  // ---------------------------------------------------------------------------
  const audioConfig: CustomAudioConfig = useMemo(
    () => ({
      sampleRate: SAMPLE_RATE,
      channels: CHANNELS,
      encoding: "pcm_16bit",
      outputFormat: "wav",
      autoResumeAfterInterruption: true,
      enableRecordingInBackground: true,
      keepAwake: true,

      enableProcessing: true,
      interval: 100,
      pointsPerSecond: 10,
      algorithm: "rms",
      features: { energy: true, rms: true },

      // Avoid keeping a second encoded stream in memory while recording.
      enableCompressedOutput: false,

      onAudioStream: (event: any) => {
        if (AppState.currentState !== "active") return;

        let audioLevel = 0;
        if (typeof event?.rms === "number") {
          audioLevel = Math.max(0, Math.min(1, event.rms));
        } else if (typeof event?.amplitude === "number") {
          audioLevel = Math.max(0, Math.min(1, Math.abs(event.amplitude)));
        }

        const now = Date.now();
        if (now - lastAudioUpdateTime.current >= 50) {
          lastAudioUpdateTime.current = now;
          setRecordingState((prev) => ({
            ...prev,
            currentAudioLevel: audioLevel,
          }));
        }
      },

      onRecordingInterrupted: (event: {
        reason: string;
        isPaused: boolean;
      }) => {
        if (event.isPaused) {
          // finalize current segment’s time
          stopTimer();
          const currentTime = Date.now();
          const segmentDuration = currentTime - segmentStartTimeRef.current;
          totalDurationRef.current += segmentDuration;
          isActivelyRecording.current = false;

          if (currentSessionIdRef.current) {
            recordingBackupService.updateRecordingProgress(
              currentSessionIdRef.current,
              recordingState.segments,
              totalDurationRef.current
            );
          }
        } else {
          // resuming → record to a fresh segment id
          if (recordingState.currentSegmentId) {
            const interruptedSegment: RecordingSegment = {
              id: recordingState.currentSegmentId,
              filePath: generateOutputPath(recordingState.currentSegmentId),
              duration:
                totalDurationRef.current -
                recordingState.segments.reduce((sum, s) => sum + s.duration, 0),
              startTime: segmentStartTimeRef.current,
              endTime: Date.now(),
            };
            setRecordingState((prev) => ({
              ...prev,
              segments: [...prev.segments, interruptedSegment],
              currentSegmentId: generateSegmentId(),
            }));
          }
          segmentStartTimeRef.current = Date.now();
          startTimer();
          isActivelyRecording.current = true;
        }

        setRecordingState((prev) => ({
          ...prev,
          isInterrupted: event.isPaused,
          interruptionReason: event.reason,
          isPaused: event.isPaused,
          duration: totalDurationRef.current,
        }));

        if (
          event.isPaused &&
          (event.reason === "phoneCall" || event.reason === "audioFocusLoss")
        ) {
          wasRecordingBeforeInterruption.current = true;
          Toast.show({
            type: "info",
            text1: "Recording Paused",
            text2: "Audio in use — will resume automatically",
            topOffset: 150,
          });
        } else if (
          !event.isPaused &&
          (event.reason === "phoneCallEnded" ||
            event.reason === "audioFocusGain")
        ) {
          wasRecordingBeforeInterruption.current = false;
          Toast.show({
            type: "success",
            text1: "Recording Resumed",
            text2: "Audio available again",
            topOffset: 150,
          });
        }
      },

      onRecordingStatusUpdate: (status: CustomRecordingStatus) => {
        if (status.isRecording) {
          setRecordingState((prev) => ({
            ...prev,
            duration: status.durationMs || 0,
            isRecording: true,
            isPaused: false,
            isInterrupted: false,
            interruptionReason: null,
          }));
        }
      },
    }),
    // eslint-disable-next-line react-hooks/exhaustive-deps
    [recordingState.segments]
  );

  // library hook
  const {
    startRecording: startRecordingBase,
    stopRecording: stopRecordingBase,
    pauseRecording: pauseRecordingBase,
    resumeRecording: resumeRecordingBase,
    isRecording: isRecordingBase,
    isPaused: isPausedBase,
  } = useAudioRecorder(audioConfig as any);

  // ---------------------------------------------------------------------------
  // Segment rotation
  // ---------------------------------------------------------------------------
  const createNewSegment = useCallback(async () => {
    try {
      const recordingResult = await stopRecordingBase();
      if (recordingResult && recordingState.currentSegmentId) {
        const endTime = Date.now();
        const duration = endTime - segmentStartTimeRef.current;
        totalDurationRef.current += duration;

        const completedSegment: RecordingSegment = {
          id: recordingState.currentSegmentId,
          filePath: recordingResult.fileUri,
          duration,
          startTime: segmentStartTimeRef.current,
          endTime,
        };

        setRecordingState((prev) => ({
          ...prev,
          segments: [...prev.segments, completedSegment],
          duration: totalDurationRef.current,
        }));

        if (recordingState.currentSessionId) {
          recordingBackupService.updateRecordingProgress(
            recordingState.currentSessionId,
            [...recordingState.segments, completedSegment],
            totalDurationRef.current
          );
        }
      }

      await new Promise((resolve) => setTimeout(resolve, 60)); // ensure file written

      const newSegmentId = generateSegmentId();
      const outputPath = generateOutputPath(newSegmentId);
      segmentStartTimeRef.current = Date.now();

      await startRecordingBase({ ...(audioConfig as any), outputPath });

      currentSegmentIdRef.current = newSegmentId;
      setRecordingState((prev) => ({
        ...prev,
        currentSegmentId: newSegmentId,
      }));
    } catch {
      // ignore
    }
  }, [
    audioConfig,
    generateOutputPath,
    generateSegmentId,
    recordingState.currentSegmentId,
    recordingState.currentSessionId,
    recordingState.segments,
    startRecordingBase,
    stopRecordingBase,
  ]);

  // ---------------------------------------------------------------------------
  // Concatenate segments (WAV) — consistent headers
  // ---------------------------------------------------------------------------
  const getConsolidatedAudioFileFromSegments = useCallback(
    async (segments: RecordingSegment[]): Promise<string | null> => {
      try {
        if (segments.length === 0) return null;
        if (segments.length === 1) return segments[0].filePath;

        const consolidatedPath = `${
          FileSystem.documentDirectory
        }recordings/consolidated_${Date.now()}.wav`;
        const infos: WavFileInfo[] = segments.map((segment) => ({
          filePath: segment.filePath,
          sampleRate: SAMPLE_RATE,
          channels: CHANNELS,
          duration: segment.duration,
        }));

        try {
          const result = await concatenateWavFiles(infos, consolidatedPath);
          return result;
        } catch {
          return segments[0].filePath;
        }
      } catch {
        return null;
      }
    },
    []
  );

  // ---------------------------------------------------------------------------
  // AppState: auto-resume after interruption; reduce work in background
  // ---------------------------------------------------------------------------
  useEffect(() => {
    const handleAppStateChange = async (nextAppState: AppStateStatus) => {
      if (nextAppState === "active" && wasRecordingBeforeInterruption.current) {
        setTimeout(() => {
          if (recordingState.isPaused && recordingState.isInterrupted) {
            void resumeRecording();
          }
        }, 500);
      } else if (nextAppState === "background" && recordingState.isRecording) {
        stopTimer();
        timerIntervalRef.current = setInterval(() => {
          const now = Date.now();
          const curr = now - segmentStartTimeRef.current;
          const total = totalDurationRef.current + curr;
          setRecordingState((prev) => ({ ...prev, duration: total }));
        }, 10_000);
      } else if (nextAppState === "active" && recordingState.isRecording) {
        stopTimer();
        startTimer();
      }
    };

    const subscription = AppState.addEventListener(
      "change",
      handleAppStateChange
    );
    return () => subscription?.remove();
  }, [
    recordingState.isRecording,
    recordingState.isPaused,
    recordingState.isInterrupted,
    startTimer,
    stopTimer,
  ]);

  // ---------------------------------------------------------------------------
  // Public API
  // ---------------------------------------------------------------------------
  const startRecording = useCallback(async (): Promise<void> => {
    try {
      await ensureRecordingsDirectory();

      const segmentId = generateSegmentId();
      const outputPath = generateOutputPath(segmentId);
      const sessionId = await recordingBackupService.startNewRecordingSession();

      startTimeRef.current = Date.now();
      segmentStartTimeRef.current = Date.now();
      totalDurationRef.current = 0;

      await startRecordingBase({ ...(audioConfig as any), outputPath });

      isActivelyRecording.current = true;
      currentSessionIdRef.current = sessionId;
      currentSegmentIdRef.current = segmentId;

      startTimer();
      startAutoSegmentTimer();

      posthogClient.capture("recording_started", { sessionId });

      setRecordingState((prev) => ({
        ...prev,
        isRecording: true,
        isPaused: false,
        currentSegmentId: segmentId,
        currentSessionId: sessionId,
        isInterrupted: false,
        interruptionReason: null,
        segments: [],
        duration: 0,
      }));
    } catch {
      Toast.show({
        type: "error",
        text1: "Recording Failed",
        text2: "Could not start recording. Please try again.",
        topOffset: 50,
      });
    }
  }, [
    audioConfig,
    ensureRecordingsDirectory,
    generateOutputPath,
    generateSegmentId,
    startAutoSegmentTimer,
    startRecordingBase,
    startTimer,
  ]);

  const stopRecording = useCallback(async (): Promise<string | null> => {
    try {
      stopTimer();
      stopAutoSegmentTimer();

      isActivelyRecording.current = false;
      const result = await stopRecordingBase();

      if (result && recordingState.currentSegmentId) {
        const endTime = Date.now();
        const duration = endTime - segmentStartTimeRef.current;
        totalDurationRef.current += duration;

        const lastSeg: RecordingSegment = {
          id: recordingState.currentSegmentId,
          filePath: result.fileUri,
          duration,
          startTime: segmentStartTimeRef.current,
          endTime: endTime,
        };

        const allSegments = [...recordingState.segments, lastSeg];

        const consolidatedUri = await getConsolidatedAudioFileFromSegments(
          allSegments
        );

        if (recordingState.currentSessionId) {
          recordingBackupService.completeRecording(
            recordingState.currentSessionId,
            consolidatedUri || undefined
          );
        }

        // clear session refs AFTER completeRecording
        currentSessionIdRef.current = null;
        currentSegmentIdRef.current = null;

        setRecordingState((prev) => ({
          ...prev,
          isRecording: false,
          isPaused: false,
          currentSegmentId: null,
          currentSessionId: null,
          segments: allSegments,
          duration: totalDurationRef.current,
          currentAudioLevel: 0,
          lastRecordingUri: consolidatedUri,
        }));

        posthogClient.capture("recording_stopped", {
          totalDurationMinutes: (totalDurationRef.current / 60000).toFixed(1),
        });

        return consolidatedUri;
      }

      currentSessionIdRef.current = null;
      currentSegmentIdRef.current = null;
      return null;
    } catch {
      currentSessionIdRef.current = null;
      currentSegmentIdRef.current = null;
      Toast.show({
        type: "error",
        text1: "Error Stopping Recording",
        text2: "Recording may have been saved",
        topOffset: 50,
      });
      return null;
    }
  }, [
    getConsolidatedAudioFileFromSegments,
    recordingState.currentSegmentId,
    recordingState.currentSessionId,
    recordingState.segments,
    stopAutoSegmentTimer,
    stopRecordingBase,
    stopTimer,
  ]);

  const pauseRecording = useCallback(async (): Promise<void> => {
    try {
      stopTimer();
      const now = Date.now();
      const segDur = now - segmentStartTimeRef.current;
      totalDurationRef.current += segDur;

      await pauseRecordingBase();
      isActivelyRecording.current = false;

      setRecordingState((prev) => ({
        ...prev,
        isPaused: true,
        duration: totalDurationRef.current,
      }));
    } catch {
      // ignore
    }
  }, [pauseRecordingBase, stopTimer]);

  const resumeRecording = useCallback(async (): Promise<void> => {
    try {
      await resumeRecordingBase();
      segmentStartTimeRef.current = Date.now();
      startTimer();
      isActivelyRecording.current = true;

      setRecordingState((prev) => ({
        ...prev,
        isPaused: false,
        isInterrupted: false,
        interruptionReason: null,
      }));
    } catch {
      // ignore
    }
  }, [resumeRecordingBase, startTimer]);

  const discardRecording = useCallback(async (): Promise<void> => {
    try {
      stopTimer();
      stopAutoSegmentTimer();

      if (isRecordingBase) {
        await stopRecordingBase();
      }

      if (recordingState.currentSessionId) {
        recordingBackupService.discardRecording(
          recordingState.currentSessionId
        );
      }

      for (const seg of recordingState.segments) {
        try {
          await FileSystem.deleteAsync(seg.filePath, { idempotent: true });
        } catch {}
      }

      isActivelyRecording.current = false;
      currentSessionIdRef.current = null;
      currentSegmentIdRef.current = null;

      setRecordingState({
        isRecording: false,
        isPaused: false,
        duration: 0,
        segments: [],
        currentSegmentId: null,
        currentSessionId: null,
        isInterrupted: false,
        interruptionReason: null,
        lastRecordingUri: null,
        currentAudioLevel: 0,
      });

      totalDurationRef.current = 0;

      posthogClient.capture("recording_discarded", {});
    } catch {
      // ignore
    }
  }, [
    isRecordingBase,
    recordingState.currentSessionId,
    recordingState.segments,
    stopAutoSegmentTimer,
    stopRecordingBase,
    stopTimer,
  ]);

  // wrappers
  const getConsolidatedAudioFile = useCallback(async (): Promise<
    string | null
  > => {
    return getConsolidatedAudioFileFromSegments(recordingState.segments);
  }, [getConsolidatedAudioFileFromSegments, recordingState.segments]);

  const getCurrentSessionId = useCallback(
    () => recordingState.currentSessionId,
    [recordingState.currentSessionId]
  );

  // ---------------------------------------------------------------------------
  // Cleanup on unmount
  // ---------------------------------------------------------------------------
  useEffect(() => {
    return () => {
      if (timerIntervalRef.current) clearInterval(timerIntervalRef.current);
      if (autoSegmentTimerRef.current)
        clearInterval(autoSegmentTimerRef.current);
    };
  }, []);

  return {
    recordingState,
    startRecording,
    stopRecording,
    pauseRecording,
    resumeRecording,
    discardRecording,
    getConsolidatedAudioFile,
    getCurrentSessionId,
  };
}
