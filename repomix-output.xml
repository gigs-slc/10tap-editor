import {supabase} from "@/utils/supabase";
import {Content, InsertContent, UpdateContent} from "./types"


export async function insertContentMutation(inputData: InsertContent) : Promise<Content> {
    const {data, error} = await supabase
        .from("content")
        .insert({
            device_type: "MOBILE",
            ...inputData
        })
        .select()
        .single()
    if (error) throw new Error("Error inserting content topic: " + error.message);
    if(!data) throw new Error("Could not fetch content rows from DB")
    return data;
}

export async function updateContentMutation(updateData: UpdateContent) : Promise<Content> {
    const {data, error} = await supabase
        .from("content")
        .update(updateData)
        .eq("content_id", updateData.content_id)
        .select('*')
        .single()
    if (error) throw new Error("Error updating content topic: " + error.message);
    if (!data) throw new Error("Could not fetch content topic: " + updateData.content_id);
    console.log('data:', data)
    return data;
}

export async function deleteContentMutation (content_id: string): Promise<void> {
    const { error } = await supabase
        .from("content")
        .delete()
        .eq("content_id", content_id);
    if (error) throw new Error(`Failed to delete note: ${error.message}`);
}
