import React from 'react';
import {Pressable, View, Text} from 'react-native';
import Animated, {
    interpolate,
    useAnimatedStyle,
    useSharedValue,
    withTiming,
} from 'react-native-reanimated';
import {windowWidth} from "@/utils/window";
import {createStyleSheet, useStyles} from "react-native-unistyles";
import {moderateScale} from "react-native-size-matters";


interface FlipCardProps {
    front: string;
    back: string;
    index: number;
}

export const FlippableCard = ({front, back, index} : FlipCardProps) => {
    const isDirectionX = false;
    const durationMS = 400;
    const isFlipped = useSharedValue(false);
    const { styles } = useStyles(stylesheet);


    const regularCardAnimatedStyle = useAnimatedStyle(() => {
        const spinValue = interpolate(Number(isFlipped.value), [0, 1], [0, 180]);
        const rotateValue = withTiming(`${spinValue}deg`, { duration: durationMS });

        return {
            transform: [
                isDirectionX ? { rotateX: rotateValue } : { rotateY: rotateValue },
            ],
        };
    });

    const flippedCardAnimatedStyle = useAnimatedStyle(() => {
        const spinValue = interpolate(Number(isFlipped.value), [0, 1], [180, 360]);
        const rotateValue = withTiming(`${spinValue}deg`, { duration: durationMS });

        return {
            transform: [
                isDirectionX ? { rotateX: rotateValue } : { rotateY: rotateValue },
            ],
        };
    });

    return (
        <View >
            <Animated.View
                style={[
                    styles.regularCard,
                    regularCardAnimatedStyle,
                ]}>
                <Pressable style={styles.card} onPress={() => {
                    isFlipped.value = !isFlipped.value;
                }}>
                    <Text style={styles.text}>{front}</Text>
                </Pressable>
            </Animated.View>
            <Animated.View
                style={[
                    styles.flippedCard,
                    flippedCardAnimatedStyle,
                ]}>
                <Pressable style={styles.card} onPress={() => {
                    isFlipped.value = !isFlipped.value;
                }}>
                    <Text style={styles.text}>{back}</Text>
                </Pressable>
            </Animated.View>
        </View>
    );
};

const stylesheet = createStyleSheet((theme) => ({
    regularCard: {
        position: 'absolute',
        zIndex: 1,
    },
    flippedCard: {
        backfaceVisibility: 'hidden',
        zIndex: 2,
    },
    card: {
        flex: 1,
        backgroundColor: theme.colors.background.SECONDARY,
        borderRadius: 16,
        justifyContent: 'center',
        alignItems: 'center',
        width: windowWidth * .77,
        height: windowWidth * .65
    },
    text: {
        color: theme.colors.text.PRIMARY,
        fontFamily: 'Sans-Medium',
        fontSize: moderateScale(14),
        width: windowWidth * .7,
        alignSelf: 'center',
        textAlign: 'center'
    },
}));
</file>

