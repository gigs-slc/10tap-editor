<file path="tiptap-extensions/CustomExtensions/CleanPasteExtension.ts">
import { Extension } from '@tiptap/core'
import { Plugin } from 'prosemirror-state'

type CleanPasteOptions = {
    /** Font families you actually load in your app (case-insensitive). */
    allowedFonts: string[]
    /** If set, unknown fonts will be rewritten to this font, else the font-family style is removed. */
    unknownFontFallback?: string | null
    /** Whether to strip explicitly black colors. Default true. */
    stripBlack?: boolean
    /** Whether to strip explicitly white colors. Default true. */
    stripWhite?: boolean
}

const normalizeFontName = (f: string) =>
    f.trim().replace(/^['"]|['"]$/g, '').toLowerCase()

const parseFontList = (list: string): string[] =>
    // Split by commas (very good approximation for pasted content)
    list.split(',').map(normalizeFontName).filter(Boolean)

/** Accepts hex (#000, #000000, #fff, #ffffff), rgb()/rgba(), and named 'black'/'white'. */
const isBlackOrWhite = (value: string, stripBlack: boolean, stripWhite: boolean) => {
    if (!value) return false
    const v = value.trim().toLowerCase()

    // Named
    if (stripBlack && v === 'black') return true
    if (stripWhite && v === 'white') return true

    // HEX
    if (v[0] === '#') {
        const hex = v.replace('#', '')
        if (stripBlack && (hex === '000' || hex === '000000')) return true
        if (stripWhite && (hex === 'fff' || hex === 'ffffff')) return true
        return false
    }

    // rgb() / rgba() — allow both comma and space separated forms
    // examples: rgb(0,0,0), rgba(255,255,255,1), rgb(0 0 0 / 1)
    const rgbLike = v
        .replace(/\s*\/\s*[\d.]+%?\)?$/, ')') // drop alpha for comparison
        .replace(/\s+/g, ' ')                 // normalize spaces
        .replace(/,\s*/g, ',')                // normalize commas
    const m = rgbLike.match(/^rgba?\(([\d.\s,]+)\)$/)
    if (m) {
        // pull the first three numeric channels
        const nums = m[1].split(/[,\s]+/).slice(0, 3).map(n => Number(n))
        if (nums.length === 3 && nums.every(n => Number.isFinite(n))) {
            const [r, g, b] = nums
            if (stripBlack && r === 0 && g === 0 && b === 0) return true
            if (stripWhite && r === 255 && g === 255 && b === 255) return true
        }
    }

    // Legacy MSO special-case: treat 'windowtext' as black if present
    if (stripBlack && v === 'windowtext') return true

    return false
}

const quoteIfNeeded = (name: string) =>
    /\s/.test(name) ? `"${name}"` : name

function cleanPastedHTML(
    html: string,
    opts: Required<Omit<CleanPasteOptions, 'allowedFonts' | 'unknownFontFallback'>> & {
        allowedFontsSet: Set<string>,
        unknownFontFallback?: string | null
    },
): string {
    console.log('[CleanPaste] Original HTML:', html)
    console.log('[CleanPaste] Options:', {
        allowedFonts: Array.from(opts.allowedFontsSet),
        unknownFontFallback: opts.unknownFontFallback,
        stripBlack: opts.stripBlack,
        stripWhite: opts.stripWhite
    })
    
    const container = document.createElement('div')
    container.innerHTML = html

    const { allowedFontsSet, unknownFontFallback, stripBlack, stripWhite } = opts

    // Allowed line heights from toolbar
    const allowedLineHeights = new Set(['normal', '1', '1.15', '1.5', '2']);
    
    // Process paragraphs and other block elements for line-height
    container.querySelectorAll<HTMLElement>('p, div, h1, h2, h3, h4, h5, h6').forEach(el => {
        const lineHeight = el.style?.lineHeight;
        if (lineHeight) {
            console.log(`[CleanPaste] Line height found on ${el.tagName}: ${lineHeight}`);
            
            // Check if it's one of our allowed values
            if (!allowedLineHeights.has(lineHeight)) {
                // Convert common line height values to our closest option
                const numericValue = parseFloat(lineHeight);
                let closestValue = 'normal';
                
                if (!isNaN(numericValue)) {
                    if (numericValue <= 1.1) closestValue = '1';
                    else if (numericValue <= 1.3) closestValue = '1.15';
                    else if (numericValue <= 1.75) closestValue = '1.5';
                    else closestValue = '2';
                }
                
                console.log(`[CleanPaste] Normalizing line height from ${lineHeight} to ${closestValue}`);
                el.style.lineHeight = closestValue;
            }
        }
    });

    // Clean inline styles & legacy <font color="">
    container.querySelectorAll<HTMLElement>('*').forEach(el => {
        // LOG FONT SIZE
        const fontSize = el.style?.fontSize;
        if (fontSize) {
            console.log(`[CleanPaste] Font size found on ${el.tagName}: ${fontSize}`);
        }
        // COLOR
        const inlineColor = el.style?.color
        if (inlineColor && isBlackOrWhite(inlineColor, stripBlack, stripWhite)) {
            console.log(`[CleanPaste] Removing color "${inlineColor}" from ${el.tagName}`)
            el.style.removeProperty('color')
        }
        // <font color="..."> (rare, but some sources still use it)
        const fontTagColor = el.getAttribute('color')
        if (fontTagColor && isBlackOrWhite(fontTagColor, stripBlack, stripWhite)) {
            console.log(`[CleanPaste] Removing color attribute "${fontTagColor}" from ${el.tagName}`)
            el.removeAttribute('color')
        }

        // FONT-FAMILY
        const ff = el.style?.fontFamily
        if (ff) {
            const families = parseFontList(ff)
            const kept = families.filter(f => allowedFontsSet.has(f))
            
            console.log(`[CleanPaste] Font-family processing for ${el.tagName}:`, {
                original: ff,
                parsed: families,
                kept: kept,
                willReplace: kept.length === 0 && unknownFontFallback
            })

            if (kept.length > 0) {
                el.style.fontFamily = kept.map(quoteIfNeeded).join(', ')
            } else if (unknownFontFallback && unknownFontFallback.trim().length > 0) {
                el.style.fontFamily = quoteIfNeeded(unknownFontFallback)
            } else {
                el.style.removeProperty('font-family')
            }
        }
    })

    // Clean up link styling - be more granular about what we remove
    container.querySelectorAll<HTMLAnchorElement>('a').forEach(link => {
        console.log(`[CleanPaste] Processing link: ${link.href}`);
        
        // Remove specific inline styles but preserve font-family and font-size
        if (link.style.length > 0) {
            console.log(`[CleanPaste] Processing ${link.style.length} inline styles on link`);
            
            // Save font-family and font-size if they exist
            const fontFamily = link.style.fontFamily;
            const fontSize = link.style.fontSize;
            
            // Remove specific unwanted styles
            link.style.removeProperty('color');
            link.style.removeProperty('text-decoration');
            link.style.removeProperty('text-decoration-line');
            link.style.removeProperty('text-decoration-style');
            link.style.removeProperty('text-decoration-color');
            link.style.removeProperty('background-color');
            link.style.removeProperty('background');
            
            console.log(`[CleanPaste] Preserved font-family: ${fontFamily}, font-size: ${fontSize}`);
        }
        
        // Remove any color-related attributes
        if (link.hasAttribute('color')) {
            link.removeAttribute('color');
        }
        
        // Keep only essential attributes (href, target, rel)
        const allowedLinkAttributes = ['href', 'target', 'rel', 'style'];
        const attributesToRemove: string[] = [];
        
        for (let i = 0; i < link.attributes.length; i++) {
            const attr = link.attributes[i];
            if (!allowedLinkAttributes.includes(attr.name)) {
                attributesToRemove.push(attr.name);
            }
        }
        
        attributesToRemove.forEach(attrName => {
            console.log(`[CleanPaste] Removing attribute "${attrName}" from link`);
            link.removeAttribute(attrName);
        });
        
        // Process spans inside links - preserve font-family and font-size
        link.querySelectorAll<HTMLElement>('span').forEach(span => {
            console.log(`[CleanPaste] Processing span inside link`);
            
            // Check if span has font-family or font-size
            const spanFontFamily = span.style?.fontFamily;
            const spanFontSize = span.style?.fontSize;
            
            if (spanFontFamily || spanFontSize) {
                // Remove unwanted styles but preserve font properties
                console.log(`[CleanPaste] Span has font properties: family=${spanFontFamily}, size=${spanFontSize}`);
                
                // Remove specific unwanted styles
                span.style.removeProperty('color');
                span.style.removeProperty('text-decoration');
                span.style.removeProperty('text-decoration-line');
                span.style.removeProperty('text-decoration-style');
                span.style.removeProperty('text-decoration-color');
                span.style.removeProperty('background-color');
                span.style.removeProperty('background');
                
                // If the span now has no styles, remove it but preserve content
                if (span.style.length === 0) {
                    const textNode = document.createTextNode(span.textContent || '');
                    span.parentNode?.replaceChild(textNode, span);
                }
            } else {
                // No font properties to preserve, just replace with text
                const textNode = document.createTextNode(span.textContent || '');
                span.parentNode?.replaceChild(textNode, span);
            }
        });
    });

    // Optional: nuke any <style> tags that sneak in from Google Docs/Word
    // (TipTap usually sanitizes, but keeping this for belt & suspenders)
    const styleTags = container.querySelectorAll('style')
    if (styleTags.length > 0) {
        console.log(`[CleanPaste] Removing ${styleTags.length} <style> tags`)
        styleTags.forEach(s => s.remove())
    }

    const cleanedHTML = container.innerHTML
    console.log('[CleanPaste] Cleaned HTML:', cleanedHTML)
    
    return cleanedHTML
}

export const CleanPasteExtension = Extension.create<CleanPasteOptions>({
    name: 'cleanPaste',

    addOptions() {
        return {
            allowedFonts: [],
            unknownFontFallback: null,
            stripBlack: true,
            stripWhite: true,
        }
    },

    addProseMirrorPlugins() {
        const allowedFontsSet = new Set(
            this.options.allowedFonts.map(normalizeFontName)
        )

        return [
            new Plugin({
                props: {
                    transformPastedHTML: (html: string) =>
                        cleanPastedHTML(html, {
                            allowedFontsSet,
                            unknownFontFallback: this.options.unknownFontFallback ?? null,
                            stripBlack: this.options.stripBlack ?? true,
                            stripWhite: this.options.stripWhite ?? true,
                        }),
                },
            }),
        ]
    },
})
</file>

<file path="tiptap-extensions/CustomExtensions/customPlaceholder.ts">
import { Plugin, PluginKey } from '@tiptap/pm/state'
import { Decoration, DecorationSet } from '@tiptap/pm/view'
import { isNodeEmpty } from '@tiptap/core'
import {Placeholder} from "@tiptap/extensions";

interface PlaceholderOptions {
    emptyEditorClass?: string;
    emptyNodeClass?: string;
    placeholder?: string | ((props: { editor: any; node: any; pos: number; hasAnchor: boolean }) => string);
    showOnlyWhenEditable?: boolean;
    showOnlyCurrent?: boolean;
    includeChildren?: boolean;
}

export const CustomPlaceholder = Placeholder.extend<PlaceholderOptions & { disabled: boolean }>({
    name: 'customPlaceholder',

    addOptions() {
        return {
            ...this.parent?.(),   // ← access parent defaults
            disabled: false,
        }
    },

    addProseMirrorPlugins() {
        const key = new PluginKey('customPlaceholder')

        return [
            new Plugin({
                key,
                props: {
                    decorations: ({ doc, selection }) => {
                        const active =
                            this.editor.isEditable || !this.options.showOnlyWhenEditable
                        
                        if (!active) return null

                        const { anchor } = selection
                        const isEmptyDoc = this.editor.isEmpty
                        const decorations: Decoration[] = []

                        doc.descendants((node, pos) => {
                            const hasAnchor = anchor >= pos && anchor <= pos + node.nodeSize
                            const isEmpty = !node.isLeaf && isNodeEmpty(node)
                            const isDefaultLeft = !('textAlign' in (node.attrs || {}));
                            const isLeft = node.attrs?.textAlign === 'left' || isDefaultLeft

                            if (
                                isEmpty &&
                                isLeft &&
                                (hasAnchor || !this.options.showOnlyCurrent)
                            ) {
                                const classes = [this.options.emptyNodeClass]
                                if (isEmptyDoc) classes.push(this.options.emptyEditorClass)

                                decorations.push(
                                    Decoration.node(pos, pos + node.nodeSize, {
                                        class: classes.join(' '),
                                        'data-placeholder':
                                            typeof this.options.placeholder === 'function'
                                                ? this.options.placeholder({
                                                    editor: this.editor,
                                                    node,
                                                    pos,
                                                    hasAnchor,
                                                })
                                                : this.options.placeholder,
                                    }),
                                )
                            }

                            return this.options.includeChildren
                        })

                        return DecorationSet.create(doc, decorations)
                    },
                },
            }),
        ]
    },
})
</file>

<file path="tiptap-extensions/CustomExtensions/exitListOnBackspace.ts">
import { Extension } from '@tiptap/core'
import { Selection } from 'prosemirror-state'

export const ExitListOnBackspace = Extension.create({
    name: 'exitListOnBackspace',
    priority: 2000,

    addKeyboardShortcuts() {
        return {
            Backspace: ({ editor }) => {
                const { state } = editor
                const { selection, schema } = state
                const { $from } = selection
                if (!selection.empty) return false

                const bulletList = schema.nodes.bulletList
                const orderedList = schema.nodes.orderedList
                const listItem = schema.nodes.listItem
                if ((!bulletList && !orderedList) || !listItem) return false

                {
                    let liDepth = -1
                    for (let d = $from.depth; d > 0; d--) {
                        if ($from.node(d).type === listItem) {
                            liDepth = d
                            break
                        }
                    }

                    const parentBlock = $from.parent
                    const atStartOfBlock = $from.parentOffset === 0
                    const isEmptyBlock = parentBlock.isTextblock && parentBlock.content.size === 0

                    if (liDepth === -1 && atStartOfBlock && isEmptyBlock) {
                        const containerDepth = $from.depth - 1
                        const container = $from.node(containerDepth)
                        const idxInContainer = $from.index(containerDepth)
                        const prevSibling =
                            idxInContainer > 0 ? container.child(idxInContainer - 1) : null

                        if (prevSibling && (prevSibling.type === bulletList || prevSibling.type === orderedList)) {
                            const fromPos = $from.before()
                            const toPos = $from.after()
                            const tr = state.tr.delete(fromPos, toPos)
                            tr.setSelection(Selection.near(tr.doc.resolve(fromPos), -1))
                            editor.view.dispatch(tr)
                            return true
                        }
                    }
                }

                {
                    let liDepth = -1
                    for (let d = $from.depth; d > 0; d--) {
                        if ($from.node(d).type === listItem) {
                            liDepth = d
                            break
                        }
                    }
                    if (liDepth === -1) return false

                    const isTextblock = $from.parent.isTextblock
                    const atStartOfBlock = $from.parentOffset === 0
                    const isFirstChildOfLI = $from.index(liDepth) === 0
                    if (!isTextblock || !atStartOfBlock || !isFirstChildOfLI) return false

                    const blockTypeName = $from.parent.type.name
                    const isAlignable = blockTypeName === 'paragraph' || blockTypeName === 'heading'
                    const currentAlign = isAlignable ? ($from.parent.attrs as any)?.textAlign : undefined
                    const shouldForceLeft = isAlignable && (currentAlign == null || currentAlign === '')

                    const chain = editor.chain().focus().liftListItem('listItem')
                    if (shouldForceLeft) chain.setTextAlign('left')
                    return chain.run()
                }
            },
        }
    },
})
</file>

<file path="tiptap-extensions/CustomExtensions/fontsize.ts">
import { Extension } from "@tiptap/core";
import "@tiptap/extension-text-style";

declare module "@tiptap/core" {
    interface Commands<ReturnType> {
        fontSize: {
            setFontSize: (size: string) => ReturnType
            unsetFontSize: () => ReturnType
        }
    }
}

export const FontSizeExtension = Extension.create({
    name: "fontSize",
    addOptions() {
        return {
            types: ["textStyle"],
        }
    },
    addGlobalAttributes() {
        return [
            {
                types: this.options.types,
                attributes: {
                    fontSize: {
                        default: null,
                        parseHTML: element => element.style.fontSize,
                        renderHTML: attributes => {
                            if (!attributes.fontSize) {
                                return {};
                            }

                            return {
                                style: `font-size: ${attributes.fontSize}`,
                            }
                        }
                    }
                }
            }
        ]
    },
    addCommands() {
        return {
            setFontSize: (fontSize: string) => ({ chain }) => {
                return chain()
                    .setMark("textStyle", { fontSize })
                    .run()
            },
            unsetFontSize: () => ({ chain }) => {
                return chain()
                    .setMark("textStyle", { fontSize: null })
                    .removeEmptyTextStyle()
                    .run()
            },
        }
    },
});
</file>

<file path="tiptap-extensions/CustomExtensions/lineHeight.ts">
import { Extension } from "@tiptap/core";

declare module "@tiptap/core" {
    interface Commands<ReturnType> {
        lineHeight: {
            setLineHeight: (lineHeight: string) => ReturnType
            unsetLineHeight: () => ReturnType
        }
    }
}

export const LineHeightExtension = Extension.create({
    name: "lineHeight",
    addOptions() {
        return {
            types: ["paragraph", "heading"],
            defaultLineHeight: "normal",
        }
    },
    addGlobalAttributes() {
        return [
            {
                types: this.options.types,
                attributes: {
                    lineHeight: {
                        default: this.options.defaultLineHeight,
                        renderHTML: attributes => {
                            if (!attributes.lineHeight) return {}
                            return {
                                style: `line-height: ${attributes.lineHeight}`,
                            }
                        },
                        parseHTML: element => {
                            return element.style.lineHeight || this.options.defaultLineHeight
                        }
                    }
                }
            }
        ]
    },
    addCommands() {
        return {
            setLineHeight: (lineHeight: string) => ({ tr, state, dispatch }) => {
                const { selection } = state;
                tr = tr.setSelection(selection);

                const { from, to } = selection;
                state.doc.nodesBetween(from, to, (node, pos) => {
                    if (this.options.types.includes(node.type.name)) {
                        tr = tr.setNodeMarkup(pos, undefined, {
                            ...node.attrs,
                            lineHeight,
                        })
                    }
                })

                if (dispatch) dispatch(tr)
                return true;
            },
            unsetLineHeight: () => ({ tr, state, dispatch }) => {
                const { selection } = state;
                tr = tr.setSelection(selection);

                const { from, to } = selection;
                state.doc.nodesBetween(from, to, (node, pos) => {
                    if (this.options.types.includes(node.type.name)) {
                        tr = tr.setNodeMarkup(pos, undefined, {
                            ...node.attrs,
                            lineHeight: this.options.defaultLineHeight
                        })
                    }
                })

                if (dispatch) dispatch(tr)
                return true;
            }
        }
    },
});
</file>

<file path="tiptap-extensions/CustomExtensions/SelectionDecoration.ts">
import { Extension } from '@tiptap/core';
import { Plugin, PluginKey } from '@tiptap/pm/state';
import { Decoration, DecorationSet } from '@tiptap/pm/view';

export const SelectionDecoration = Extension.create({
  name: 'selectionDecoration',

  addOptions() {
    return {
      className: 'selection-decoration',
    }
  },

  addProseMirrorPlugins() {
    const pluginKey = new PluginKey('selection')
    
    return [
      new Plugin({
        key: pluginKey,
        props: {
          decorations: (state) => {
            const { selection } = state
            const isFocused = this.editor.isFocused

            // Skip decoration if editor is focused or no selection
            if (isFocused || selection.empty) {
              return null
            }

            return DecorationSet.create(state.doc, [
              Decoration.inline(selection.from, selection.to, {
                class: this.options.className,
              }),
            ])
          },
          handleDOMEvents: {
            // Handle mousedown to focus editor immediately
            mousedown: (view) => {
              if (!view.hasFocus()) {
                // Focus the editor immediately
                view.focus()
                // Force update to remove decoration
                requestAnimationFrame(() => {
                  view.dispatch(view.state.tr)
                })
              }
              return false
            },
          },
        },
      }),
    ]
  },
})
</file>

