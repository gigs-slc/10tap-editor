import {windowWidth} from "@/utils/window";
import {useSingleContentRowQuery} from "@data/content/hooks/useSingleContentRowQuery";
import {createStyleSheet, useStyles} from "react-native-unistyles";

export default function ActionBar({ selectedAction, setSelectedAction, content_id }: { selectedAction: NoteActionButton; setSelectedAction: React.Dispatch<React.SetStateAction<NoteActionButton>>, content_id: string }) {
    const { styles, theme } = useStyles(stylesheet);
    const { data: currentNote  } = useSingleContentRowQuery(content_id);
    const data: NoteActionButton[] = ['Notes', 'Podcast','Quiz', 'Chat', 'Flashcards', 'Transcript'];

    type ItemProps = { title: NoteActionButton };

    const returnTextColor = (title : string) => {
        if(selectedAction === title) return '#fff';
        else {
            return theme.colors.text.PRIMARY;
        }
    }

    const isDisabled = !currentNote || currentNote.percent_completed !== 100 || currentNote.content_status === "NOT_ENOUGH_CREDITS";
    
    const Item = ({ title }: ItemProps) => (
        <TouchableOpacity 
            style={[
                styles.button, 
                { 
                    backgroundColor: selectedAction === title ? theme.colors.tints.PRIMARY : theme.colors.background.SECONDARY,
                    opacity: isDisabled && title !== 'Notes' ? 0.5 : 1
                }
            ]} 
            onPress={() => {
                void heavyHaptic();
                if(!isDisabled) {
                    setSelectedAction(title);
                }
            }}
            disabled={isDisabled && title !== 'Notes'}
        >
            <Text style={[styles.title, { color: returnTextColor(title)}]}>{title}</Text>
        </TouchableOpacity>
    );

    return (
        <View style={styles.row}>
            <FlatList
                data={data}
                horizontal={true}
                showsHorizontalScrollIndicator={false}
                renderItem={({ item }) => <Item key={item} title={item} />}
                keyExtractor={(item) => item}
            />
        </View>
    );
}

