  const [speaker1, setSpeaker1] = useState<PodcastSpeakers | null>(null);
  const [speaker2, setSpeaker2] = useState<PodcastSpeakers | null>(null);
  const [length, setLength] = useState<'short' | 'medium' | 'long'>('short');
  const [instructions, setInstructions] = useState<string>('');
  const [isSubmitting, setIsSubmitting] = useState<boolean>(false);

  const [openSpeaker1Dialog, setOpenSpeaker1Dialog] = useState<boolean>(false);
  const [openSpeaker2Dialog, setOpenSpeaker2Dialog] = useState<boolean>(false);

  const [sound, setSound] = useState<Audio.Sound | null>(null);
  const [playingId, setPlayingId] = useState<string | null>(null);

  const [openInstructionsModal, setOpenInstructionsModal] = useState<boolean>(false);
  const [tempInstructions, setTempInstructions] = useState<string>('');

  const { data: speakers, isPending: speakersLoading } = usePodcastSpeakersRowsQuery();

  const insertPodcast = useInsertPodcastMutation();
  const updatePodcast = useUpdatePodcastMutation();
  // Initialize audio mode once
  useEffect(() => {
    console.log('CreatePodcastPage mounted');
    
    Audio.setAudioModeAsync({
      allowsRecordingIOS: false,
      staysActiveInBackground: false,
      playsInSilentModeIOS: true,
      shouldDuckAndroid: true,
      playThroughEarpieceAndroid: false,
    }).catch(err => console.log('Audio mode setup error:', err));

    return () => {
      console.log('CreatePodcastPage unmounting');
      if (sound) sound.unloadAsync();
    };
  }, []);

  // Clear selections when language changes
  useEffect(() => {
    setSpeaker1(null);
    setSpeaker2(null);
  }, [language]);

  const speakerOptions = speakers
    ?.filter((s: PodcastSpeakers) => s.is_active && s.language_code === language) ?? [];

  // Better togglePlay using Audio.Sound constructor
  const togglePlay = async (sp: PodcastSpeakers) => {
    try {
      // If already playing this one, stop & unload
      if (playingId === sp.speaker_id && sound) {
        await sound.stopAsync();
        await sound.unloadAsync();
        setSound(null);
        setPlayingId(null);
        return;
      }
  
      // Otherwise, stop/unload any other sound first
      if (sound) {
        await sound.stopAsync();
        await sound.unloadAsync();
        setSound(null);
        setPlayingId(null);
      }
  
      // Create & load new sound
      const playback = new Audio.Sound();
  
      await playback.loadAsync({ uri: sp.example_audio_url });
      await playback.playAsync();
  
      setSound(playback);
      setPlayingId(sp.speaker_id);
  
    } catch (err) {
      console.error('Error toggling playback:', err);
      Alert.alert('Audio Error', 'Unable to play this sample. Please try again later.');
      setPlayingId(null);
    }
  };
  

  const handleGenerate = async () => {
    if (!speaker1 || !speaker2) return;
    setIsSubmitting(true);

    const podcast_uuid = uuid();

    try {
      insertPodcast.mutate({
        podcast_id: podcast_uuid,
        speaker_1_id: speaker1.speaker_id,
        speaker_2_id: speaker2.speaker_id,
        content_id: contentId,
        student_id: student_id!,
        podcast_length: length,
        podcast_focus: instructions || null,
        podcast_status: "IN_PROGRESS"
      });

      const accessToken = await getUserAccessToken();

      const response = await fetch(`${NODE_EXPRESS_URL}/handlePodcastGenerationRequest`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${accessToken}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          podcastID: podcast_uuid,
          speaker1ID: speaker1.speaker_id,
          speaker2ID: speaker2.speaker_id,
          podcast_focus: instructions || ''
        }),
      });

      if (!response.ok) {
        throw new Error(`Generation request failed: ${response.status}`);
      }

      // Call the onPodcastCreated callback with the new podcast ID
      if (onPodcastCreated) {
        onPodcastCreated(podcast_uuid);
      }

      // Reset form
      setInstructions('');
      setLength('short');
      setSpeaker1(null);
      setSpeaker2(null);

    } catch (error) {
      console.error('Error generating podcast:', error);
      
      // Update podcast status to FAILED
      updatePodcast.mutate({
        podcast_id: podcast_uuid,
        content_id: contentId,
        podcast_status: 'FAILED'
      });
      
      // Navigate to the podcast page to show the failed state
      if (onPodcastCreated) {
        onPodcastCreated(podcast_uuid);
      }
    } finally {
      setIsSubmitting(false);
    }
  };

  const handleInstructionsSave = () => {
    setInstructions(tempInstructions);
    setOpenInstructionsModal(false);
  };

  return (
    <View style={styles.container}>
      <ScrollView
        style={styles.scrollView}
        contentContainerStyle={styles.contentContainer}
        showsVerticalScrollIndicator={false}
        showsHorizontalScrollIndicator={false}
        horizontal={false}
      >
        <View style={styles.formCard}>
          {onViewAllPodcasts && hasExistingPodcasts ? (
            <TouchableOpacity
              style={styles.viewAllButton}
              onPress={onViewAllPodcasts}
            >
