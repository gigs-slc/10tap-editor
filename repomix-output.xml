              >
                <Text style={[styles.modalButtonText, { color: '#FFFFFF' }]}>Save</Text>
              </TouchableOpacity>
            </View>
          </View>
        </TouchableOpacity>
      </Modal>

      {/* Speaker 1 Modal */}
      <Modal
        visible={openSpeaker1Dialog}
        transparent
