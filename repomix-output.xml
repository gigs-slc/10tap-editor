import * as FileSystem from "expo-file-system";

export interface WavFileInfo {
  filePath: string;
  sampleRate: number;
  channels: number;
  duration: number;
}

/**
 * Concatenates multiple WAV files into a single WAV file
 * This implementation properly handles WAV headers and concatenates audio data
 */
export async function concatenateWavFiles(
  wavFiles: WavFileInfo[],
  outputPath: string
): Promise<string> {
  try {
    if (wavFiles.length === 0) {
      throw new Error("No WAV files provided for concatenation");
    }

    if (wavFiles.length === 1) {
      // Only one file, just copy it to the output path
      await FileSystem.copyAsync({
        from: wavFiles[0].filePath,
        to: outputPath,
      });
      return outputPath;
    }

    console.log("🎵 Concatenating", wavFiles.length, "WAV files");

    // Verify all files exist before processing
    for (let i = 0; i < wavFiles.length; i++) {
      const fileInfo = await FileSystem.getInfoAsync(wavFiles[i].filePath);
      if (!fileInfo.exists) {
        console.error(
          `❌ WAV file ${i + 1} does not exist:`,
          wavFiles[i].filePath
        );
        throw new Error(`WAV file does not exist: ${wavFiles[i].filePath}`);
      }
    }

    // Read the first file to get WAV header and format info
    const firstFileUri = await FileSystem.readAsStringAsync(
      wavFiles[0].filePath,
      {
        encoding: FileSystem.EncodingType.Base64,
      }
    );
    const firstFileBytes = base64ToUint8Array(firstFileUri);

    if (firstFileBytes.length < 44) {
      throw new Error("Invalid WAV file: too small");
    }

    // Validate WAV header
    const riffHeader = String.fromCharCode(...firstFileBytes.slice(0, 4));
    const waveHeader = String.fromCharCode(...firstFileBytes.slice(8, 12));

    if (riffHeader !== "RIFF" || waveHeader !== "WAVE") {
      throw new Error("Invalid WAV file format");
    }

    // Extract format information from first file
    const formatChunkStart = findChunk(firstFileBytes, "fmt ");
    if (formatChunkStart === -1) {
      throw new Error("No format chunk found in WAV file");
    }

    const formatChunkSize = readUint32LE(firstFileBytes, formatChunkStart + 4);
    const audioFormat = readUint16LE(firstFileBytes, formatChunkStart + 8);
    const numChannels = readUint16LE(firstFileBytes, formatChunkStart + 10);
    const sampleRate = readUint32LE(firstFileBytes, formatChunkStart + 12);
    const byteRate = readUint32LE(firstFileBytes, formatChunkStart + 16);
    const blockAlign = readUint16LE(firstFileBytes, formatChunkStart + 20);
    const bitsPerSample = readUint16LE(firstFileBytes, formatChunkStart + 22);

    console.log("🎵 WAV Format:", {
      audioFormat,
      numChannels,
      sampleRate,
      bitsPerSample,
      blockAlign,
    });

    // Collect all audio data from all files
    const audioDataChunks: Uint8Array[] = [];
    let totalAudioBytes = 0;

    for (let i = 0; i < wavFiles.length; i++) {
      console.log(
        `🎵 Processing file ${i + 1}/${wavFiles.length}:`,
        wavFiles[i].filePath
      );

      const fileUri = await FileSystem.readAsStringAsync(wavFiles[i].filePath, {
        encoding: FileSystem.EncodingType.Base64,
      });
      const fileBytes = base64ToUint8Array(fileUri);

      // Find data chunk in this file
      const dataChunkStart = findChunk(fileBytes, "data");
      if (dataChunkStart === -1) {
        console.warn(`⚠️ No data chunk found in file ${i + 1}, skipping`);
        continue;
      }

      const dataChunkSize = readUint32LE(fileBytes, dataChunkStart + 4);
      const audioData = fileBytes.slice(
        dataChunkStart + 8,
        dataChunkStart + 8 + dataChunkSize
      );

      console.log(
        `🎵 File ${i + 1} audio data size:`,
        audioData.length,
        "bytes"
      );

      audioDataChunks.push(audioData);
      totalAudioBytes += audioData.length;
    }

    if (audioDataChunks.length === 0) {
      throw new Error("No valid audio data found in any WAV files");
    }

    console.log("🎵 Total audio data:", totalAudioBytes, "bytes");

    // Create new WAV file with concatenated audio data
    const outputFileSize = 36 + totalAudioBytes; // 44 byte header - 8 bytes + data size
    const outputBuffer = new Uint8Array(44 + totalAudioBytes);

    // Write WAV header
    let offset = 0;

    // RIFF header
    writeString(outputBuffer, offset, "RIFF");
    offset += 4;
    writeUint32LE(outputBuffer, offset, outputFileSize);
    offset += 4;
    writeString(outputBuffer, offset, "WAVE");
    offset += 4;

    // Format chunk
    writeString(outputBuffer, offset, "fmt ");
    offset += 4;
    writeUint32LE(outputBuffer, offset, 16);
    offset += 4; // Format chunk size
    writeUint16LE(outputBuffer, offset, audioFormat);
    offset += 2;
    writeUint16LE(outputBuffer, offset, numChannels);
    offset += 2;
    writeUint32LE(outputBuffer, offset, sampleRate);
    offset += 4;
    writeUint32LE(outputBuffer, offset, byteRate);
    offset += 4;
    writeUint16LE(outputBuffer, offset, blockAlign);
    offset += 2;
    writeUint16LE(outputBuffer, offset, bitsPerSample);
    offset += 2;

    // Data chunk header
    writeString(outputBuffer, offset, "data");
    offset += 4;
    writeUint32LE(outputBuffer, offset, totalAudioBytes);
    offset += 4;

    // Copy all audio data
    for (const audioChunk of audioDataChunks) {
      outputBuffer.set(audioChunk, offset);
      offset += audioChunk.length;
    }

    // Convert to base64 and write to file
    const outputBase64 = uint8ArrayToBase64(outputBuffer);
    await FileSystem.writeAsStringAsync(outputPath, outputBase64, {
      encoding: FileSystem.EncodingType.Base64,
    });

    console.log(
      "✅ Successfully concatenated",
      wavFiles.length,
      "WAV files to:",
      outputPath
    );
    console.log("🎵 Output file size:", outputBuffer.length, "bytes");

    return outputPath;
  } catch (error) {
    console.error("❌ Error concatenating WAV files:", error);
    throw error;
  }
}

// Helper functions for WAV file manipulation
function base64ToUint8Array(base64: string): Uint8Array {
  const binaryString = atob(base64);
  const bytes = new Uint8Array(binaryString.length);
  for (let i = 0; i < binaryString.length; i++) {
    bytes[i] = binaryString.charCodeAt(i);
  }
  return bytes;
}

function uint8ArrayToBase64(uint8Array: Uint8Array): string {
  let binaryString = "";
  for (let i = 0; i < uint8Array.length; i++) {
    binaryString += String.fromCharCode(uint8Array[i]);
  }
  return btoa(binaryString);
}

function findChunk(bytes: Uint8Array, chunkId: string): number {
  const chunkIdBytes = new TextEncoder().encode(chunkId);
  for (let i = 12; i < bytes.length - 8; i += 4) {
    let match = true;
    for (let j = 0; j < 4; j++) {
      if (bytes[i + j] !== chunkIdBytes[j]) {
        match = false;
        break;
      }
    }
    if (match) {
      return i;
    }
  }
  return -1;
}

function readUint16LE(bytes: Uint8Array, offset: number): number {
  return bytes[offset] | (bytes[offset + 1] << 8);
}

function readUint32LE(bytes: Uint8Array, offset: number): number {
  return (
    bytes[offset] |
    (bytes[offset + 1] << 8) |
    (bytes[offset + 2] << 16) |
    (bytes[offset + 3] << 24)
  );
}

function writeString(bytes: Uint8Array, offset: number, str: string): void {
  for (let i = 0; i < str.length; i++) {
    bytes[offset + i] = str.charCodeAt(i);
  }
}

function writeUint16LE(bytes: Uint8Array, offset: number, value: number): void {
  bytes[offset] = value & 0xff;
  bytes[offset + 1] = (value >> 8) & 0xff;
}

function writeUint32LE(bytes: Uint8Array, offset: number, value: number): void {
  bytes[offset] = value & 0xff;
  bytes[offset + 1] = (value >> 8) & 0xff;
  bytes[offset + 2] = (value >> 16) & 0xff;
  bytes[offset + 3] = (value >> 24) & 0xff;
}

/**
 * Analyzes a WAV file to extract basic information
 * This is a simplified implementation
 */
export async function analyzeWavFile(filePath: string): Promise<WavFileInfo> {
  try {
    const fileInfo = await FileSystem.getInfoAsync(filePath);

    if (!fileInfo.exists) {
      throw new Error(`WAV file does not exist: ${filePath}`);
    }

    // For now, return default values
    // In production, you'd parse the WAV header to get actual values
    return {
      filePath,
      sampleRate: 44100, // Default from our recording config
      channels: 1, // Mono as configured
      duration: 0, // Would need to calculate from file size and format
    };
  } catch (error) {
    console.error("Error analyzing WAV file:", error);
    throw error;
  }
}

/**
 * Clean up temporary WAV files
 */
export async function cleanupWavFiles(filePaths: string[]): Promise<void> {
  const cleanupPromises = filePaths.map(async (filePath) => {
    try {
      await FileSystem.deleteAsync(filePath, { idempotent: true });
      console.log("🗑️ Cleaned up WAV file:", filePath);
    } catch (error) {
      console.warn("Failed to cleanup WAV file:", filePath, error);
    }
  });

  await Promise.all(cleanupPromises);
}
</file>

