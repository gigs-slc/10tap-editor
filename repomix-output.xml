import React, { useEffect } from 'react';
import {View, TouchableOpacity} from 'react-native';
import Animated, {
    useSharedValue,
    useAnimatedStyle,
    withTiming, FadeInRight, FadeOutLeft,
} from 'react-native-reanimated';
import {windowWidth} from "@/utils/window";
import {createStyleSheet, useStyles} from "react-native-unistyles";
import Ionicons from "@expo/vector-icons/Ionicons";
import {moderateScale} from "react-native-size-matters";
import {heavyHaptic} from "@/utils/haptic";

interface AnimatedProgressBarProps {
    currentStep: number;
    totalSteps: number;
    goToPreviousStep: () => void;
}

export default function AnimatedProgressBar({currentStep, totalSteps, goToPreviousStep }: AnimatedProgressBarProps) {
    const progress = useSharedValue(0.1);
    const { styles, theme } = useStyles(stylesheet);

    useEffect(() => {
        progress.value = withTiming(currentStep / totalSteps, { duration: 500 });
    }, [currentStep, totalSteps, progress]);

    const animatedBarStyle = useAnimatedStyle(() => {
        return {
            width: windowWidth * .7 * progress.value,
        };
    });

    return (
        <View style={styles.row}>
            {(currentStep != 1 && currentStep != totalSteps + 1) && <Animated.View
                entering={FadeInRight.duration(300)}
                exiting={FadeOutLeft.duration(300)}
            >
                <TouchableOpacity onPress={() => {
                    void heavyHaptic();
                    goToPreviousStep();
                }}>
                    <Ionicons
                        name={"chevron-back-outline"}
                        size={moderateScale(30)}
                        style={{marginRight: 10}}
                        color="#868789"
                    />
                </TouchableOpacity>
            </Animated.View>}
            <View style={styles.container}>
                <Animated.View style={[styles.progressBar, animatedBarStyle]} />
            </View>
        </View>
    );
}

const stylesheet = createStyleSheet((theme) => ({
    row: {
      flexDirection: 'row',
      alignItems: 'center',
        justifyContent: 'center',
        marginTop: 10
    },
    container: {
        height: 20,
        width: windowWidth * .8,
        backgroundColor: "rgba(0,0,0,0.3)",
        borderRadius: 1000,
        overflow: 'hidden',
    },
    progressBar: {
        height: '100%',
        backgroundColor: theme.colors.tints.PRIMARY,
    }
}));
</file>

