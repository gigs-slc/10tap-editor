<file path="src/services/RecordingBackupService.ts">
import { storage } from "@/utils/mmkv";
import * as FileSystem from "expo-file-system";
import { RecordingSegment } from "@/services/EnhancedAudioRecordingService";
import { concatenateWavFiles, WavFileInfo } from "@/utils/wavConcatenation";
import { supabase } from "@/utils/supabase";

const RECORDING_BACKUPS_KEY = "RECORDING_BACKUPS";
const PROCESSED_FILES_KEY = "PROCESSED_RECORDING_FILES";

export interface RecordingBackup {
  id: string;
  sessionId: string;
  userId: string; // Add user ID to associate backups with specific users
  dateCreated: Date;
  lastUpdated: Date;
  totalDuration: number;
  isComplete: boolean;
  segments: RecordingSegment[];
  consolidatedFilePath?: string;
  hasShownRecoveryDialog?: boolean;
  metadata?: {
    studentId?: string;
    contentTitle?: string;
  };
}

export class RecordingBackupService {
  private static instance: RecordingBackupService;
  private currentBackup: RecordingBackup | null = null;

  static getInstance(): RecordingBackupService {
    if (!RecordingBackupService.instance) {
      RecordingBackupService.instance = new RecordingBackupService();
    }
    return RecordingBackupService.instance;
  }

  private generateSessionId(): string {
    return `session_${Date.now()}_${Math.random()
      .toString(36)
      .substring(2, 9)}`;
  }

  async startNewRecordingSession(): Promise<string> {
    const sessionId = this.generateSessionId();

    // Get current user ID
    const {
      data: { user },
    } = await supabase.auth.getUser();
    const userId = user?.id || "anonymous";

    this.currentBackup = {
      id: sessionId,
      sessionId,
      userId,
      dateCreated: new Date(),
      lastUpdated: new Date(),
      totalDuration: 0,
      isComplete: false,
      segments: [],
    };

    this.saveCurrentBackup();
    return sessionId;
  }

  updateRecordingProgress(
    sessionId: string,
    segments: RecordingSegment[],
    totalDuration: number,
    metadata?: { studentId?: string; contentTitle?: string }
  ): void {
    if (!this.currentBackup || this.currentBackup.sessionId !== sessionId) {
      return;
    }

    this.currentBackup = {
      ...this.currentBackup,
      segments: [...segments],
      totalDuration,
      lastUpdated: new Date(),
      metadata: metadata
        ? { ...this.currentBackup.metadata, ...metadata }
        : this.currentBackup.metadata,
    };

    this.saveCurrentBackup();
  }

  completeRecording(sessionId: string, consolidatedFilePath?: string): void {
    if (!this.currentBackup || this.currentBackup.sessionId !== sessionId) {
      return;
    }

    this.currentBackup = {
      ...this.currentBackup,
      isComplete: true,
      consolidatedFilePath,
      lastUpdated: new Date(),
    };

    this.saveCurrentBackup();
    this.currentBackup = null;
  }

  discardRecording(sessionId: string): void {
    if (this.currentBackup && this.currentBackup.sessionId === sessionId) {
      this.removeBackup(sessionId);
      this.currentBackup = null;
    }
  }

  private saveCurrentBackup(): void {
    if (!this.currentBackup) return;

    const allBackups = this.getAllBackups();
    const existingIndex = allBackups.findIndex(
      (backup) => backup.sessionId === this.currentBackup!.sessionId
    );

    if (existingIndex >= 0) {
      allBackups[existingIndex] = this.currentBackup;
    } else {
      allBackups.push(this.currentBackup);
    }

    storage.set(RECORDING_BACKUPS_KEY, JSON.stringify(allBackups));
  }

  getAllBackups(): RecordingBackup[] {
    const backupsJson = storage.getString(RECORDING_BACKUPS_KEY);
    if (!backupsJson) return [];

    try {
      const backups = JSON.parse(backupsJson);
      return backups.map((backup: any) => ({
        ...backup,
        dateCreated: new Date(backup.dateCreated),
        lastUpdated: new Date(backup.lastUpdated),
        // Ensure hasShownRecoveryDialog is properly set, default to false if missing
        // Handle both boolean true and string "true" for backward compatibility
        hasShownRecoveryDialog:
          backup.hasShownRecoveryDialog === true ||
          backup.hasShownRecoveryDialog === "true",
        // Ensure userId exists for backwards compatibility
        userId: backup.userId || "legacy",
      }));
    } catch (error) {
      console.error("Error parsing recording backups:", error);
      return [];
    }
  }

  async getCurrentUserBackups(): Promise<RecordingBackup[]> {
    const {
      data: { user },
    } = await supabase.auth.getUser();
    const currentUserId = user?.id;

    if (!currentUserId) {
      console.warn("No authenticated user found, returning empty backups");
      return [];
    }

    const allBackups = this.getAllBackups();
    return allBackups.filter((backup) => backup.userId === currentUserId);
  }

  getBackup(sessionId: string): RecordingBackup | null {
    const allBackups = this.getAllBackups();
    return allBackups.find((backup) => backup.sessionId === sessionId) || null;
  }

  async getIncompleteRecordings(): Promise<RecordingBackup[]> {
    const userBackups = await this.getCurrentUserBackups();
    return userBackups.filter((backup) => !backup.isComplete);
  }

  async getCompletedButNotUploadedRecordings(): Promise<RecordingBackup[]> {
    const userBackups = await this.getCurrentUserBackups();
    return userBackups.filter((backup) => backup.isComplete);
  }

  async getUnshownRecoverableRecordings(): Promise<RecordingBackup[]> {
    const userBackups = await this.getCurrentUserBackups();
    console.log("🔍 BackupService: User backups:", userBackups.length);
    userBackups.forEach((backup, index) => {
      console.log(`🔍 Backup ${index + 1}:`, {
        sessionId: backup.sessionId,
        userId: backup.userId,
        isComplete: backup.isComplete,
        duration: backup.totalDuration,
        hasShownDialog: backup.hasShownRecoveryDialog,
        hasShownDialogType: typeof backup.hasShownRecoveryDialog,
        dateCreated: backup.dateCreated,
        lastUpdated: backup.lastUpdated,
        segments: backup.segments.length,
      });
    });

    const unshownRecoverable = userBackups.filter((backup) => {
      const shouldShow =
        !backup.hasShownRecoveryDialog &&
        (backup.isComplete ||
          (!backup.isComplete && backup.totalDuration > 5000));

      console.log(
        `🔍 Backup ${
          backup.sessionId
        } shouldShow: ${shouldShow} (hasShownDialog: ${
          backup.hasShownRecoveryDialog
        }, type: ${typeof backup.hasShownRecoveryDialog})`
      );
      return shouldShow;
    });

    console.log(
      "🔍 BackupService: Unshown recoverable for current user:",
      unshownRecoverable.length
    );
    unshownRecoverable.forEach((backup) => {
      console.log(
        `🔍 Will show recovery for: ${backup.sessionId} (hasShownDialog: ${backup.hasShownRecoveryDialog})`
      );
    });
    return unshownRecoverable;
  }

  markRecoveryDialogShown(sessionId: string): void {
    console.log("🏷️ Marking recovery dialog as shown for session:", sessionId);

    const allBackups = this.getAllBackups();
    console.log(
      "🔍 All backups before marking:",
      allBackups.map((b) => ({
        sessionId: b.sessionId,
        hasShownRecoveryDialog: b.hasShownRecoveryDialog,
        userId: b.userId,
      }))
    );

    const backupIndex = allBackups.findIndex(
      (backup) => backup.sessionId === sessionId
    );

    if (backupIndex >= 0) {
      console.log(
        "🔍 Found backup at index:",
        backupIndex,
        "Current hasShownRecoveryDialog:",
        allBackups[backupIndex].hasShownRecoveryDialog
      );

      const updatedBackups = [...allBackups];
      updatedBackups[backupIndex] = {
        ...updatedBackups[backupIndex],
        hasShownRecoveryDialog: true,
        lastUpdated: new Date(), // Update timestamp to ensure it's saved
      };

      console.log("🏷️ Updated backup marked as shown:", {
        sessionId: updatedBackups[backupIndex].sessionId,
        hasShownRecoveryDialog:
          updatedBackups[backupIndex].hasShownRecoveryDialog,
        lastUpdated: updatedBackups[backupIndex].lastUpdated,
      });

      // Force save to storage with explicit logging
      const jsonString = JSON.stringify(updatedBackups);
      storage.set(RECORDING_BACKUPS_KEY, jsonString);
      console.log("💾 Recovery dialog flag saved to storage");

      // Verify it was saved correctly
      const verifyJson = storage.getString(RECORDING_BACKUPS_KEY);
      const verifyBackups = verifyJson ? JSON.parse(verifyJson) : [];
      const verifyBackup = verifyBackups.find(
        (b: any) => b.sessionId === sessionId
      );
      console.log(
        "✅ Verification - backup hasShownRecoveryDialog:",
        verifyBackup?.hasShownRecoveryDialog
      );
    } else {
      console.warn("⚠️ Could not find backup to mark as shown:", sessionId);
      console.warn(
        "⚠️ Available session IDs:",
        allBackups.map((b) => b.sessionId)
      );
    }
  }

  addOrphanedBackup(backup: RecordingBackup): void {
    const allBackups = this.getAllBackups();
    const existingBackup = allBackups.find(
      (b) => b.sessionId === backup.sessionId
    );

    if (!existingBackup) {
      allBackups.push(backup);
      storage.set(RECORDING_BACKUPS_KEY, JSON.stringify(allBackups));
    }
  }

  removeBackup(sessionId: string): void {
    const allBackups = this.getAllBackups();
    const filteredBackups = allBackups.filter(
      (backup) => backup.sessionId !== sessionId
    );
    storage.set(RECORDING_BACKUPS_KEY, JSON.stringify(filteredBackups));
  }

  async cleanupOldBackups(olderThanDays: number = 7): Promise<void> {
    const cutoffDate = new Date();
    cutoffDate.setDate(cutoffDate.getDate() - olderThanDays);

    const allBackups = this.getAllBackups();
    const backupsToRemove = allBackups.filter((backup) => {
      // Don't delete backups with obviously incorrect timestamps (before 2020)
      const minValidDate = new Date("2020-01-01");
      if (backup.lastUpdated < minValidDate) {
        console.log(
          "🔍 Skipping cleanup of backup with invalid timestamp:",
          backup.sessionId,
          backup.lastUpdated
        );
        return false;
      }
      return backup.lastUpdated < cutoffDate;
    });

    for (const backup of backupsToRemove) {
      try {
        for (const segment of backup.segments) {
          await FileSystem.deleteAsync(segment.filePath, { idempotent: true });
        }
        if (backup.consolidatedFilePath) {
          await FileSystem.deleteAsync(backup.consolidatedFilePath, {
            idempotent: true,
          });
        }
      } catch (error) {
        console.warn(
          "Failed to cleanup backup files for session:",
          backup.sessionId,
          error
        );
      }
    }

    const remainingBackups = allBackups.filter(
      (backup) => backup.lastUpdated >= cutoffDate
    );
    storage.set(RECORDING_BACKUPS_KEY, JSON.stringify(remainingBackups));
  }

  async getConsolidatedFileForBackup(
    backup: RecordingBackup
  ): Promise<string | null> {
    console.log("🔍 getConsolidatedFileForBackup:", {
      sessionId: backup.sessionId,
      hasConsolidatedPath: !!backup.consolidatedFilePath,
      consolidatedPath: backup.consolidatedFilePath,
      segmentCount: backup.segments.length,
    });

    // First, check if we have a completed consolidated file
    if (backup.consolidatedFilePath) {
      console.log(
        "🔍 Checking consolidated file:",
        backup.consolidatedFilePath
      );
      const fileInfo = await FileSystem.getInfoAsync(
        backup.consolidatedFilePath
      );
      console.log("🔍 Consolidated file exists:", fileInfo.exists);
      console.log("🔍 Consolidated file info:", {
        exists: fileInfo.exists,
        size: (fileInfo as any).size || 0,
        uri: fileInfo.uri,
        isDirectory: fileInfo.isDirectory,
      });
      if (fileInfo.exists) {
        return backup.consolidatedFilePath;
      }
    }

    // Fall back to segments if no consolidated file
    if (backup.segments.length === 0) {
      console.log("🔍 No segments or chunks available");
      return null;
    }

    if (backup.segments.length === 1) {
      const segmentPath = backup.segments[0].filePath;
      console.log("🔍 Using single segment:", segmentPath);
      const segmentInfo = await FileSystem.getInfoAsync(segmentPath);
      console.log("🔍 Single segment exists:", segmentInfo.exists);
      console.log("🔍 Single segment info:", {
        exists: segmentInfo.exists,
        size: (segmentInfo as any).size || 0,
        uri: segmentInfo.uri,
        isDirectory: segmentInfo.isDirectory,
      });

      // If original segment doesn't exist, try backup file
      if (!segmentInfo.exists) {
        const backupPath = await this.findBackupFilePath(segmentPath);
        if (backupPath) {
          return backupPath;
        }
      }

      return segmentInfo.exists ? segmentPath : null;
    }

    // Multiple segments - need to concatenate them
    console.log("🔍 Multiple segments found, attempting concatenation");

    // Find all existing segment files (including backup files)
    const existingSegments: { segment: RecordingSegment; filePath: string }[] =
      [];

    for (const segment of backup.segments) {
      const segmentInfo = await FileSystem.getInfoAsync(segment.filePath);
      if (segmentInfo.exists) {
        console.log("🔍 Found existing segment:", segment.filePath);
        existingSegments.push({ segment, filePath: segment.filePath });
      } else {
        // Try to find backup file
        const backupPath = await this.findBackupFilePath(segment.filePath);
        if (backupPath) {
          console.log("🔍 Found backup file for segment:", backupPath);
          existingSegments.push({ segment, filePath: backupPath });
        } else {
          console.warn("⚠️ Missing segment and backup file:", segment.filePath);
        }
      }
    }

    if (existingSegments.length === 0) {
      console.log("🔍 No existing segment files found");
      return null;
    }

    if (existingSegments.length === 1) {
      console.log(
        "🔍 Only one segment file exists, using it:",
        existingSegments[0].filePath
      );
      return existingSegments[0].filePath;
    }

    // Sort segments by their start time to ensure correct order
    existingSegments.sort((a, b) => a.segment.startTime - b.segment.startTime);

    console.log("🔍 Concatenating", existingSegments.length, "segments");

    try {
      // Create concatenated file path
      const concatenatedPath = `${
        FileSystem.documentDirectory
      }recordings/recovered_${backup.sessionId}_${Date.now()}.wav`;

      // Prepare WAV file info for concatenation
      const wavFiles: WavFileInfo[] = existingSegments.map(
        ({ segment, filePath }) => ({
          filePath: filePath,
          sampleRate: 16000, // Use the sample rate from recording config
          channels: 1, // Mono recording
          duration: segment.duration,
        })
      );

      // Concatenate all segments
      const result = await concatenateWavFiles(wavFiles, concatenatedPath);
      console.log("✅ Successfully concatenated segments to:", result);

      return result;
    } catch (error) {
      console.error("❌ Failed to concatenate segments:", error);

      // Fallback to latest existing segment
      console.log("🔍 Falling back to latest existing segment");
      const latestSegment = existingSegments[existingSegments.length - 1];
      return latestSegment.filePath;
    }

    console.log("🔍 No existing files found for backup");
    return null;
  }

  getCurrentRecordingSession(): RecordingBackup | null {
    return this.currentBackup;
  }

  // Track processed recording files to prevent re-detection as orphaned
  markFileAsProcessed(filePath: string): void {
    const processedFiles = this.getProcessedFiles();
    if (!processedFiles.includes(filePath)) {
      processedFiles.push(filePath);
      storage.set(PROCESSED_FILES_KEY, JSON.stringify(processedFiles));
      console.log("🏷️ Marked file as processed:", filePath);
    }
  }

  isFileProcessed(filePath: string): boolean {
    const processedFiles = this.getProcessedFiles();
    return processedFiles.includes(filePath);
  }

  private getProcessedFiles(): string[] {
    const processedJson = storage.getString(PROCESSED_FILES_KEY);
    if (!processedJson) return [];

    try {
      return JSON.parse(processedJson);
    } catch (error) {
      console.error("Error parsing processed files:", error);
      return [];
    }
  }

  clearProcessedFiles(): void {
    storage.delete(PROCESSED_FILES_KEY);
    console.log("🧹 Cleared processed files tracking");
  }

  async clearCurrentUserBackups(): Promise<void> {
    try {
      console.log("🧹 Clearing backups for current user...");

      const {
        data: { user },
      } = await supabase.auth.getUser();
      const currentUserId = user?.id;

      if (!currentUserId) {
        console.warn(
          "No authenticated user found, clearing all backups as fallback"
        );
        storage.delete(RECORDING_BACKUPS_KEY);
        return;
      }

      const allBackups = this.getAllBackups();
      const userBackups = allBackups.filter(
        (backup) => backup.userId === currentUserId
      );
      const otherUserBackups = allBackups.filter(
        (backup) => backup.userId !== currentUserId
      );

      // Clean up audio files for current user's backups
      for (const backup of userBackups) {
        try {
          const filesToCleanup = await this.getAllPotentialFilePathsForBackup(
            backup.sessionId
          );
          for (const filePath of filesToCleanup) {
            await FileSystem.deleteAsync(filePath, { idempotent: true });
          }
        } catch (error) {
          console.warn(
            `Failed to cleanup files for backup ${backup.sessionId}:`,
            error
          );
        }
      }

      // Keep only other users' backups
      storage.set(RECORDING_BACKUPS_KEY, JSON.stringify(otherUserBackups));

      console.log(
        `✅ Cleared ${userBackups.length} backups for user ${currentUserId}`
      );
    } catch (error) {
      console.error("❌ Error clearing user backups:", error);
      // Fallback: clear all backups if there's an error
      storage.delete(RECORDING_BACKUPS_KEY);
    }
  }

  async markLegacyBackupsAsOtherUsers(): Promise<void> {
    try {
      console.log("🔄 Checking for legacy backups without user IDs...");

      const {
        data: { user },
      } = await supabase.auth.getUser();
      const currentUserId = user?.id;

      if (!currentUserId) {
        console.warn("No authenticated user found");
        return;
      }

      const allBackups = this.getAllBackups();
      let hasChanges = false;

      const updatedBackups = allBackups.map((backup) => {
        // If backup has 'legacy' userId and hasn't been shown, mark it as from a different user
        if (backup.userId === "legacy" && !backup.hasShownRecoveryDialog) {
          console.log(
            `🔄 Marking legacy backup ${backup.sessionId} as from different user`
          );
          hasChanges = true;
          return {
            ...backup,
            userId: "previous_user",
            hasShownRecoveryDialog: true, // Prevent it from showing to new user
          };
        }
        return backup;
      });

      if (hasChanges) {
        storage.set(RECORDING_BACKUPS_KEY, JSON.stringify(updatedBackups));
        console.log("✅ Legacy backups marked as from previous users");
      } else {
        console.log("ℹ️ No legacy backups found to update");
      }
    } catch (error) {
      console.error("❌ Error marking legacy backups:", error);
    }
  }

  // Utility method to forcefully mark recordings as shown with better error handling
  forceMarkRecordingAsShown(sessionId: string): void {
    console.log(
      "🔒 Force marking recording as shown (will never show again):",
      sessionId
    );

    try {
      // Get current backups
      const backupsJson = storage.getString(RECORDING_BACKUPS_KEY);
      if (!backupsJson) {
        console.warn("No backups found in storage");
        return;
      }

      const backups = JSON.parse(backupsJson);
      const backupIndex = backups.findIndex(
        (b: any) => b.sessionId === sessionId
      );

      if (backupIndex >= 0) {
        // Force set the flag
        backups[backupIndex].hasShownRecoveryDialog = true;
        backups[backupIndex].lastUpdated = new Date().toISOString();

        // Save back to storage
        storage.set(RECORDING_BACKUPS_KEY, JSON.stringify(backups));

        // Verify the save
        const verifyJson = storage.getString(RECORDING_BACKUPS_KEY);
        const verifyBackups = verifyJson ? JSON.parse(verifyJson) : [];
        const verifyBackup = verifyBackups.find(
          (b: any) => b.sessionId === sessionId
        );

        console.log("🔒 Force mark complete:", {
          sessionId,
          hasShownRecoveryDialog: verifyBackup?.hasShownRecoveryDialog,
          verified: verifyBackup?.hasShownRecoveryDialog === true,
        });
      } else {
        console.warn("⚠️ Could not find backup to force mark:", sessionId);
      }
    } catch (error) {
      console.error("❌ Error force marking backup:", error);
    }
  }

  // Helper method to find backup file path for a given segment path
  private async findBackupFilePath(
    segmentPath: string
  ): Promise<string | null> {
    // Handle both cases: segment file path and backup file path
    if (segmentPath.includes("backup_")) {
      // Already a backup file path, check if it exists
      const backupInfo = await FileSystem.getInfoAsync(segmentPath);
      return backupInfo.exists ? segmentPath : null;
    }

    // Convert segment path to backup path
    const fileName = segmentPath.split("/").pop() || "";
    const directory = segmentPath.replace(fileName, "");

    // Try backup_segment_ pattern first (most common)
    const backupPath1 =
      directory + fileName.replace(/segment_/, "backup_segment_");
    console.log("🔍 Trying backup file (pattern 1):", backupPath1);
    const backupInfo1 = await FileSystem.getInfoAsync(backupPath1);
    if (backupInfo1.exists) {
      console.log("🔍 Backup file exists (pattern 1):", backupPath1);
      return backupPath1;
    }

    // Try backup_ pattern as fallback
    const backupPath2 = directory + fileName.replace(/segment_/, "backup_");
    console.log("🔍 Trying backup file (pattern 2):", backupPath2);
    const backupInfo2 = await FileSystem.getInfoAsync(backupPath2);
    if (backupInfo2.exists) {
      console.log("🔍 Backup file exists (pattern 2):", backupPath2);
      return backupPath2;
    }

    return null;
  }

  // Get all file paths associated with a backup for cleanup purposes
  getAllFilePathsForBackup(sessionId: string): string[] {
    const backup = this.getBackup(sessionId);
    if (!backup) return [];

    const filePaths: string[] = [];

    // Add all segment file paths
    for (const segment of backup.segments) {
      filePaths.push(segment.filePath);
    }

    // Add consolidated file path if it exists and is different from segments
    if (
      backup.consolidatedFilePath &&
      !filePaths.includes(backup.consolidatedFilePath)
    ) {
      filePaths.push(backup.consolidatedFilePath);
    }

    return filePaths;
  }

  // Get all potential file paths for cleanup, including recovered files
  async getAllPotentialFilePathsForBackup(
    sessionId: string
  ): Promise<string[]> {
    const filePaths = this.getAllFilePathsForBackup(sessionId);

    // Also look for recovered concatenated files
    const recordingsDir = `${FileSystem.documentDirectory}recordings/`;
    try {
      const dirContents = await FileSystem.readDirectoryAsync(recordingsDir);
      const recoveredFiles = dirContents.filter((fileName) =>
        fileName.includes(`recovered_${sessionId}_`)
      );

      for (const fileName of recoveredFiles) {
        const fullPath = recordingsDir + fileName;
        filePaths.push(fullPath);
      }
    } catch (error) {
      console.warn("Failed to scan for recovered files:", error);
    }

    return filePaths;
  }
}

export const recordingBackupService = RecordingBackupService.getInstance();
