import { Tabs, useLocalSearchParams, router, useSegments } from 'expo-router';
import { View } from 'react-native';
import { useEffect } from 'react';
import Constants from 'expo-constants';
import UnsafeContainer from '@/common/generics/UnsafeContainer';
import NoteHeader from '@/components/notes/noteHeader';
import NoteSettingsSheet from '@/common/components/sheets/noteSettingsSheet';
import { useAtom } from 'jotai';
import { editNoteSheetIndex } from '@/utils/atoms';
import { useSingleContentRowQuery } from '@data/content/hooks/useSingleContentRowQuery';
import { useTopicRowsQuery } from '@data/topics/hooks/useTopicRowsQuery';
import { useGenerateContentTopicsMutation } from '@data/topics/hooks/useGenerateTopicsMutation';
import NotesLoading from '@/components/notes/insideScreens/notesLoading';
import NotEnoughCreditsNote from '@/components/notes/insideScreens/NotEnoughCreditsScreens/notEnoughCreditsNote';
import FailedNoteScreen from '@/components/notes/insideScreens/failedNoteScreen';
import { Text } from '@/common/generics/Text';
import ActionBar from '@/components/notes/actionBar';
import { NoteActionButton } from '@/types/db.types';

export default function ContentLayout() {
  const { content_id }: { content_id: string } = useLocalSearchParams();
  const segments = useSegments();
  const [noteSettingsSheetIndex, setNoteSettingsSheetIndex] = useAtom(editNoteSheetIndex);
  const { data: currentNote, isPending: notesLoading } = useSingleContentRowQuery(content_id);
  const { data: topics, isPending: topicsPending } = useTopicRowsQuery(content_id);
  const generateTopics = useGenerateContentTopicsMutation();

  const getCurrentAction = (): NoteActionButton => {
    const lastSegment = segments[segments.length - 1];
    const routeNameMap: Record<string, NoteActionButton> = {
      'notes': 'Notes',
      'podcast': 'Podcast',
      'quiz': 'Quiz',
      'chat': 'Chat',
      'flashcards': 'Flashcards',
      'transcript': 'Transcript'
    };
    return routeNameMap[lastSegment] || 'Notes';
  };

  useEffect(() => {
    if (currentNote?.content_status === "COMPLETE" && !topicsPending && topics?.length === 0 && !generateTopics.isPending) {
      generateTopics.mutate(content_id);
    }
  }, [topics, content_id, topicsPending, currentNote]);

  if (!content_id) {
    return (
      <UnsafeContainer>
        <Text>No content ID found!</Text>
      </UnsafeContainer>
    );
  }

  if (notesLoading) {
    return (
      <UnsafeContainer>
        <View style={{ marginTop: Constants.statusBarHeight }} />
        <NoteHeader content_id={content_id} />
        <ActionBar 
          selectedAction={'Notes'} 
          setSelectedAction={() => {}}
          content_id={content_id}
        />
        <NotesLoading content_id={content_id} />
      </UnsafeContainer>
    );
  }

  if (!currentNote) {
    return (
      <UnsafeContainer>
        <View style={{ marginTop: Constants.statusBarHeight }} />
        <NoteHeader content_id={content_id} />
        <Text> This note does not exist! </Text>
      </UnsafeContainer>
    );
  }

  if (currentNote.content_status === "NOT_ENOUGH_CREDITS") {
    return (
      <UnsafeContainer>
        <View style={{ marginTop: Constants.statusBarHeight }} />
        <NoteHeader content_id={content_id} />
        <NotEnoughCreditsNote content_id={content_id} />
      </UnsafeContainer>
    );
  }

  if (currentNote.content_status === "FAILED") {
    return (
      <UnsafeContainer>
        <View style={{ marginTop: Constants.statusBarHeight }} />
        <NoteHeader content_id={content_id} />
        <FailedNoteScreen currentNote={currentNote} />
      </UnsafeContainer>
    );
  }

  if (currentNote.percent_completed !== 100) {
    return (
      <UnsafeContainer>
        <View style={{ marginTop: Constants.statusBarHeight }} />
        <NoteHeader content_id={content_id} />
        <ActionBar 
          selectedAction={'Notes'} 
          setSelectedAction={() => {}}
          content_id={content_id}
        />
        <NotesLoading content_id={content_id} />
      </UnsafeContainer>
    );
  }

  return (
    <UnsafeContainer>
      <View style={{ marginTop: Constants.statusBarHeight }} />
      <NoteHeader content_id={content_id} />
      {currentNote.content_type !== 'blank' && (
        <ActionBar
          selectedAction={getCurrentAction()} 
          setSelectedAction={(action) => {
            const actualAction = typeof action === 'function' ? action(getCurrentAction()) : action;
            const routeMap: Record<NoteActionButton, string> = {
              'Notes': 'notes',
              'Podcast': 'podcast',
              'Quiz': 'quiz',
              'Chat': 'chat',
              'Flashcards': 'flashcards',
              'Transcript': 'transcript'
            };
            const routeName = routeMap[actualAction];
            if (routeName) {
              router.push(`/home/${content_id}/${routeName}`);
            }
          }}
          content_id={content_id}
        />
      )}
      
      <Tabs
        screenOptions={{
          headerShown: false,
          tabBarStyle: { display: 'none' }
        }}
      >
        <Tabs.Screen
          name="notes"
          options={{
            title: 'Notes',
          }}
        />
        <Tabs.Screen
          name="podcast"
          options={{
            title: 'Podcast',
          }}
        />
        <Tabs.Screen
          name="quiz"
          options={{
            title: 'Quiz',
          }}
        />
        <Tabs.Screen
          name="chat"
          options={{
            title: 'Chat',
          }}
        />
        <Tabs.Screen
          name="flashcards"
          options={{
            title: 'Flashcards',
          }}
        />
        <Tabs.Screen
          name="transcript"
          options={{
            title: 'Transcript',
          }}
        />
      </Tabs>

      <NoteSettingsSheet 
        content_id={content_id} 
        index={noteSettingsSheetIndex} 
        setIndex={setNoteSettingsSheetIndex}
      />
    </UnsafeContainer>
  );
}
</file>

