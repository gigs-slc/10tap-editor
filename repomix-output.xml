<file path="src/components/notes/insideScreens/Podcasts/LanguageDropdown.tsx">
import { View, Text, TouchableOpacity, FlatList, Modal } from 'react-native';
import { createStyleSheet, useStyles } from 'react-native-unistyles';
import { moderateScale } from 'react-native-size-matters';
import { windowWidth, windowHeight } from '@/utils/window';
import React, { useState } from 'react';

export interface Language {
  code: string;
  name: string;
  flag: string;
}

export interface LanguageDropdownProps {
  selectedLanguage: string;
  setSelectedLanguage: React.Dispatch<React.SetStateAction<string>>;
  languages: Language[];
}

export default function LanguageDropdown({ selectedLanguage, setSelectedLanguage, languages }: LanguageDropdownProps) {
  const { styles, theme } = useStyles(stylesheet);
  const [modalVisible, setModalVisible] = useState(false);

  const selectedLang = languages.find(l => l.code === selectedLanguage)

  return (
    <>
      <TouchableOpacity
        style={styles.trigger}
        onPress={() => setModalVisible(true)}
      >
        <Text style={styles.triggerText}>
          {selectedLang?.flag} {selectedLang?.name || 'Select a language'}
        </Text>
      </TouchableOpacity>

      <Modal
        visible={modalVisible}
        transparent
        animationType="fade"
        onRequestClose={() => setModalVisible(false)}
      >
        <TouchableOpacity
          style={styles.overlay}
          activeOpacity={1}
          onPressOut={() => setModalVisible(false)}
        >
          <View style={styles.content}>            
            <FlatList
              showsVerticalScrollIndicator={false}
              data={languages}
              keyExtractor={(item) => item.code}
              style={styles.list}
              renderItem={({ item }) => (
                <TouchableOpacity
                  style={styles.item}
                  onPress={() => {
                    setSelectedLanguage(item.code);
                    setModalVisible(false);
                  }}
                >
                  <Text style={styles.itemText}>{item.flag} {item.name}</Text>
                </TouchableOpacity>
              )}
            />
          </View>
        </TouchableOpacity>
      </Modal>
    </>
  );
}

