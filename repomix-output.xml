            body::-webkit-scrollbar,
            .ProseMirror::-webkit-scrollbar,
            #root::-webkit-scrollbar,
            div::-webkit-scrollbar {
                display: none;
            }
            /* Hide scrollbar for IE, Edge and Firefox */
            body,
