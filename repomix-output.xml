import React, {ReactNode} from "react";
import {ColorValue, Text as GenericText, TextProps, TextStyle, useColorScheme} from "react-native";
import {useStyles} from "react-native-unistyles";

interface Props {
    children?: ReactNode;
    style?: TextStyle | TextStyle[];
    lightColor?: ColorValue;
    darkColor?: ColorValue;
    textProps?: TextProps;
}

export const Text = ({ children, style, lightColor, darkColor, textProps }: Props) => {
    const { theme } = useStyles();
    const colorScheme = useColorScheme();
    
    const color = colorScheme === 'dark' 
        ? (lightColor ?? theme.colors.text.PRIMARY)
        : (darkColor ?? theme.colors.text.PRIMARY);

    return (
        <GenericText {...textProps} style={[{color}, style]}>
            {children}
        </GenericText>
    )
}
</file>

