                  </View>
                ) : (
                  <Text style={styles.speakerText}>Choose Speaker 1</Text>
                )}
              </TouchableOpacity>

              <TouchableOpacity
                style={styles.speakerBox}
                onPress={() => setOpenSpeaker2Dialog(true)}
              >
                {speaker2 ? (
                  <View style={styles.speakerInfo}>
                    <FastImage source={{ uri: speaker2.avatar_url }} style={styles.avatar} />
                    <Text style={styles.speakerText}>{speaker2.full_name}</Text>
                  </View>
                ) : (
                  <Text style={styles.speakerText}>Choose Speaker 2</Text>
                )}
              </TouchableOpacity>
            </View>
          </View>

          {/* Length Selector */}
          <View style={styles.inputGroup}>
            <Text style={styles.label}>Length</Text>
            <LengthDropdown
              selectedLength={length}
