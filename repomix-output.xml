<file path="src/data/quiz_questions/hooks/useUpdateQuizMutation.ts">
import {useMutation, useQueryClient, UseMutationResult} from "@tanstack/react-query";
import {updateQuizMutation} from "@data/quiz_questions/mutations";
import {JoinedQuestion, UpdateQuizQuestion} from "@data/quiz_questions/types";


export const useUpdateQuizMutation = (): UseMutationResult<JoinedQuestion, Error, UpdateQuizQuestion> => {
    const queryClient = useQueryClient();
    return useMutation({
        mutationFn: (updatedQuiz: UpdateQuizQuestion) => updateQuizMutation(updatedQuiz),
        onMutate: async (updates: UpdateQuizQuestion) => {
            await queryClient.cancelQueries({ queryKey: ['questions', 'individual', updates.question_id] });
            await queryClient.cancelQueries({ queryKey: ['questions', 'list', 'content', updates.content_id] });

            const previousQuiz : JoinedQuestion | undefined = queryClient.getQueryData<JoinedQuestion>(['questions', 'individual', updates.question_id]);
            const previousQuizzes : JoinedQuestion[] | undefined = queryClient.getQueryData<JoinedQuestion[]>(['questions', 'list', 'content', updates.content_id]);

            if (previousQuiz) {
                const optimisticQuiz : JoinedQuestion = { ...previousQuiz, ...updates };

                queryClient.setQueryData(['questions', 'individual', updates.question_id], optimisticQuiz);

                queryClient.setQueryData(
                    ['questions', 'list', 'content', updates.content_id],
                    (oldData: JoinedQuestion[] | undefined) => {
                        if (!oldData) return [];
                        return oldData.map(quiz =>
                            quiz.question_id === updates.question_id ? optimisticQuiz : quiz
                        );
                    }
                );
            }
            return { previousQuiz, previousQuizzes };
        },
        onError: (err, updates, context) => {
            if (context?.previousQuiz) {
                queryClient.setQueryData(['questions', 'individual', updates.question_id], context.previousQuiz);
            }
            if (context?.previousQuizzes) {
                queryClient.setQueryData(['questions', 'list', 'content', updates.content_id], context.previousQuizzes);
            }
        },
        onSuccess: (updatedQuiz: JoinedQuestion) => {
            queryClient.setQueryData(
                ['question', 'list', 'content', updatedQuiz.content_id],
                (oldData: JoinedQuestion[] | undefined) => {
                    if (!oldData) return [];
                    return oldData.map(quiz =>
                        quiz.question_id === updatedQuiz.question_id ? updatedQuiz : quiz
                    );
                }
            );
            queryClient.setQueryData(['questions', 'individual', updatedQuiz.question_id], updatedQuiz);
        }

    });
}
</file>

