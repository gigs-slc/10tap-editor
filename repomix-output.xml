<file path="tiptap-extensions/CustomExtensions/suggestions/prosemirror-suggestion-mode/plugin.ts">
import { Plugin, Transaction, EditorState } from 'prosemirror-state';
import {
    ReplaceStep,
    AddMarkStep,
    RemoveMarkStep,
    ReplaceAroundStep,
    Transform,
    Mapping,
} from 'prosemirror-transform';
import {
    SuggestionModePluginState,
    suggestionPluginKey,
    suggestionTransactionKey,
} from './key';
import {
    SuggestionHoverMenuRenderer,
    hoverMenuFactory,
    SuggestionHoverMenuOptions,
} from './hoverMenu';
import { createDecorations } from './decorations';
import { initSuggestionHoverListeners } from './hoverHandlers';
import { findNonStartingPos } from './helpers/nodePosition';
import { uuidv4 } from "lib0/random";
import { Mark } from "prosemirror-model";
import { Decoration } from "prosemirror-view";
import {SuggestionData} from "../SuggestionsExtension";
import {ySyncPluginKey} from "@tiptap/y-tiptap";


type AnyStep = ReplaceStep | AddMarkStep | RemoveMarkStep | ReplaceAroundStep;

// Type guard functions for each step type
function isReplaceStep(step: AnyStep): step is ReplaceStep {
    return 'slice' in step && !('gapFrom' in step);
}

function isReplaceAroundStep(step: AnyStep): step is ReplaceAroundStep {
    return 'slice' in step && 'gapFrom' in step && 'gapTo' in step;
}

/**
 * PATCH: Helper function to merge adjacent suggestion marks with same username
 * This ensures that consecutive edits by the same user are grouped together
 * into a single suggestion with a shared ID, improving visual clarity and
 * making it easier to accept/reject related changes as a unit.
 */
function mergeAdjacentSuggestionMarks(tr: Transaction) {
    const doc = tr.doc;
    const changes: Array<{ from: number; to: number; mark: Mark }> = [];

    // Collect all suggestion marks
    doc.descendants((node, pos) => {
        if (!node.isInline) return;

        node.marks.forEach(mark => {
            if (mark.type.name === 'suggestion_insert' || mark.type.name === 'suggestion_delete') {
                changes.push({
                    from: pos,
                    to: pos + node.nodeSize,
                    mark: mark
                });
            }
        });
    });

    // Sort by position
    changes.sort((a, b) => a.from - b.from);

    // Find groups of adjacent marks with same username and type
    const groups: Array<{
        from: number;
        to: number;
        mark: Mark;
        positions: Array<{ from: number; to: number }>;
    }> = [];

    for (const change of changes) {
        const lastGroup = groups[groups.length - 1];
        
        if (
            lastGroup &&
            lastGroup.to === change.from &&
            lastGroup.mark.type === change.mark.type &&
            lastGroup.mark.attrs.username === change.mark.attrs.username
        ) {
            // Extend the group
            lastGroup.to = change.to;
            lastGroup.positions.push({ from: change.from, to: change.to });
        } else {
            // Start a new group
            groups.push({
                from: change.from,
                to: change.to,
                mark: change.mark,
                positions: [{ from: change.from, to: change.to }]
            });
        }
    }

    // Apply merged marks
    groups.forEach(group => {
        if (group.positions.length > 1) {
            // Remove old marks and add a single merged mark
            const groupId = group.mark.attrs.id || uuidv4();
            const mergedMark = group.mark.type.create({
                ...group.mark.attrs,
                id: groupId
            });

            // Remove all old marks in this group
            tr.removeMark(group.from, group.to, group.mark.type);
            
            // Add the merged mark
            tr.addMark(group.from, group.to, mergedMark);
        }
    });
}

/**
 * PATCH: Collect all suggestions from the document and group them by ID
 * Returns a Map of suggestion IDs to suggestion data including position ranges,
 * type (insert/delete/replace), and associated metadata. This is used to maintain
 * a current index of all suggestions in the document state.
 */
function collectSuggestions(state: EditorState) {
    const suggestions = new Map<string, SuggestionData>();

    state.doc.descendants((node, pos) => {
        node.marks.forEach(mark => {
            const isInsert = mark.type.name === 'suggestion_insert';
            const isDelete = mark.type.name === 'suggestion_delete';
            if (isInsert || isDelete) {
                const id = mark.attrs.id;
                const suggestionEntry = suggestions.get(id) || {
                    id: mark.attrs.id,
                    from: pos,
                    to: pos + node.nodeSize,
                    type: isInsert ? 'insert' : 'delete',
                    author: mark.attrs.data.author,
                    timestamp: mark.attrs.data.timestamp,
                    description: mark.attrs.data.description,
                };

                suggestionEntry.from = Math.min(suggestionEntry.from, pos);
                suggestionEntry.to = Math.max(suggestionEntry.to, pos + node.nodeSize);
                if (
                    (suggestionEntry.type === 'insert' && !isInsert) ||
                    (suggestionEntry.type === 'delete' && !isDelete)
                ) {
                    suggestionEntry.type = 'replace';
                }

                // otherwise it must have a been a replace already?
                suggestions.set(id, suggestionEntry);
            }
        });
        return true;
    });
    return suggestions;
}

// Plugin options interface
export interface SuggestionModePluginOptions {
    inSuggestionMode?: boolean; // starting status of suggestion mode
    username?: string;
    data?: Record<string, any>;
    hoverMenuRenderer?: SuggestionHoverMenuRenderer;
    hoverMenuOptions?: SuggestionHoverMenuOptions;
    setActiveSuggestion?: (suggestionId: string | null) => void; // PATCH: callback when cursor enters/leaves suggestion
}

// Create the suggestions plugin
export const suggestionModePlugin = (
    options: SuggestionModePluginOptions = {}
) => {
    // If custom options but no renderer is provided, use default renderer with custom options
    const renderHoverMenu =
        options.hoverMenuRenderer ||
        hoverMenuFactory(options?.hoverMenuOptions || {});

    // Store listeners for cleanup
    let currentListeners: WeakMap<HTMLElement, any> | null = null;

    return new Plugin({
        key: suggestionPluginKey,

        // After a transaction is applied we add our suggestion marks to it
        // This will not impact undo/redo as ProseMirror's history plugin
        // automatically combines related transactions that happen close together in time
        // this is chosen over wrapping dispatchTransaction because it will keep a clean set of steps
        // and be less likely to interfere with other plugins.
        appendTransaction(
            transactions: readonly Transaction[],
            oldState: EditorState,
            newState: EditorState
        ) {
            // handle when a selection is deleted
            const pluginState = this.getState(oldState);

            let tr = newState.tr;
            let changed = false;

            // For handling multiple transforming steps in this dispatch
            // we need to keep track of the intermediate doc inbetween each step
            // so we can get the correct slice
            // Mapping is not enough because if you for instance delete a range,
            // and then delete another range around that first range
            // you can't just get the second deleted slice with simple mapping

            let intermediateTr = new Transform(oldState.doc);
            let lastStep: AnyStep | null = null;

            // After transactions are applied, apply transactions needed for the suggestion marks
            transactions.forEach((transaction, trIndex) => {
                // If the transaction is part of undo/redo history, skip it
                if (transaction.getMeta('history$')) return;

                // PATCH: ignore remote changes for suggestions
                const yMeta = transaction.getMeta('y-sync$') as
                    | { isChangeOrigin?: boolean }
                    | undefined;

                if (yMeta?.isChangeOrigin) return;

                // Get the meta for this transaction from transaction metadata, with global meta defaults
                // Transaction only meta gets global meta defaults
                const transactionMeta = transaction.getMeta(suggestionTransactionKey);
                const mergedData = {
                    ...pluginState.data,
                    ...transactionMeta?.data,
                };
                const meta = {
                    ...pluginState,
                    ...transactionMeta,
                    data: mergedData,
                };
                // If we're not in suggestion mode do nothing
                if (!meta.inSuggestionMode) return;
                // if this is a transaction that we created in this plugin, ignore it
                if (meta && meta.skipSuggestionOperation) return;

                const username = meta.username;

                // Process each step in the transaction
                // This works for all 4 types of steps: ReplaceStep, AddMarkStep, RemoveMarkStep, ReplaceAroundStep
                // @ts-ignore
                transaction.steps.forEach((step: AnyStep, stepIndex: number) => {

                    // update intermediateState if there was a previous step
                    if (lastStep) intermediateTr.step(lastStep);
                    lastStep = step;
                    // Each transaction has two optional parts:
                    //   1. removedSlice - content that should be marked as suggestion_delete
                    //   2. addedSlice - content that should be marked as suggestion_insert
                    const removedSlice = intermediateTr.doc.slice(
                        step.from,
                        step.to,
                        false
                    );

                    // we don't actually use/need the addedSlice, we just need its size to mark it
                    // in all but the ReplaceStep, the removedSlice is the same size as the addedSlice
                    let addedSliceSize = isReplaceStep(step)
                        ? step.slice.size
                        : removedSlice.size;
                    let extraInsertChars = 0;

                    if (isReplaceAroundStep(step)) {
                        addedSliceSize = step.gapTo - step.gapFrom + step.slice.size;
                    }
                    // Mark our next transactions as an internal suggestion operation so it won't be intercepted again
                    tr.setMeta(suggestionTransactionKey, {
                        skipSuggestionOperation: true,
                    });

                    // Check if we're inside an existing suggestion mark
                    const $pos = intermediateTr.doc.resolve(step.from);
                    const marksAtPos = $pos.marks();
                    const existingSuggestionMark = marksAtPos.find(
                        (m) =>
                            m.type.name === 'suggestion_insert' ||
                            m.type.name === 'suggestion_delete'
                    );
                    let from = step.from;
                    if (existingSuggestionMark) {
                        if (addedSliceSize > 1) {
                            // a paste has happened in the middle of a suggestion mark
                            // make sure it has the same mark as the surrounding text
                            tr.addMark(from, from + addedSliceSize, existingSuggestionMark);
                            changed = true;
                        }
                        // We are already inside a suggestion mark so we don't need to do anything
                        return;
                    }

                    // PATCH: Generate ID - check for adjacent delete mark to the right
                    let groupId = uuidv4();
                    
                    // Check if there's a delete suggestion mark immediately to the right
                    // This is important for continuous deletion to preserve the existing suggestion ID
                    // and prevent animation glitches from suggestion cards unmounting/remounting
                    const mappedFrom = tr.mapping.map(step.from);
                    if (mappedFrom < tr.doc.content.size) {
                        const $after = tr.doc.resolve(mappedFrom);
                        const nodeAfter = $after.nodeAfter;
                        
                        if (nodeAfter && nodeAfter.marks.length > 0) {
                            const rightDeleteMark = nodeAfter.marks.find(m => 
                                m.type.name === 'suggestion_delete' &&
                                m.attrs.username === username &&
                                m.attrs.id
                            );
                            
                            if (rightDeleteMark) {
                                groupId = rightDeleteMark.attrs.id;
                            }
                        }
                    }

                    if (removedSlice.size > 0) {
                        // DELETE - content was removed.
                        // We need to put it back and add a suggestion_delete mark on it

                        const isBackspace =
                            (isReplaceStep(step) || isReplaceAroundStep(step)) &&
                            step.slice.size === 0 &&
                            newState.selection.from === step.from;

                        // first map its position to the new doc
                        // grab all the unprocessed steps left in the transaction into a mapping
                        const mapToNewDocPos: Mapping = transactions
                            .slice(trIndex)
                            .reduce((acc, tr, i) => {
                                const startStep = i === 0 ? stepIndex : 0;
                                tr.steps.slice(startStep).forEach((s) => {
                                    acc.appendMap(s.getMap());
                                });
                                return acc;
                            }, new Mapping());

                        // map to the new doc position
                        from = mapToNewDocPos.map(step.from);
                        // then map to what we've done in suggestion transactions so far
                        from = tr.mapping.map(from);

                        const $from = tr.doc.resolve(from);
                        from = findNonStartingPos($from);

                        if (removedSlice.openEnd + removedSlice.openStart > 0) {
                            let currentPos = 0;
                            const pilcrowPositions: number[] = [];
                            removedSlice.content.forEach((node, offset, index) => {
                                if (
                                    index >=
                                    removedSlice.content.childCount - removedSlice.openEnd
                                )
                                    // Don't add pilcrows for open ended nodes
                                    return;

                                // If it's a block node, add its end position
                                if (node.isBlock) {
                                    pilcrowPositions.push(currentPos + node.nodeSize - 2); // -2 to get inside the closing tag
                                }
                                currentPos += node.nodeSize;
                            });
                            // First insert the slice normally
                            tr.replace(from, from, removedSlice);

                            // Then insert pilcrows at the end of each block
                            let extraChars = 0;
                            pilcrowPositions.forEach((pos) => {
                                tr.insertText('¶', from + pos + extraChars);
                                extraChars += 1;
                            });

                            //@ts-ignore
                            const endsWithText = removedSlice.content.lastChild?.textContent.length > 0;
                            if (removedSlice.openEnd > 0 && !endsWithText) {
                                // if the last open node is empty, add a zero width space to be marked
                                tr.insertText('\u200B', from + currentPos + extraChars);
                                extraChars += 1;
                            }

                            // Add mark with expanded size to cover the pilcrows
                            tr.addMark(
                                from,
                                from + removedSlice.size + extraChars,
                                newState.schema.marks.suggestion_delete.create({
                                    username,
                                    data: meta.data,
                                    id: groupId
                                })
                            );
                        } else {
                            // Normal case without block boundaries
                            tr.replace(from, from, removedSlice);
                            tr.addMark(
                                from,
                                from + removedSlice.size,
                                newState.schema.marks.suggestion_delete.create({
                                    username,
                                    data: meta.data,
                                    id: groupId
                                })
                            );
                        }

                        if (isBackspace) {
                            // place the cursor at the front if there was a backspace
                            tr.setSelection(tr.selection.constructor.create(tr.doc, from));
                        }

                        changed = true;
                    }

                    if (addedSliceSize > 0) {
                        // ReplaceAroundStep has an insert property that is the number of extra characters inserted
                        // for things like numbers in a list item

                        const addedFrom = from + removedSlice.size;
                        const addedTo = addedFrom + addedSliceSize + extraInsertChars;

                        // just mark it, it was already inserted before appendTransaction
                        tr.addMark(
                            addedFrom,
                            addedTo,
                            newState.schema.marks.suggestion_insert.create({
                                username,
                                data: meta.data,
                                id: groupId
                            })
                        );
                        changed = true;
                    }
                });
            });

            // PATCH: Merge adjacent suggestion marks with the same username
            if (changed) {
                mergeAdjacentSuggestionMarks(tr);
            }

            // Return the transaction if there were changes; otherwise return null
            return changed ? tr : null;
        },

        state: {
            init(_config, state): SuggestionModePluginState {

                // PATCH: parse document for suggestions state on initialization
                const suggestions = collectSuggestions(state)

                return {
                    inSuggestionMode: options.inSuggestionMode || false,
                    username: options.username || 'Anonymous',
                    data: options.data || {},
                    suggestions
                };
            },

            apply(
                tr: Transaction,
                value: SuggestionModePluginState,
                _oldState,
                newState
            ): SuggestionModePluginState {
                // If there's global metadata associated with this transaction, merge it into the current state
                const meta = tr.getMeta(suggestionPluginKey);
                const data = {
                    ...value.data,
                    ...meta?.data,
                };

                // PATCH: update suggestions in the state when document changes
                const suggestions = tr.docChanged
                    ? collectSuggestions(newState)
                    : value.suggestions;

                if (meta) {
                    return {
                        ...value,
                        ...meta,
                        data,
                        suggestions
                    };
                }
                // Otherwise, return the existing state as-is
                return {
                    ...value,
                    ...data,
                    suggestions
                };
            },
        },

        props: {
            decorations(state: EditorState) {
                if (options.hoverMenuOptions?.disabled) return null;
                const baseDecorations = createDecorations(state, renderHoverMenu);
                
                // PATCH: Add active suggestion decorations
                if (options.setActiveSuggestion) {
                    const cursorPos = state.selection.from;
                    const suggestions = suggestionPluginKey.getState(state)?.suggestions;
                    
                    if (suggestions) {
                        const activeDecos: Decoration[] = [];
                        // @ts-ignore
                        for (const [id, suggestion] of suggestions) {
                            if (cursorPos >= suggestion.from && cursorPos <= suggestion.to) {
                                // Add active class decoration specifically to each text node with suggestion marks
                                state.doc.nodesBetween(suggestion.from, suggestion.to, (node, pos) => {
                                    if (node.isText && node.marks.length > 0) {
                                        const hasSuggestionMark = node.marks.some(m => 
                                            m.type.name === 'suggestion_insert' || m.type.name === 'suggestion_delete'
                                        );
                                        if (hasSuggestionMark) {
                                            activeDecos.push(
                                                Decoration.inline(pos, pos + node.nodeSize, {
                                                    class: 'suggestion-active'
                                                })
                                            );
                                        }
                                    }
                                });
                                break;
                            }
                        }
                        
                        if (activeDecos.length > 0) {
                            return baseDecorations.add(state.doc, activeDecos);
                        }
                    }
                }
                
                return baseDecorations;
            },
        },

        view(view) {
            // PATCH: add cursor tracking for active suggestion state
            if (!options.setActiveSuggestion) return {};

            return {
                update(view, prevState) {
                    const cursorPos = view.state.selection.from;
                    const suggestions = suggestionPluginKey.getState(view.state)?.suggestions;
                    
                    if (!suggestions) return;
                    
                    // Find which suggestion the cursor is inside
                    let activeSuggestionId: string | null = null;
                    // @ts-ignore
                    for (const [id, suggestion] of suggestions) {
                        if (cursorPos >= suggestion.from && cursorPos <= suggestion.to) {
                            activeSuggestionId = id;
                            break;
                        }
                    }
                    
                    // Check if we had an active suggestion in the previous state
                    const prevCursorPos = prevState.selection.from;
                    const prevSuggestions = suggestionPluginKey.getState(prevState)?.suggestions;
                    let prevActiveSuggestionId: string | null = null;
                    
                    if (prevSuggestions) {
                        // @ts-ignore
                        for (const [id, suggestion] of prevSuggestions) {
                            if (prevCursorPos >= suggestion.from && prevCursorPos <= suggestion.to) {
                                prevActiveSuggestionId = id;
                                break;
                            }
                        }
                    }
                    
                    // Only call setActiveSuggestion if the active suggestion changed
                    if (prevActiveSuggestionId !== activeSuggestionId) {
                        options.setActiveSuggestion!(activeSuggestionId);
                    }
                }
            }


            // PATCH: comment out all prev view code for popup suggestion menu
            // if (options.hoverMenuOptions?.disabled) return null;
            // // Initialize listeners when the view is created
            // setTimeout(() => {
            //     currentListeners = initSuggestionHoverListeners(view);
            // }, 0);
            //
            // return {
            //     update(view, prevState) {
            //         // Re-initialize listeners when the decorations might have changed
            //         if (view.state.doc !== prevState.doc) {
            //             setTimeout(() => {
            //                 currentListeners = initSuggestionHoverListeners(view);
            //             }, 0);
            //         }
            //     },
            //     destroy() {
            //         // Cleanup would happen automatically with WeakMap
            //         currentListeners = null;
            //     },
            // };
        },
    });
};
