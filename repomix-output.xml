        fontSize: moderateScale(16),
        fontFamily: 'Sans-Bold',
        color: '#fff'
    },
    subtitle: {
        fontSize: moderateScale(13),
        fontFamily: 'Sans-Light',
        marginTop: 2,
        color: '#b1b3b5'
    }
}))

function findUniInitial(name: string): string {
    const lowerName = name.toLowerCase();
    const words = lowerName.replace(',', '').split(' ');
    const skipPrefixes = ['university of', 'university of '];

    if (skipPrefixes.some(prefix => lowerName.startsWith(prefix))) {
        for (let i = 2; i < words.length; i++) {
            if (!['of', 'at'].includes(words[i])) {
                return words[i].charAt(0).toUpperCase();
            }
        }
    }

    return words[0].charAt(0).toUpperCase();
}
