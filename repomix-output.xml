import { useEffect } from "react";
import { TouchableOpacity } from "react-native";
import Animated, {
  useSharedValue,
  useAnimatedStyle,
  withTiming,
  interpolateColor,
  interpolate,
  Easing,
} from "react-native-reanimated";
import Ionicons from "@expo/vector-icons/Ionicons";
import { moderateVerticalScale } from "react-native-size-matters";
import { createStyleSheet, useStyles } from "react-native-unistyles";

const AnimatedIonicon = Animated.createAnimatedComponent(Ionicons);
const AnimatedTouchableOpacity = Animated.createAnimatedComponent(TouchableOpacity);

export default function QuizArrow({
  isAnswered,
  onPressNext,
}: {
  isAnswered: boolean;
  onPressNext: () => void;
}) {
  const { styles, theme } = useStyles(stylesheet);
  
  const arrowColor = useSharedValue(1);
  const arrowOpacity = useSharedValue(0.5);
  const morphProgress = useSharedValue(0);

  useEffect(() => {
    arrowColor.value = withTiming(isAnswered ? 0 : 1, {
      duration: 300,
      easing: Easing.bezier(0.25, 0.1, 0.25, 1),
    });
    arrowOpacity.value = withTiming(isAnswered ? 1 : 0.5, {
      duration: 300,
      easing: Easing.bezier(0.25, 0.1, 0.25, 1),
    });
    morphProgress.value = withTiming(isAnswered ? 1 : 0, {
      duration: 300,
      easing: Easing.bezier(0.25, 0.1, 0.25, 1),
    });
  }, [isAnswered]);

  const arrowAnimatedStyle = useAnimatedStyle(() => {
    const color = interpolateColor(
      arrowColor.value,
      [0, 1],
      ['white', theme.colors.grays.PRIMARY]
    );
    return { 
      color,
      opacity: arrowOpacity.value
    };1
  });

  const buttonAnimatedStyle = useAnimatedStyle(() => {
    const width = interpolate(
      morphProgress.value,
      [0, 1],
      [45, 100]
    );
    const height = interpolate(
      morphProgress.value,
      [0, 1],
      [45, 50]
    );
    const borderRadius = interpolate(
      morphProgress.value,
      [0, 1],
      [0, 12]
    );
    const backgroundColor = interpolateColor(
      morphProgress.value,
      [0, 1],
      ['transparent', theme.colors.tints.PRIMARY]
    );
    return {
      width,
      height,
      borderRadius,
      backgroundColor
    };
  });

  const textAnimatedStyle = useAnimatedStyle(() => {
    return {
      opacity: morphProgress.value,
      transform: [
        {
          translateX: interpolate(
            morphProgress.value,
            [0, 1],
            [5, 0]
          )
        }
      ]
    };
  });

  const iconAnimatedStyle = useAnimatedStyle(() => {
    return {
      transform: [
        {
          translateX: interpolate(
            morphProgress.value,
            [0, 1],
            [0, 4]
          )
        }
      ]
    };
  });

  return (
    <AnimatedTouchableOpacity
      style={[styles.arrowButton, buttonAnimatedStyle]}
      onPress={() => {
        if (!isAnswered) return;
        arrowColor.value = withTiming(0, { duration: 100 });
        onPressNext();
      }}
    >
      <Animated.View style={styles.buttonContent}>
        <Animated.Text style={[styles.nextText, textAnimatedStyle]}>
          Next
        </Animated.Text>
        <Animated.View style={iconAnimatedStyle}>
          <AnimatedIonicon
            name="chevron-forward"
            size={moderateVerticalScale(24)}
            style={arrowAnimatedStyle}
          />
        </Animated.View>
      </Animated.View>
    </AnimatedTouchableOpacity>
  );
}

const stylesheet = createStyleSheet((theme) => ({
  arrowButton: {
    width: 45,
    height: 45,
    justifyContent: 'center',
    alignItems: 'center',
    paddingHorizontal: 8,
  },
  buttonContent: {
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'center',
    gap: 6,
  },
  nextText: {
    fontSize: moderateVerticalScale(14),
    fontFamily: 'Sans-Medium',
    color: 'white',
  },
}));
</file>

