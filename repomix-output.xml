import {QueryClient, useQuery, useQueryClient, UseQueryResult} from "@tanstack/react-query";
import {Content} from "@data/content/types";
import {getContentRowsQuery} from "@data/content/queries";
import {useEffect} from "react";

export const useContentRowsQuery = (folder_id: string | null): UseQueryResult<Content[]> => {
