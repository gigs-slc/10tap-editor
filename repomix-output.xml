import { Bold } from "@tiptap/extension-bold";
import { Document } from "@tiptap/extension-document";
import { Blockquote } from "@tiptap/extension-blockquote";
import { HardBreak } from "@tiptap/extension-hard-break";
import { Heading } from "@tiptap/extension-heading";
import { HorizontalRule } from "@tiptap/extension-horizontal-rule";
import { Paragraph } from "@tiptap/extension-paragraph";
import { Text } from "@tiptap/extension-text";
import { Strike } from "@tiptap/extension-strike";
import Link from "@tiptap/extension-link";
import Highlight from "@tiptap/extension-highlight";
import Underline from "@tiptap/extension-underline";
import TextAlign from "@tiptap/extension-text-align";
import { TextStyle } from "@tiptap/extension-text-style";
import { FontFamily } from "@tiptap/extension-font-family";
import { Color } from "@tiptap/extension-color";
import { FontSizeExtension } from "../CustomExtensions/fontsize";
import { LineHeightExtension } from "../CustomExtensions/lineHeight";
import FileHandler from "@tiptap/extension-file-handler";
import {Mathematics} from "@tiptap/extension-mathematics";
import { ExitListOnBackspace } from "../CustomExtensions/exitListOnBackspace";
import { Table, TableRow, TableCell, TableHeader } from '@tiptap/extension-table'
import { BulletList, OrderedList, ListItem, ListKeymap, TaskList, TaskItem } from '@tiptap/extension-list'
import { Focus, UndoRedo, Dropcursor, Gapcursor, CharacterCount } from '@tiptap/extensions'
import { CleanPasteExtension } from "../CustomExtensions/CleanPasteExtension";
import { SelectionDecoration } from "../CustomExtensions/SelectionDecoration";
import { CodeBlock } from "@tiptap/extension-code-block";

export function getV1Extensions(args: ExtensionArgs): AnyExtension[] {
    const extensions: AnyExtension[] = [
        // Base extensions
        Document,
        Blockquote,
        BulletList,
        HardBreak,
        Heading,
        HorizontalRule,
        ListItem,
        OrderedList,
        Paragraph,
        Text,
        Bold,
        Italic,
        Strike,
        Table.configure({
            resizable: true,
        }),
        TableRow,
        TableHeader,
        TableCell,
        FontSizeExtension,
        Link,
        Highlight.configure({
            multicolor: true,
        }),
        Underline,
        TextAlign.configure({
            types: ['heading', 'paragraph', 'resizableImage'],
        }),
        TextStyle,
        FontFamily,
        Color,
        LineHeightExtension,
        FileHandler,
        TaskList.configure({
            HTMLAttributes: {
                class: 'task-list',
            },
        }),
        TaskItem.configure({
            nested: true,
            HTMLAttributes: {
                class: 'task-item',
            },
        }),
        // Mathematics.configure({
        //     shouldRender: (state, pos, node) => {
        //         const $pos = state.doc.resolve(pos)
        //         return node.type.name === 'text' && $pos.parent.type.name !== 'codeBlock'
        //     },
        //     regex: /\$([^\s$](?:[^$]*[^\s$])?)\$/gi,
        // }),
        CharacterCount,
        UndoRedo,
        // Dropcursor, Breaks Webview
        // Gapcursor, Breaks Webview
    ];

    // Only add collaboration extensions if yProvider is provided
    if (args.yProvider) {
        extensions.push(
            CollaborationCaret.configure({
                provider: args.yProvider,
                user: {
                    name: args.name || 'Anonymous',
                    color: args.cursorColor || '#000000',
                },
                render: user => {
                    const cursor = document.createElement('span')
                    cursor.classList.add('collaboration-carets__caret')
                    cursor.setAttribute('style', `border-color: ${user.color}`)
                    cursor.setAttribute('data-user', user.name)

                    const label = document.createElement('div')
                    label.classList.add('collaboration-carets__label')
                    label.setAttribute('style', `background-color: ${user.color}`)

                    // Add pen icon for Turbo AI
                    if (user.name && user.name.includes('Turbo AI')) {
                        const icon = document.createElement('svg')
                        icon.setAttribute('width', '14')
                        icon.setAttribute('height', '14')
                        icon.setAttribute('viewBox', '0 0 24 24')
                        icon.setAttribute('fill', 'none')
                        icon.setAttribute('stroke', 'currentColor')
                        icon.setAttribute('stroke-width', '2')
                        icon.setAttribute('stroke-linecap', 'round')
                        icon.setAttribute('stroke-linejoin', 'round')
                        icon.style.display = 'inline-block'
                        icon.style.marginRight = '4px'
                        icon.style.verticalAlign = 'middle'
                        // Lucide Pen icon path
                        icon.innerHTML = '<path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/>'
                        label.appendChild(icon)
                    }

                    label.appendChild(document.createTextNode(user.name))

                    cursor.insertBefore(label, null)
                    return cursor
                }
            }),
            Collaboration.configure({
                document: args.yProvider.doc,
            })
        );
    }

    extensions.push(
        CodeBlock,
        CustomPlaceholder.configure({
            placeholder: 'Type / for command menu',
        }),
        ResizableImage.configure({
            defaultWidth: 400,
            defaultHeight: 300,
            maxWidth: 800,
            allowBase64: true,
        }),
    );

    // Only add comment-related extensions if yProvider is provided
    if (args.yProvider) {
        extensions.push(
            CommentExtension.configure({
                ydoc: args.yProvider.doc,
                setActiveComments: args.setActiveComments || (() => {}),
                getShowResolved: args.getShowResolvedState || (() => false),
                disabled: args.disableComments || false,
            }),
            SuggestionInsert,
            SuggestionDelete,
            SuggestionModeExtension.configure({
                username: args.name || 'Anonymous',
                data: { id: uuidv4(), timestamp: Date.now(), author: {name: args.name || 'Anonymous'} },
                setActiveSuggestion: args.setActiveSuggestion || (() => {}),
                disabled: args.disableSuggestions || false,
            }),
        );
    }

    // Add slash commands if renderer is provided
    if (args.SlashCommandRenderer) {
        extensions.push(
            SlashCommandsExtension.configure({
                renderer: args.SlashCommandRenderer,
                disabled: args.disableSlashCommands || false,
            })
        );
    }

    extensions.push(
        // CLEANPASTE BREAKS WEBVIEW
        // CleanPasteExtension.configure({
        //     allowedFonts: ['var(--font-clarika)', 'Georgia', 'Arial', 'Times New Roman', 'Verdana', 'Courier New' ],
        //     unknownFontFallback: null,
        //     stripBlack: true,
        //     stripWhite: true,
        // }),
        ExitListOnBackspace,
        SelectionDecoration,
    )

    return extensions;
}
</file>

<file path="tiptap-extensions/generate-schemas.ts">
import {getSchema} from "@tiptap/core";
import {writeFileSync} from "fs";
import {join} from "path";
import * as Y from "yjs";
import OrderedMap from 'orderedmap';
import {getV1Extensions} from './versions/v1';
import {getV2Extensions} from './versions/v2';
import {ExtensionArgs} from './index';

// helper – flatten OrderedMap → plain array
const orderedMapToArray = (map: OrderedMap<any>) => {
    const result: Array<{ key: string; value: any }> = [];
    map.forEach((key: string, value: any) => {
        result.push({key, value});
    });
    return result;
};

export function schemaToJSON_noFuncs(schema: any) {
    const {nodes, marks} = schema.spec;

    const specForBackend = {
        // strip every field that is a function
        nodes: orderedMapToArray(nodes).map(item => ({
            key: item.key,
            value: item.value ? Object.fromEntries(
                Object.entries(item.value).filter(([, v]) => typeof v !== 'function'),
            ) : {},
        })),
        marks: orderedMapToArray(marks).map(item => ({
            key: item.key,
            value: item.value ? Object.fromEntries(
                Object.entries(item.value).filter(([, v]) => typeof v !== 'function'),
            ) : {},
        })),
    };

    return JSON.stringify(specForBackend, null, 2); // pretty print
}

// Create a mock Y.Doc for schema generation
const mockDoc = new Y.Doc();

// Mock args for schema generation
const mockArgs: ExtensionArgs = {
    // All args are optional, so we can provide minimal setup
    name: "Schema Generator",
    cursorColor: "#000000",
};

// Define all versions to generate schemas for
const versions = [
    {version: 0, getExtensions: getV1Extensions},  // v0 uses v1 extensions
    {version: 1, getExtensions: getV2Extensions}
];

export async function generateSchemas() {
    // Generate schemas for all versions
    for (const {version, getExtensions} of versions) {
        try {
            const extensions = getExtensions(mockArgs);
            const schema = getSchema(extensions);
            const json = schemaToJSON_noFuncs(schema);

            const outputPath = join(__dirname, `${version}-pm-schema.json`);
            writeFileSync(outputPath, json);

            console.log(`✓ Generated ${version}-pm-schema.json`);
        } catch (error) {
            console.error(`✗ Failed to generate schema for version ${version}:`, error);
        }
    }

    console.log('\n✓ Schema generation complete!');
}

// Uncomment to run directly
generateSchemas().catch(console.error);
</file>

<file path="CLAUDE.md">
# CLAUDE.md

This file provides guidance to Claude Code (claude.ai/code) when working with code in this repository.

## Common Development Commands
Always use yarn to install packages, NOT npm

```bash
# Start development server
npx expo start
```

## High-Level Architecture

### Tech Stack
- **Framework**: React Native with Expo (SDK 53)
- **Navigation**: Expo Router (file-based routing in `/app` directory)
- **State Management**: 
  - Jotai for global state (atoms in `/src/utils/atoms.ts`)
  - TanStack Query for server state (custom hooks in `/src/data/*`)
- **Backend**: Supabase (PostgreSQL with realtime subscriptions)
- **Styling**: React Native Unistyles (theme config in `/unistyles.ts`)

### Key Architectural Patterns

1. **Data Layer Architecture**
   - All data fetching uses custom hooks pattern in `/src/data/[feature]/hooks/`
   - Each feature has: `queries.ts`, `mutations.ts`, `types.ts`, and optionally `subscription.ts`
   - Hooks follow naming convention: `use[Action][Feature]Query/Mutation`
   - Real-time subscriptions for content and podcasts

2. **File-Based Routing**
   - Routes defined in `/app` directory structure
   - Dynamic routes use brackets: `[content_id].tsx`, `[folder_id].tsx`
   - Nested layouts with `_layout.tsx` files

3. **Component Organization**
   - Common components: `/src/common/components/` (buttons, headers, modals, sheets)
   - Feature components: `/src/components/` (folders, notes, onboarding, etc.)
   - Generic wrappers: `/src/common/generics/` (Container, Text, UnsafeContainer)

4. **Type Safety**
   - Database types generated in `/src/types/db-generated.types.ts`
   - Custom types extended in `/src/types/db.types.ts`
   - Strict TypeScript configuration with path aliases

### Critical Services Integration

- **Authentication**: Supabase Auth with Apple/Google Sign-In
- **Audio Processing**: Deepgram SDK for transcription, expo-av for recording
- **Analytics**: PostHog (tracked in `/src/utils/posthog.ts`)
- **Monetization**: RevenueCat + Superwall for subscriptions
- **Storage**: MMKV for local persistence, Supabase Storage for media files

### Environment Configuration
- Environment variables in `/src/common/environment.ts`
- Staging/Production API endpoints configured
- Edge function calls via `/src/utils/edge.ts`

### State Management Flow
1. User actions trigger mutations via custom hooks
2. Mutations update Supabase database
3. Realtime subscriptions update local React Query cache
4. UI automatically reflects changes via query hooks

### React Best Practices
1. Do NOT use ternary operators for conditional rendering. This leads to unreadable code that is hard to manage down the line. Instead, use a React Sub-component in the same file, then if-statements.
2. Please emphasize clear and readable variable names, especially for files and React components.
3. Do NOT write comments anywhere, your code should be simple and understandable - therefore comments are NOT needed.
4. NEVER use svg elements directly in a React component. SVGs should always be created as their own file in the public folder, then referenced in the React component.
5. ALWAYS USE UNISTYLES when styling / creating stylsheets with proper use of the theme variables.

When working with this codebase, always check existing patterns in similar features before implementing new functionality.
</file>

