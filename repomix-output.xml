<file path="tiptap-extensions/CustomExtensions/slash/extension.ts">
import { Extension } from '@tiptap/core'
import Suggestion from '@tiptap/suggestion'
import { SuggestionRenderResult, SlashCommandItem } from './types'
import { defaultSlashCommands } from './commands'

export const SlashCommandsExtension = Extension.create({
    name: 'slashCommands',

    addOptions() {
        return {
            renderer: () => ({} as SuggestionRenderResult),
            commands: undefined as SlashCommandItem[] | undefined,
            disabled: false,
        }
    },

    addProseMirrorPlugins() {
        const { renderer, commands, disabled } = this.options
        
        if (disabled) {
            return []
        }
        
        const commandList = commands || defaultSlashCommands

        return [
            Suggestion({
                editor: this.editor,
                char: '/',
                startOfLine: false,
                items: ({ query }: { query: string }) => {
                    return commandList.filter((item: SlashCommandItem) => {
                        const titleMatch = item.title.toLowerCase().startsWith(query.toLowerCase())
                        const aliasMatch = item.aliases?.some(alias => 
                            alias.toLowerCase().startsWith(query.toLowerCase())
                        )
                        return titleMatch || aliasMatch
                    })
                },
                render: renderer,
                command: ({ editor, range, props }: any) => {
                    props.command({ editor, range })
                },
            }),
        ]
    },
})
</file>

