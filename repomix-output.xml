import {JoinedQuestion, UpdateQuizQuestion} from "@data/quiz_questions/types";
import {supabase} from "@/utils/supabase";

export const updateQuizMutation = async (updatedQuiz: UpdateQuizQuestion): Promise<JoinedQuestion> => {
    const { question_id, ...updates} = updatedQuiz;
    if (!question_id) {
        throw new Error("Could not fetch question ID!");
    }
    const { data, error } = await supabase
        .from("quiz_questions")
        .update(updates)
        .eq("question_id", question_id)
        .select(`
          *,
          mc_questions (*)
        `)
        .single()
        .returns<JoinedQuestion>()
    if (error) throw new Error(`Failed to update folder: ` + error.message);
    if (!data) throw new Error("Failed to update folder: No data returned");

    return data;
}
</file>

