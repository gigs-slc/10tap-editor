import { useMutation, useQueryClient } from "@tanstack/react-query";
import { generateQuizQuestions } from "@data/quiz_questions/generate";

export const useGenerateQuizQuestionsMutation = () => {
    const queryClient = useQueryClient();

    return useMutation({
        mutationKey: ["generate-quiz-questions"],
        mutationFn: (vars: { content_id: string; topic_ids: string[]; is_user_subscribed: boolean; }) =>
            generateQuizQuestions(
                vars.content_id,
                vars.topic_ids,
                vars.is_user_subscribed
            ),
        onSuccess: async (_data, vars) => {
            await queryClient.refetchQueries({
                queryKey: ["questions", "list", "content", vars.content_id],
            });
        },
    });
};
