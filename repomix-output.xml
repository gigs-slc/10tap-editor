import React, {useState, useEffect} from "react";
import {Text, View, Modal, TouchableOpacity} from "react-native";
import {moderateScale} from "react-native-size-matters";
import {createStyleSheet, useStyles} from "react-native-unistyles";
import {windowHeight, windowWidth} from "@/utils/window";
import {VideoView, useVideoPlayer} from "expo-video";
import BasicButton from "@/common/components/buttons/basicButton";
import Animated, { FadeIn } from "react-native-reanimated";

type WebsitePresentationModalProps = {
    visible: boolean;
    onClose: () => void;
    onWebsitePress: () => void;
}

export default function WebsitePresentationModal({visible, onClose, onWebsitePress}: WebsitePresentationModalProps) {
    const {styles, theme} = useStyles(stylesheet);
    const [showModal, setShowModal] = useState(false);
    const [isVideoReady, setIsVideoReady] = useState(false);
    const [showButton, setShowButton] = useState(false);
    
    const player = useVideoPlayer("https://assets.api-turbo.ai/mobile/websitepreview.mp4", (player) => {
        player.loop = true;
        player.muted = true;
        player.play();
    });
    
    useEffect(() => {
        if (!visible) {
            setShowModal(false);
            setIsVideoReady(false);
            setShowButton(false);
        }
    }, [visible]);
    
    useEffect(() => {
        if (visible && player) {
            const checkStatus = () => {
                if (player.status === 'readyToPlay') {
                    setIsVideoReady(true);
                    setShowModal(true);
                }
            };
            
            checkStatus();
            
            const subscription = player.addListener('statusChange', (event) => {
                if (event.status === 'readyToPlay' && !isVideoReady) {
                    setIsVideoReady(true);
                    setShowModal(true);
                }
            });
            
            return () => {
                subscription.remove();
            };
        }
    }, [visible, player, isVideoReady]);
    
    useEffect(() => {
        if (showModal) {
            const timer = setTimeout(() => {
                setShowButton(true);
            }, 3000);
            
            return () => clearTimeout(timer);
        }
    }, [showModal]);
    
    const handleClose = () => {
        setShowModal(false);
        setIsVideoReady(false);
        setShowButton(false);
        onClose();
    };
    
    return (
        <Modal animationType="slide" transparent={true} visible={showModal}>
            <View style={styles.container}>
                <VideoView
                    player={player}
                    style={styles.backgroundVideo}
                    contentFit="cover"
                    allowsFullscreen={false}
                    allowsPictureInPicture={false}
                />
                <View style={styles.overlay} />
                <View style={styles.topBar}>
                    <Text style={styles.title}>Try Turbo on Web!</Text>
                    
                    <TouchableOpacity onPress={onWebsitePress}>
                        <Text style={styles.websiteLink}>www.turbo.ai</Text>
                    </TouchableOpacity>
                    
                    <View style={styles.underline} />
                </View>
                <View style={styles.content}>
                    
                    <View style={{flex: 1}} />
                    
                    {showButton && (
                        <Animated.View entering={FadeIn.duration(500)}>
                            <BasicButton 
                                text="Continue on Mobile"
                                onPress={handleClose}
                                backgroundColor={theme.colors.tints.PRIMARY}
                                width={windowWidth * 0.9}
                            />
                        </Animated.View>
                    )}
                </View>
            </View>
        </Modal>
    );
}


