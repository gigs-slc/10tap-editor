import {supabase} from "@/utils/supabase";
import {getUserID} from "@/utils/auth";
import {Content} from "@/data/content/types";


// getting all content for student based on folder_id - newest first
export const getContentRowsQuery = async (folder_id: string | null) : Promise<Content[]>  => {
    const student_id  = await getUserID();
    if(!student_id) throw new Error("Could not fetch content rows from DB - user is not signed in!")
    // FOR DASHBOARD (NULL FOLDER_ID)
    if (!folder_id) {
        const { data, error } = await supabase
            .from("content")
            .select("*")
            .order("created_at", { ascending: false })
            .eq("student_id", student_id)
            .is("folder_id", null)
            .is("is_deleted", false)
        if (error) throw new Error("Error fetching content rows for student: " + error.message)
        if(!data) throw new Error("Could not fetch content rows from DB")
        return data;
    }
    // FOR FOLDERS
    const { data, error } = await supabase
        .from("content")
        .select("*")
        .order("created_at", { ascending: false })
        .eq("student_id", student_id)
        .eq("folder_id", folder_id)
        .is("is_deleted", false)
    if (error) throw new Error("Error fetching content rows for student: " + error.message)
    if(!data) throw new Error("Could not fetch content rows from DB")
    return data;
};


// getting a specific content row based on contentID
export const getSingleContentRowQuery = async (contentID : string) : Promise<Content>  => {
    const { data, error } = await supabase
        .from("content")
        .select("*")
        .eq("content_id", contentID)
        .single()
    if (error) throw new Error("Could not fetch content rows: " + error.message);
    if(!data) throw new Error("Could not fetch content rows from DB")
    return data;
};
</file>

<file path="src/data/content/subscription.ts">
import { RealtimeChannel } from '@supabase/supabase-js'
import { supabase } from "@/utils/supabase";
import type { Content } from './types.ts'

export function subscribeToContent(content_id: string, onUpdate: (newRow: Content) => void) : RealtimeChannel {
    return supabase
        .channel(`content-${content_id}`)
        .on(
            'postgres_changes',
            {
                event: 'UPDATE',
                schema: 'public',
                table: 'content',
                filter: `content_id=eq.${content_id}`,
            },
            ({ new: updatedRow}) => {
                    onUpdate(updatedRow as Content)
            }
        )
        .subscribe()
}
</file>

