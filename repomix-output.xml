};

declare global {
    interface Window {
        editorData?: {
            content_id: string;
            student_id: string;
            name: string;
            yjs_url: string;
            token: string;
            pm_schema_version: number;
        };
        initialHtml?: string;
    }
}

interface EditorContentProps {
    editorData: {
        content_id: string;
        student_id: string;
        name: string;
        yjs_url: string;
        token: string;
        pm_schema_version: number;
    };
}

const EditorWithContent = ({ editorData }: EditorContentProps) => {
    const normalizedHost = editorData.yjs_url.startsWith('http') || editorData.yjs_url.startsWith('ws')
        ? editorData.yjs_url
        : `https://${editorData.yjs_url}`;
    const provider = useYProvider({
        host: normalizedHost,
        room: editorData.content_id,
        party: "partykit-object",
        options: {
            params: async () => ({
                token: editorData.token
            }),
        }
    });

    const extensionArgs: ExtensionArgs = {
        name: editorData.name,
        cursorColor: randomColor,
        yProvider: provider,
        setActiveComments: () => {},
        setActiveSuggestion: () => {},
        getShowResolvedState: () => false,
        disableComments: true,
        disableSuggestions: true,
        disablePlaceholder: true,
        disableSlashCommands: true,
    };

    const editor = useTenTap({
        bridges: [],
        tiptapOptions: {
            extensions: getExtensions(editorData.pm_schema_version, extensionArgs),
        },
    });

    // If RN provided initial HTML (markdown rendered to HTML), set it once editor is ready
    React.useEffect(() => {
        if (window.initialHtml && editor) {
            try {
                // @ts-ignore tiptap editor commands available
                editor?.commands?.setContent?.(window.initialHtml);
            } catch (_) {
                // no-op
            }
        }
    }, [editor]);

    React.useEffect(() => {
        window.ReactNativeWebView?.postMessage(
            JSON.stringify({
                type: "editorReady",
                message: "Web editor initialized and ready"
            })
        );
    }, []);
    return (
        <EditorContent
            editor={editor}
            className={window.dynamicHeight ? 'dynamic-height' : undefined}
        />
    );
};

/**
 * Here we control the web side of our custom editor
 */
export const AdvancedEditor = () => {

    // Forward unhandled errors to native for visibility without console noise
    window.onerror = (msg, url, line, col, err) => {
        try { window.ReactNativeWebView?.postMessage(JSON.stringify({ type: 'error' })); } catch {}
    };

    const [editorData, setEditorData] = React.useState<{
        content_id: string;
        student_id: string;
        name: string;
        yjs_url: string;
        token: string;
        pm_schema_version: number;
    } | null>(null);
    const [theme, setTheme] = React.useState<'light' | 'dark'>('light');

    // Signal RN that the webview is mounted and ready to receive editorData
    React.useEffect(() => {
        try { window.ReactNativeWebView?.postMessage(JSON.stringify({ type: 'readyForEditorData' })); } catch {}
    }, []);

    React.useEffect(() => {
        const currentTheme = themes[theme];
        const style = document.createElement('style');
        style.id = 'theme-styles';
        style.innerHTML = `
            ${ClarikaLightBase64}
