import React, {useCallback, useEffect, useMemo, useRef, useState} from "react";
import {Text, TouchableOpacity, View, TextInput, Keyboard} from "react-native";
import BottomSheet from "@gorhom/bottom-sheet";
import {moderateScale} from "react-native-size-matters";
import UnsafeContainer from "@/common/generics/UnsafeContainer";
import {windowWidth} from "@/utils/window";
import {createStyleSheet, useStyles} from "react-native-unistyles";
import LoadingModal from "@/common/components/modals/loadingModal";
import {heavyHaptic} from "@/utils/haptic";
import {Portal} from "react-native-portalize";
import {useRouter} from "expo-router";
import { useDebouncedCallback } from "use-debounce";
import {useSingleFolderRowQuery} from "@data/folders/hooks/useSingleFolderRowQuery";
import {useUpdateFolderMutation} from "@data/folders/hooks/useUpdateFolderMutation";
import {useDeleteFolderMutation} from "@data/folders/hooks/useDeleteFolderMutation";

export default function FolderSettingsSheet({folder_id, index, setIndex} : { folder_id: string; index: number; setIndex: any; }) {
    const bottomSheetRef = useRef<BottomSheet>(null);
    const { data: currentFolder, isPending: folderLoading } = useSingleFolderRowQuery(folder_id)
    const snapPoints = useMemo(() => ["80%"], []);
    const [loading, setLoading] = useState<boolean>(false);
    const { styles, theme } = useStyles(stylesheet);
    const [folderTitle, setFolderTitle] = useState(currentFolder?.title || '');
    const router = useRouter();

    useEffect(() => {
        if (index < 0) {
            setFolderTitle("");
            Keyboard.dismiss();
            return;
        }
        if (!folderLoading) {
            setFolderTitle(currentFolder?.title || "");
        }
    }, [index, currentFolder, folderLoading]);

    const updateFolderTitle = useUpdateFolderMutation();

    const deleteFolder = useDeleteFolderMutation();

    const debouncedUpdate = useDebouncedCallback((newTitle: string) => {
        void updateFolderTitle.mutate({
            folder_id: currentFolder!.folder_id,
            title: newTitle
        });
    }, 1000);

    const handleSheetChanges = useCallback((index: number) => {
        setIndex(index);
    }, [setIndex]);

    const handleDeleteFolder = async () => {
        if (!currentFolder) return;
        try {
            deleteFolder.mutate(currentFolder.folder_id);
            bottomSheetRef.current?.close();
            setIndex(-1);
            router.navigate('/home');
        } catch (error) {
        }
    };

    return (
        <Portal>
        <BottomSheet
            ref={bottomSheetRef}
            index={index}
            backgroundStyle={styles.bottomSheetBackground}
            handleIndicatorStyle={styles.bottomSheetHandleIndicator}
            handleStyle={styles.bottomSheetHandle}
            enablePanDownToClose={true}
            snapPoints={snapPoints}
            onChange={handleSheetChanges}
        >
            <LoadingModal visible={loading} message={'Processing...'}  />
            <UnsafeContainer style={styles.container} >
                <View style={styles.titleInputContainer}>
                    <TextInput
                        style={styles.titleInput}
                        value={folderTitle}
                        onChangeText={(text) => {
                            setFolderTitle(text);
                            debouncedUpdate(text);
                        }}
                        placeholder="Enter Folder Title"
