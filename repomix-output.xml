<file path="src/hooks/useLoginLogic.ts">
import {useState} from "react";
import {useAtom} from "jotai/index";
import {onboardingDataAtom, studentAtom} from "@/utils/atoms";
import {GoogleSignin, isErrorWithCode, User} from "@react-native-google-signin/google-signin";
import {supabase} from "@/utils/supabase";
import {createStudent, createStudentWithoutNames, getStudentRow, updateStudentExistingUser} from "@/db/students";
import * as AppleAuthentication from "expo-apple-authentication";
import {PostHog, usePostHog} from "posthog-react-native";
import Toast from "react-native-toast-message";
import {Student} from "@data/student/types";

export function useLoginLogic(onNext : any) {
    const [loading, setLoading] = useState(false);
    const[onboardingData, setOnboardingData] = useAtom(onboardingDataAtom);
    const[student, setStudent] = useAtom(studentAtom);
    const posthog : PostHog = usePostHog();

    const handleGoogleSignIn = async () => {
        setLoading(true)
        
        try {
            // Sign out first to ensure clean state
            await GoogleSignin.signOut();
            
            await GoogleSignin.hasPlayServices()
            
            // Add a small delay to ensure any previous auth state is cleared
            await new Promise(resolve => setTimeout(resolve, 1));
            
            const userInfo: User = await GoogleSignin.signIn()
            
            if (userInfo.idToken) {
                const {data, error} = await supabase.auth.signInWithIdToken({
                    provider: 'google',
                    token: userInfo.idToken
                })
                
                if (!error && data) {
                    const userRow = await getStudentRow()
                    
                    if (userRow) {
                        const newStudent = await updateStudentExistingUser(userRow, onboardingData, posthog);
                        setStudent(newStudent)
                        setLoading(false)
                        onNext()
                        return
                    }
                    
                    if (userInfo.user.email) {
                        const fullName = userInfo.user.name;
                        const firstName = fullName ? fullName.split(" ")[0] : null
                        const lastName = fullName ? fullName.split(" ")[fullName.split(" ").length - 1] : null
                        
                        if (data.user?.id && firstName && lastName) {
                            await createStudent(userInfo.user.email, firstName, lastName, data.user.id, onboardingData, posthog)
                        } else if (userInfo.user.email) {
                            await createStudentWithoutNames(userInfo.user.email, data.user.id, onboardingData, posthog)
                        } else {
                            throw new Error("Email from google user is null!")
                        }
                        setLoading(false)
                        onNext("")
                    }
                } else {
                    setLoading(false)
                    throw new Error("Google onboarding error on sign in: " + error?.message + " " + error)
                }
            } else {
                setLoading(false)
                throw new Error('User does not have ID token')
            }
        } catch (error) {
            setLoading(false);
        }
    }

    const handleAppleSignIn = async () => {
        setLoading(true)
        await AppleAuthentication.signInAsync({
            requestedScopes: [
                AppleAuthentication.AppleAuthenticationScope.FULL_NAME,
                AppleAuthentication.AppleAuthenticationScope.EMAIL,
            ],
        }).then(async (credential) => {
            if (credential.identityToken) {
                const {
                    error,
                    data: {user},
                } = await supabase.auth.signInWithIdToken({
                    provider: 'apple',
                    token: credential.identityToken,
                })
                if (!error) {
                    const studentRow : Student = await getStudentRow()
                    if (studentRow) {
                        const newStudent = await updateStudentExistingUser(studentRow, onboardingData, posthog)
                        setStudent(newStudent)
                        setLoading(false)
                        onNext()
                        return
                    }
                    const fullName = credential.fullName ? credential.fullName : null
                    const firstName = fullName?.givenName ? fullName.givenName : null;
                    const lastName = fullName?.familyName ? fullName.familyName : null;
                    if (user?.id) {
                        if (fullName && firstName && lastName && user.email) {
                            await createStudent(user.email, firstName, lastName, user?.id, onboardingData, posthog)
                        } else if (user.email) {
                            await createStudentWithoutNames(user.email, user.id, onboardingData, posthog)
                        } else {
                            throw new Error("Email from user is null! ")
                        }
                        setLoading(false)
                        onNext()
                    } else {
                        alert("User ID is null apple sign in!")
                        setLoading(false)
                        throw new Error("User ID is null apple sign in!")
                    }
                } else {
                    setLoading(false)
                    alert("Error signing in with ID token apple supabase: " + error.message)
                    throw new Error("Error signing in with ID token apple supabase: " + error.message)
                }
            } else {
                setLoading(false)
                alert("No credential identity token returned apple!")
                throw new Error("No credential identity token returned apple!")
            }
        }).catch((error) => {
            setLoading(false)
        })
    }

    const signInEmailPassword = async (email : string, password : string) => {
        if(email === "" || password === "") {
            Toast.show({
                type: 'error',
                text1: 'Fill out the email and password fields!',
                text2: "They cannot be empty.",
                topOffset: 50,
            });
            return;
        }
        setLoading(true);
        const { data : { user }, error } = await supabase.auth.signInWithPassword(
            {
                email: email,
                password: password,
            }
        );
        if(error) {
            Toast.show({
                type: 'error',
                text1: 'Error signing in!',
                text2: error.message,
                topOffset: 50,
            });
            setLoading(false);
            return;
        }
        const studentRow : Student = await getStudentRow();
        const newStudent = await updateStudentExistingUser(studentRow, onboardingData, posthog);
        setStudent(newStudent);
        setLoading(false)
        onNext()
    }

    return { loading, handleAppleSignIn, handleGoogleSignIn, signInEmailPassword};

}
</file>

<file path="src/hooks/useOnboardingAnimation.ts">
import { useState } from 'react';
import {usePosthogLogic} from "@/hooks/usePosthogLogic";

export function useOnboardingAnimation(questions: any[]) {
    const [currentStepIndex, setCurrentStepIndex] = useState(0);
    const { trackEvent } = usePosthogLogic();

    const totalSteps = questions.length;

    const goToNextStep = (stepID : string, answer?: string) => {
        if (currentStepIndex < totalSteps - 1) {
            setCurrentStepIndex(currentStepIndex + 1);
        }
        trackEvent(`mobile_user_answered_onboarding_question_${stepID}`, {
            question_answer: answer
        })
    };

    const goToPreviousStep = () => {
        if (currentStepIndex > 0) {
            setCurrentStepIndex(currentStepIndex - 1);
        }
    };

    return {
        currentStepIndex,
        totalSteps,
        goToNextStep,
        goToPreviousStep,
    };
}
</file>

