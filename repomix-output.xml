import TrackPlayer, { Event } from 'react-native-track-player';

export const PlaybackService = async function() {
    TrackPlayer.addEventListener(Event.RemotePlay, () => TrackPlayer.play());
    TrackPlayer.addEventListener(Event.RemotePause, () => TrackPlayer.pause());
    TrackPlayer.addEventListener(Event.RemoteStop, () => TrackPlayer.stop());
    
    TrackPlayer.addEventListener(Event.RemoteJumpForward, async (event) => {
        await TrackPlayer.seekBy(event.interval);
    });
    
    TrackPlayer.addEventListener(Event.RemoteJumpBackward, async (event) => {
        await TrackPlayer.seekBy(-event.interval);
    });
    
    TrackPlayer.addEventListener(Event.RemoteSeek, async (event) => {
        await TrackPlayer.seekTo(event.position);
    });
};
</file>

<file path="tiptap-extensions/index.ts">
import {AnyExtension} from "@tiptap/core";
import React from "react";
import { SuggestionRenderResult } from "./CustomExtensions/slash/types";
import YProvider from "y-partyserver/provider";
import { ActionButtonType } from "@/utils/actionButton/types";
import {getV1Extensions} from './versions/v1';
import {getV2Extensions} from './versions/v2';

// Import extensions to ensure module augmentations are included in the build
import './CustomExtensions/fontsize';
import './CustomExtensions/lineHeight';

export interface ExtensionArgs {
    name?: string;
    cursorColor?: string;
    yProvider?: YProvider;
    setActiveComments?: (ids: string[]) => void;
    setActiveSuggestion?: (id: string | null) => void;
    getShowResolvedState?: () => boolean;
    CodeBlockComponent?: React.ComponentType<any>;
    SlashCommandRenderer?: () => SuggestionRenderResult;
    disablePlaceholder?: boolean;
    disableSlashCommands?: boolean;
    disableComments?: boolean;
    disableSuggestions?: boolean;
    
    // Content-specific args
    contentId?: string;
    
    // Static rendering mode - simplifies extensions for static output
    staticRender?: boolean;
    
    // ActionButton callback
    onButtonClick?: (actionType: ActionButtonType, actionData: any) => void;
}

export interface Author {
    name: string;
    email: string;
    avatarUrl: string;
    color: string;
}

type ExtensionGetter = (args: ExtensionArgs) => AnyExtension[];

// Simple version map
const versionMap: Record<number, ExtensionGetter> = {
  0: getV1Extensions,
  1: getV2Extensions,
};

export function getExtensions(
  version: number,
  args: ExtensionArgs = {}
): AnyExtension[] {
  const getter = versionMap[version];
  if (!getter) {
    throw new Error(`Unknown version: ${version}`);
  }
  
  return getter(args);
}

// Re-export for backward compatibility
export {getV1Extensions, getV2Extensions};
</file>

