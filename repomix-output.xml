import React, { useState, useEffect, useRef } from 'react';
import { View, ScrollView } from "react-native";
import { useSharedValue } from "react-native-reanimated";
import { createStyleSheet, useStyles } from "react-native-unistyles";
import CreatePodcastPage from '@/components/notes/insideScreens/Podcasts/createPodcastPage';
import PodcastPlayer from './PodcastPlayer';
import AllPodcastsModal from './AllPodcastsModal';
import NotEnoughCreditsPodcast from "../NotEnoughCreditsScreens/notEnoughCreditsPodcast";
import PodcastLoading from './PodcastLoading';
import PodcastFailed from './PodcastFailed';
import TrackPlayer from 'react-native-track-player';
import PodcastSkeleton from './PodcastSkeleton';
import { moderateScale } from "react-native-size-matters";
import { Animated } from 'react-native';
import { useAtom } from 'jotai';
import { currentPodcastAtom } from '@/utils/atoms';

import {Podcast} from "@data/podcast/types";
import { usePodcastRowsQuery } from "@data/podcast/hooks/usePodcastRowsQuery";

interface PodcastPageProps {
    contentID: string;
}

interface ConditionalPodcastRenderProps {
    selectedOption: string;
    podcasts: Podcast[] | undefined;
    contentID: string;
    onViewAllPodcasts: () => void;
    onPodcastCreated: (podcastId: string) => void;
    hasExistingPodcasts: boolean;
}

const ConditionalPodcastRender: React.FC<ConditionalPodcastRenderProps> = ({
    selectedOption,
    podcasts,
    contentID,
    onViewAllPodcasts,
    onPodcastCreated,
    hasExistingPodcasts
}) => {
    if (selectedOption === 'CREATE') {
        return (
            <CreatePodcastPage 
                contentId={contentID} 
                onPodcastCreated={onPodcastCreated}
                onViewAllPodcasts={onViewAllPodcasts}
                hasExistingPodcasts={hasExistingPodcasts}
            />
        );
    }

    const selectedPodcast = podcasts?.find((podcast: Podcast) => podcast.podcast_id === selectedOption);
    if (!selectedPodcast) return null;

    if (selectedPodcast.podcast_status === 'IN_PROGRESS') {
        return (
            <PodcastLoading 
                podcast_id={selectedPodcast.podcast_id}
                content_id={contentID}
                onViewAllPodcasts={hasExistingPodcasts ? onViewAllPodcasts : undefined}
            />
        );
    }
    if (selectedPodcast.podcast_status === 'FAILED') {
        return <PodcastFailed />;
    }
    if (selectedPodcast.podcast_status === 'NOT_ENOUGH_CREDITS') {
        return (
            <NotEnoughCreditsPodcast 
                onViewAllPodcasts={onViewAllPodcasts}
            />
        );
    }

    return (
        <PodcastPlayer 
            key={selectedPodcast.podcast_id} 
            podcast_id={selectedPodcast.podcast_id} 
            onViewAllPodcasts={onViewAllPodcasts}
        />
    );
};

export default function PodcastPage({ contentID }: PodcastPageProps) {
    const { styles, theme } = useStyles(stylesheet);
    const { data: podcasts, refetch, isPending } = usePodcastRowsQuery(contentID);
    const [currentPodcast, setCurrentPodcast] = useAtom(currentPodcastAtom);
    const [selectedOption, setSelectedOption] = useState<string>('CREATE');
    const [showAllPodcastsModal, setShowAllPodcastsModal] = useState<boolean>(false);
    const opacity = useSharedValue(1);
    const [loadingGone, setLoadingGone] = useState(false);
    const [showContent, setShowContent] = useState(false);


    useEffect(() => {
        if (currentPodcast && currentPodcast.contentId === contentID) {
            setSelectedOption(currentPodcast.podcastId);
        } else if (selectedOption === 'CREATE') {
            setSelectedOption('CREATE');
        }
    }, [contentID]);

    useEffect(() => {
        if (!isPending && podcasts && podcasts.length > 0 && selectedOption === 'CREATE' && (!currentPodcast || currentPodcast.contentId !== contentID)) {
            const sortedPodcasts = [...podcasts].sort((a, b) => 
                new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
            );
            setSelectedOption(sortedPodcasts[0].podcast_id);
            setCurrentPodcast({ contentId: contentID, podcastId: sortedPodcasts[0].podcast_id });
        }
        if (!isPending && podcasts) {
            setShowContent(true);
            opacity.value = 0;
            setTimeout(() => {
                setLoadingGone(true);
            }, 300);
        }
    }, [podcasts, isPending]);

    useEffect(() => {
        return () => {
            opacity.value = 0;
        };
    }, []);


    const handleShowAllPodcasts = () => {
        setShowAllPodcastsModal(true);
        TrackPlayer.reset();
    };

    const handleHideAllPodcasts = () => {
        setShowAllPodcastsModal(false);
    };


    return (
        <View style={styles.container}>
            {!loadingGone && <PodcastSkeleton opacity={opacity} />}
            {showContent && (
                <Animated.View style={[styles.container, { opacity: 1 - opacity.value }]}>      
                    <ScrollView style={styles.podcastContainer} showsVerticalScrollIndicator={false}>
                        <ConditionalPodcastRender
                            selectedOption={selectedOption}
                            podcasts={podcasts}
                            contentID={contentID}
                            onViewAllPodcasts={handleShowAllPodcasts}
                            onPodcastCreated={(podcastId) => {
                                setSelectedOption(podcastId);
                                setCurrentPodcast({ contentId: contentID, podcastId });
                            }}
                            hasExistingPodcasts={Boolean(podcasts?.length)}
                        />
                    </ScrollView>
                </Animated.View>
            )}
            
            <AllPodcastsModal
                visible={showAllPodcastsModal}
                onClose={handleHideAllPodcasts}
                podcasts={podcasts}
                onSelectPodcast={(podcastId) => {
                    setSelectedOption(podcastId);
                    setCurrentPodcast({ contentId: contentID, podcastId });
                }}
                onSelectCreate={() => {
                    setSelectedOption('CREATE');
                    setCurrentPodcast(null);
                }}
                isLoading={isPending}
            />
        </View>
