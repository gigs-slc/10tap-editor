<file path="src/data/quiz_questions/queries.ts">
import {supabase} from "@/utils/supabase";
import {JoinedQuestion} from "@data/quiz_questions/types";

export const getQuizRowsQuery = async (content_id: string) : Promise<JoinedQuestion[]> => {
    const { data, error } = await supabase
        .from("quiz_questions")
        .select(`
          *,
          mc_questions (*)
        `)
        .eq("content_id", content_id)
        .eq("question_type", "mc")
        .order("created_at", { ascending: false })
        .returns<JoinedQuestion[]>()

    if (error) throw new Error(`Failed to fetch question rows: ` + error.message);
    if (!data) throw new Error("Failed to fetch question rows: No data returned");

    return data;
}

export const getQuestionQuery = async (question_id: string) : Promise<JoinedQuestion> => {
    const { data, error } = await supabase
        .from("quiz_questions")
        .select(`
          *,
          mc_questions (*)
        `)
        .eq("question_id", question_id)
        .eq("question_type", "mc")
        .single()
        .returns<JoinedQuestion>()

    if (error) throw new Error(`Failed to fetch question: ` + error.message);
    if (!data) throw new Error("Failed to fetch question: No data returned");

    return data;
}
