import Container from "@/common/generics/Container";
import BackHeader from "@/common/components/headers/backHeader";
import {
    Linking,
    Text,
    TextInput,
    TouchableOpacity,
    View
} from "react-native";
import {moderateScale} from "react-native-size-matters";
import {useEffect, useState} from "react";
import {heavyHaptic} from "@/utils/haptic";
import BasicButton from "@/common/components/buttons/basicButton";
import Toast from "react-native-toast-message";
import {router} from "expo-router";
import { Text as GenericText } from '@/common/generics/Text'
import * as Clipboard from 'expo-clipboard';
import LoadingModal from "@/common/components/modals/loadingModal";
import uuid from "react-native-uuid";
import {useStudentIDQuery} from "@data/student/hooks/useStudentIDQuery";
import {useInsertContentMutation} from "@data/content/hooks/useInsertContentMutation";
import {createStyleSheet, useStyles} from "react-native-unistyles";

export default function YoutubeVideo() {
    const {styles, theme} = useStyles(stylesheet);
    const[link, setLink] = useState("");
    const[opacity, setOpacity] = useState<number>(0.2);
    const[loading, setLoading] = useState<boolean>(false);
    const { student_id } = useStudentIDQuery();

    const insertContent = useInsertContentMutation()



    const handleGenerateNotes = async () => {
        setLoading(true)
        if (extractVideoID(link) != null) {
            let content_uuid : string = uuid.v4() as string;
            await insertContent.mutate(
                {
                    content_id: content_uuid,
                    class_subject: "humanities",
                    content_type: "video",
                    file_link: link,
                    student_id: student_id
                }
            )
            router.navigate(`/home/${content_uuid}/notes`);
            setLoading(false)
        }
        else {
            Toast.show({
                type: 'error',
                text1: 'Please enter a valid YouTube video URL!!',
                text2: 'We don\'t accept LIVE videos!',
                topOffset: 50,
            });
            setLoading(false)
        }
    }

    useEffect(() => {
        if(link && link !== "") {
            setOpacity(1);
        }
        else {
            setOpacity(0.2);
        }
    }, [link]);

    const handlePaste = async () => {
        const text = await Clipboard.getStringAsync();
        setLink(text);
    };


    return <Container>
        <LoadingModal visible={loading} message={'Uploading audio...'} />
        <BackHeader title={'Paste YouTube Link'} textStyle={{}} />
        <TouchableOpacity onPress={() => {
            void heavyHaptic();
            void Linking.openURL("youtube://");
        }}>
            <Text style={styles.openAppText}>Open YouTube App</Text>
        </TouchableOpacity>
        <View style={{flex: 0.7, justifyContent: 'center', alignItems: 'center'}}>
            <GenericText style={styles.pasteLinkText}>👇 enter link here 👇</GenericText>
            <TextInput
                value={link}
                onChangeText={setLink}
                style={[styles.textInput]}
                placeholder={'www.youtube.com/watch?v=ArcI4A5nvBo'}
                placeholderTextColor={'#8c8c8c'}
                returnKeyType="go"
                onSubmitEditing={() => {
                    void heavyHaptic();
                    void handleGenerateNotes();
                }}
                keyboardType="url"
            />
            <TouchableOpacity onPress={() => {
                void heavyHaptic();
                void handlePaste();
            }}>
                <Text style={styles.pasteLinkButton}>Paste From Clipboard</Text>
            </TouchableOpacity>

        </View>
        <BasicButton onPress={() => {
            void heavyHaptic();
            if(opacity === 1) {
                void handleGenerateNotes()
            }
            else {
                Toast.show({
                    type: 'error',
                    text1: 'Paste link to generate notes!',
                    text2: 'Then press the purple record button to start!',
                    topOffset: 50,
                });
            }
        }} backgroundColor={theme.colors.tints.PRIMARY} text={'Generate Notes'} style={{opacity: opacity, position: 'absolute', bottom: '7%' }} />
    </Container>
}

const stylesheet = createStyleSheet((theme) => ({
    textInput: {
        paddingVertical: 25,
        borderRadius: 20,
        alignSelf: 'center',
        width: '90%',
        paddingHorizontal: 20,
        borderColor: '#000',
        color: '#fff',
        marginTop: 10,
        fontSize: moderateScale(15),
        fontFamily: 'Sans-Medium',
        backgroundColor: theme.colors.background.SECONDARY
    },
    openAppText: {
        color: theme.colors.tints.SECONDARY,
        fontSize: moderateScale(17),
        textAlign: 'center',
        fontFamily: 'Sans-Medium',
        marginVertical: 10
    },
    pasteLinkButton: {
        color: theme.colors.tints.SECONDARY,
        fontSize: moderateScale(17),
        textAlign: 'center',
        fontFamily: 'Sans-Medium',
        marginVertical: 10
    },
    pasteLinkText: {
        fontSize: moderateScale(14),
        textAlign: 'center',
        fontFamily: 'Sans-Medium',
        marginVertical: 10
    }
}));

function extractVideoID(url : string) {
    let videoID = null;

    // Check for standard YouTube format (https://www.youtube.com/watch?v=)
    const standardFormat = url.match(/youtube\.com.*(\?v=|&v=)([^#\&\?]*).*/);
    if (standardFormat && standardFormat[2].length === 11) {
        videoID = standardFormat[2];
    }

    // Check for shortened YouTube format (https://youtu.be/)
    const shortFormat = url.match(/youtu\.be\/([^#\&\?]*).*/);
    if (shortFormat && shortFormat[1].length === 11) {
        videoID = shortFormat[1];
    }

    return videoID;
}
