<file path="src/utils/modifyHtml.ts">
import { parseHTML } from 'linkedom';

const modifyHtml = (html: string): string => {
    const { document } = parseHTML(html);

    const addStyle = (element: Element, style: string): void => {
        const currentStyle = element.getAttribute('style') || '';
        const updatedStyle =
            currentStyle && !currentStyle.trim().endsWith(';')
                ? currentStyle + ';'
                : currentStyle;
        element.setAttribute('style', updatedStyle + ' ' + style);
    };

    document.querySelectorAll('h1, h2, h3, h4, h5, h6').forEach((header) => {
        addStyle(header, 'font-weight: bold;');
    });

    document.querySelectorAll('h1, h2').forEach((header) => {
        addStyle(header, 'text-align: center;');
    });

    document.querySelectorAll('*').forEach((element) => {
        addStyle(element, 'line-height: 1.5;');
    });

    document.querySelectorAll('ul, ol, li').forEach((element) => {
        addStyle(element, 'line-height: 2;');
    });

    document.querySelectorAll('strong').forEach((element) => {
        const span = document.createElement('span');
        span.setAttribute('style', 'color: #7d77fc;');
        while (element.firstChild) {
            span.appendChild(element.firstChild);
        }
        element.appendChild(span);
    });

    document.querySelectorAll('img').forEach((element) => {
        addStyle(element, 'margin: 10px auto;');
    });

    return document.toString();
};

export default modifyHtml;
</file>

