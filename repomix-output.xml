<file path="app/home/failedUploads.tsx">
import {createStyleSheet, useStyles} from "react-native-unistyles";
import Container from "@/common/generics/Container";
import BackHeader from "@/common/components/headers/backHeader";
import {getPendingUploads, removeUploadStorage, uploadAudioFileTUS} from "@/utils/tus";
import {ScrollView, Text, TouchableOpacity} from "react-native";
import {PendingUpload} from "@/types/db.types";
import { recordingBackupService, RecordingBackup } from "@/services/RecordingBackupService";
import {windowWidth} from "@/utils/window";
import {format} from "date-fns";
import {moderateScale} from "react-native-size-matters";
import {heavyHaptic} from "@/utils/haptic";
import React, {useState} from "react";
import AudioUploadingModal from "@/common/components/modals/audioUploadingModal";
import {router} from "expo-router";
import uuid from "react-native-uuid";
import {useStudentIDQuery} from "@data/student/hooks/useStudentIDQuery";
import { useInsertContentMutation } from "@data/content/hooks/useInsertContentMutation";
import { cleanupWavFiles } from "@/utils/wavConcatenation";

export default function FailedUploads() {
    const { styles } = useStyles(stylesheet);
    const[uploads, setUploads] = useState(getPendingUploads());
    const[recordingBackups, setRecordingBackups] = useState<RecordingBackup[]>([]);
    const[uploadProgress, setUploadProgress] = useState<number>(0);
    const[uploadedBytes, setUploadedBytes] = useState<number>(0);
    const[totalBytes, setTotalBytes] = useState<number>(0);
    const[loading, setLoading] = useState<boolean>(false);
    const { student_id } = useStudentIDQuery();


    const insertContent = useInsertContentMutation();

    React.useEffect(() => {
        const loadBackups = async () => {
            const backups = await recordingBackupService.getCompletedButNotUploadedRecordings();
            setRecordingBackups(backups);
        };
        loadBackups();
    }, []);

    const handleGenerateNotesFromBackup = async (backup: RecordingBackup) => {
        setLoading(true);
        try {
            const audioUri = await recordingBackupService.getConsolidatedFileForBackup(backup);
            if (!audioUri) {
                throw new Error("No audio file found for backup");
            }

            const filePath = `${student_id}/${uuid.v4()}.mp3`;
            await uploadAudioFileTUS(audioUri, filePath, null, false, {
                onProgress: (bytesUploaded, bytesTotal, progress) => {
                    setUploadProgress(progress);
                    setUploadedBytes(bytesUploaded);
                    setTotalBytes(bytesTotal);
                },
                onError: (error) => {
                    console.log('ERROR UPLOADING BACKUP AUDIO');
                    console.log(error);
                    setLoading(false);
                },
                onSuccess: async (fileLink: string) => {
                    const content_uuid = uuid.v4() as string;

                    await insertContent.mutate({
                        content_id: content_uuid,
                        class_subject: "humanities",
                        content_type: "audio",
                        file_link: fileLink,
                        student_id: student_id,
                        content_title: backup.metadata?.contentTitle || null
                    });

                    setLoading(false);
                    
                    // Clean up ALL recording files (segments + consolidated + recovered) after successful upload and processing
                    try {
                        const filesToCleanup = await recordingBackupService.getAllPotentialFilePathsForBackup(backup.sessionId);
                        if (filesToCleanup.length > 0) {
                            await cleanupWavFiles(filesToCleanup);
                            console.log('✅ All backup recording files cleaned up:', filesToCleanup.length, 'files');
                        }
                    } catch (cleanupError) {
                        console.warn('⚠️ Failed to cleanup backup recording files:', cleanupError);
                    }
                    
                    recordingBackupService.removeBackup(backup.sessionId);
                    setRecordingBackups(prev => prev.filter(b => b.sessionId !== backup.sessionId));
                    router.navigate(`/home/${content_uuid}/notes`);
                }
            });
        } catch (error) {
            console.log('ERROR UPLOADING BACKUP AUDIO');
            console.log(error);
            setLoading(false);
        }
    };

    const handleGenerateNotes = async (upload : PendingUpload) => {
        setLoading(true)
        try{
            const { cancel, progress } = await uploadAudioFileTUS(upload.audioURI, upload.path, null, true, {
                onProgress: (bytesUploaded, bytesTotal, progress) => {
                    setUploadProgress(progress)
                    setUploadedBytes(bytesUploaded)
                    setTotalBytes(bytesTotal)
                },
                onError: (error) => {
                    console.log('ERROR UPLOADING AUDIO');
                    console.log(error)
                },
                onSuccess: async (fileLink : string) => {
                    const content_uuid = uuid.v4() as string;

                    await insertContent.mutate(
                        {
                            content_id: content_uuid,
                            class_subject: "humanities",
                            content_type: "audio",
                            file_link: fileLink,
                            student_id: student_id
                        }
                    );

                    setLoading(false)
                    
                    // Clean up the audio file after successful upload and processing
                    try {
                        await cleanupWavFiles([upload.audioURI]);
                        console.log('✅ Pending upload audio file cleaned up:', upload.audioURI);
                    } catch (cleanupError) {
                        console.warn('⚠️ Failed to cleanup pending upload audio file:', upload.audioURI, cleanupError);
                    }
                    
                    removeUploadStorage(upload.id);
                    setUploads((prevUploads) =>
                        prevUploads.filter((prevUpload) => prevUpload.id !== upload.id)
                    )
                    router.navigate(`/home/${content_uuid}/notes`)
                }
            });
        }
        catch(error) {
            console.log('ERROR UPLOADING AUDIO');
            console.log(error)
        }
    }


    return (
        <Container>
            <AudioUploadingModal visible={loading}  progress={uploadProgress} totalBytes={totalBytes} uploadedBytes={uploadedBytes}/>
            <BackHeader title={'Failed Uploads'} textStyle={{}} />
            <Text style={styles.subheader}>Press any recording to retry the upload! :)</Text>
            <ScrollView showsVerticalScrollIndicator={false}>
                {uploads.length === 0 && recordingBackups.length === 0 && <Text style={[styles.subtitle, {textAlign: 'center', marginTop: 20}]}>No failed uploads right now! :)</Text>}
                
                {recordingBackups.sort((a, b) => new Date(b.lastUpdated).getTime() - new Date(a.lastUpdated).getTime()).map((backup: RecordingBackup) => {
                    const formatDuration = (ms: number) => {
                        const totalSeconds = Math.floor(ms / 1000);
                        const minutes = Math.floor(totalSeconds / 60);
                        const seconds = totalSeconds % 60;
                        return `${minutes}:${seconds.toString().padStart(2, "0")}`;
                    };
                    
                    return <TouchableOpacity style={styles.retryButton} key={`backup_${backup.sessionId}`} onPress={() => {
                        void heavyHaptic();
                        void handleGenerateNotesFromBackup(backup);
                    }}>
                        <Text style={styles.rowTitle}>{backup.metadata?.contentTitle || "Saved Recording"}</Text>
                        <Text style={styles.subtitle}>{formatDuration(backup.totalDuration)} • Created {format(backup.dateCreated, "MMM do, yyyy h:mm a")}</Text>
                    </TouchableOpacity>
                })}
                
                {uploads.sort((a, b) => new Date(b.dateCreated).getTime() - new Date(a.dateCreated).getTime()).map((upload : PendingUpload, index : number) => {
                    return <TouchableOpacity style={styles.retryButton} key={`upload_${upload.id}`} onPress={() => {
                        void heavyHaptic();
                        void handleGenerateNotes(upload);
                    }}>
                        <Text style={styles.rowTitle}>Failed Upload</Text>
                        <Text style={styles.subtitle}>Created {format(upload.dateCreated, "MMM do, yyyy h:mm a")}</Text>
                    </TouchableOpacity>
                })}
            </ScrollView>


        </Container>
    )

}

const stylesheet = createStyleSheet((theme) => ({
    retryButton: {
        width: windowWidth * .9,
        borderRadius: 15,
        paddingVertical: 15,
        paddingHorizontal: 20,
        marginVertical: 5,
        alignSelf: 'center',
        backgroundColor: theme.colors.background.SECONDARY,
    },
    subheader: {
        fontSize: moderateScale(15),
        fontFamily: 'Sans-Medium',
        marginVertical: 10,
        color: theme.colors.grays.PRIMARY,
        textAlign: 'center'
    },
    rowTitle: {
        fontSize: moderateScale(17),
        fontFamily: 'Sans-Bold',
        color: theme.colors.text.PRIMARY,
    },
    subtitle: {
        fontSize: moderateScale(14),
        fontFamily: 'Sans-Light',
        color: theme.colors.grays.PRIMARY,
        marginTop: 5,
    }
}))
</file>

