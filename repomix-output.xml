export const getFlashcardRowsQuery = async (contentID: string): Promise<Flashcard[]> => {
    const {data, error} = await supabase
        .from("flashcards")
        .select()
        .eq('content_id', contentID)
        .limit(40)
    if (error) throw new Error(`Failed to fetch flashcards: ` + error.message);
    if(!data) throw new Error("Failed to fetch podcasts: No data returned");
    return data;
};
