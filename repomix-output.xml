import { InsertFolder, UpdateFolder, Folder} from "@/data/folders/types";
import { supabase } from "@/utils/supabase"


export const insertFolderMutation = async (folder: InsertFolder): Promise<Folder> => {
    const { data, error } = await supabase
        .from("folders")
        .insert(folder)
        .select()
        .single()

    if (error) throw new Error(`Failed to create folder: ${error.message}`);
    if (!data) throw new Error("Failed to create folder: No data returned");

    return data;
}

export const updateFolderMutation = async (updatedFolder: UpdateFolder): Promise<Folder> => {
    const { folder_id, ...updates} = updatedFolder;
    const { data, error } = await supabase
        .from("folders")
        .update(updates)
        .eq("folder_id", folder_id)
        .select()
        .single()
    if (error) throw new Error(`Failed to update folder: ` + error.message);
    if (!data) throw new Error("Failed to update folder: No data returned");

    return data;
}

export const deleteFolderMutation = async (folder_id: string): Promise<void> => {
    const { error } = await supabase
        .from("folders")
        .delete()
        .eq("folder_id", folder_id)
    if (error) throw new Error(`Failed to delete folder: ` + error.message);
}
