            ) : speakerOptions.length > 0 ? (
              speakerOptions.map(sp => (
                <View key={sp.speaker_id} style={styles.modalItem}>
                  <TouchableOpacity
                    style={styles.modalSelect}
                    onPress={() => {
                      setSpeaker2(sp);
