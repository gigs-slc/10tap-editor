import {MODAL_URL} from "@/common/environment";

export const generateContentTopics = async (content_id: string) => {
    const student_id  = await getUserID();
    if(!student_id) throw new Error("Could not generate content topics - user is not signed in!")
    const accessToken = await getUserAccessToken();

    try {
        const response = await fetch(`${MODAL_URL}-generate-all-quiz-topics.modal.run`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${accessToken}`,
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({content_id, student_id}),
        });

        if (!response.ok) {
            const errorText = await response.text();
            throw new Error(`Content Topic Generation Failed: ${response.status} ${response.statusText} - ${errorText}`);
        }

        const data = await response.json();
        return data;
    } catch (error) {
        console.error('Error generating content topics:', error);
        throw error;
    }
}
