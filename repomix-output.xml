import React, {useCallback, useMemo, useRef, useState} from "react";
import {Text, TouchableOpacity, View} from "react-native";
import BottomSheet from "@gorhom/bottom-sheet";
import {useAtom} from "jotai";
import {isPayingOnWebAtom} from "@/utils/atoms";
import {moderateScale} from "react-native-size-matters";
import Microphone from '../../../../assets/svgs/notes/microphone.svg';
import Youtube from '@/../assets/svgs/notes/youtube.svg';
import UnsafeContainer from "@/common/generics/UnsafeContainer";
import {windowWidth} from "@/utils/window";
import Ionicons from "@expo/vector-icons/Ionicons";
import {heavyHaptic} from "@/utils/haptic";
import {router} from "expo-router";
import PDF from '@/../assets/svgs/notes/pdf.svg';
import {createStyleSheet, useStyles} from "react-native-unistyles";
import * as DocumentPicker from "expo-document-picker";
import {DocumentPickerAsset, DocumentPickerResult} from "expo-document-picker";
import Toast from "react-native-toast-message";
import LoadingModal from "@/common/components/modals/loadingModal";
import {uploadPDFFile} from "@/utils/general";
import Superwall, { PaywallPresentationHandler } from "expo-superwall/compat";
import {initialNotesIDs} from "../../../../app/home";
import {Portal} from "react-native-portalize";
import {useStudentIDQuery} from "@data/student/hooks/useStudentIDQuery";
import uuid from "react-native-uuid";
import {Content} from "@/data/content/types";
import { useContentRowsQuery} from "@data/content/hooks/useContentRowsQuery";
import { useInsertContentMutation } from "@data/content/hooks/useInsertContentMutation";


export default function NewNoteSheet({index, setIndex} : { index: number; setIndex: any}) {
    const bottomSheetRef = useRef<BottomSheet>(null);
    const snapPoints = useMemo(() => ["45%"], []);
    const[loading, setLoading] = useState<boolean>(false);
    const[isPayingOnWeb, setIsPayingOnWeb] = useAtom(isPayingOnWebAtom);
    const { student_id } = useStudentIDQuery();
    const { data: contentRows, isPending : contentRowsPending } = useContentRowsQuery(null);
    const { styles, theme } = useStyles(stylesheet);

    const isCompletedMoreThanOneNote = () : boolean => {
        return removeInitialNotes(contentRows || []).filter(note => note.content_status === 'COMPLETE').length >= 1;
    }

    const removeInitialNotes = (notes: Content[]) => {
        return notes.filter(note => !initialNotesIDs.find(initialNote => initialNote === note.content_id));
    }

    const handleSheetChanges = useCallback((index: number) => {
        setIndex(index);
    }, [setIndex]);

    const closeModalAndNavigate = (routeName : string) => {
        if(bottomSheetRef.current) bottomSheetRef.current.close();
        setIndex(-1)
        setTimeout(() => {
            router.navigate(routeName)
        }, 250)
    }

    const handleRecordButtonPress = async () => {
        void heavyHaptic();
        if(isPayingOnWeb || !isCompletedMoreThanOneNote()){
            closeModalAndNavigate('/home/record');
        }
        else {
            const handler = new PaywallPresentationHandler();
            handler.onDismiss(() => {
                void Superwall.shared.register({ 
                    placement: "discounted_offer",
                    feature: () => {
                        closeModalAndNavigate('/home/record');
                    }
                });
            });
            void Superwall.shared.register({ 
                placement: "note_creation_after_first", 
                handler,
                feature: () => {
                    closeModalAndNavigate('/home/record');
                }
            })
        }
    }

    const handleYoutubeButtonPress = async () => {
        void heavyHaptic();
        if(isPayingOnWeb || !isCompletedMoreThanOneNote()){
            closeModalAndNavigate('/home/youtube');
        }
        else {
            const handler = new PaywallPresentationHandler();
            handler.onDismiss(() => {
                void Superwall.shared.register({ 
                    placement: "discounted_offer",
                    feature: () => {
                        closeModalAndNavigate('/home/youtube');
                    }
                });
            });
            void Superwall.shared.register({ 
                placement: "note_creation_after_first", 
                handler,
                feature: () => {
                    closeModalAndNavigate('/home/youtube');
                }
            })
        }
    }

    const handlePDFButtonPress = async () => {
        void heavyHaptic();
        if(isPayingOnWeb || !isCompletedMoreThanOneNote()){
                void handlePDFLogic();
        }
        else {
            const handler = new PaywallPresentationHandler();
            handler.onDismiss(() => {
                void Superwall.shared.register({ 
                    placement: "discounted_offer",
                    feature: () => {
                        void handlePDFLogic();
                    }
                });
            });
            void Superwall.shared.register({ 
                placement: "note_creation_after_first", 
                handler,
                feature: () => {
                    void handlePDFLogic();
                }
            })
        }
    }
    const insertContent = useInsertContentMutation();

    const handlePDFLogic = async () => {
        const result : DocumentPickerResult = await DocumentPicker.getDocumentAsync();
        if(!result.canceled) {
            const PDFAsset : DocumentPickerAsset = result.assets[0];
            if(PDFAsset.mimeType == 'application/pdf') {
                setLoading(true)
                if(student_id) {
                    const pdfURL = await uploadPDFFile(student_id, PDFAsset.uri);
                    let content_uuid : string = uuid.v4() as string;
                    
                    // Remove file extension from filename
                    const filenameWithoutExt = PDFAsset.name.replace(/\.[^/.]+$/, "");
                    
                    await insertContent.mutate(
                        {
                            content_id: content_uuid,
                            class_subject: "humanities",
                            content_type: "pdf",
                            file_link: pdfURL,
                            student_id: student_id,
                            content_title: filenameWithoutExt
                        }
                    )
                    setLoading(false);
                    if(bottomSheetRef.current) bottomSheetRef.current.close();
                    router.navigate(`/home/${content_uuid}/notes`)
                }
            }
            else {
                Toast.show({
                    type: 'error',
                    text1: 'File must be a PDF!',
                    text2: `The file you chose was not a PDF: ${PDFAsset.mimeType}!`,
                    topOffset: 50,
                });
            }
        }
    }

    return (
        <Portal>
        <BottomSheet
            ref={bottomSheetRef}
            index={index}
            backgroundStyle={styles.bottomSheetBackground}
            handleIndicatorStyle={styles.bottomSheetHandleIndicator}
            handleStyle={styles.bottomSheetHandle}
            enablePanDownToClose={true}
            snapPoints={snapPoints}
            onChange={handleSheetChanges}
        >
            <UnsafeContainer style={styles.container} >
                <LoadingModal visible={loading} message={'Uploading your PDF...'}  />
                <TouchableOpacity style={[styles.row]} onPress={handleRecordButtonPress}>
                    <View style={styles.rowLeftContent}>
                        <Microphone width={35} height={35} style={styles.icon} />
                        <Text style={styles.title}>Record or upload audio</Text>
                    </View>
                    <Ionicons
                        name="chevron-forward-outline"
                        size={moderateScale(20)}
                        color={theme.colors.grays.PRIMARY}
                    />
                </TouchableOpacity>
                <TouchableOpacity style={[styles.row]}
                onPress={handleYoutubeButtonPress}
                >
                    <View style={styles.rowLeftContent}>
                        <Youtube width={35} height={35} style={styles.icon} />
                        <Text style={styles.title}>YouTube video</Text>
                    </View>
                    <Ionicons
                        name="chevron-forward-outline"
                        size={moderateScale(20)}
                        color={theme.colors.grays.PRIMARY}
                    />
                </TouchableOpacity>
                <TouchableOpacity style={[styles.row]} onPress={handlePDFButtonPress}>
                    <View style={styles.rowLeftContent}>
                        <PDF width={35} height={35} style={styles.icon} />
                        <View style={styles.textContainer}>
                            <Text style={styles.title}>Upload document</Text>
                            <Text style={styles.subtitle}>Any PDF, DOCX, PPT, TXT, etc!</Text>
                        </View>
                    </View>
                    <Ionicons
                        name="chevron-forward-outline"
                        size={moderateScale(20)}
                        color={theme.colors.grays.PRIMARY}
                    />
                </TouchableOpacity>
            </UnsafeContainer>
        </BottomSheet>
        </Portal>
    );
}

const stylesheet = createStyleSheet((theme) => ({
    bottomSheetBackground: {
        backgroundColor: theme.colors.background.SECONDARY,
    },
    bottomSheetHandleIndicator: {
        backgroundColor: theme.colors.grays.PRIMARY,
    },
    bottomSheetHandle: {
        backgroundColor: theme.colors.background.SECONDARY,
    },
    container: {
        backgroundColor: theme.colors.background.SECONDARY,
    },
    rowLeftContent: {
        flexDirection: 'row',
        alignItems: 'center',
    },
    textContainer: {
        justifyContent: 'center',
    },
    title: {
        fontSize: moderateScale(16),
        fontFamily: 'Sans-Medium',
        color: theme.colors.text.PRIMARY,
    },
    subtitle: {
        fontSize: moderateScale(11),
        fontFamily: 'Sans-Light',
        color: theme.colors.grays.PRIMARY,
        marginTop: 5,
    },
    mainTitle: {
        fontSize: moderateScale(20),
        fontFamily: 'Sans-Bold',
        textAlign: 'center',
        marginVertical: moderateScale(10),
        color: theme.colors.text.PRIMARY,
    },
    row: {
        flexDirection: 'row',
        width: windowWidth * .9,
        alignItems: 'center',
        justifyContent: 'space-between',
        paddingHorizontal: 20,
        paddingVertical: 15,
        borderRadius: 15,
        alignSelf: 'center',
        marginVertical: 7,
        backgroundColor: theme.colors.background.TERTIARY
    },
    icon: {
        marginRight: 15,
    },
    topTitle: {
        fontSize: moderateScale(15),
        fontFamily: 'Sans-Bold',
        textAlign: 'center',
        marginVertical: 10,
        color: theme.colors.text.PRIMARY,
        width: windowWidth * .9,
        alignSelf: 'center'
    },
    folderNameTitle: {
        textDecorationLine: 'underline'
    }
}));
