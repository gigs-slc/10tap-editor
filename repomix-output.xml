import {
    View,
    Keyboard
} from "react-native";
import React, {useEffect, useRef, useState} from "react";
import {windowWidth} from "@/utils/window";
import {heavyHaptic} from "@/utils/haptic";
import { convertMessagesToOpenAIFormatWithInitialPrompt} from "@/components/notes/chat/messages";
import {ChatMessage} from "@/types/db.types";
import Composer from "@/components/notes/chat/composer";
import MessageComponent from "@/components/notes/chat/message";
import {KeyboardAwareScrollView } from "react-native-keyboard-controller";
import {postGenerateChatMessages} from "@/utils/node-api";
import {createStyleSheet, useStyles} from "react-native-unistyles";
import Superwall from "expo-superwall/compat";

export default function ChatPage({ contentID } : { contentID : string;}) {
    const [ChatMessages, setChatMessages] = useState<ChatMessage[]>([{content: 'Ask me any question about your  content!', role: 'assistant'}])
    const [keyCount, setKeyCount] = useState(3);
    const [isTyping, setIsTyping] = useState(false)
    const ref = useRef(null);
    const { styles } = useStyles(stylesheet);

    const handlePostOpenRouter = async (localChatMessages: ChatMessage[]) => {
        setIsTyping(true)
        const ChatMessagesBody: ChatMessage[] = convertMessagesToOpenAIFormatWithInitialPrompt(localChatMessages);
        console.log(ChatMessagesBody[ChatMessagesBody.length - 1])
        const chatResponse = await postGenerateChatMessages(ChatMessagesBody, contentID);
        console.log(chatResponse)
        if(chatResponse.notEnoughCredits === true) {
            console.log('not enough credits for chat!');
            void Superwall.shared.register({ placement: "not_enough_credits", feature: async () => {

            }})
        }
            setTimeout(() => {
                setChatMessages((previousChatMessages: ChatMessage[]) => {
                        void heavyHaptic()
                        const newChatMessage: ChatMessage = {content: chatResponse.latestMessage.trim(), role: 'assistant'};
                        let newChatMessages = previousChatMessages.slice(0, previousChatMessages.length - 1);
                        newChatMessages.push(newChatMessage);
                        return newChatMessages;
                    }
                )
            }, 100)
            setTimeout(() => {
                _keyboardDidShow()
            }, 200)
            setKeyCount((count: number) => {
                return count + 1
            })
    }

    useEffect(() => {
        Keyboard.addListener("keyboardDidShow", _keyboardDidShow);
    }, []);

    const _keyboardDidShow = () => {
        //@ts-ignore
        ref.current?.scrollToEnd({animated: true});
    };


    return (
        <View style={[styles.container]}>
            <KeyboardAwareScrollView
                // @ts-ignore
                ref={ref}
                style={{flex: 1}}
                onScrollBeginDrag={() => {
                    setTimeout(() => {
                        Keyboard.dismiss()
                    }, 100)
                }}
                contentContainerStyle={{paddingBottom: 120, paddingTop: 10}}
                showsVerticalScrollIndicator={false}>
                {ChatMessages.length != 0 ?ChatMessages.map((ChatMessage: ChatMessage) => {
                    return <MessageComponent messageObject={ChatMessage} key={ChatMessage.content + Math.random()}/>
                }) : null}
            </KeyboardAwareScrollView>
            <Composer onSubmit={(text: string) => {
                void heavyHaptic()
                console.log(text)
                setChatMessages((prevChatMessages: ChatMessage[]) => {
                    const ret: ChatMessage[] = [...prevChatMessages, {content: text, role: 'user'}]
                    setTimeout(() => {
                        setChatMessages((previousChatMessages: ChatMessage[]) => {
                                return [...previousChatMessages, {content: 'loading', role: 'assistant'}]
                            }
                        )
                        setTimeout(() => {
                            _keyboardDidShow()
                        }, 100)
                    }, 200)
                    void handlePostOpenRouter(ret)
                    return ret
                })
            }}/>
        </View>
    );
}

