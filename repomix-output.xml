import {supabase} from "@/utils/supabase";


const CHECK_STRIPE_SUBSCRIPTION_FUNCTION = "check-global-user-subscription";


export const checkUserActiveSubscription = async () : Promise<boolean> => {
    try {
        const {data, error} = await supabase.functions.invoke(CHECK_STRIPE_SUBSCRIPTION_FUNCTION)
        if (error) throw new Error('Error invoking check stripe edge function: ' + error)
        if (!data) throw new Error('Error invoking check stripe edge function: no data returned')
        
        const isActive = data.is_subscription_active;
        return isActive;
    
    }
    catch(e) {
        return false;
    }
}
