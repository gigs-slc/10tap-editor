import React, {useEffect, useState} from "react";
import { Text, View, Modal, Dimensions, TouchableOpacity} from "react-native";
import {moderateScale} from "react-native-size-matters";
import {createStyleSheet, useStyles} from "react-native-unistyles";
import Animated, {useAnimatedStyle, useSharedValue, withSpring, withTiming} from "react-native-reanimated";
import {windowWidth} from "@/utils/window";
import LottieView from "lottie-react-native";
import RecordingStuckInstructionsSheet from "@/common/components/sheets/recordingStuckInstructionsSheet";

type LoadingModalProps = {
    visible: boolean;
    uploadedBytes : number;
    totalBytes: number;
    progress: number;
}

export default function AudioUploadingModal({visible, uploadedBytes, totalBytes, progress}: LoadingModalProps) {
    const barWidth = useSharedValue(
        ((progress || 1) / 100) * 0.8 * windowWidth
    );
    const { styles } = useStyles(stylesheet);
    const[helpSheetIndex, setHelpSheetIndex] = useState(-1);

    useEffect(() => {
        barWidth.value = withSpring(((progress || 1) / 100) * 0.8 * windowWidth, {
            damping: 15,
            stiffness: 90,
        });
    }, [progress]);


    const style = useAnimatedStyle(() => ({
        width: barWidth.value,
    }));


    return (
        <View>
            <Modal animationType="fade" transparent={true} visible={visible}>
                <View style={styles.centeredView}>
                    <View style={styles.modalView}>
                        <View>
                            <Text style={styles.modalText}>Uploading Audio...</Text>
                            <Text style={styles.subheader}>Do <Text style={styles.redText}>NOT</Text> leave or close the app! Be patient. This will cause the upload to <Text style={styles.redText}>FAIL!</Text></Text>
                        </View>
                        <View style={{marginTop: -100}}>
                            <LottieView
                                source={require("@/../assets/lottie/cloud-loading.json")}
                                style={{width: windowWidth * .6, height: windowWidth * .6, alignSelf: 'center'}}
                                autoPlay
                                loop
                            />
                            <View style={styles.outerBar}>
                                <Animated.View style={[styles.innerBar, style]}/>
                            </View>
                            <Text style={styles.progressSubtitle}>{Number(uploadedBytes / 1000000).toFixed(2)} MB uploaded of {Number(totalBytes / 1000000).toFixed(2)} MB</Text>
                        </View>
                        <TouchableOpacity onPress={() => {
                            setHelpSheetIndex(0);
                        }}>
                            <Text style={styles.helpText}>Loading stuck for hours? Click here for help :)</Text>
                        </TouchableOpacity>
                    </View>
                </View>
            <RecordingStuckInstructionsSheet index={helpSheetIndex} setIndex={setHelpSheetIndex} />
            </Modal>
        </View>
    );
}

