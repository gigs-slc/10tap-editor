<file path="src/data/podcast/hooks/useInsertPodcastMutation.ts">
import {useMutation, UseMutationResult, useQueryClient} from "@tanstack/react-query";
import {insertPodcastMutation} from "@data/podcast/mutations";
import {Podcast, InsertPodcast} from "@data/podcast/types";

export const useInsertPodcastMutation = () : UseMutationResult<Podcast, Error, InsertPodcast> => {
    const queryClient = useQueryClient()
    return useMutation({
        mutationFn: (newPodcast: InsertPodcast) => insertPodcastMutation(newPodcast),
        onMutate: async (newPodcast: InsertPodcast) => {
            await queryClient.cancelQueries({ queryKey: ['podcast', 'list', 'content', newPodcast.content_id] });

            const previousPodcasts: Podcast[] | undefined = queryClient.getQueryData<Podcast[]>(['podcast', 'list', 'content', newPodcast.content_id])

            const optimisticPodcast: Partial<Podcast> = {
                ...newPodcast,
                podcast_status: 'IN_PROGRESS',
                created_at: new Date().toISOString(),
            };

            queryClient.setQueryData(['podcast', 'list', 'content', newPodcast.content_id],
                (oldData: Podcast[] | undefined) => {
                    if (!oldData) return [optimisticPodcast as Podcast];
                    return [optimisticPodcast as Podcast, ...oldData];
                }
            );
            queryClient.setQueryData(['podcast', 'individual', newPodcast.podcast_id], optimisticPodcast);

            return { previousPodcasts };
        },
        onError: (err, newPodcast, context) => {
            if (context?.previousPodcasts) {
                queryClient.setQueryData(['podcast', 'list', 'content', newPodcast.content_id], context.previousPodcasts);
            }
            queryClient.removeQueries({ queryKey: ['podcast', 'individual', newPodcast.podcast_id] });
        },
        onSuccess: (newPodcast: Podcast) => {
            queryClient.setQueryData(
                ['podcast', 'list', 'content', newPodcast.content_id],
                (oldData: Podcast[] | undefined) => {
                    if (!oldData) return [newPodcast];
                    return oldData.map(podcast =>
                        podcast.podcast_id === newPodcast.podcast_id ? newPodcast : podcast
                    );
                }
            );
            queryClient.setQueryData(['podcast', 'individual', newPodcast.podcast_id], newPodcast);
        }
    });
}
</file>

