import React, { useState, useEffect, useRef } from 'react';
import { View, Text, TouchableOpacity, Animated } from 'react-native';
import { createStyleSheet, useStyles } from "react-native-unistyles";
import { moderateScale } from "react-native-size-matters";
import { windowWidth } from "@/utils/window";
import TrackPlayer, { useActiveTrack, usePlaybackState, useProgress, State } from 'react-native-track-player';
import { Pause, Play } from 'lucide-react-native';
import SkipIcon from './SkipIcon';
import Slider from '@react-native-community/slider';
import SkeletonPlaceholder from "react-native-skeleton-placeholder";
import FastImage from 'react-native-fast-image';

import {Podcast} from "@data/podcast/types";
import { useSinglePodcastRowQuery } from "@data/podcast/hooks/useSinglePodcastRowQuery";

interface PodcastPlayerProps {
    podcast_id: string;
    onViewAllPodcasts: () => void;
    onImageLoad?: () => void;
}

export default function PodcastPlayer({ podcast_id, onViewAllPodcasts, onImageLoad }: PodcastPlayerProps) {
    const { styles, theme } = useStyles(stylesheet);
    const { data: podcast, isPending } = useSinglePodcastRowQuery(podcast_id);
    const [playbackRate, setPlaybackRate] = useState<number>(1.0);
    const fadeAnim = useRef(new Animated.Value(0)).current;
    const progress = useProgress();
    const playbackState = usePlaybackState();
    const activeTrack = useActiveTrack();
    const isPlaying = playbackState.state === State.Playing;

    useEffect(() => {
        const setupTrack = async () => {
            if (!podcast?.completed_audio_url) return;
            
            try {
                // Check if this track is already loaded
                if (activeTrack?.id === podcast.podcast_id) {
                    // Track already loaded
                    return;
                }
                
                // Preload the track
                await TrackPlayer.reset();
                await TrackPlayer.add({
                    id: podcast.podcast_id,
                    url: podcast.completed_audio_url,
                    title: podcast.title || 'Untitled Podcast',
                    artist: 'Turbo',
                    artwork: podcast.cover_art_url || undefined,
                });
            } catch (error) {
                console.error('Error setting up track:', error);
            }
        };
        
        setupTrack();
    }, [podcast, activeTrack]);

    const togglePlayback = async () => {
        if (!podcast) return;
        
        try {
            if (isPlaying) {
                await TrackPlayer.pause();
            } else {
                await TrackPlayer.play();
            }
        } catch (error) {
            console.error('Error toggling playback:', error);
        }
    };

    const cyclePlaybackRate = async () => {
        const rates = [1.0, 1.25, 1.5, 2.0];
        const currentIndex = rates.indexOf(playbackRate);
        const nextIndex = (currentIndex + 1) % rates.length;
        const newRate = rates[nextIndex];
        
        try {
            await TrackPlayer.setRate(newRate);
            setPlaybackRate(newRate);
        } catch (error) {
            console.error('Error setting playback rate:', error);
        }
    };

    const skipForward = async () => {
        try {
            const newPosition = Math.min(progress.position + 10, progress.duration);
            await TrackPlayer.seekTo(newPosition);
        } catch (error) {
            console.error('Error skipping forward:', error);
        }
    };

    const skipBackward = async () => {
        try {
            const newPosition = Math.max(progress.position - 10, 0);
            await TrackPlayer.seekTo(newPosition);
        } catch (error) {
            console.error('Error skipping backward:', error);
        }
    };

    const formatTime = (seconds: number) => {
        const minutes = Math.floor(seconds / 60);
        const remainingSeconds = Math.floor(seconds % 60);
        return `${minutes}:${remainingSeconds.toString().padStart(2, '0')}`;
    };

    const handleSlidingStart = async () => {
        if (isPlaying) {
            await TrackPlayer.pause();
        }
    };

    const handleSlidingComplete = async (value: number) => {
        await TrackPlayer.seekTo(value);
        if (isPlaying) {
            await TrackPlayer.play();
        }
    };

    const fadeIn = () => {
        Animated.timing(fadeAnim, {
            toValue: 1,
            duration: 500,
            useNativeDriver: true,
        }).start();
    };

    if (isPending || !podcast) {
        return (
            <View style={styles.container}>
                <View style={styles.podcastItem}>
                    <View style={styles.coverArtContainer}>
