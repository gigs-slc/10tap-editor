<file path="src/data/collaborator/mutations.ts">
import { getUserAccessToken } from "@/utils/auth";
import { MODAL_URL } from "@/common/environment";

const MODAL_ENDPOINT = MODAL_URL;

export const createCollaboratorAcl = async (
  email: string | null,
  role: string,
  object_id: string,
  object_type: 'content' | 'folder'
) => {
  const accessToken = await getUserAccessToken();
  
  const response = await fetch(`${MODAL_ENDPOINT}-create-collaborator-acl.modal.run`, {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${accessToken}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ email, role, object_id, object_type }),
  });

  if (!response.ok) {
    const errorText = await response.text();
    throw new Error(`Failed to create collaborator: ${errorText}`);
  }

  return response.json();
};
</file>

<file path="src/data/content/hooks/useRealtimeContentSubscription.ts">
import {useQueryClient} from "@tanstack/react-query";
import {useEffect} from "react";
import {subscribeToContent} from "@data/content/subscription";
import {Content} from "@data/content/types";
import {supabase} from "@/utils/supabase";

export function useRealtimeContentSubscription(content_id: string)  {
    const queryClient = useQueryClient()

    useEffect(() => {
        const channel = subscribeToContent(content_id, (newRow : Content) => {

            // Get the existing cached data
            const existingData = queryClient.getQueryData<Content>(['content', 'individual', content_id]);

            // Merge the update with existing data, keeping non-undefined values
            const mergedData = existingData ? {
                ...existingData,
                ...Object.fromEntries(
                    Object.entries(newRow).filter(([_, value]) => value !== undefined)
                )
            } : newRow;

            queryClient.setQueryData(['content', 'individual', content_id], mergedData);

            // Same for the folder list
            queryClient.setQueryData<Content[]>(
                ['content', 'list', 'folder', newRow.folder_id],
                (old = []) =>
                    old.map(item =>
                        item.content_id === newRow.content_id
                            ? { ...item, ...Object.fromEntries(
                                    Object.entries(newRow).filter(([_, value]) => value !== undefined)
                                )}
                            : item
                    )
            )
        })

        return () => {
            supabase.removeChannel(channel)
        }
    }, [content_id])
}
</file>

<file path="src/data/content/hooks/useUpdateContentMutation.ts">
import {useMutation, UseMutationResult, useQueryClient} from "@tanstack/react-query";
import {Content, UpdateContent} from "@data/content/types";
import {updateContentMutation} from "@data/content/mutations";

export const useUpdateContentMutation = (): UseMutationResult<Content, Error, UpdateContent> => {
    const queryClient = useQueryClient()
    return useMutation({
        mutationFn: (newUpdateContent: UpdateContent) => updateContentMutation(newUpdateContent),
        onMutate: async (updates: UpdateContent) => {
            await queryClient.cancelQueries({ queryKey: ['content', 'individual', updates.content_id] });

            const previousContent: Content | undefined = queryClient.getQueryData<Content>(['content', 'individual', updates.content_id]);
            let previousOldFolderList: Content[] | undefined;
            let previousNewFolderList: Content[] | undefined;

            if (previousContent) {
                const optimisticContent: Content = { ...previousContent, ...updates };

                queryClient.setQueryData(['content', 'individual', updates.content_id], optimisticContent);

                if (updates.folder_id !== undefined && updates.folder_id !== previousContent.folder_id) {
                    await queryClient.cancelQueries({ queryKey: ['content', 'list', 'folder', previousContent.folder_id] });
                    await queryClient.cancelQueries({ queryKey: ['content', 'list', 'folder', updates.folder_id] });

                    previousOldFolderList = queryClient.getQueryData<Content[]>(['content', 'list', 'folder', previousContent.folder_id]);
                    previousNewFolderList = queryClient.getQueryData<Content[]>(['content', 'list', 'folder', updates.folder_id]);

                    queryClient.setQueryData(
                        ['content', 'list', 'folder', previousContent.folder_id],
                        (oldData: Content[] | undefined) => {
                            if (!oldData) return [];
                            return oldData.filter(content => content.content_id !== updates.content_id);
                        }
                    );

                    queryClient.setQueryData(
                        ['content', 'list', 'folder', updates.folder_id],
                        (oldData: Content[] | undefined) => {
                            if (!oldData) return [optimisticContent];
                            return [optimisticContent, ...oldData];
                        }
                    );
                } else {
                    await queryClient.cancelQueries({ queryKey: ['content', 'list', 'folder', previousContent.folder_id] });
                    previousOldFolderList = queryClient.getQueryData<Content[]>(['content', 'list', 'folder', previousContent.folder_id]);

                    queryClient.setQueryData(
                        ['content', 'list', 'folder', previousContent.folder_id],
                        (oldData: Content[] | undefined) => {
                            if (!oldData) return [];
                            return oldData.map(content =>
                                content.content_id === updates.content_id ? optimisticContent : content
                            );
                        }
                    );
                }
            }

            return { previousContent, previousOldFolderList, previousNewFolderList };
        },
        onError: (err, updates, context)=> {
            if (context?.previousContent) {
                queryClient.setQueryData(['content', 'individual', updates.content_id], context.previousContent);

                if (context.previousOldFolderList !== undefined) {
                    queryClient.setQueryData(['content', 'list', 'folder', context.previousContent.folder_id], context.previousOldFolderList);
                }
                if (context.previousNewFolderList !== undefined && updates.folder_id !== undefined) {
                    queryClient.setQueryData(['content', 'list', 'folder', updates.folder_id], context.previousNewFolderList);
                }
            }
        },
        onSuccess: (updatedContent: Content) => {
            void queryClient.invalidateQueries({ queryKey: ['content', 'list'] });
            queryClient.setQueryData(['content', 'individual', updatedContent.content_id], updatedContent);
        }
    });
}
</file>

