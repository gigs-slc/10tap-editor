import React, {useState, useEffect} from 'react';
import {View, ScrollView, Text} from 'react-native';
import SkeletonPlaceholder from 'react-native-skeleton-placeholder';
import { windowHeight, windowWidth } from '@/utils/window';
import { createStyleSheet, useStyles } from 'react-native-unistyles';
import Carousel from 'react-native-reanimated-carousel';
import { FlippableCard } from '@/components/notes/insideScreens/Flashcards/FlippableCard';
import Dots from "react-native-dots-pagination";
import {moderateScale} from "react-native-size-matters";
import { useFlashcardRowsQuery } from '@data/flashcards/hooks/useFlashcardRowsQuery';
import { useSingleContentRowQuery } from '@data/content/hooks/useSingleContentRowQuery';
import { postGenerateFlashcards } from '@/utils/node-api';

export default function FlashcardsPage({ contentId }: { contentId: string }) {
    const { styles, theme } = useStyles(stylesheet);
    const [activeDotIndex, setDoteIndex] = useState(0);
    const { data: currentNote } = useSingleContentRowQuery(contentId);
    const { data: flashcards, isPending, refetch } = useFlashcardRowsQuery(contentId);

    useEffect(() => {
        if (currentNote?.content_status === "COMPLETE" && flashcards && flashcards.length === 0) {
            void generateFlashcards();
        }
    }, [currentNote, flashcards]);

    const generateFlashcards = async () => {
        const flashcardsData = await postGenerateFlashcards(contentId);
        if (flashcardsData) {
            await refetch();
        }
    };

    if (isPending || !flashcards) {
        return (
            <View style={styles.loadingContainer}>
                {[1, 2, 3, 4, 5].map(number => (
                    <View style={styles.skeletonWrapper} key={number}>
                        <SkeletonPlaceholder
                            borderRadius={35}
                            backgroundColor={theme.colors.background.SECONDARY}
                            highlightColor={theme.colors.background.TERTIARY}
                        >
                            <SkeletonPlaceholder.Item
                                width={windowWidth * 0.9}
                                height={windowHeight * 0.12}
                                borderRadius={25}
                            />
                        </SkeletonPlaceholder>
                    </View>
                ))}
            </View>
        );
    }

    return (
        <ScrollView contentContainerStyle={{paddingBottom: 100}} showsVerticalScrollIndicator={false} >
            <View style={{marginTop: 15}}/>
            <Carousel
                loop={false}
                width={windowWidth * .8}
                height={windowWidth * 0.65}
                style={styles.carousel}
                defaultIndex={0}
                data={flashcards}
                scrollAnimationDuration={400}
                onSnapToItem={(index) => setDoteIndex(index)}
                renderItem={({ item, index }) => (
                    <View style={styles.carouselItemContainer}>
                        <FlippableCard front={item.front || ""} back={item.back || ""} index={index} />
                    </View>
                )}
            />
            <View style={{marginTop: 10}}/>
            <Dots length={flashcards.length} active={activeDotIndex} passiveColor={'#87898B'}
                  marginHorizontal={2} passiveDotHeight={5} passiveDotWidth={5} activeDotHeight={6} activeDotWidth={6}
                  activeColor={theme.colors.tints.SECONDARY} alignDotsOnXAxis={true} width={windowWidth * .95}/>
            <View style={{marginTop: 10}}/>
            {flashcards.map((flashcard) => {
                return <View style={styles.flashcardBox} key={flashcard.flashcard_id}>
                    <Text style={styles.front}>{flashcard.front}</Text>
                    <Text style={styles.back}>{flashcard.back}</Text>
                </View>
            })}
