export const initialEmojisOptions = ['📚', '📖', '📘', '📝', '✏️', '📕', '📙', '📗', '📓'];

export default function NewFolderSheet({index, setIndex} : { index: number; setIndex: any}) {
    const bottomSheetRef = useRef<BottomSheet>(null);
    const snapPoints = useMemo(() => ["75%"], []);
    const [isEmojiPickerOpen, setEmojiPickerIsOpen] = useState<boolean>(false);
    const { student_id } = useStudentIDQuery();
    const [selectedEmoji, setSelectedEmoji] = useState<string>(
        initialEmojisOptions[Math.floor(Math.random() * initialEmojisOptions.length)]
    );
    const [folderTitle, setFolderTitle] = useState<string>("")
    const { styles, theme } = useStyles(stylesheet);
    const insertFolder = useInsertFolderMutation()

    useEffect(() => {
        if (index < 0) {
            Keyboard.dismiss();
            setFolderTitle("");
        }
    }, [index]);


    const handleSheetChanges = useCallback((index: number) => {
        setIndex(index);
    }, [setIndex]);

    const handleEmojiSelect = useCallback((emoji: EmojiType) => {
        setSelectedEmoji(emoji.emoji)
    }, [])

    const handleCreateNewFolder = async () => {
        if(folderTitle == "") {
            Toast.show({
                type: 'error',
                text1: 'Enter a name for your new folder!',
                text2: 'We don\'t accept empty folders!',
                topOffset: 50,
            });
            return;
        }
        let folder_uuid : string = uuid.v4() as string;
        if(student_id)
            insertFolder.mutate(
            {
                folder_id: folder_uuid,
                title: folderTitle,
                student_id: student_id,
                emoji: selectedEmoji,
                created_at: new Date().toISOString()
            }
        )
        bottomSheetRef.current?.close();
        Keyboard.dismiss();
        setFolderTitle("");
    }

    return (
        <Portal>
        <BottomSheet
            ref={bottomSheetRef}
            index={index}
            backgroundStyle={styles.bottomSheetBackground}
            handleIndicatorStyle={styles.bottomSheetHandleIndicator}
            handleStyle={styles.bottomSheetHandle}
            enablePanDownToClose={true}
            snapPoints={snapPoints}
            onChange={handleSheetChanges}
