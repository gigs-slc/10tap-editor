import {supabase} from "@/utils/supabase";

export const getUserID = async () => {
    const {data: {session }, error} = await supabase.auth.getSession();
    if (error) throw new Error("Could not get user session: " + error.message)
    if (!session) throw new Error("Failed to get user ID from session -> user should be logged out!")
    return session.user.id;
}

export const getUserAccessToken = async () => {
    const {data: {session }, error} = await supabase.auth.getSession();
    if (error) throw new Error("Could not get user session: " + error.message)
    if (!session) {
        throw new Error("Failed to get session -> user should be logged out!")
    }
    return session.access_token;
}
</file>

