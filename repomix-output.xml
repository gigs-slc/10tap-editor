import {moderateVerticalScale} from "react-native-size-matters";
import {windowWidth} from "@/utils/window";
import {heavyHaptic} from "@/utils/haptic";
import QuizMarkdownText from "@/components/notes/insideScreens/Quizzes/QuizMarkdownText";

interface QuizAnswerChoiceProps {
    choice: string;
    index: number;
    questionId: string;
    isSelected: boolean;
    isCorrect: boolean;
    isCurrentQuestionAnswered: boolean;
    correctAnswerStyle: any;
    wrongAnswerStyle: any;
    onPress: (index: number) => void;
}

export default function QuizAnswerChoice({ 
    choice, 
    index, 
    questionId,
    isSelected, 
    isCorrect, 
    isCurrentQuestionAnswered,
    correctAnswerStyle,
    wrongAnswerStyle,
    onPress 
}: QuizAnswerChoiceProps) {
    const { styles } = useStyles(stylesheet);
    const showAsCorrect = isCurrentQuestionAnswered && isCorrect;
    const showAsWrong = isCurrentQuestionAnswered && isSelected && !isCorrect;
    
    return (
        <TouchableOpacity 
            key={`${questionId}-${index}`} 
            style={styles.answerChoiceBoxTouchable} 
            onPress={() => {
                if (!isCurrentQuestionAnswered) {
                    void heavyHaptic();
                    onPress(index);
                }
            }}
            disabled={isCurrentQuestionAnswered}
        >
            <Animated.View style={[
                styles.innerChoiceBox,
                showAsCorrect && correctAnswerStyle,
                showAsWrong && wrongAnswerStyle
            ]}>
                <QuizMarkdownText
                    content={choice}
                    fontSize={13}
                    fontFamily="Sans-Light"
                    textAlign="center"
                    isInteractive={false}
                />
            </Animated.View>
        </TouchableOpacity>
    );
}

