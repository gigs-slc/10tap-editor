<file path="tiptap-extensions/CustomExtensions/comments/commentDataHelpers.ts">
import {Editor} from "@tiptap/core";
import * as Y from 'yjs';
import {CommentData} from "./CommentExtension";
import {relativeToAbsolutePos} from "../utils/usePositionConversions";

/**
 * Helper: convert a Y.Map thread into a plain JS object for rendering
 */
export function threadMapToObj(threadMap: Y.Map<any>): CommentData {
    const replies = threadMap.get('replies') as Y.Array<Y.Map<any>> | undefined;

    return {
        id: threadMap.get('id'),
        author: threadMap.get('author'),
        text: threadMap.get('text'),
        timestamp: threadMap.get('timestamp'),
        resolved: threadMap.get('resolved') || false,
        yRelStart: Y.decodeRelativePosition(threadMap.get('yRelStart')),
        yRelEnd: Y.decodeRelativePosition(threadMap.get('yRelEnd')),
        replies: replies
            ? replies.toArray().map((replyMap: Y.Map<any>) => ({
                id: replyMap.get('id'),
                author: replyMap.get('author'),
                text: replyMap.get('text'),
                timestamp: new Date(replyMap.get('timestamp')),
                attachments: replyMap.get('attachments'),
                turboState: replyMap.get('turboState'),
            }))
            : [],
        attachments: threadMap.get('attachments'),
        turboState: threadMap.get('turboState'),
        isTurboTyping: threadMap.get('isTurboTyping') || false,
        top: 0,
        height: 0
    }
}

/**
 * Get all comments from the Yjs map, optionally filtered by resolved status
 */
export function getFilteredComments(
    commentsMap: Y.Map<Y.Map<any>>,
    showResolved: boolean
): CommentData[] {
    const comments: CommentData[] = [];

    // @ts-ignore
    for (const threadMap of commentsMap.values()) {
        const comment = threadMapToObj(threadMap);
        if (!comment.resolved || showResolved) {
            comments.push(comment);
        }
    }

    return comments;
}

/**
 * Sort comments by their position in the document
 */
export function sortCommentsByPosition(
    comments: CommentData[],
    editor: Editor,
    ydoc: Y.Doc
): CommentData[] {
    return [...comments].sort((a, b) => {
        const aRelStart = a.yRelStart;
        const bRelStart = b.yRelStart;

        try {
            const aFrom = relativeToAbsolutePos(ydoc, editor.state, aRelStart);
            const bFrom = relativeToAbsolutePos(ydoc, editor.state, bRelStart);

            if (!aFrom || !bFrom) {
                return -1;
            }

            return aFrom - bFrom;
        } catch (e) {
            console.error('Error sorting comments:', e);
            return 0;
        }
    });
}

/**
 * Get filtered and sorted comments
 */
export function getSortedComments(
    commentsMap: Y.Map<any>,
    editor: Editor,
    ydoc: Y.Doc,
    showResolved: boolean
): CommentData[] {
    const filtered = getFilteredComments(commentsMap, showResolved);
    return sortCommentsByPosition(filtered, editor, ydoc);
}
</file>

<file path="tiptap-extensions/CustomExtensions/comments/CommentExtension.ts">
import {Extension} from "@tiptap/core"
import {EditorState, Plugin, PluginKey} from "prosemirror-state";
import {ySyncPluginKey} from "@tiptap/y-tiptap";
import {DecorationSet} from "prosemirror-view";
import {Decoration} from "@tiptap/pm/view";
import * as Y from 'yjs'
import {getFilteredComments} from "./commentDataHelpers";
import {absolutePosToRelative, relativeToAbsolutePos} from "../utils/usePositionConversions";
import {Author} from "../..";


/**
 * Application comment interfaces.
 */
export interface Attachment {
    type: 'audio' | 'image';
    url: string;
}

export interface CommentData {
    id: string;
    text: string;
    author: Author;
    replies: CommentReply[];
    resolved: boolean;
    timestamp: Date;
    yRelStart: any;
    yRelEnd: any;
    top: number;
    height?: number;
    attachments?: Attachment[];
    turboState?: string;
    isTurboTyping?: boolean;
}
export interface CommentReply {
    id: string;
    text: string;
    author: Author;
    timestamp: Date;
    attachments?: Attachment[];
    turboState?: string;
}

const commentsPluginKey = new PluginKey("commentsPlugins");

function buildDecorations(
    state: EditorState,          // <— pass the state you are building for
    ydoc: Y.Doc,
    getShowResolved: () => boolean,
): DecorationSet {
    const yState = ySyncPluginKey.getState(state);
    if (!yState) return DecorationSet.empty;

    // Check if document is properly synced before making deletions
    const isSynced = yState.synced;

    // 2. Grab comment threads and filter them
    const commentsMap: Y.Map<Y.Map<any>>  = ydoc.getMap('comments');
    const filteredComments  = getFilteredComments(commentsMap, getShowResolved());

    const cursorPos = state.selection.$head.pos;

    // Collect all comment ranges with their ids
    const commentRanges: { from: number, to: number, id: string, isActive: boolean }[] = [];
    
    filteredComments.forEach(comment => {
        try {
            const from = relativeToAbsolutePos(ydoc, state, comment.yRelStart);
            const to   = relativeToAbsolutePos(ydoc, state, comment.yRelEnd);

            if (from == null || to == null) return;

            const isActive = cursorPos >= from && cursorPos <= to;
            commentRanges.push({ from, to, id: comment.id, isActive });

        } catch (err) {
            console.error(`Error creating decoration for comment ${comment.id}:`, err);
        }
    });

    // Sort ranges by start position, then by end position (larger ranges first)
    commentRanges.sort((a, b) => {
        if (a.from !== b.from) return a.from - b.from;
        return b.to - a.to;
    });

    // Merge overlapping ranges
    const mergedRanges: { from: number, to: number, ids: string[], isActive: boolean }[] = [];
    
    commentRanges.forEach(range => {
        let merged = false;
        
        // Check if this range overlaps with any existing merged range
        for (const mergedRange of mergedRanges) {
            // Check if ranges overlap or are adjacent
            if (range.from <= mergedRange.to && range.to >= mergedRange.from) {
                // Merge the ranges
                mergedRange.from = Math.min(mergedRange.from, range.from);
                mergedRange.to = Math.max(mergedRange.to, range.to);
                mergedRange.ids.push(range.id);
                mergedRange.isActive = mergedRange.isActive || range.isActive;
                merged = true;
                break;
            }
        }
        
        // If not merged with any existing range, add as new
        if (!merged) {
            mergedRanges.push({
                from: range.from,
                to: range.to,
                ids: [range.id],
                isActive: range.isActive
            });
        }
    });

    // Create decorations for each merged range
    const decos: Decoration[] = [];
    mergedRanges.forEach(({ from, to, ids, isActive }) => {
        decos.push(
            Decoration.inline(
                from,
                to,
                {
                    class: isActive
                        ? 'active-comment-highlight'
                        : 'comment-highlight',
                    'data-comment-ids': ids.join(','),
                },
                {ids: ids}
            )
        );
    });

    // 4. Build and return the DecorationSet for the current document
    return DecorationSet.create(state.doc, decos);
}


export const CommentExtension = Extension.create({
    name: 'comments',
    addOptions() {
        return {
            ydoc: Y.Doc,
            setActiveComments: (ids: string[]) => {},
            getShowResolved: () => false,
            disabled: false
        };
    },

    addProseMirrorPlugins() {
        // const pluginKey = new PluginKey('commentsPlugin');
        const { ydoc, getShowResolved, disabled } = this.options
        const editor = this.editor;

        if (disabled) {
            return []
        }

        return [
            new Plugin<DecorationSet>({
                key: commentsPluginKey,
                // we’ll just call decorations() on each update
                state: {
                    init(_, _state) {
                        return buildDecorations(_state, ydoc, getShowResolved)
                    },
                    apply(tr, oldDecos, _old, newState) {
                        let mapped = oldDecos.map(tr.mapping, tr.doc);

                        const needsRefresh =
                            tr.getMeta('comments:showResolvedChanged') ||
                            tr.getMeta('comments:refresh') ||          // <- new line
                            !!tr.getMeta('y-sync$');          // <- new line

                        // Update active highlights
                        if (tr.selectionSet && !tr.docChanged && !needsRefresh) {
                            const {$head} = tr.selection;
                            const updated: Decoration[] = [];

                            mapped.find().forEach(dec => {
                                const isActive = $head.pos >= dec.from && $head.pos <= dec.to;
                                const ids = dec.spec.ids;
                                updated.push(
                                    Decoration.inline(
                                        dec.from,
                                        dec.to,
                                        {
                                            class: isActive
                                                ? "active-comment-highlight"
                                                : "comment-highlight",
                                            'data-comment-ids': ids.join(',')
                                        },
                                        {ids: ids}           // keep the ids stable
                                    )
                                );
                            });

                            return DecorationSet.create(tr.doc, updated)
                        }

                        return needsRefresh
                            ? buildDecorations(newState, ydoc, getShowResolved)
                            : mapped;
                    }
                },
                view(view) {
                    const commentsMap = ydoc.getMap('comments');

                    const observer = () => {
                        view.dispatch(
                            view.state.tr.setMeta('comments:refresh', true)
                        );
                    };

                    commentsMap.observe(observer);
                    return {
                        destroy() { commentsMap.unobserve(observer); }
                    };
                },
                props: {
                    decorations: (state) => {
                        return commentsPluginKey.getState(state) as DecorationSet;
                    }
                },

                /**
                 * appendTransaction
                 *
                 * This handles split line comments and updates relative positions in the Y.map.
                 *
                 * After every document change, collapse each comment’s highlight range,
                 * store the new start/end as Yjs-relative positions (so remote peers stay
                 * in sync and split-line comments remain accurate), then queue a refresh
                 * to repaint the highlights.
                 */
                appendTransaction(trs, _old, newState) {
                    if (!trs.some(tr => tr.docChanged || tr.getMeta('y-sync$'))) return;

                    // New deco set
                    const decoSet = commentsPluginKey.getState(newState) as DecorationSet | undefined;
                    if (!decoSet) return;

                    // Multiple fragments into one - now handling arrays of ids
                    const grouped: Record<string, { from: number; to: number }> = {};
                    decoSet.find().forEach(d => {
                        const ids = d.spec.ids as string[] | undefined;
                        if (!ids || !ids.length) return;

                        // Process each comment id in the decoration
                        ids.forEach(id => {
                            const g = grouped[id];
                            grouped[id] = g
                                ? { from: Math.min(g.from, d.from), to: Math.max(g.to, d.to) }
                                : { from: d.from, to: d.to };
                        });
                    });
                    if (!Object.keys(grouped).length) return;    // nothing to update

                    // New rel ends back to yjs map
                    const ydoc       = ySyncPluginKey.getState(newState)?.doc as Y.Doc | undefined;
                    if (!ydoc) return;
                    const commentMap = ydoc.getMap('comments');

                    ydoc.transact(() => {
                        for (const [id, { from, to }] of Object.entries(grouped)) {
                            const rec = commentMap.get(id) as Y.Map<any> | undefined;
                            if (!rec) continue;

                            rec.set('yRelStart', Y.encodeRelativePosition(absolutePosToRelative(newState, from)));
                            rec.set('yRelEnd',   Y.encodeRelativePosition(absolutePosToRelative(newState, to)));
                        }
                    });

                    return newState.tr.setMeta('comments:refresh', true);
                }
            })
        ];
    },
    // @ts-ignore
    onSelectionUpdate({ editor }) {
        // Skip if the extension is disabled
        if (this.options.disabled) {
            return;
        }
        
        const { from, to } = editor.state.selection;
        const decos = commentsPluginKey.getState(editor.state) as DecorationSet;
        const hit   = decos.find(from, to)
            .find(d => (d.spec as any).ids);
        
        if (hit) {
            const ids = (hit.spec as any).ids;
            this.options.setActiveComments(ids);
        } else {
            this.options.setActiveComments([]);
        }
    },

    // @ts-ignore
    addCommands() {
        return {
            addComment:
                (comment: CommentData) =>
                    // @ts-ignore
                    ({ tr, state, editor }) => {
                        const yState = ySyncPluginKey.getState(state)!;
                        const ydoc   = yState.doc as Y.Doc;
                        const commentsMap = ydoc.getMap('comments');

                        ydoc.transact(() => {
                            const thread = new Y.Map();
                            thread.set('id', comment.id);
                            thread.set('yRelStart', Y.encodeRelativePosition(comment.yRelStart));
                            thread.set('yRelEnd', Y.encodeRelativePosition(comment.yRelEnd));
                            thread.set('author', comment.author);
                            thread.set('text', comment.text);
                            thread.set('timestamp', new Date().toISOString());
                            thread.set('resolved', false);
                            thread.set('attachments', comment.attachments);
                            thread.set('turboState', comment.turboState);
                            thread.set('isTurboTyping', comment.isTurboTyping || false);
                            // @ts-ignore
                            thread.set('replies', new Y.Array<Y.Map>());
                            commentsMap.set(comment.id, thread);
                        });

                        return true;
                    },

            addReply:
                (threadId: string, reply: CommentReply) =>
                    // @ts-ignore
                    ({ state }) => {
                        const yState = ySyncPluginKey.getState(state)!;
                        const ydoc   = yState.doc as Y.Doc;
                        const thread = ydoc.getMap('comments').get(threadId) as Y.Map<any>;
                        if (!thread) return false;

                        ydoc.transact(() => {
                            const replyMap = new Y.Map();
                            replyMap.set('id', reply.id);
                            replyMap.set('text', reply.text);
                            replyMap.set('author', reply.author);
                            replyMap.set('timestamp', reply.timestamp instanceof Date ? reply.timestamp.toISOString() : reply.timestamp);
                            replyMap.set('attachments', reply.attachments);
                            replyMap.set('turboState', reply.turboState);
                            thread.get('replies').push([replyMap]);
                        });

                        return true;
                    },

            resolveComment:
                (threadId: string) =>
                    // @ts-ignore
                    ({ state, tr, dispatch }) => {
                        const yState = ySyncPluginKey.getState(state)!;
                        const ydoc   = yState.doc as Y.Doc;
                        const thread = ydoc.getMap('comments').get(threadId) as Y.Map<any>;
                        if (!thread) return false;

                        ydoc.transact(() => {
                            thread.set('resolved', true);
                        });

                        dispatch(tr.setMeta('comments:refresh', true));
                        return true;
                    },

            unresolveComment:
                (threadId: string) =>
                    // @ts-ignore
                    ({ state, tr, dispatch }) => {
                        const yState = ySyncPluginKey.getState(state)!;
                        const ydoc   = yState.doc as Y.Doc;
                        const thread = ydoc.getMap('comments').get(threadId) as Y.Map<any>;
                        if (!thread) return false;

                        ydoc.transact(() => {
                            thread.set('resolved', false);
                        });

                        dispatch(tr.setMeta('comments:refresh', true));
                        return true;
                    },
            
            deleteComment:
                (threadId: string) =>
                    // @ts-ignore
                    ({ state, tr, dispatch }) => {
                        const yState = ySyncPluginKey.getState(state)!;
                        const ydoc   = yState.doc as Y.Doc;
                        const commentMap = ydoc.getMap('comments');
                        
                        if (!commentMap.has(threadId)) return false;

                        ydoc.transact(() => {
                            commentMap.delete(threadId);
                        });
                        dispatch(tr.setMeta('comments:refresh', true));

                        return true;
                    },
                    
            refreshComments:
                () =>
                    //@ts-ignore
                    ({ tr, dispatch }) => {
                        dispatch(tr.setMeta('comments:refresh', true));
                        return true;
                    },
        };
    },
})
</file>

