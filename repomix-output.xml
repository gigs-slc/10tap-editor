import React, { useState, useEffect } from 'react';
import { View, ScrollView, TextInput, Keyboard } from 'react-native';
import { Text } from '@/common/generics/Text';
import { languagesArray } from '@/common/data/languages';
import { onboardingStyles as onboardingStylesheet } from '@/common/styles/onboarding';
import { moderateScale } from 'react-native-size-matters';
import { heavyHaptic } from '@/utils/haptic';
import LanguageRow from '@/components/login/languageRow';
import { usePostHog } from 'posthog-react-native';
import { useAtom } from 'jotai';
import { onboardingDataAtom } from '@/utils/atoms';
import { createStyleSheet, useStyles } from 'react-native-unistyles';

interface LanguageSelectionScreenProps {
    onNext: (language?: string) => void;
}

export default function LanguageSelectionScreen({ onNext }: LanguageSelectionScreenProps) {
    const [search, setSearch] = useState("");
    const [filteredLanguages, setFilteredLanguages] = useState(languagesArray);
    const posthog = usePostHog();
    const [onboardingData, setOnboardingData] = useAtom(onboardingDataAtom);
    const { styles } = useStyles(stylesheet);
    const { styles: onboardingStyles } = useStyles(onboardingStylesheet);

    useEffect(() => {
        const filtered = languagesArray
            .filter(language =>
                language.name.toLowerCase().includes(search.toLowerCase())
            )
            .sort((a, b) => {
                // English
                if (a.code === 'en') return -1;
                if (b.code === 'en') return 1;
                // Spanish
                if (a.code === 'es') return -1;
                if (b.code === 'es') return 1;
                // Rest alphabetically
                return a.name.localeCompare(b.name);
            });
        setFilteredLanguages(filtered);
    }, [search]);

    const handlePress = (languageCode: string) => {
        void heavyHaptic();
        const selectedLanguage = languagesArray.find(lang => lang.code === languageCode);
        posthog.capture('User selected language', {
            languageCode: languageCode,
            languageName: selectedLanguage ? selectedLanguage.name : 'Unknown'
        });
        setOnboardingData((prev) => {
            return { ...prev, languageCode, selectedLanguage: selectedLanguage?.name }
        });
        onNext(languageCode);
    };

    const handleScroll = () => {
        Keyboard.dismiss();
    };

    return (
        <View style={styles.container}>
            <Text style={onboardingStyles.title}>What language would you like your notes in?</Text>
            
            <TextInput
                value={search}
                onChangeText={setSearch}
                style={[styles.textInput]}
                placeholder={'Search language...'}
                placeholderTextColor={'#8c8c8c'}
            />
            
            <ScrollView 
                style={styles.scrollView} 
                showsVerticalScrollIndicator={false}
                onScrollBeginDrag={handleScroll}
            >
                {filteredLanguages.map((language) => (
                    <LanguageRow
                        key={language.code}
                        language={language}
                        handlePress={handlePress}
                    />
                ))}
            </ScrollView>
        </View>
    );
}

const stylesheet = createStyleSheet((theme) => ({
    container: {
        marginTop: 10,
        flex: 1,
    },
    scrollView: {
        flex: 1,
        marginTop: 10,
    },
    textInput: {
        paddingVertical: 20,
        borderRadius: 20,
        alignSelf: 'center',
        width: {
            xs: '90%',
            md: '100%'
        },
        paddingHorizontal: 20,
