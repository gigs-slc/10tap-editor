const PodcastImage = ({ podcast, styles, theme }: { podcast: Podcast; styles: any; theme: any }) => {
    const [loaded, setLoaded] = useState(false);
    const opacity = useSharedValue(0);
    
    const animatedStyle = useAnimatedStyle(() => ({
        opacity: opacity.value
    }));
    
    useEffect(() => {
        if (loaded) {
            opacity.value = withTiming(1, { duration: 500 });
        }
    }, [loaded]);
    
    return (
        <>
            {!loaded && (
                <SkeletonPlaceholder
                    backgroundColor={theme.colors.background.SECONDARY}
                    highlightColor={theme.colors.background.TERTIARY}
                >
                    <SkeletonPlaceholder.Item 
                        width={moderateScale(50)} 
                        height={moderateScale(50)} 
                        borderRadius={moderateScale(8)} 
                        marginRight={moderateScale(12)} 
                    />
                </SkeletonPlaceholder>
            )}
            <Animated.Image 
                source={{ uri: podcast.cover_art_url || '@/../assets/images/logo.png' }} 
                style={[
                    styles.podcastCoverArt,
                    !loaded && { position: 'absolute', opacity: 0 },
                    animatedStyle
                ]}
                onLoadEnd={() => setLoaded(true)}
            />
        </>
    );
};

interface AllPodcastsModalProps {
    visible: boolean;
    onClose: () => void;
    podcasts: Podcast[] | null | undefined;
    onSelectPodcast: (podcastId: string) => void;
    onSelectCreate: () => void;
    isLoading?: boolean;
}

export default function AllPodcastsModal({
    visible,
    onClose,
    podcasts,
    onSelectPodcast,
    onSelectCreate,
    isLoading = false
}: AllPodcastsModalProps) {
    const { styles, theme } = useStyles(stylesheet);

    const completedPodcasts = podcasts?.filter(podcast => podcast.podcast_status === "COMPLETE") || [];



    const renderSkeletonPodcast = () => (
        <SkeletonPlaceholder
            backgroundColor={theme.colors.background.SECONDARY}
            highlightColor={theme.colors.background.TERTIARY}
        >
            <SkeletonPlaceholder.Item flexDirection="row" alignItems="center" padding={moderateScale(12)} borderRadius={moderateScale(12)} marginBottom={moderateScale(12)}>
                <SkeletonPlaceholder.Item width={moderateScale(50)} height={moderateScale(50)} borderRadius={moderateScale(8)} marginRight={moderateScale(12)} />
                <SkeletonPlaceholder.Item flex={1}>
                    <SkeletonPlaceholder.Item width="80%" height={moderateScale(20)} borderRadius={moderateScale(4)} marginBottom={moderateScale(8)} />
                    <SkeletonPlaceholder.Item width="60%" height={moderateScale(16)} borderRadius={moderateScale(4)} />
                </SkeletonPlaceholder.Item>
                <SkeletonPlaceholder.Item width={moderateScale(24)} height={moderateScale(24)} borderRadius={moderateScale(12)} />
            </SkeletonPlaceholder.Item>
        </SkeletonPlaceholder>
    );

    const handlePodcastSelect = (podcastId: string) => {
        void heavyHaptic();
        onSelectPodcast(podcastId);
        onClose();
    };

    const handleCreateNew = () => {
        void heavyHaptic();
        onSelectCreate();
        onClose();
    };

    return (
        <Modal
            animationType="fade"
            transparent={true}
            visible={visible}
            onRequestClose={onClose}
        >
            <View style={styles.modalOverlay}>
                <View style={styles.modalContent}>
                    <View style={{ marginTop: Constants.statusBarHeight }} />
                    <Text style={styles.modalTitle}>All Podcasts 🎙️</Text>
                    
                    <ScrollView style={styles.podcastsScroll} showsVerticalScrollIndicator={false} contentContainerStyle={styles.scrollContent}>
                        <TouchableOpacity
                            style={styles.createNewButton}
                            onPress={handleCreateNew}
                        >
                            <Ionicons name="add-circle" size={24} color={theme.colors.text.PRIMARY} />
                            <Text style={styles.createNewText}>Create New Podcast</Text>
                        </TouchableOpacity>

                        {isLoading ? (
                            <>
                                {renderSkeletonPodcast()}
                                {renderSkeletonPodcast()}
                                {renderSkeletonPodcast()}
                            </>
                        ) : (
                            completedPodcasts.map((podcast: Podcast) => (
                                <TouchableOpacity
                                    key={podcast.podcast_id}
                                    style={styles.podcastCard}
                                    onPress={() => handlePodcastSelect(podcast.podcast_id)}
                                >
                                    <PodcastImage podcast={podcast} styles={styles} theme={theme} />
                                    <View style={styles.podcastCardContent}>
                                        <Text style={styles.podcastTitle}>
                                            {podcast.title || 'Podcast Generation in Progress'}
                                        </Text>
                                        <Text style={styles.podcastDate}>
                                            Created on {formatNoteTimestamp(podcast.created_at)}
                                        </Text>
                                    </View>
                                    <Ionicons name="chevron-forward" size={24} color={theme.colors.text.SECONDARY} />
                                </TouchableOpacity>
                            ))
                        )}
                    </ScrollView>
                    
                    <BasicButton
                        onPress={() => {
                            void heavyHaptic();
                            onClose();
                        }}
                        backgroundColor={theme.colors.tints.PRIMARY}
                        text={'Close'}
                        style={styles.closeButton}
                    />
                </View>
            </View>
        </Modal>
    );
}

