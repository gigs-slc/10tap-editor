<file path="src/components/notes/insideScreens/Podcasts/LengthDropdown.tsx">
import { View, Text, TouchableOpacity, FlatList, Modal } from 'react-native';
import { createStyleSheet, useStyles } from 'react-native-unistyles';
import { moderateScale } from 'react-native-size-matters';
import { windowWidth, windowHeight } from '@/utils/window';
import React, { useState, useEffect } from 'react';
import {useAtom} from "jotai";
import {isPayingOnWebAtom} from "@/utils/atoms";
import Superwall, { SubscriptionStatus } from "expo-superwall/compat";
import { MaterialCommunityIcons } from '@expo/vector-icons';

export interface LengthOption {
  value: 'short' | 'medium' | 'long';
  label: string;
}

export interface LengthDropdownProps {
  selectedLength: 'short' | 'medium' | 'long';
  setSelectedLength: React.Dispatch<React.SetStateAction<'short' | 'medium' | 'long'>>;
}

const lengthOptions: LengthOption[] = [
  { value: 'short', label: 'Short (5-15 minutes)' },
  { value: 'medium', label: 'Medium (15-30 minutes)' },
  { value: 'long', label: 'Long (30+ minutes)' },
];

export default function LengthDropdown({ selectedLength, setSelectedLength }: LengthDropdownProps) {
  const { styles, theme } = useStyles(stylesheet);
  const [modalVisible, setModalVisible] = useState(false);
  const [isPayingOnWeb] = useAtom(isPayingOnWebAtom);
  const [subscriptionStatus, setSubscriptionStatus] = useState<SubscriptionStatus | null>(null);

  useEffect(() => {
    const checkSubscription = async () => {
      const status = await Superwall.shared.getSubscriptionStatus();
      setSubscriptionStatus(status);
    };
    void checkSubscription();
  }, []);

  const toggleModal = () => setModalVisible(!modalVisible);

  const selectedOption = lengthOptions.find(option => option.value === selectedLength);


  const handleLengthSelection = async (value: 'short' | 'medium' | 'long') => {
    if (value === 'medium' || value === 'long') {
      const subscriptionStatus = await Superwall.shared.getSubscriptionStatus();
      if (!isPayingOnWeb && (subscriptionStatus !== SubscriptionStatus.ACTIVE)) {
        void Superwall.shared.register({ placement: "not_enough_credits", feature: async () => {
          setSelectedLength('short');
        }})
      }
    }
    setSelectedLength(value);
    toggleModal();
  };

  return (
    <>
      <TouchableOpacity
        style={styles.trigger}
        onPress={toggleModal}
      >
        <Text style={styles.triggerText}>
          {selectedOption?.label || 'Select length'}
        </Text>
      </TouchableOpacity>

      <Modal
        visible={modalVisible}
        transparent
        animationType="fade"
        onRequestClose={toggleModal}
      >
        <TouchableOpacity
          style={styles.overlay}
          activeOpacity={1}
          onPressOut={toggleModal}
        >
          <View style={styles.content}>            
            <FlatList
              showsVerticalScrollIndicator={false}
              data={lengthOptions}
              keyExtractor={(item) => item.value}
              renderItem={({ item }) => (
                <TouchableOpacity
                  style={styles.item}
                  onPress={() => handleLengthSelection(item.value)}
                >
                  <View style={styles.itemContent}>
                    <Text style={styles.itemText}>{item.label}</Text>
                    {(item.value === 'medium' || item.value === 'long') && !isPayingOnWeb && subscriptionStatus !== SubscriptionStatus.ACTIVE && (
                      <MaterialCommunityIcons
                        name="crown" 
                        size={moderateScale(20)} 
                        color={theme.colors.tints.PRIMARY} 
                      />
                    )}
                  </View>
                </TouchableOpacity>
              )}
            />
          </View>
        </TouchableOpacity>
      </Modal>
    </>
  );
}

const stylesheet = createStyleSheet((theme) => ({
  trigger: {
    backgroundColor: theme.colors.background.SECONDARY,
    width: '100%',
    paddingVertical: moderateScale(15),
    paddingHorizontal: moderateScale(15),
    borderRadius: moderateScale(10),
    borderWidth: 1,
    borderColor: theme.colors.background.TERTIARY,
    alignItems: 'center',
  },
  triggerText: {
    fontSize: moderateScale(14),
    fontFamily: 'Sans-Light',
    color: theme.colors.text.PRIMARY,
  },
  overlay: {
    flex: 1,
    backgroundColor: 'rgba(0,0,0,0.5)',
    justifyContent: 'center',
    alignItems: 'center',
  },
  content: {
    backgroundColor: theme.colors.background.PRIMARY,
    width: windowWidth * 0.8,
    maxHeight: windowHeight * 0.6,
    borderRadius: moderateScale(15),
    overflow: 'hidden',
  },
  item: {
    paddingVertical: moderateScale(15),
    paddingHorizontal: moderateScale(15),
    borderBottomWidth: 1,
    borderBottomColor: theme.colors.background.TERTIARY,
  },
  itemContent: {
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'space-between',
  },
  itemText: {
    fontSize: moderateScale(14),
    fontFamily: 'Sans-Light',
    color: theme.colors.text.PRIMARY,
  },
}));
