<file path="app/home/accountInfo.tsx">
import React from 'react';
import {
    View,
    Text,
    Image,
    ScrollView,
    Alert,
    TouchableOpacity
} from 'react-native';
import { createStyleSheet, useStyles } from 'react-native-unistyles';
import { moderateScale } from 'react-native-size-matters';
import { format } from 'date-fns';
import Constants from 'expo-constants';
import * as Clipboard from 'expo-clipboard';
import BackHeader from '@/common/components/headers/backHeader';
import UnsafeContainer from '@/common/generics/UnsafeContainer';
import { useCurrentStudentRowQuery } from '@data/student/hooks/useStudentRowQuery';
import Toast from 'react-native-toast-message';
import { useAtom } from 'jotai';
import { isPayingOnWebAtom } from '@/utils/atoms';
import SkeletonPlaceholder from "react-native-skeleton-placeholder";

export default function AccountInfo() {
    const { styles, theme } = useStyles(stylesheet);
    const { data: student, isLoading: studentLoading, error: studentError } = useCurrentStudentRowQuery();
    const [subscriptionActive] = useAtom(isPayingOnWebAtom);

    if (studentLoading) {
        return (
            <UnsafeContainer style={styles.container}>
                <View style={{ marginTop: Constants.statusBarHeight }} />
                <BackHeader title="Account Info" textStyle={{}} />
                <ScrollView 
                    style={styles.scrollView} 
                    showsVerticalScrollIndicator={false}
                    contentContainerStyle={styles.scrollContent}
                >
                    <View style={styles.content}>
                        <SkeletonPlaceholder
                            backgroundColor={theme.colors.background.SECONDARY}
                            highlightColor={theme.colors.background.TERTIARY}
                        >
                            {/* Profile Section Skeleton */}
                            <View style={styles.profileSection}>
                                <SkeletonPlaceholder.Item 
                                    width={120} 
                                    height={120} 
                                    borderRadius={60}
                                    alignSelf="center"
                                    marginBottom={20}
                                />
                                <SkeletonPlaceholder.Item 
                                    width={180} 
                                    height={28} 
                                    borderRadius={4}
                                    alignSelf="center"
                                    marginBottom={8}
                                />
                                <SkeletonPlaceholder.Item 
                                    width={220} 
                                    height={20} 
                                    borderRadius={4}
                                    alignSelf="center"
                                    marginBottom={30}
                                />
                            </View>

                            {/* Info Cards Skeleton */}
                            <View style={{ gap: 16 }}>
                                {[1, 2, 3, 4].map((index) => (
                                    <View key={index} style={styles.infoCard}>
                                        <SkeletonPlaceholder.Item 
                                            width={100} 
                                            height={16} 
                                            borderRadius={4}
                                            marginBottom={12}
                                        />
                                        <SkeletonPlaceholder.Item 
                                            width="80%" 
                                            height={20} 
                                            borderRadius={4}
                                        />
                                    </View>
                                ))}
                            </View>
                        </SkeletonPlaceholder>
                    </View>
                </ScrollView>
            </UnsafeContainer>
        );
    }

    if (studentError || !student) {
        return (
            <UnsafeContainer style={styles.container}>
                <View style={{ marginTop: Constants.statusBarHeight }} />
                <BackHeader title="Account Info" textStyle={{}} />
                <View style={styles.errorContainer}>
                    <Text style={styles.errorText}>Failed to load account information</Text>
                    <Text style={styles.errorSubtext}>Please try again later</Text>
                </View>
            </UnsafeContainer>
        );
    }

    const formatDate = (dateString: string) => {
        try {
            return format(new Date(dateString), 'MMMM d, yyyy');
        } catch (error) {
            return 'Invalid date';
        }
    };

    const getSubscriptionStatusText = () => {
        if (subscriptionActive === null) return 'Checking...';
        return subscriptionActive ? 'Premium' : 'Free';
    };

    const getSubscriptionStatusColor = () => {
        if (subscriptionActive === null) return theme.colors.grays.PRIMARY;
        return subscriptionActive ? '#4CAF50' : theme.colors.grays.PRIMARY;
    };

    const getSubscriptionTextColor = () => {
        const statusText = getSubscriptionStatusText();
        if (statusText === 'Free') {
            return theme.colors.grays.PRIMARY === '#dedede' ? '#000000' : '#ffffff';
        } else {
            return 'white';
        }
    };

    const copyUserIdToClipboard = async () => {
        if (student?.student_id) {
            await Clipboard.setStringAsync(student.student_id);
            Toast.show({
                type: 'success',
                text1: 'User ID copied to clipboard',
                text2: 'Ready to share with customer support',
                topOffset: 50,
            });
        }
    };

    return (
        <UnsafeContainer style={styles.container}>
            <View style={{ marginTop: Constants.statusBarHeight }} />
            <BackHeader title="" textStyle={{}} />
            <ScrollView 
                style={styles.scrollView} 
                showsVerticalScrollIndicator={false}
                contentContainerStyle={styles.scrollContent}
            >
                <View style={styles.content}>
                    
                    {/* Profile Section */}
                    <View style={styles.profileSection}>
                        <View style={styles.profileImageContainer}>
                            {student.profile_picture_url ? (
                                <Image 
                                    source={{ uri: student.profile_picture_url }} 
                                    style={styles.profileImage}
                                />
                            ) : (
                                <View style={[styles.defaultProfileImage, { backgroundColor: theme.colors.tints.PRIMARY }]}>
                                    <Text style={styles.defaultProfileText}>
                                        {student.full_name ? student.full_name.charAt(0).toUpperCase() : '?'}
                                    </Text>
                                </View>
                            )}
                        </View>
                        <Text style={styles.fullName}>
                            {student.full_name || 'No name provided'}
                        </Text>
                    </View>

                    {/* Account Details Section */}
                    <View style={styles.detailsSection}>
                        <Text style={styles.sectionTitle}>Account Details</Text>
                        
                        {/* Email */}
                        <View style={styles.detailRow}>
                            <View style={styles.detailIconContainer}>
                                <Text style={styles.detailIcon}>📧</Text>
                            </View>
                            <View style={styles.detailContent}>
                                <Text style={styles.detailLabel}>Email</Text>
                                <Text style={styles.detailValue}>
                                    {student.email || 'No email provided'}
                                </Text>
                            </View>
                        </View>

                        {/* Subscription Status */}
                        <View style={styles.detailRow}>
                            <View style={styles.detailIconContainer}>
                                <Text style={styles.detailIcon}>💎</Text>
                            </View>
                            <View style={styles.detailContent}>
                                <Text style={styles.detailLabel}>Subscription</Text>
                                <View style={styles.subscriptionContainer}>
                                    <View style={[styles.subscriptionBadge, { backgroundColor: getSubscriptionStatusColor() }]}>
                                        <Text style={[styles.subscriptionText, { color: getSubscriptionTextColor() }]}>
                                            {getSubscriptionStatusText()}
                                        </Text>
                                    </View>
                                </View>
                            </View>
                        </View>

                        {/* Account Created */}
                        <View style={styles.detailRow}>
                            <View style={styles.detailIconContainer}>
                                <Text style={styles.detailIcon}>📅</Text>
                            </View>
                            <View style={styles.detailContent}>
                                <Text style={styles.detailLabel}>Member Since</Text>
                                <Text style={styles.detailValue}>
                                    {formatDate(student.created_at)}
                                </Text>
                            </View>
                        </View>

                        {/* Additional Info if available */}
                        {student.university_id && (
                            <View style={styles.detailRow}>
                                <View style={styles.detailIconContainer}>
                                    <Text style={styles.detailIcon}>🎓</Text>
                                </View>
                                <View style={styles.detailContent}>
                                    <Text style={styles.detailLabel}>University</Text>
                                    <Text style={styles.detailValue}>
                                        {student.university_id}
                                    </Text>
                                </View>
                            </View>
                        )}

                        {student.major && (
                            <View style={styles.detailRow}>
                                <View style={styles.detailIconContainer}>
                                    <Text style={styles.detailIcon}>📚</Text>
                                </View>
                                <View style={styles.detailContent}>
                                    <Text style={styles.detailLabel}>Major</Text>
                                    <Text style={styles.detailValue}>
                                        {student.major}
                                    </Text>
                                </View>
                            </View>
                        )}
                    </View>
                </View>
            </ScrollView>
            
            {/* Customer Support Section - Fixed at bottom */}
            <TouchableOpacity 
                style={styles.supportButton} 
                onPress={copyUserIdToClipboard}
                activeOpacity={0.7}
            >
                <Text style={styles.supportText}>Customer Support: Copy User ID</Text>
            </TouchableOpacity>
        </UnsafeContainer>
    );
}

const stylesheet = createStyleSheet((theme) => ({
    container: {
        backgroundColor: theme.colors.background.PRIMARY,
        flex: 1,
    },
    scrollView: {
        flex: 1,
    },
    scrollContent: {
        paddingBottom: moderateScale(80), // Add space for the fixed button
    },
    content: {
        padding: moderateScale(20),
    },
    loadingContainer: {
        flex: 1,
        justifyContent: 'center',
        alignItems: 'center',
    },
    loadingText: {
        marginTop: moderateScale(12),
        fontSize: moderateScale(16),
        color: theme.colors.text.PRIMARY,
        fontFamily: 'Sans-Medium',
    },
    errorContainer: {
        flex: 1,
        justifyContent: 'center',
        alignItems: 'center',
        paddingHorizontal: moderateScale(20),
    },
    errorText: {
        fontSize: moderateScale(18),
        color: theme.colors.text.PRIMARY,
        fontFamily: 'Sans-Bold',
        textAlign: 'center',
        marginBottom: moderateScale(8),
    },
    errorSubtext: {
        fontSize: moderateScale(14),
        color: theme.colors.grays.PRIMARY,
        fontFamily: 'Sans-Regular',
        textAlign: 'center',
