import {useMutation, useQueryClient, UseMutationResult} from "@tanstack/react-query";
import {updateFolderMutation} from "@data/folders/mutations";
import {Folder, UpdateFolder} from "@data/folders/types";


export const useUpdateFolderMutation = (): UseMutationResult<Folder, Error, UpdateFolder> => {
    const queryClient = useQueryClient();
    return useMutation({
        mutationFn: (updatedFolder: UpdateFolder) => updateFolderMutation(updatedFolder),
        onMutate: async (updates: UpdateFolder) => {
            await queryClient.cancelQueries({ queryKey: ['folder', 'individual', updates.folder_id] });
            await queryClient.cancelQueries({ queryKey: ['folder', 'list'] });

            const previousFolder : Folder | undefined = queryClient.getQueryData<Folder>(['folder', 'individual', updates.folder_id]);
            const previousFolders : Folder[] | undefined = queryClient.getQueryData<Folder[]>(['folder', 'list']);

            if (previousFolder) {
                const optimisticFolder : Folder = { ...previousFolder, ...updates };

                queryClient.setQueryData(['folder', 'individual', updates.folder_id], optimisticFolder);

                queryClient.setQueryData(
                    ['folder', 'list'],
                    (oldData: Folder[] | undefined) => {
                        if (!oldData) return [];
                        return oldData.map(folder =>
                            folder.folder_id === updates.folder_id ? optimisticFolder : folder
                        );
                    }
                );
            }
            return { previousFolder, previousFolders };
        },
        onError: (err, updates, context) => {
            if (context?.previousFolder) {
                queryClient.setQueryData(['folder', 'individual', updates.folder_id], context.previousFolder);
            }
            if (context?.previousFolders) {
                queryClient.setQueryData(['folder', 'list'], context.previousFolders);
            }
        },
        onSuccess: (updatedFolder: Folder) => {
            queryClient.setQueryData(
                ['folder', 'list'],
                (oldData: Folder[] | undefined) => {
                    if (!oldData) return [];
                    return oldData.map(folder =>
                        folder.folder_id === updatedFolder.folder_id ? updatedFolder : folder
                    );
                }
            );
            queryClient.setQueryData(['folder', 'individual', updatedFolder.folder_id], updatedFolder);
        }

    });
}
