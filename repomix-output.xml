<file path="src/data/podcast/hooks/useRealtimePodcastSubscription.ts">
import {useQueryClient} from "@tanstack/react-query";
import {useEffect} from "react";
import {subscribeToPodcast} from "@data/podcast/subscription";
import {Podcast} from "@data/podcast/types";
import {supabase} from "@/utils/supabase";

export function useRealtimePodcastSubscription(podcast_id: string)  {
    const queryClient = useQueryClient()

    useEffect(() => {
        const channelId= subscribeToPodcast(podcast_id, (newRow : Podcast) => {
            queryClient.setQueryData(['podcast', 'individual', newRow.podcast_id], newRow)
            queryClient.setQueryData<Podcast[]>(
                ['podcast', 'list', 'content', newRow.content_id],
                (old = []) =>
                    old.map(item =>
                        item.podcast_id === newRow.podcast_id ? newRow : item
                    )
            )
        })

        return () => {
            supabase.removeChannel(channelId)
        }
    }, [podcast_id]);
}
