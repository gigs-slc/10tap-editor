import React from 'react';
import { View, ScrollView } from 'react-native';
import SkeletonPlaceholder from "react-native-skeleton-placeholder";
import { moderateScale } from "react-native-size-matters";
import { windowWidth } from "@/utils/window";
import { createStyleSheet, useStyles } from "react-native-unistyles";
import Animated, { Easing, SharedValue, useAnimatedStyle, withTiming } from "react-native-reanimated";

interface PodcastSkeletonProps {
    opacity: SharedValue<number>;
}

export default function PodcastSkeleton({ opacity }: PodcastSkeletonProps) {
    const { styles, theme } = useStyles(stylesheet);

    const config = {
        duration: 500,
        easing: Easing.bezier(0.5, 0.01, 0, 1),
    };

    const opacityStyle = useAnimatedStyle(() => {
        return {
            opacity: withTiming(opacity.value, config),
        };
    });

    return (
        <Animated.View style={[styles.container, opacityStyle]}>
            <ScrollView style={styles.podcastContainer} showsVerticalScrollIndicator={false}>
                <View style={[styles.podcastItem, { width: '95%', alignSelf: 'center' }]}>
                    <SkeletonPlaceholder
                        backgroundColor={theme.colors.background.SECONDARY}
                        highlightColor={theme.colors.background.TERTIARY}
                    >
                        <SkeletonPlaceholder.Item 
                            width={windowWidth * 0.8} 
                            height={windowWidth * 0.8} 
                            borderRadius={moderateScale(10)}
                            marginTop={moderateScale(10)}
                            marginBottom={moderateScale(20)}
                            alignSelf="center"
                        />
                        <SkeletonPlaceholder.Item 
                            width="70%" 
                            height={moderateScale(24)} 
                            borderRadius={moderateScale(5)}
                            marginBottom={moderateScale(10)}
                            alignSelf="center"
                        />
                        <SkeletonPlaceholder.Item 
                            width="80%" 
                            height={moderateScale(40)} 
                            borderRadius={moderateScale(8)}
                            marginBottom={moderateScale(15)}
                            alignSelf="center"
                        />
                        <SkeletonPlaceholder.Item 
                            width="90%" 
                            height={moderateScale(4)} 
                            borderRadius={moderateScale(2)}
                            marginBottom={moderateScale(20)}
                            alignSelf="center"
                        />
                        <SkeletonPlaceholder.Item 
                            flexDirection="row"
                            justifyContent="center"
                            alignItems="center"
                            marginBottom={moderateScale(10)}
                        >
                            <SkeletonPlaceholder.Item 
                                width={moderateScale(40)} 
                                height={moderateScale(40)} 
                                borderRadius={moderateScale(8)}
                                marginRight={moderateScale(20)}
                            />
                            <SkeletonPlaceholder.Item 
                                width={moderateScale(50)} 
                                height={moderateScale(50)} 
                                borderRadius={moderateScale(8)}
                                marginHorizontal={moderateScale(20)}
                            />
                            <SkeletonPlaceholder.Item 
                                width={moderateScale(40)} 
                                height={moderateScale(40)} 
                                borderRadius={moderateScale(8)}
                                marginLeft={moderateScale(20)}
                            />
                        </SkeletonPlaceholder.Item>
                    </SkeletonPlaceholder>
                </View>
            </ScrollView>
        </Animated.View>
    );
}

const stylesheet = createStyleSheet((theme) => ({
    container: {
        backgroundColor: theme.colors.background.PRIMARY,
        flex: 1,
        alignItems: 'center',
        width: '100%',
    },
    podcastContainer: {
        width: '100%',
    },
    podcastItem: {
        backgroundColor: theme.colors.background.PRIMARY,
        borderRadius: moderateScale(15),
        padding: moderateScale(10),
        marginTop: moderateScale(10),
        marginBottom: moderateScale(15),
        alignItems: 'center',
        shadowColor: '#000',
        shadowOffset: {
            width: 0,
            height: 2,
        },
        shadowOpacity: 0.1,
        shadowRadius: 4,
        elevation: 4,
        borderWidth: 1,
        borderColor: theme.colors.background.QUATERNARY,
    },
}));
