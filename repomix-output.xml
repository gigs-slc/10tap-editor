import {Audio, InterruptionModeIOS} from 'expo-av';
import { ExpoAudioStreamModule } from '@siteed/expo-audio-studio';
import React, { useEffect, useState } from 'react';
import { ColorSchemeName, Platform, TouchableOpacity, useColorScheme, View } from 'react-native';
import { windowHeight, windowWidth } from '@/utils/window';
import { Text } from '@/common/generics/Text';
import { moderateScale } from 'react-native-size-matters';
import Toast from 'react-native-toast-message';
import { router } from 'expo-router';
import uuid from 'react-native-uuid';
import {uploadAudioFileTUS} from '@/utils/tus';
import { DocumentPickerAsset, DocumentPickerResult } from 'expo-document-picker';
import * as DocumentPicker from 'expo-document-picker';
import UnsafeContainer from '@/common/generics/UnsafeContainer';
import Constants from 'expo-constants';
import FastImage from 'react-native-fast-image';
import BasicButton from '@/common/components/buttons/basicButton';
import { heavyHaptic } from '@/utils/haptic';
import AudioUploadingModal from '@/common/components/modals/audioUploadingModal';
import UploadSVG from '@/../assets/svgs/notes/upload.svg';
import {createStyleSheet, useStyles} from "react-native-unistyles";
import {formatAudioDuration} from "@/utils/general";
import AudioControls from "@/components/record/audioControlsButton";
import RecordBackHeader from "@/common/components/headers/recordBackHeader";
import Animated, {useAnimatedStyle, useSharedValue, withTiming} from "react-native-reanimated";
import {useStudentIDQuery} from "@data/student/hooks/useStudentIDQuery";
import {useInsertContentMutation} from "@data/content/hooks/useInsertContentMutation";
import { useEnhancedAudioRecorder } from '@/services/EnhancedAudioRecordingService';
import { recordingBackupService } from '@/services/RecordingBackupService';
import { cleanupWavFiles } from '@/utils/wavConcatenation';
import LottieView from 'lottie-react-native';

import SuperWhisperBarsVisualizer from '@/common/components/recording/SuperWhisperBarsVisualizer';

export default function RecordPage() {
    const { student_id } = useStudentIDQuery();
    const [permissionResponse, requestPermission] = Audio.usePermissions();
    const [loading, setLoading] = useState(false);
    const [uploadProgress, setUploadProgress] = useState(0);
    const [uploadedBytes, setUploadedBytes] = useState(0);
    const [totalBytes, setTotalBytes] = useState(0);
    const { styles, theme } = useStyles(stylesheet);
    const colorScheme: ColorSchemeName = useColorScheme();
    
    // Use the enhanced audio recorder with interruption handling
    const {
        recordingState,
        startRecording: startEnhancedRecording,
        stopRecording: stopEnhancedRecording,
        pauseRecording: pauseEnhancedRecording,
        resumeRecording: resumeEnhancedRecording,
        discardRecording: discardEnhancedRecording,
        getCurrentSessionId,
        getSegmentPathsForCleanup,
    } = useEnhancedAudioRecorder();

    const animatedStyle = useAnimatedStyle(() => {
        return {
            opacity: withTiming(recordingState.isRecording ? 0 : 1, { duration: 500 }),
        };
    });

    useEffect(() => {
        void starter();
    }, []);

    const starter = async () => {
        // Use the enhanced audio studio permission request
        const { granted } = await ExpoAudioStreamModule.requestPermissionsAsync();
        if (granted) {
            
            // Also request expo-av permissions for compatibility
            const expoPerm = await requestPermission();
            if (expoPerm.granted) {
                const audioMode = Platform.select({
                    ios: {
                        allowsRecordingIOS: true,
                        playsInSilentModeIOS: true,
                        staysActiveInBackground: true,
                        interruptionModeIOS: InterruptionModeIOS.DoNotMix,
                    },
                    android: {
                        staysActiveInBackground: true,
                    },
                    default: {
                        allowsRecordingIOS: false,
                        staysActiveInBackground: true,
                    }
                });

                await Audio.setAudioModeAsync(audioMode);
            }
        } else {
            alert('Audio Permission denied. Please allow microphone access from the settings apps to proceed recording.');
        }
    };

    const startNewRecording = async () => {
        if (permissionResponse?.status === 'denied') {
            alert('Audio Permission denied. Please allow microphone access from the settings apps to proceed recording.');
            return;
        }
        try {
            await startEnhancedRecording();
        } catch (error) {
            Toast.show({
                type: 'error',
                text1: 'Failed to start new recording!',
                text2: `Try closing and reopening the app by swiping it up from your recent apps if the errors persists`,
                topOffset: 50,
            });
            console.error('Failed to start recording:', error);
        }
    };

    const pauseRecording = async () => {
        try {
            await pauseEnhancedRecording();
        } catch (error) {
            console.error('Failed to pause recording:', error);
        }
    };

    const resumeRecording = async () => {
        try {
            await resumeEnhancedRecording();
        } catch (error) {
            console.error('Failed to resume recording:', error);
        }
    };



    const insertContent = useInsertContentMutation()

    const handleGenerateNotes = async (fileURI: string, filePath: string, contentTitle: string | null, sessionId?: string | null) => {
        setLoading(true);
        try {
            await uploadAudioFileTUS(fileURI, filePath, null, false, {
                onProgress: (bytesUploaded, bytesTotal, progress) => {
                    setUploadProgress(progress);
                    setUploadedBytes(bytesUploaded);
                    setTotalBytes(bytesTotal);
                },
                onError: (error) => {
                    console.error('Error uploading audio:', error);
                },
                onSuccess: async (fileLink : string) => {
                    const content_uuid = uuid.v4() as string;

                    insertContent.mutate(
                        {
                            content_id: content_uuid,
                            class_subject: "humanities",
                            content_type: "audio",
                            file_link: fileLink,
                            student_id: student_id,
                            content_title: contentTitle
                        },
                        {
                            onSuccess: async (data) => {
                                console.log('✅ Content inserted successfully:', data);
                                
                                // Clean up ALL recording files (segments + consolidated) after successful processing
                                try {
                                    const filesToCleanup = sessionId ? getSegmentPathsForCleanup(sessionId) : [fileURI];
                                    if (filesToCleanup.length > 0) {
                                        await cleanupWavFiles(filesToCleanup);
                                        console.log('✅ Recording files cleaned up:', filesToCleanup.length, 'files');
                                    }
                                } catch (cleanupError) {
                                    console.warn('⚠️ Failed to cleanup recording files:', cleanupError);
                                }
                                
                                if (sessionId) {
                                    recordingBackupService.removeBackup(sessionId);
                                    console.log('✅ Recording backup cleaned up for session:', sessionId);
                                }
                            },
                            onError: (error) => {
                                console.error('❌ Error inserting content:', error);
                                console.error('📋 Error details:', {
                                    message: error.message,
                                    stack: error.stack,
                                    fileLink,
                                    content_uuid
                                });
                                setLoading(false);
                                Toast.show({
                                    type: 'error',
                                    text1: 'Generation Failed!',
                                    text2: `Backend error: ${error.message}`,
                                    topOffset: 50,
                                });
                            }
                        }
                    )
                    setLoading(false)
                    router.navigate(`/home/${content_uuid}/notes`)
                },
            });
        } catch (error) {
            console.error('Error uploading audio:', error);
        }
    };

    const handleUploadAudioLogic = async () => {
        const result: DocumentPickerResult = await DocumentPicker.getDocumentAsync();
        if (!result.canceled) {
            const audioAsset: DocumentPickerAsset = result.assets[0];
            if (audioAsset.mimeType === 'audio/mpeg' || audioAsset.mimeType === 'audio/x-m4a') {
                setLoading(true);
                if (student_id) {
                    const filePath = `${student_id}/${uuid.v4()}.mp3`;
                    const fileName = audioAsset.name || 'Uploaded Audio';
                    const fileNameWithoutExtension = fileName.replace(/\.[^/.]+$/, "");
                    void handleGenerateNotes(audioAsset.uri, filePath, fileNameWithoutExtension);
                }
            } else {
                Toast.show({
                    type: 'error',
                    text1: 'File must be an mp3 audio!',
                    text2: `The file you chose was not audio: ${audioAsset.mimeType}!`,
                    topOffset: 50,
                });
            }
        }
    };

    const handleDiscardRecording = async () => {
        if(recordingState.isRecording){
            await discardEnhancedRecording();
        }
    }

    return (
        <UnsafeContainer>
            <AudioUploadingModal
                visible={loading}
                progress={uploadProgress}
                totalBytes={totalBytes}
                uploadedBytes={uploadedBytes}
            />
            <View style={{ marginTop: Constants.statusBarHeight }} />
            <RecordBackHeader title="Live Recording"  isRecording={recordingState.isRecording} />
            <Animated.View style={animatedStyle}>
                <TouchableOpacity onPress={handleUploadAudioLogic} style={styles.uploadAudioTextBox}>
                    <UploadSVG width={20} height={20} style={{marginRight: 5}}/>
                    <Text style={styles.uploadAudioFileText}>Upload Audio File</Text>
                </TouchableOpacity>
            </Animated.View>
            {/* <SuperWhisperBarsVisualizer 
                isRecording={recordingState.isRecording}
                isPaused={recordingState.isPaused}        
                     audioLevel={recordingState.currentAudioLevel}
            /> */}
            <LottieView
                source={require('@/../assets/lottie/tube-wave.json')}
                style={styles.lottieStyle}
                autoPlay
                loop
            />
            <FastImage
                source={
                    colorScheme === 'dark'
                        ? require('../../assets/images/logoWhite.png')
                        : require('../../assets/images/logoGray.png')
                }
                style={styles.logoStyle}
                resizeMode={FastImage.resizeMode.contain}
            />
            <View
                style={[
                    styles.bottomSection,
                    {
                        shadowColor: colorScheme === 'dark' ? '#fff' : '#000',
                        shadowOpacity: colorScheme === 'dark' ? 0.3 : 0.95,
                        backgroundColor: colorScheme === 'dark' ? '#16161a' : '#cfcfd1',
                    },
                ]}
            >
                <View style={{flexDirection: 'column', flex: 0.95, justifyContent: 'space-around'}}>
                    <Text style={styles.durationText}>{formatAudioDuration(recordingState.duration)}</Text>
                    <AudioControls isRecording={recordingState.isRecording} isPaused={recordingState.isPaused} startNewRecording={startNewRecording} pauseRecording={pauseRecording} resumeRecording={resumeRecording} handleDiscard={handleDiscardRecording}/>
                    <BasicButton
                        onPress={async () => {
                            heavyHaptic();
                            if ((recordingState.isRecording || recordingState.isPaused) && student_id) {
                                setLoading(true);
                                const sessionId = getCurrentSessionId();
                                const uri = await stopEnhancedRecording();
                                if (uri) {
                                    const filePath = `${student_id}/${uuid.v4()}.mp3`;
                                    void handleGenerateNotes(uri, filePath, null, sessionId);
                                } else {
                                    console.error('🎤 No URI returned from stopRecording');
                                    setLoading(false);
                                    Toast.show({
                                        type: 'error',
                                        text1: 'Recording Failed!',
                                        text2: 'No audio file was generated. Please try recording again.',
                                        topOffset: 50,
                                    });
                                }
                            } else {
                                Toast.show({
                                    type: 'error',
                                    text1: 'Record before generating notes!',
                                    text2: 'Press the start recording button to begin!',
                                    topOffset: 50,
                                });
                            }
                        }}
                        backgroundColor={theme.colors.tints.PRIMARY}
                        text="Generate Notes"
                        style={{ opacity: (recordingState.isRecording || recordingState.isPaused) ? 1 : 0}}
                    />
                </View>
            </View>
        </UnsafeContainer>
    );
}

const stylesheet = createStyleSheet((theme) => ({
    lottieStyle: {
        width: '100%',
        height: {
            xs: '25%',
            md: '45%'
        },
        marginTop: {
            xs: 0,
            md: moderateScale(-30)
        }
    },
    logoStyle: {
        height: {
            xs: windowWidth * 0.5 * 0.167,
            md: windowWidth * 0.3 * 0.167
        },
        width: {
            xs: windowWidth * 0.5,
            md: windowWidth * 0.3
        },
        alignSelf: 'center',
        marginTop: {
            xs: windowHeight * 0.07,
            md: windowHeight * 0.03
        },
    },
    bottomSection: {
        alignSelf: 'center',
        flex: 1,
        width: windowWidth,
        marginTop: 25,
        shadowOffset: {
            width: 0,
            height: 2,
        },
        shadowRadius: 10,
        elevation: 5,
    },
    durationText: {
        textAlign: 'center',
        fontSize: moderateScale(22),
        fontFamily: 'Sans-Light',
    },
    uploadAudioFileText: {
        color: theme.colors.tints.SECONDARY,
        fontSize: moderateScale(15),
        textAlign: 'center',
        fontFamily: 'Sans-Medium',
        marginVertical: 5,
    },
    uploadAudioTextBox: {
        flexDirection: 'row',
        alignItems: 'center',
        alignSelf: 'center',
        justifyContent: 'center',
    }
}));
