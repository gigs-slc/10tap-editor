import {useMutation, useQueryClient, UseMutationResult} from "@tanstack/react-query";
import {updatePodcastMutation} from "@data/podcast/mutations";
import {Podcast, UpdatePodcast} from "@data/podcast/types";


export const useUpdatePodcastMutation = (): UseMutationResult<Podcast, Error, UpdatePodcast> => {
    const queryClient = useQueryClient();
    return useMutation({
        mutationFn: (updatedPodcast: UpdatePodcast) => updatePodcastMutation(updatedPodcast),
        onMutate: async (updates: UpdatePodcast) => {
            await queryClient.cancelQueries({ queryKey: ['podcast', 'individual', updates.podcast_id] });
            await queryClient.cancelQueries({ queryKey: ['podcast', 'list', 'content', updates.content_id] });

            const previousPodcast : Podcast | undefined = queryClient.getQueryData<Podcast>(['podcast', 'individual', updates.podcast_id]);
            const previousPodcasts : Podcast[] | undefined = queryClient.getQueryData<Podcast[]>(['podcast', 'list', 'content', updates.content_id]);

            if (previousPodcast) {
                const optimisticPodcast : Podcast = { ...previousPodcast, ...updates };

                queryClient.setQueryData(['podcast', 'individual', updates.podcast_id], optimisticPodcast);

                queryClient.setQueryData(
                    ['podcast', 'list', 'content', updates.content_id],
                    (oldData: Podcast[] | undefined) => {
                        if (!oldData) return [];
                        return oldData.map(podcast =>
                            podcast.podcast_id === updates.podcast_id ? optimisticPodcast : podcast
                        );
                    }
                );
            }
            return { previousPodcast: previousPodcast, previousPodcasts: previousPodcasts };
        },
        onError: (err, updates, context) => {
            if (context?.previousPodcast) {
                queryClient.setQueryData(['podcast', 'individual', updates.podcast_id], context.previousPodcast);
            }
            if (context?.previousPodcasts) {
                queryClient.setQueryData(['podcast', 'list', 'content', updates.content_id], context.previousPodcasts);
            }
        },
        onSuccess: (updatedPodcast: Podcast) => {
            queryClient.setQueryData(
                ['podcast', 'list', 'content', updatedPodcast.content_id],
                (oldData: Podcast[] | undefined) => {
                    if (!oldData) return [];
                    return oldData.map(podcast =>
                        podcast.podcast_id === updatedPodcast.podcast_id ? updatedPodcast : podcast
                    );
                }
            );
            queryClient.setQueryData(['podcast', 'individual', updatedPodcast.podcast_id], updatedPodcast);
        }

    });
}
</file>

