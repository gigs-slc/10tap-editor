// markFromSpec.ts
import { Mark } from '@tiptap/core'
import type { MarkSpec, Mark as PMMark } from 'prosemirror-model'

export function markFromSpec(name: string, spec: MarkSpec) {
    return Mark.create({
        name,

        // --- schema fields ---------------------------------------------------
        inclusive: spec.inclusive ?? true,
        excludes : spec.excludes  ?? '',
        spanning : spec.spanning  ?? true,

        // DELETE FOR V3
        // keep the custom equality test if the spec provides one
        // (Tiptap passes through to ProseMirror automatically for marks)
        // extendsMark: undefined as unknown as (a: PMMark, b: PMMark) => boolean,
        // eq(thisMark: PMMark, other: PMMark) {
        //     // fall back to default comparison if spec.eq not provided
        //     return (spec as any).eq ? (spec as any).eq(thisMark, other) : thisMark.eq(other)
        // },


        addAttributes() {
            const attrs: Record<string, any> = {}
            if (spec.attrs) {
                for (const [key, attr] of Object.entries(spec.attrs))
                    attrs[key] = { default: (attr as any).default }
            }
            return attrs
        },

        // --- HTML ↔︎ PM ------------------------------------------------------
        parseHTML() {
            return spec.parseDOM ?? []
        },
        // @ts-ignore
        renderHTML({ node, HTMLAttributes }) {
            // spec.toDOM returns [tag, attrs, ...content]
            // @ts-ignore
            const domOut = spec.toDOM(node)
            // @ts-ignore
            const [tagName, attrs, ...content] = domOut
            return [tagName, { ...attrs, ...HTMLAttributes }, ...content]
        },
    })
}
</file>

<file path="tiptap-extensions/CustomExtensions/utils/usePositionConversions.ts">
//@ts-nocheck
import * as Y from 'yjs'
import {
    absolutePositionToRelativePosition,
    relativePositionToAbsolutePosition,
    ySyncPluginKey,
} from '@tiptap/y-tiptap'
import {EditorState} from "prosemirror-state";

/**
 * Convert a ProseMirror absolute offset → Yjs RelativePosition.
 */
export function absolutePosToRelative(
    state: EditorState,
    absPos: number
): Y.RelativePosition {
    const { type: yRoot, binding } = ySyncPluginKey.getState(state)
    const relPos = absolutePositionToRelativePosition(
        absPos,
        yRoot,
        binding.mapping
    )
    return relPos
}

/**
 * Convert a Yjs RelativePosition → ProseMirror absolute offset | null.
 */
export function relativeToAbsolutePos(
    ydoc: Y.Doc,
    state: EditorState,
    relPos: Y.RelativePosition,
): number | null{
    try {
        const { type: yRoot, binding } = ySyncPluginKey.getState(state)
        return relativePositionToAbsolutePosition(
            ydoc,
            yRoot,
            relPos,
            binding.mapping
        )
    } catch (error) {
        return null;
    }
}

/**
 * Convert an absolute range → relative range.
 */
export function absoluteRangeToRelativeRange(
    state: EditorState,
    range: { from: number; to: number }
): { relStart: Y.RelativePosition; relEnd: Y.RelativePosition } {
    return {
        relStart: absolutePosToRelative(state, range.from),
        relEnd:   absolutePosToRelative(state, range.to),
    }
}

/**
 * Convert a relative range → absolute range.
 */
export function relativeRangeToAbsoluteRange(
    state: EditorState,
    ydoc: Y.Doc,
    range: { relStart: Y.RelativePosition; relEnd: Y.RelativePosition }
): { from: number; to: number } {
    return {
        from: relativeToAbsolutePos(ydoc, state, range.relStart),
        to:   relativeToAbsolutePos(ydoc, state, range.relEnd),
    }
}
</file>

