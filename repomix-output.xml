    const query = useQuery<Content[], Error>({
        queryKey: ['content', 'list', 'folder', folder_id],
        queryFn: (): Promise<Content[]> => getContentRowsQuery(folder_id),
    });

    // onSuccess no longer exists, use this pattern w/ useEffects
    useEffect(() => {
        if (!query.data || !query.isSuccess) return;

        query.data.map((content: Content) => {
            queryClient.setQueryData(['content', 'individual', content.content_id], content)
        })

    }, [query.data, query.isSuccess]);

