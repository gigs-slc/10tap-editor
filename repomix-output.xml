<file path="assets/fonts/rename_fonts.sh">
#!/bin/bash

# First remove all italic variants since they're not needed
rm Montserrat-*Italic.ttf

# Rename Montserrat fonts to match Poppins naming pattern
mv "Montserrat-Black.ttf" "Poppins-Black.ttf"
mv "Montserrat-Bold.ttf" "Poppins-Bold.ttf"
mv "Montserrat-ExtraBold.ttf" "Poppins-ExtraBold.ttf"
mv "Montserrat-ExtraLight.ttf" "Poppins-ExtraLight.ttf"
mv "Montserrat-Light.ttf" "Poppins-Light.ttf"
mv "Montserrat-Medium.ttf" "Poppins-Medium.ttf"
mv "Montserrat-Regular.ttf" "Poppins-Regular.ttf"
mv "Montserrat-SemiBold.ttf" "Poppins-SemiBold.ttf"
mv "Montserrat-Thin.ttf" "Poppins-Thin.ttf"
</file>

