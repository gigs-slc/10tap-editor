export const ActionButton = Node.create({
    name: 'actionButton',
    group: 'block',
    inline: false,
    atom: true,

    addOptions() {
        return {
            onButtonClick: undefined as ((actionType: ActionButtonType, actionData: any) => void) | undefined,
        }
    },

    addAttributes() {
        return {
            label: {
                default: 'Click me',
            },
            actionType: {
                default: null,
            },
            actionData: {
                default: null,
            },
            variant: {
                default: 'default',
            },
            size: {
                default: 'lg',
            },
        }
    },

    parseHTML() {
        return [
            {
                tag: 'div.action-button',
                getAttrs: (dom) => {
                    const el = dom as HTMLElement;
                    let actionData = null;
                    const actionDataStr = el.getAttribute('data-actiondata');
                    
                    if (actionDataStr) {
                        try {
                            actionData = JSON.parse(actionDataStr);
                        } catch {
                            actionData = actionDataStr;
                        }
                    }
                    
                    return {
                        label: el.textContent || 'Click me',
                        actionType: el.getAttribute('data-actiontype') || null,
                        actionData: actionData,
                        variant: el.getAttribute('data-variant') || 'default',
                        size: el.getAttribute('data-size') || 'lg'
                    };
                }
            },
            {
                tag: 'div[data-action-button]',
                getAttrs: (dom) => {
                    const el = dom as HTMLElement;
                    let actionData = null;
                    const actionDataStr = el.getAttribute('data-actiondata');
                    
                    if (actionDataStr) {
                        try {
                            actionData = JSON.parse(actionDataStr);
                        } catch {
                            actionData = actionDataStr;
                        }
                    }
                    
                    return {
                        label: el.textContent || 'Click me',
                        actionType: el.getAttribute('data-actiontype') || null,
                        actionData: actionData,
                        variant: el.getAttribute('data-variant') || 'default',
                        size: el.getAttribute('data-size') || 'lg'
                    };
                }
            },
            {
                tag: 'button[data-action-button]',
                getAttrs: (dom) => {
                    const el = dom as HTMLElement;
                    let actionData = null;
                    const actionDataStr = el.getAttribute('data-actiondata');
                    
                    if (actionDataStr) {
                        try {
                            actionData = JSON.parse(actionDataStr);
                        } catch {
                            actionData = actionDataStr;
                        }
                    }
                    
                    return {
                        label: el.textContent || 'Click me',
                        actionType: el.getAttribute('data-actiontype') || null,
                        actionData: actionData,
                        variant: el.getAttribute('data-variant') || 'default',
                        size: el.getAttribute('data-size') || 'lg'
                    };
                }
            },
        ]
    },

    renderHTML({ HTMLAttributes }) {
        return ['div', mergeAttributes(HTMLAttributes, {
            class: 'action-button',
            'data-action-button': 'true',
            contenteditable: 'false'
        }), HTMLAttributes.label || 'Click me']
    }
})
