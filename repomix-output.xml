import uuid from 'react-native-uuid';
import {format, parseISO} from "date-fns";
import {supabase} from "@/utils/supabase";
import * as StoreReview from "expo-store-review";
import {Adjust, AdjustEvent} from "react-native-adjust";

export const formatNoteTimestamp = (timestamp: string): string => {
    const date = parseISO(timestamp);
    return format(date, "MMM do");
};

export const getAudioFileURL = (path : string) => {
    const { data } = supabase.storage.from("audio").getPublicUrl(path);
    return data.publicUrl;
};

export const uploadPDFFile = async (student_id : string, uri: string) => {
    const pdf = {
        uri: uri,
        type: "application/pdf",
        name: "PDF Upload",
    };

    const formData = new FormData();
    //@ts-ignore
    formData.append("file", pdf);
    const { data, error } = await supabase.storage
        .from("pdf")
        .upload(`${student_id}/${uuid.v4()}.pdf`, formData, {
            contentType: 'application/pdf',
            upsert: true
        });
    if (error) throw new Error("Error uploading pdf file from recording: " + error.message)
    const path = data.path;
    return getPDFFileURL(path);
}

const getPDFFileURL = (path : string) => {
    const { data } = supabase.storage.from("pdf").getPublicUrl(path);
    return data.publicUrl;
};

export const requestStoreReview = async () => {
    if (await StoreReview.hasAction()) {
        await StoreReview.requestReview()
    }
}

export const trackAdjustEvent = (revenue : number, eventToken: string) : void => {
    var adjustEvent : AdjustEvent = new AdjustEvent(eventToken);
    adjustEvent.setRevenue(revenue, 'USD');
    Adjust.trackEvent(adjustEvent);
}

export function formatAudioDuration(ms: number): string {
    const totalSeconds = Math.floor(ms / 1000);
    const hours = Math.floor(totalSeconds / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;
    const hoursString = String(hours).padStart(2, '0');
    const minutesString = String(minutes).padStart(2, '0');
    const secondsString = String(seconds).padStart(2, '0');
    return `${hoursString}:${minutesString}:${secondsString}`;
}
