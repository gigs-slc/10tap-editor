import { RealtimeChannel } from '@supabase/supabase-js'
import { supabase } from "@/utils/supabase";
import type { Podcast } from './types.ts'

export function subscribeToPodcast(podcast_id: string, onUpdate: (newRow: Podcast) => void) : RealtimeChannel {
    return supabase
        .channel(`podcast-${podcast_id}`)
        .on(
            'postgres_changes',
            {
                event: 'UPDATE',
                schema: 'public',
                table: 'podcasts',
                filter: `podcast_id=eq.${podcast_id}`,
            },
            ({ new: updatedRow}) => {
                onUpdate(updatedRow as Podcast)
            }
        )
        .subscribe()
}
</file>

