import { useEffect, useRef, useState } from "react";
import { windowWidth } from "@/utils/window";
import { useSharedValue } from "react-native-reanimated";
import { AppState, AppStateStatus } from "react-native";
import Superwall from "expo-superwall/compat";
import { requestStoreReview, trackAdjustEvent } from "@/utils/general";
import { Content } from "@/data/content/types";
import { useSingleContentRowQuery } from "@data/content/hooks/useSingleContentRowQuery";
import { useRealtimeContentSubscription } from "@data/content/hooks/useRealtimeContentSubscription";

export function useNoteProgress(content_id: string) {
  const {
    data: contentRow,
    refetch,
    isLoading,
  } = useSingleContentRowQuery(content_id);
  const [progress, setProgress] = useState(1);
  const appState = useRef(AppState.currentState);
  const [appStateVisible, setAppStateVisible] = useState(appState.current);
  const barWidth = useSharedValue((progress / 100) * 0.7 * windowWidth);
  useRealtimeContentSubscription(content_id);

  // Temporary fallback: force-refetch periodically in case realtime subscription misses updates
  useEffect(() => {
    const intervalId = setInterval(() => {
      void refetch();
    }, 3000);

    return () => clearInterval(intervalId);
  }, [refetch]);

  const handleFinishedProgress = async (payload: Content) => {
    console.log("note finished!");
    trackAdjustEvent(0, "9hqwyf");
  };

  const handleNotEnoughCredits = async (payload: Content) => {
    setTimeout(() => {
      void Superwall.shared.register({
        placement: "not_enough_credits",
        feature: () => {},
      });
    }, 1000);
  };

  useEffect(() => {
    if (!contentRow?.percent_completed) return;
    const p = contentRow.percent_completed;
    if (p > progress) {
      barWidth.value = (p / 100) * (windowWidth * 0.7);
      setProgress(p);
    }

    if (contentRow.content_status === "NOT_ENOUGH_CREDITS") {
      void handleNotEnoughCredits(contentRow);
    }
    if (p === 100) {
      void handleFinishedProgress(contentRow);
      setTimeout(() => void requestStoreReview(), 3_000);
    }
  }, [contentRow, barWidth]);

  useEffect(() => {
    const intervalId = setInterval(() => {
      setProgress((prevProgress: any) => {
        if (prevProgress <= 90) {
          const next = prevProgress + 1;
          barWidth.value = (next / 100) * (windowWidth * 0.7);
          return next;
        }
        return prevProgress;
      });
    }, 10000);

    return () => {
      clearInterval(intervalId);
    };
  }, []);

  useEffect(() => {
    const subscription = AppState.addEventListener(
      "change",
      (nextAppState: AppStateStatus) => {
        if (
          appState.current.match(/inactive|background/) &&
          nextAppState === "active"
        ) {
          void handleScanForegroundEvent();
          console.log("Progress card has come to the foreground!");
        }
        appState.current = nextAppState;
        setAppStateVisible(appState.current);
        console.log("AppState", appState.current);
      }
    );

    return () => {
      subscription.remove();
    };
  }, []);

  const handleScanForegroundEvent = async () => {
    refetch();
    if (!contentRow) return;
    barWidth.value =
      ((contentRow.percent_completed || 1) / 100) * (windowWidth * 0.7);
    setProgress(contentRow.percent_completed || 1);
    if (contentRow.content_status === "NOT_ENOUGH_CREDITS") {
      void handleNotEnoughCredits(contentRow);
    }
    if (contentRow.percent_completed === 100) {
      void handleFinishedProgress(contentRow);
      setTimeout(() => {
        void requestStoreReview();
      }, 3000);
    }
  };

  return { progress, barWidth };
}
</file>

