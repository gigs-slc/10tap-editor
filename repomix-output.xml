            condition: (ans: any) => ans['user_type_question'] === 'Undergraduate Student' || ans['question1'] === 'Graduate Student',
        },
        {
            id: 'language_selection',
            type: 'custom',
            question: 'Select your language',
            component: <LanguageSelectionScreen onNext={() => {}} />,
            condition: () => {
                if (!ipData) return false;
                const isEnglishSpeakingCountry = ["US", "CA", "GB", "UK", "AU"].includes(ipData.country_code);
                return !isEnglishSpeakingCountry;
            },
        },
        {
            id: 'hours_studying_question',
            type: 'question',
            question: 'How many hours per week do you spend on studying or homework?',
            subtitle: "Give us a rough estimate :)",
            answers: ['Less than 1 hour', '1-5 Hours', '5-10 Hours', "10-15 Hours", "15-20 Hours", '20+ Hours'],
            condition: (ans: any) => ans['user_type_question'] === 'Graduate Student' || ans['user_type_question'] === 'Undergraduate Student' || ans['user_type_question'] === 'High School Student',
        },
        {
            id: 'classes_per_week_question',
            type: 'question',
            question: 'How many classes are you taking this semester?',
            answers: ['1', '2', '3', "4", "5+", "N/A"],
            condition: (ans: any) => ans['user_type_question'] === 'Undergraduate Student',
        },
        {
            id: 'applying_to_grad',
            type: 'question',
            question: 'What are your plans after completing your undergraduate degree?',
            subtitle: "We use this information to personalize your experience!",
            answers: ['Find a Job', 'Apply to Grad School', 'Other'],
            condition: (ans : any) => ans['user_type_question'] === "Undergraduate Student",
        },
        {
            id: 'desired_job',
            type: 'question',
            question: 'Which industry are you interested in recruiting for?',
            subtitle: "We use this information to personalize your experience!",
            answers: ['Finance', 'Software Engineering / IT', 'Banking', 'Research', "Human Resources", "Marketing", 'Other'],
            condition: (ans : any) => ans['applying_to_grad'] === "Find a Job",
        },
        {
            id: 'intended_use_question',
            type: 'question',
            question: 'How do you plan on using Turbo?',
            subtitle: "Choose the option you plan to use most.",
            answers: ['Recording Lectures', 'YouTube Videos',  'Summarizing PDFs', 'Recording Meetings', 'Medical Appointments',  'Sales Calls', 'Other']
        },
        {
            id: 'notification1',
            type: 'notification',
        },
        {
            id: 'review1',
            type: 'review',
        },
        {
            id: 'auth_sign_up',
            type: 'auth_sign_up',
        },
        {
            id: 'auth_sign_in',
            type: 'auth_sign_in',
            condition: (ans: any) => ans['auth_sign_up'] === "Login",
        },
        {
            id: 'customize_plan',
            type: 'custom',
            component: <PersonalizingExperienceScreen userData={""}/>
        }
    ];

    const filteredSteps = stepsData.filter((step) => {
        if (step.condition) {
            return step.condition(answers);
        }
        return true;
    });

    const {currentStepIndex, totalSteps, goToNextStep, goToPreviousStep } = useOnboardingAnimation(filteredSteps);

    const currentStep = filteredSteps[currentStepIndex];

    const handleAnswerSelected = (answer?: string) => {
        if(answer) {
            setAnswers({ ...answers, [currentStep.id]: answer });
        }
        goToNextStep(currentStep.id, answer);
    };

    function renderCurrentStep(step: any) {
        switch (step.type) {
            case 'question':
                return (
                    <OnboardingStep
                        question={step.question}
                        subtitle={step.subtitle}
                        answers={step.answers}
                        onAnswerSelected={handleAnswerSelected}
                    />
                );

            case 'notification':
                return <EnableNotificationScreen onNext={() => {goToNextStep(currentStep.id)}} />;

            case 'auth_sign_up':
                return <SignUpScreen onNext={() => {goToNextStep(currentStep.id)}} handleAnswerSelected={handleAnswerSelected} />;

            case 'auth_sign_in':
                return <LoginScreen onNext={() => {goToNextStep(currentStep.id)}} />;

            case 'review':
                return <ReviewAppScreen onNext={() => {goToNextStep(currentStep.id)}} />;

            case 'custom':
                return React.cloneElement(step.component, {
                    onNext: handleAnswerSelected,
                    userData: formatUserDataString(stepsData, answers)
                });

            default:
                return null;
        }
    }

    return (
        <View style={styles.container}>
            <View style={{marginTop: Constants.statusBarHeight }}/>
            <AnimatedProgressBar
                currentStep={currentStepIndex + 1}
                totalSteps={filteredSteps.length - 1}
                goToPreviousStep={goToPreviousStep}
            />

            {currentStep && (
                <Animated.ScrollView
                    key={currentStep.id}
                    style={{ flex: 1 }}
                    contentContainerStyle={{ flexGrow: 1 }}
                    showsVerticalScrollIndicator={false}
                    entering={FadeInRight.duration(300)}
                    exiting={FadeOutLeft.duration(300)}
                >
                    {renderCurrentStep(currentStep)}
                </Animated.ScrollView>
            )}

            {/* If you want a "Back" button:
      <Button title="Back" onPress={goToPreviousStep} />
      */}
        </View>
    );
}

const stylesheet = createStyleSheet((theme) => ({
    container: {
        flex: 1,
        alignItems: 'center',
        marginTop: {
            md: moderateScale(10)
        },
        alignSelf: {
            md: 'center',
        },
        width: {
            md: '100%',
        },
        paddingHorizontal: {
            md: moderateScale(20),
        },
    },
}));
