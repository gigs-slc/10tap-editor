<file path="editor-web/styling/image.css">
/* ResizableImage extension styling */
.tiptap .resizable-image-container {
    max-width: 100% !important;
    margin: 1rem auto;
}

.tiptap .resizable-image-wrapper {
    max-width: min(100%, 600px) !important;
    margin: 0 auto;
    position: relative;
}

.tiptap .resizable-image {
    max-width: 100% !important;
    height: auto !important;
    display: block;
}

/* Override inline styles with !important */
.tiptap img[data-resizable-image] {
    max-width: min(100%, 600px) !important;
    height: auto !important;
    display: block;
    margin: 0 auto;
}

/* Handle any image regardless of wrapper */
.tiptap img {
    max-width: min(100%, 600px) !important;
    height: auto !important;
    object-fit: contain;
}

/* For images inside any container */
.tiptap * img {
    max-width: min(100%, 600px) !important;
    height: auto !important;
}

/* Handle resize handles visibility */
.tiptap .resizable-image-container .resize-handle {
    opacity: 0;
    transition: opacity 0.2s;
}

.tiptap .resizable-image-container:hover .resize-handle,
.tiptap .resizable-image-container.ProseMirror-selectednode .resize-handle {
    opacity: 1;
}

/* Selected image styling */
.tiptap img.ProseMirror-selectednode,
.tiptap .resizable-image-container.ProseMirror-selectednode {
    outline: 2px solid #6823FF;
    outline-offset: 2px;
}
