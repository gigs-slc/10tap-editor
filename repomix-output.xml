                <SafeAreaView
                    style={{backgroundColor: theme.colors.background.PRIMARY, flex: 1}}
                ></SafeAreaView>
        );

    return (
                <SafeAreaView
                    style={{flex: 1, backgroundColor: theme.colors.background.PRIMARY}}
                ></SafeAreaView>
    );
}

export default Sentry.wrap(App);
