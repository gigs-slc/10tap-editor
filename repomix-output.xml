import {useMutation, useQueryClient, UseMutationResult} from "@tanstack/react-query";
import {deleteFolderMutation} from "@data/folders/mutations";
import {Folder} from "@data/folders/types";

export const useDeleteFolderMutation = (): UseMutationResult<void, Error, string> => {
    const queryClient = useQueryClient();

    return useMutation({
        mutationFn: (folder_id: string) => deleteFolderMutation(folder_id),
        onMutate: async (folder_id: string) => {
            await queryClient.cancelQueries({ queryKey: ['folder', 'list'] });
            await queryClient.cancelQueries({ queryKey: ['folder', 'individual', folder_id] });

            const previousFolders : Folder[] | undefined = queryClient.getQueryData(['folder', 'list']);
            const previousFolder : Folder | undefined = queryClient.getQueryData(['folder', 'individual', folder_id]);

            queryClient.setQueryData(
                ['folder', 'list'],
                (oldData: Folder[] | undefined) => {
                    if (!oldData) return [];
                    return oldData.filter((folder : Folder) => folder.folder_id !== folder_id);
                }
            );
            queryClient.removeQueries({ queryKey: ['folder', 'individual', folder_id] });

            return { previousFolders, previousFolder };
        },
        onError: (err, folder_id, context) => {
            if (context?.previousFolders) {
                queryClient.setQueryData(['folder', 'list'], context.previousFolders);
            }
            if (context?.previousFolder) {
                queryClient.setQueryData(['folder', 'individual', folder_id], context.previousFolder);
            }
        },
        onSuccess: (_void, folder_id) => {
            queryClient.setQueryData(
                ['folder', 'list'],
                (oldData: Folder[] | undefined) => {
                    if (!oldData) return [];
                    return oldData.filter((folder : Folder) => folder.folder_id !== folder_id);
                });
            queryClient.removeQueries({ queryKey: ['folder', 'individual', folder_id] });
        }
    });
}
</file>

