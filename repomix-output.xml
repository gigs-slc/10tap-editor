<file path="src/services/RecordingRecoveryService.ts">
import {
  recordingBackupService,
  RecordingBackup,
} from "@/services/RecordingBackupService";
import { Alert } from "react-native";
import { router } from "expo-router";
import Toast from "react-native-toast-message";
import * as FileSystem from "expo-file-system";
import { addPendingUpload } from "@/utils/tus";
import { PendingUpload } from "@/types/db.types";
import { getUserID } from "@/utils/auth";
import uuid from "react-native-uuid";

export interface RecoveryOption {
  backup: RecordingBackup;
  displayTitle: string;
  displaySubtitle: string;
  action: "resume" | "upload" | "discard";
}

export class RecordingRecoveryService {
  private static instance: RecordingRecoveryService;

  static getInstance(): RecordingRecoveryService {
    if (!RecordingRecoveryService.instance) {
      RecordingRecoveryService.instance = new RecordingRecoveryService();
    }
    return RecordingRecoveryService.instance;
  }

  async checkForRecoverableRecordings(): Promise<RecoveryOption[]> {
    console.log("🔍 RecoveryService: Cleaning up old backups...");
    await recordingBackupService.cleanupOldBackups(7);

    console.log("🔍 RecoveryService: Cleaning up invalid backups...");
    await this.cleanupInvalidBackups();

    console.log(
      "🔍 RecoveryService: Getting unshown backups from MMKV for current user..."
    );
    const unshownBackups =
      await recordingBackupService.getUnshownRecoverableRecordings();
    console.log(
      "🔍 RecoveryService: Found",
      unshownBackups.length,
      "unshown backups for current user"
    );

    console.log("🔍 RecoveryService: Scanning for orphaned files...");
    const orphanedFiles = await this.scanForOrphanedRecordings();
    console.log(
      "🔍 RecoveryService: Found",
      orphanedFiles.length,
      "orphaned files"
    );

    const options: RecoveryOption[] = [];

    // Add backups from MMKV storage
    for (const backup of unshownBackups) {
      console.log("🔍 Processing MMKV backup:", {
        sessionId: backup.sessionId,
        isComplete: backup.isComplete,
        duration: backup.totalDuration,
        hasShownDialog: backup.hasShownRecoveryDialog,
      });

      if (backup.isComplete) {
        options.push({
          backup,
          displayTitle: backup.metadata?.contentTitle || "Completed Recording",
          displaySubtitle: `${this.formatDuration(
            backup.totalDuration
          )} • ${this.formatDate(backup.dateCreated)}`,
          action: "upload",
        });
        console.log("🔍 Added completed recording to options");
      } else if (backup.totalDuration > 5000) {
        // Check if incomplete recording has backup files available
        const hasBackupFiles = await this.checkForBackupFiles(backup);

        if (hasBackupFiles) {
          options.push({
            backup,
            displayTitle:
              backup.metadata?.contentTitle || "Interrupted Recording",
            displaySubtitle: `${this.formatDuration(
              backup.totalDuration
            )} • ${this.formatDate(backup.lastUpdated)}`,
            action: "upload", // Changed from "resume" to "upload" since we can recover the audio
          });
          console.log(
            "🔍 Added interrupted recording with backup files to options"
          );
        } else {
          console.log(
            "⚠️ Skipping interrupted recording without backup files:",
            backup.sessionId
          );
        }
      }
    }

    // Add orphaned recordings found on disk
    for (const orphanedBackup of orphanedFiles) {
      console.log(
        "🔍 Adding orphaned file to options:",
        orphanedBackup.sessionId
      );
      options.push({
        backup: orphanedBackup,
        displayTitle: "Recovered Recording",
        displaySubtitle: `${this.formatDuration(
          orphanedBackup.totalDuration
        )} • ${this.formatDate(orphanedBackup.dateCreated)}`,
        action: "upload",
      });
    }

    return options;
  }

  private async scanForOrphanedRecordings(): Promise<RecordingBackup[]> {
    try {
      const recordingsDir = `${FileSystem.documentDirectory}recordings/`;
      const dirInfo = await FileSystem.getInfoAsync(recordingsDir);

      if (!dirInfo.exists) {
        console.log("🔍 Recordings directory does not exist");
        return [];
      }

      const files = await FileSystem.readDirectoryAsync(recordingsDir);
      console.log("🔍 Files in recordings directory:", files.length);

      const wavFiles = files.filter((file) => file.endsWith(".wav"));
      console.log("🔍 WAV files found:", wavFiles.length, wavFiles);

      // Separate backup files from regular files
      const backupFiles = wavFiles.filter((file) => file.startsWith("backup_"));
      const regularFiles = wavFiles.filter(
        (file) => !file.startsWith("backup_")
      );
      console.log("🔍 Backup files found:", backupFiles.length, backupFiles);
      console.log("🔍 Regular files found:", regularFiles.length, regularFiles);

      const existingBackups = recordingBackupService.getAllBackups();
      const orphanedBackups: RecordingBackup[] = [];

      // Process all WAV files (both regular and backup files)
      const allWavFiles = [...regularFiles, ...backupFiles];

      for (const fileName of allWavFiles) {
        const filePath = `${recordingsDir}${fileName}`;

        // Check if this file is already tracked in a backup
        const isTracked = existingBackups.some((backup) => {
          // Check consolidatedFilePath first
          if (backup.consolidatedFilePath === filePath) {
            return true;
          }

          // Check segments with pattern-aware matching
          return backup.segments.some((segment) => {
            // Exact match
            if (segment.filePath === filePath) {
              return true;
            }

            // Check if current file is backup version of a tracked segment
            // Convert segment path to both backup patterns and see if they match current file
            const segmentFileName = segment.filePath.split("/").pop() || "";
            const currentFileName = filePath.split("/").pop() || "";

            // Pattern 1: segment_* -> backup_segment_*
            const backupPattern1 = segmentFileName.replace(
              /segment_/,
              "backup_segment_"
            );
            if (currentFileName === backupPattern1) {
              return true;
            }

            // Pattern 2: segment_* -> backup_*
            const backupPattern2 = segmentFileName.replace(
              /segment_/,
              "backup_"
            );
            if (currentFileName === backupPattern2) {
              return true;
            }

            return false;
          });
        });

        if (!isTracked) {
          // Check if this file has already been processed as a failed upload
          if (recordingBackupService.isFileProcessed(filePath)) {
            console.log("🔍 Skipping already processed file:", fileName);
            continue;
          }

          // This is an orphaned file, create a backup for it
          const fileInfo = await FileSystem.getInfoAsync(filePath);
          if (fileInfo.exists && fileInfo.size && fileInfo.size > 1000) {
            // At least 1KB
            const estimatedDuration = this.estimateAudioDuration(fileInfo.size);

            if (estimatedDuration > 5000) {
              // Only if longer than 5 seconds
              const isBackupFile = fileName.startsWith("backup_");
              const baseFileName = isBackupFile
                ? fileName.replace("backup_", "")
                : fileName;

              // Use current time if modification time is invalid (before 2020)
              const minValidDate = new Date("2020-01-01");
              const modTime =
                fileInfo.modificationTime &&
                new Date(fileInfo.modificationTime) > minValidDate
                  ? new Date(fileInfo.modificationTime)
                  : new Date();

              const orphanedBackup: RecordingBackup = {
                id: `orphaned_${Date.now()}_${Math.random()
                  .toString(36)
                  .substring(2, 9)}`,
                sessionId: `orphaned_${baseFileName.replace(".wav", "")}`,
                userId: "orphaned", // Mark orphaned files as belonging to 'orphaned' user
                dateCreated: modTime,
                lastUpdated: modTime,
                totalDuration: estimatedDuration,
                isComplete: !isBackupFile, // Backup files are incomplete recordings
                segments: [
                  {
                    id: baseFileName.replace(".wav", ""),
                    filePath: filePath, // Store the actual file path (backup or regular)
                    duration: estimatedDuration,
                    startTime: 0,
                    endTime: estimatedDuration,
                  },
                ],
                consolidatedFilePath: isBackupFile ? filePath : filePath, // For backup files, use the backup file as consolidated
                hasShownRecoveryDialog: false,
                metadata: {
                  contentTitle: isBackupFile
                    ? `Interrupted Recording - ${this.formatDate(modTime)}`
                    : `Recovered Recording - ${this.formatDate(modTime)}`,
                },
              };

              orphanedBackups.push(orphanedBackup);
              console.log("🔍 Created orphaned backup for:", fileName, {
                isBackupFile,
                isComplete: orphanedBackup.isComplete,
                duration: estimatedDuration,
              });
            }
          }
        }
      }

      // Save orphaned backups to storage so they're tracked going forward
      for (const orphanedBackup of orphanedBackups) {
        recordingBackupService.addOrphanedBackup(orphanedBackup);
      }

      return orphanedBackups;
    } catch (error) {
      console.error("Error scanning for orphaned recordings:", error);
      return [];
    }
  }

  private async cleanupInvalidBackups(): Promise<void> {
    try {
      const allBackups = recordingBackupService.getAllBackups();
      const invalidBackups: string[] = [];

      for (const backup of allBackups) {
        console.log("🔍 Validating backup:", {
          sessionId: backup.sessionId,
          segments: backup.segments.length,
          consolidatedPath: backup.consolidatedFilePath,
          duration: backup.totalDuration,
          isComplete: backup.isComplete,
        });

        // For incomplete backups, check if they have backup files (from crash recovery)
        if (!backup.isComplete) {
          console.log(
            "⏳ Checking incomplete backup for backup files:",
            backup.sessionId
          );

          let hasBackupFile = false;
          // Check if any segments have backup files
          for (const segment of backup.segments) {
            // First check if the segment path itself is a backup file
            if (segment.filePath.includes("backup_")) {
              const backupInfo = await FileSystem.getInfoAsync(
                segment.filePath
              );
              if (backupInfo.exists) {
                console.log(
                  "✅ Found backup file for incomplete recording:",
                  segment.filePath
                );
                hasBackupFile = true;
                break;
              }
            } else {
              // Try to find corresponding backup file
              // Handle both patterns: segment_ -> backup_segment_ and segment_ -> backup_
              const fileName = segment.filePath.split("/").pop() || "";
              const directory = segment.filePath.replace(fileName, "");

              // Try backup_segment_ pattern first (most common)
              const backupPath1 =
                directory + fileName.replace(/segment_/, "backup_segment_");
              const backupInfo1 = await FileSystem.getInfoAsync(backupPath1);
              if (backupInfo1.exists) {
                console.log(
                  "✅ Found backup file for incomplete recording (pattern 1):",
                  backupPath1
                );
                hasBackupFile = true;
                break;
              }

              // Try backup_ pattern as fallback
              const backupPath2 =
                directory + fileName.replace(/segment_/, "backup_");
              const backupInfo2 = await FileSystem.getInfoAsync(backupPath2);
              if (backupInfo2.exists) {
                console.log(
                  "✅ Found backup file for incomplete recording (pattern 2):",
                  backupPath2
                );
                hasBackupFile = true;
                break;
              }
            }
          }

          // If no backup files found for incomplete recording, mark for cleanup
          if (!hasBackupFile && backup.segments.length > 0) {
            console.log(
              "❌ Incomplete backup has no backup files, marking for cleanup:",
              backup.sessionId
            );
            invalidBackups.push(backup.sessionId);
          }

          continue;
        }

        let hasValidFile = false;

        // Check consolidated file first
        if (backup.consolidatedFilePath) {
          const consolidatedInfo = await FileSystem.getInfoAsync(
            backup.consolidatedFilePath
          );
          if (consolidatedInfo.exists) {
            console.log(
              "✅ Backup has valid consolidated file:",
              backup.sessionId
            );
            hasValidFile = true;
          }
        }

        // If no consolidated file, check segments
        if (!hasValidFile && backup.segments.length > 0) {
          for (const segment of backup.segments) {
            const segmentInfo = await FileSystem.getInfoAsync(segment.filePath);
            if (segmentInfo.exists) {
              console.log(
                "✅ Backup has valid segment file:",
                backup.sessionId,
                segment.filePath
              );
              hasValidFile = true;
              break;
            }
          }
        }

        // Only mark completed backups as invalid if they have no files
        if (!hasValidFile) {
          console.log(
            "❌ Completed backup has no valid files, marking for cleanup:",
            backup.sessionId
          );
          invalidBackups.push(backup.sessionId);
        }
      }

      // Remove invalid backups
      for (const sessionId of invalidBackups) {
        console.log("🗑️ Removing invalid backup:", sessionId);
        recordingBackupService.removeBackup(sessionId);
      }

      if (invalidBackups.length > 0) {
        console.log(`✅ Cleaned up ${invalidBackups.length} invalid backup(s)`);
      }
    } catch (error) {
      console.error("❌ Error cleaning up invalid backups:", error);
    }
  }

  private async checkForBackupFiles(backup: RecordingBackup): Promise<boolean> {
    try {
      // Check if any segments have corresponding backup files
      for (const segment of backup.segments) {
        // First check if the segment path itself is a backup file
        if (segment.filePath.includes("backup_")) {
          const backupInfo = await FileSystem.getInfoAsync(segment.filePath);
          if (backupInfo.exists) {
            console.log("✅ Found backup file for segment:", segment.filePath);
            return true;
          }
        } else {
          // Try to find corresponding backup file
          // Handle both patterns: segment_ -> backup_segment_ and segment_ -> backup_
          const fileName = segment.filePath.split("/").pop() || "";
          const directory = segment.filePath.replace(fileName, "");

          // Try backup_segment_ pattern first (most common)
          const backupPath1 =
            directory + fileName.replace(/segment_/, "backup_segment_");
          const backupInfo1 = await FileSystem.getInfoAsync(backupPath1);
          if (backupInfo1.exists) {
            console.log(
              "✅ Found backup file for segment (pattern 1):",
              backupPath1
            );
            return true;
          }

          // Try backup_ pattern as fallback
          const backupPath2 =
            directory + fileName.replace(/segment_/, "backup_");
          const backupInfo2 = await FileSystem.getInfoAsync(backupPath2);
          if (backupInfo2.exists) {
            console.log(
              "✅ Found backup file for segment (pattern 2):",
              backupPath2
            );
            return true;
          }
        }
      }
      return false;
    } catch (error) {
      console.error("❌ Error checking for backup files:", error);
      return false;
    }
  }

  private estimateAudioDuration(fileSize: number): number {
    // Rough estimation for WAV files at 16kHz, 16-bit, mono (matches actual recording settings)
    // Formula: duration = fileSize / (sampleRate * bytesPerSample * channels)
    const sampleRate = 16000; // Correct sample rate used by recording service
    const bytesPerSample = 2; // 16-bit = 2 bytes
    const channels = 1; // mono
    const headerSize = 44; // WAV header is typically 44 bytes

    const audioDataSize = fileSize - headerSize;
    const durationSeconds =
      audioDataSize / (sampleRate * bytesPerSample * channels);
    return Math.max(0, durationSeconds * 1000); // Convert to milliseconds
  }

  private async waitForAuthentication(): Promise<void> {
    const maxRetries = 30; // 30 attempts
    const retryDelay = 1000; // 1 second between attempts

    for (let attempt = 1; attempt <= maxRetries; attempt++) {
      try {
        await getUserID(); // This will throw if not authenticated
        console.log("✅ Authentication confirmed, proceeding with upload");
        return;
      } catch (error) {
        const errorMessage =
          error instanceof Error ? error.message : String(error);
        console.log(
          `🔍 Authentication not ready (attempt ${attempt}/${maxRetries}):`,
          errorMessage
        );

        if (attempt === maxRetries) {
          throw new Error(
            "Authentication timeout - could not verify user session after 30 seconds"
          );
        }

        await new Promise((resolve) => setTimeout(resolve, retryDelay));
      }
    }
  }

  // Debug function to check backup files
  private async debugBackupFiles(): Promise<void> {
    try {
      const recordingsDir = `${FileSystem.documentDirectory}recordings/`;
      const dirInfo = await FileSystem.getInfoAsync(recordingsDir);

      console.log("🔍 DEBUG: Recordings directory exists:", dirInfo.exists);

      if (!dirInfo.exists) {
        return;
      }

      const files = await FileSystem.readDirectoryAsync(recordingsDir);
      console.log("🔍 DEBUG: Files in recordings directory:", files);

      for (const file of files) {
        const filePath = `${recordingsDir}${file}`;
        const fileInfo = await FileSystem.getInfoAsync(filePath);
        console.log(`🔍 DEBUG: ${file}:`, {
          exists: fileInfo.exists,
          size: (fileInfo as any).size || 0,
          modified: new Date(
            (fileInfo as any).modificationTime || 0
          ).toISOString(),
          uri: fileInfo.uri,
          isDirectory: fileInfo.isDirectory,
        });

        // Double-check file access immediately
        if (fileInfo.exists) {
          try {
            const doubleCheck = await FileSystem.getInfoAsync(filePath);
            console.log(`🔍 DEBUG: Double-check ${file}:`, {
              exists: doubleCheck.exists,
              size: (doubleCheck as any).size || 0,
            });
          } catch (error) {
            console.log(`🔍 DEBUG: Error double-checking ${file}:`, error);
          }
        }
      }

      const allBackups = recordingBackupService.getAllBackups();
      console.log("🔍 DEBUG: Backups in MMKV:", allBackups.length);
      allBackups.forEach((backup, i) => {
        console.log(`🔍 DEBUG: Backup ${i + 1}:`, {
          sessionId: backup.sessionId,
          isComplete: backup.isComplete,
          duration: backup.totalDuration,
          segments: backup.segments.length,
          consolidatedPath: backup.consolidatedFilePath,
          segmentPaths: backup.segments.map((s) => s.filePath),
        });
      });
    } catch (error) {
      console.error("🔍 DEBUG: Error checking backup files:", error);
    }
  }

  async showRecoveryDialog(): Promise<void> {
    console.log("🔍 RecoveryService: Starting recovery check...");

    // Debug: Check what files exist on disk
    await this.debugBackupFiles();

    const recoveryOptions = await this.checkForRecoverableRecordings();

    console.log(
      "🔍 RecoveryService: Found",
      recoveryOptions.length,
      "recovery options"
    );
    recoveryOptions.forEach((option, index) => {
      console.log(`🔍 Recovery Option ${index + 1}:`, {
        title: option.displayTitle,
        subtitle: option.displaySubtitle,
        action: option.action,
        sessionId: option.backup.sessionId,
        isComplete: option.backup.isComplete,
        duration: option.backup.totalDuration,
        segments: option.backup.segments.length,
      });
    });

    if (recoveryOptions.length === 0) {
      console.log(
        "🔍 RecoveryService: No recovery options, not showing dialog"
      );
      return;
    }

    if (recoveryOptions.length === 1) {
      console.log("🔍 RecoveryService: Showing single recovery dialog");
      this.showSingleRecoveryAlert(recoveryOptions[0]);
    } else {
      console.log("🔍 RecoveryService: Showing multiple recoveries dialog");
      this.showMultipleRecoveriesAlert(recoveryOptions);
    }
  }

  private showSingleRecoveryAlert(option: RecoveryOption): void {
    const title =
      option.action === "resume" ? "Upload Recording?" : "Upload Recording?";
    const message = `Found ${option.displayTitle.toLowerCase()}: ${
      option.displaySubtitle
    }`;

    Alert.alert(
      title,
      message,
      [
        {
          text: "Save to Failed",
          style: "cancel",
          onPress: async () => {
            console.log(
              "🚫 User chose 'Save to Failed' - marking recording as shown permanently"
            );
            // Mark dialog as shown BEFORE processing to prevent re-showing
            recordingBackupService.markRecoveryDialogShown(
              option.backup.sessionId
            );

            // Additional failsafe: Force mark using direct storage method
            setTimeout(() => {
              recordingBackupService.forceMarkRecordingAsShown(
                option.backup.sessionId
              );
            }, 100);

            // Add to pending uploads so it appears in failed uploads page
            await this.addBackupToPendingUploads(option.backup);
            Toast.show({
              type: "info",
              text1: "Recording Saved",
              text2: "Available in Failed Uploads page",
              topOffset: 50,
            });
          },
        },
        {
          text: "Upload Now",
          style: "default",
          onPress: () => {
            // Mark dialog as shown BEFORE processing to prevent re-showing
            recordingBackupService.markRecoveryDialogShown(
              option.backup.sessionId
            );
            this.handleRecoveryAction(option);
          },
        },
      ],
      {
        cancelable: true,
        onDismiss: () => {
          // Mark as shown even if user dismisses the dialog
          recordingBackupService.markRecoveryDialogShown(
            option.backup.sessionId
          );
        },
      }
    );
  }

  private showMultipleRecoveriesAlert(options: RecoveryOption[]): void {
    Alert.alert(
      "Recover Recordings?",
      `Found ${options.length} recording${
        options.length > 1 ? "s" : ""
      } that can be recovered.`,
      [
        {
          text: "View All",
          style: "default",
          onPress: () => {
            // Mark all as shown when user chooses to view all
            options.forEach((option) => {
              recordingBackupService.markRecoveryDialogShown(
                option.backup.sessionId
              );
            });
            router.navigate("/home/failedUploads");
          },
        },
        {
          text: "Later",
          style: "cancel",
          onPress: () => {
            console.log(
              "🚫 User chose 'Later' - marking all recordings as shown permanently"
            );
            // Mark all as shown when user chooses "Later"
            options.forEach((option) => {
              console.log(
                `🚫 Marking ${option.backup.sessionId} as shown (user chose Later)`
              );
              recordingBackupService.markRecoveryDialogShown(
                option.backup.sessionId
              );
            });

            // Additional failsafe: Force mark using direct storage method
            setTimeout(() => {
              console.log("🚫 Failsafe: Force marking all recordings as shown");
              options.forEach((option) => {
                recordingBackupService.forceMarkRecordingAsShown(
                  option.backup.sessionId
                );
              });
            }, 100);
          },
        },
      ],
      {
        cancelable: true,
        onDismiss: () => {
          // Mark all as shown even if user dismisses the dialog
          options.forEach((option) => {
            recordingBackupService.markRecoveryDialogShown(
              option.backup.sessionId
            );
          });
        },
      }
    );
  }

  private async handleRecoveryAction(option: RecoveryOption): Promise<void> {
    switch (option.action) {
      case "resume":
      case "upload":
        // Navigate to dedicated upload screen with progress modal
        router.navigate({
          pathname: "/home/uploadRecording",
          params: { sessionId: option.backup.sessionId },
        });
        break;
      case "discard":
        // Permanently remove the backup and clean up files
        await this.discardBackup(option.backup);
        break;
    }
  }

  private async discardBackup(backup: RecordingBackup): Promise<void> {
    try {
      console.log("🗑️ Discarding backup:", backup.sessionId);

      // Remove backup metadata from MMKV
      recordingBackupService.removeBackup(backup.sessionId);

      // Clean up audio files from disk
      const filesToDelete: string[] = [];

      // Add consolidated file if it exists
      if (backup.consolidatedFilePath) {
        filesToDelete.push(backup.consolidatedFilePath);
      }

      // Add all segment files
      for (const segment of backup.segments) {
        if (segment.filePath) {
          filesToDelete.push(segment.filePath);
        }
      }

      // Delete files from disk
      for (const filePath of filesToDelete) {
        try {
          const fileInfo = await FileSystem.getInfoAsync(filePath);
          if (fileInfo.exists) {
            await FileSystem.deleteAsync(filePath);
            console.log("🗑️ Deleted file:", filePath);
          }
        } catch (fileError) {
          console.warn("⚠️ Could not delete file:", filePath, fileError);
        }
      }

      Toast.show({
        type: "info",
        text1: "Recording Discarded",
        text2: "Backup has been permanently removed",
        topOffset: 50,
      });

      console.log("✅ Backup successfully discarded");
    } catch (error) {
      console.error("❌ Error discarding backup:", error);
      Toast.show({
        type: "error",
        text1: "Discard Error",
        text2: "Could not fully remove backup",
        topOffset: 50,
      });
    }
  }

  private async addBackupToPendingUploads(
    backup: RecordingBackup
  ): Promise<void> {
    try {
      console.log("🔍 Converting backup to pending upload:", {
        sessionId: backup.sessionId,
        segments: backup.segments.length,
        consolidatedPath: backup.consolidatedFilePath,
      });

      // Wait for authentication to be established before processing upload
      await this.waitForAuthentication();

      // Get the user ID to construct the proper path
      const userId = await getUserID();
      if (!userId) {
        throw new Error("User ID not available for backup upload");
      }

      // Debug: Check if files still exist before processing
      if (backup.consolidatedFilePath) {
        const consolidatedCheck = await FileSystem.getInfoAsync(
          backup.consolidatedFilePath
        );
        console.log("🔍 DEBUG: Consolidated file check before processing:", {
          path: backup.consolidatedFilePath,
          exists: consolidatedCheck.exists,
          size: (consolidatedCheck as any).size || 0,
        });
      }

      for (const segment of backup.segments) {
        const segmentCheck = await FileSystem.getInfoAsync(segment.filePath);
        console.log("🔍 DEBUG: Segment file check before processing:", {
          path: segment.filePath,
          exists: segmentCheck.exists,
          size: (segmentCheck as any).size || 0,
        });
      }

      // Get the audio file path for this backup
      const audioFilePath =
        await recordingBackupService.getConsolidatedFileForBackup(backup);

      console.log("🔍 Audio file path:", audioFilePath);

      // Debug: If no audio file found, try to manually check the recordings directory
      if (!audioFilePath) {
        console.log(
          "🔍 DEBUG: No audio file found, manually checking directory..."
        );
        try {
          const recordingsDir = `${FileSystem.documentDirectory}recordings/`;
          const files = await FileSystem.readDirectoryAsync(recordingsDir);
          console.log("🔍 DEBUG: Files still in directory:", files);

          // Try to find any file that matches our session/segment
          const sessionId = backup.sessionId.replace("orphaned_", "");
          const matchingFiles = files.filter((file) =>
            file.includes(sessionId)
          );
          console.log("🔍 DEBUG: Matching files for session:", matchingFiles);

          if (matchingFiles.length > 0) {
            const manualPath = `${recordingsDir}${matchingFiles[0]}`;
            const manualCheck = await FileSystem.getInfoAsync(manualPath);
            console.log("🔍 DEBUG: Manual file check:", {
              path: manualPath,
              exists: manualCheck.exists,
              size: (manualCheck as any).size || 0,
            });
          }
        } catch (dirError) {
          console.log("🔍 DEBUG: Error checking directory manually:", dirError);
        }
      }

      if (!audioFilePath) {
        console.error("❌ No audio file found for backup:", backup.sessionId);
        // Try using first segment path as fallback
        if (backup.segments.length > 0) {
          const segmentPath = backup.segments[0].filePath;
          console.log("🔍 Trying first segment as fallback:", segmentPath);

          // Check if segment file exists
          const segmentInfo = await FileSystem.getInfoAsync(segmentPath);
          if (segmentInfo.exists) {
            console.log("✅ Using segment file as audio source");
            this.createPendingUpload(backup, segmentPath, userId);
            return;
          }
        }

        console.error("❌ No valid audio file found for backup");
        Toast.show({
          type: "error",
          text1: "Audio File Missing",
          text2: "Recording file could not be found",
          topOffset: 50,
        });
        return;
      }

      // Check if the consolidated file actually exists
      const fileInfo = await FileSystem.getInfoAsync(audioFilePath);
      console.log("🔍 File info:", {
        exists: fileInfo.exists,
        size: fileInfo.exists ? (fileInfo as any).size : 0,
        path: audioFilePath,
      });

      if (!fileInfo.exists) {
        console.error("❌ Audio file does not exist at path:", audioFilePath);
        Toast.show({
          type: "error",
          text1: "Audio File Missing",
          text2: "Recording file was not found on disk",
          topOffset: 50,
        });
        return;
      }

      this.createPendingUpload(backup, audioFilePath, userId);
    } catch (error) {
      console.error("❌ Error converting backup to pending upload:", error);
      Toast.show({
        type: "error",
        text1: "Error Processing Recording",
        text2: "Unable to prepare recording for upload",
        topOffset: 50,
      });
    }
  }

  private createPendingUpload(
    backup: RecordingBackup,
    audioFilePath: string,
    userId: string
  ): void {
    // Create a pending upload entry that matches the existing failed uploads format
    const pendingUpload: PendingUpload = {
      id: backup.sessionId, // Use backup session ID
      audioURI: audioFilePath,
      path: `${userId}/${uuid.v4()}.mp3`, // Use user folder with UUID to match RLS policy
      folderId: null,
      progress: 0,
      status: "pending",
      dateCreated: backup.dateCreated,
    };

    console.log("🔍 Creating pending upload:", {
      id: pendingUpload.id,
      audioURI: pendingUpload.audioURI,
      path: pendingUpload.path,
      dateCreated: pendingUpload.dateCreated,
    });

    // Add to the pending uploads system
    addPendingUpload(pendingUpload);

    // Mark the audio file as processed to prevent re-detection as orphaned
    recordingBackupService.markFileAsProcessed(audioFilePath);

    // Also mark all associated files for this backup as processed
    const allFilePaths = recordingBackupService.getAllFilePathsForBackup(
      backup.sessionId
    );
    for (const filePath of allFilePaths) {
      recordingBackupService.markFileAsProcessed(filePath);
    }

    // DON'T remove the backup here - it should remain marked as shown
    // The backup will be removed when the upload actually completes successfully
    // This prevents the recovery dialog from showing again on app restart
    console.log(
      "✅ Backup converted to pending upload and kept in backups with shown flag:",
      backup.sessionId
    );
  }

  private formatDuration(milliseconds: number): string {
    const totalSeconds = Math.floor(milliseconds / 1000);
    const minutes = Math.floor(totalSeconds / 60);
    const seconds = totalSeconds % 60;
    return `${minutes}:${seconds.toString().padStart(2, "0")}`;
  }

  private formatDate(date: Date): string {
    const now = new Date();
    const diffMs = now.getTime() - date.getTime();
    const diffHours = Math.floor(diffMs / (1000 * 60 * 60));

    if (diffHours < 1) {
      return "Just now";
    } else if (diffHours < 24) {
      return `${diffHours}h ago`;
    } else {
      const diffDays = Math.floor(diffHours / 24);
      return `${diffDays}d ago`;
    }
  }

  // Method to clear all recovery state for current user (useful for user logout)
  async clearAllRecoveryState(): Promise<void> {
    try {
      console.log("🧹 Clearing recording recovery state for current user...");

      // Clear current user's backups and associated files
      await recordingBackupService.clearCurrentUserBackups();

      // Clear the processed files tracking
      recordingBackupService.clearProcessedFiles();

      console.log("✅ Recovery state cleared successfully for current user");
    } catch (error) {
      console.error("❌ Error clearing recovery state:", error);
    }
  }

  // Method to mark all existing backups as shown (prevents alerts for new user)
  markAllBackupsAsShown(): void {
    try {
      console.log("🏷️ Marking all existing backups as shown...");

      const allBackups = recordingBackupService.getAllBackups();

      for (const backup of allBackups) {
        if (!backup.hasShownRecoveryDialog) {
          recordingBackupService.markRecoveryDialogShown(backup.sessionId);
        }
      }

      console.log(`✅ Marked ${allBackups.length} backups as shown`);
    } catch (error) {
      console.error("❌ Error marking backups as shown:", error);
    }
  }
}

export const recordingRecoveryService = RecordingRecoveryService.getInstance();
