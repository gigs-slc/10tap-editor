<file path="src/data/topics/hooks/useTopicRowsQuery.ts">
import {QueryClient, useQuery, useQueryClient, UseQueryResult} from "@tanstack/react-query";
import {ContentTopic} from "@data/topics/types";
import {getTopicRowsQuery} from "@data/topics/queries";
import {useEffect} from "react";

export const useTopicRowsQuery = (content_id: string): UseQueryResult<ContentTopic[]> => {
    const queryClient: QueryClient = useQueryClient();
    const query = useQuery<ContentTopic[], Error>({
        queryKey: ['topics', 'list', 'content', content_id],
        queryFn: (): Promise<ContentTopic[]> => getTopicRowsQuery(content_id),
    });

    // onSuccess no longer exists, use this pattern w/ useEffects
    useEffect(() => {
        if (!query.data || !query.isSuccess) return;

        query.data.forEach((topic: ContentTopic ) => {
            queryClient.setQueryData(['topics', 'individual', topic.topic_id], topic)
        })

    }, [query.data, query.isSuccess]);

    return query;
}
</file>

