import {getUserAccessToken} from "@/utils/auth";
import {MODAL_URL} from "@/common/environment";

export const generateQuizQuestions = async (contentID: string, topicIDs: string[], isUserSubscribed: boolean) => {
    const accessToken = await getUserAccessToken();
    try {
        const response = await fetch(`${MODAL_URL}-create-quiz-question.modal.run`, {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${accessToken}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                content_id: contentID,
                topic_ids: topicIDs,
                is_user_subscribed: isUserSubscribed
            })
        });

        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        const jsonResponse = await response.json();
        
        if (jsonResponse.not_enough_credits) {
            throw new Error('NOT_ENOUGH_CREDITS');
        }
        
        return jsonResponse;
    } catch (error) {
        console.log(error)
        if (error instanceof Error && error.message === 'NOT_ENOUGH_CREDITS') {
            throw error;
        }
        throw new Error('Failed to generate quiz response from MODAL API');
    }
};
</file>

