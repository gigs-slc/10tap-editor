import {
    FlatList,
    TextInput,
    View,
    Keyboard,
    TouchableOpacity
} from "react-native";
import {Text} from "@/common/generics/Text";
import {onboardingStyles as onboardingStylesheet} from "@/common/styles/onboarding";
import { UniversitiesJSON} from "../../../../assets/data/universities";
import {useState, useEffect} from "react";
import {UniversityType} from "@/types/db.types";
import UniversityRow from "@/components/login/universityRow";
import {heavyHaptic} from "@/utils/haptic";
import {moderateScale} from "react-native-size-matters";
import {useAtom} from "jotai/index";
import {onboardingDataAtom} from "@/utils/atoms";
import {PostHog, usePostHog} from "posthog-react-native"
import { createStyleSheet, useStyles } from 'react-native-unistyles';

export default function ChooseCollegeScreen({ onNext } : { onNext: any }) {
    const[search, setSearch] = useState("");
    const[universities, setUniversities] = useState<UniversityType[]>(UniversitiesJSON.sort((a, b) => (b.weight || 0) - (a.weight || 0)).slice(0, 30));
    const[onboardingData, setOnboardingData] = useAtom(onboardingDataAtom);
    const posthog : PostHog = usePostHog();
    const { styles } = useStyles(stylesheet);
    const { styles: onboardingStyles } = useStyles(onboardingStylesheet);

    useEffect(() => {
        const filteredUniversities = UniversitiesJSON.filter(uni =>
            uni.name.toLowerCase().includes(search.toLowerCase()) ||
            uni.web_pages?.some(page => page.toLowerCase().includes(search.toLowerCase())) ||
            uni.domains?.some(domain => domain.toLowerCase().includes(search.toLowerCase())) ||
            uni.slang?.toLowerCase().includes(search.toLowerCase())
        )
            .sort((a, b) => {
                if (a.country === 'United States' && b.country !== 'United States') return -1;
                if (b.country === 'United States' && a.country !== 'United States') return 1;
                return (b.weight || 0) - (a.weight || 0);
            })
            .slice(0, 30);
        setUniversities(filteredUniversities);
    }, [search]);


    const handlePress = (universityID : string) => {
        void heavyHaptic();
        const selectedUniversity = UniversitiesJSON.find(uni => uni.university_id === universityID);
        posthog.capture('User answered college question', {
            universityID: universityID,
            universityName: selectedUniversity ? selectedUniversity.name : 'Unknown'
        })
        setOnboardingData((prev ) => {
            return { ...prev, universityID: universityID}
        });
        onNext(selectedUniversity ? selectedUniversity.name : 'Unknown');
    }

    const handleScroll = () => {
        Keyboard.dismiss();
    }

    return <View style={styles.container}>
        <View style={styles.content}>
            <View style={{marginTop: 10}}/>
            <Text style={onboardingStyles.title}>Select your college</Text>
            <TextInput
                value={search}
                onChangeText={setSearch}
                style={[styles.textInput]}
                placeholder={'Search college name...'}
                placeholderTextColor={'#8c8c8c'}
            />
            <View style={{marginTop: 10}}/>
            <FlatList
                data={universities}
                renderItem={({item} : { item : UniversityType}) => {
                    return <UniversityRow university={item} key={item.university_id} handlePress={handlePress}/>
                }}
                showsVerticalScrollIndicator={false}
                onScrollBeginDrag={handleScroll}
                contentContainerStyle={styles.listContainer}
            />
        </View>
        <View style={styles.buttonContainer}>
            <TouchableOpacity style={[onboardingStyles.unavailableButton]} onPress={() => {
                void heavyHaptic();
                void onNext()
            }}>
                <Text style={[onboardingStyles.unavailableText]}>Skip Question</Text>
            </TouchableOpacity>
        </View>
    </View>
}

const stylesheet = createStyleSheet((theme) => ({
    container: {
        flex: 1,
        justifyContent: 'space-between',
        paddingBottom: 20,
    },
    content: {
        flex: 1,
    },
    textInput: {
        paddingVertical: 20,
        borderRadius: 20,
        alignSelf: 'center',
        width: {
            xs: '100%'
        },
        paddingHorizontal: 20,
        borderColor: '#000', 
        color: '#fff',
        marginTop: 10,
        fontSize: moderateScale(15),
        fontFamily: 'Sans-Medium',
        backgroundColor: "rgba(0,0,0,0.3)"
    },
    listContainer: {
        paddingBottom: 20
    },
