import { PendingUpload } from "@/types/db.types";
import { storage } from "@/utils/mmkv";
import { PENDING_UPLOADS_KEY } from "@/common/constants";
import { Upload } from "tus-js-client";
import { SUPABASE_URL } from "@/common/environment";
import { getAudioFileURL } from "@/utils/general";
import { getUserAccessToken } from "@/utils/auth";
import { Folder } from "@/data/folders/types";
import * as FileSystem from "expo-file-system";
import { Platform } from "react-native";
import { supabase } from "@/utils/supabase";

interface UploadCallbacks {
  onProgress?: (
    bytesUploaded: number,
    bytesTotal: number,
    progress: number
  ) => void;
  onError?: (error: Error) => void;
  onSuccess?: (fileLink: string) => void;
}

interface UploadResponse {
  upload: Upload;
  cancel: () => void;
  progress: number;
}

export async function uploadAudioFileTUS(
  audioURI: string,
  path: string,
  currentFolder: Folder | null,
  shouldPreventPendingCreation: boolean = false,
  callbacks?: UploadCallbacks
): Promise<UploadResponse> {

  if (Platform.OS === "android") {

    // Check if file exists
    const fileInfo = await FileSystem.getInfoAsync(audioURI);
    if (!fileInfo.exists) {
      throw new Error(`Audio file does not exist at URI: ${audioURI}`);
    }

    // Create FormData with file object (like PDF upload in general.ts)
    const audioFile = {
      uri: audioURI,
      type: "audio/wav",
      name: "audio.wav",
    };

    const formData = new FormData();
    // @ts-ignore - React Native FormData accepts this format
    formData.append("file", audioFile);

    try {
      // Use direct Supabase upload like PDF upload
      const { data, error } = await supabase.storage
        .from("audio")
        .upload(path, formData, {
          contentType: "audio/wav",
          upsert: true,
        });

      if (error) {
        throw new Error("Error uploading audio file: " + error.message);
      }



      // Call the success callback directly
      if (callbacks?.onSuccess) {
        callbacks.onSuccess(getAudioFileURL(data.path));
      }

      // Return a mock upload object for compatibility
      return {
        upload: {} as Upload,
        cancel: () => console.log("Cancel called on direct upload"),
        progress: 100,
      };
    } catch (supabaseError) {
      throw supabaseError;
    }
  } else {

    let blob: Blob;
    try {
      const response = await fetch(audioURI);
      if (!response.ok) {
        throw new Error(`Direct fetch failed: ${response.status}`);
      }
      blob = await response.blob();
    } catch (directFetchError) {
      const errorMessage =
        directFetchError instanceof Error
          ? directFetchError.message
          : String(directFetchError);
      throw directFetchError;
    }

    // Continue with TUS upload for iOS
    let progress = 0;

    const uploadId = `upload_${Date.now()}`;
    const pendingUpload: PendingUpload = {
      id: uploadId,
      audioURI: audioURI,
      path: path,
      folderId: currentFolder?.folder_id || null,
      progress: 0,
      status: "pending",
      dateCreated: new Date(),
    };

    if (!shouldPreventPendingCreation) addPendingUpload(pendingUpload);
    const accessToken = await getUserAccessToken();

    const upload = new Upload(blob, {
      endpoint: `${SUPABASE_URL}/storage/v1/upload/resumable`,
      retryDelays: RETRY_DELAYS,
      headers: {
        authorization: `Bearer ${accessToken}`,
        "x-upsert": "true",
        "retry-after": "true",
        timeout: "3600",
      },
      uploadDataDuringCreation: true,
      removeFingerprintOnSuccess: true,
      overridePatchMethod: false,
      metadata: {
        bucketName: "audio",
        objectName: path,
        contentType: "audio/mp4",
        cacheControl: "3600",
      },
      chunkSize: 6 * 1024 * 1024,
      onError: (error) => {
        console.error("🚨 TUS Upload Error Details:", {
          message: error.message,
          stack: error.stack,
          errorType: error.constructor.name,
          fullError: error,
        });
        callbacks?.onError?.(error);
      },
      onProgress: (bytesUploaded, bytesTotal) => {
        progress = Number(((bytesUploaded / bytesTotal) * 100).toFixed(2));
        callbacks?.onProgress?.(bytesUploaded, bytesTotal, progress);
      },
      onSuccess: async () => {
        if (!shouldPreventPendingCreation) removeUploadStorage(uploadId);
        callbacks?.onSuccess?.(getAudioFileURL(path));
      },
    });

    upload.start();

    return {
      upload,
      cancel: () => upload.abort(),
      progress,
    };
  }
}

export function addPendingUpload(upload: PendingUpload) {
  const uploads = getPendingUploads();
  storage.set(PENDING_UPLOADS_KEY, JSON.stringify([...uploads, upload]));
}

export function getPendingUploads(): PendingUpload[] {
  const uploads = storage.getString(PENDING_UPLOADS_KEY);
  return uploads ? JSON.parse(uploads) : [];
}

export function updateUploadProgress(uploadId: string, progress: number) {
  const uploads = getPendingUploads();
  const updatedUploads = uploads.map((upload) =>
    upload.id === uploadId ? { ...upload, progress } : upload
  );
  storage.set(PENDING_UPLOADS_KEY, JSON.stringify(updatedUploads));
}

export function removeUploadStorage(uploadId: string) {
  const uploads = getPendingUploads();
  const filteredUploads = uploads.filter((upload) => upload.id !== uploadId);
  storage.set(PENDING_UPLOADS_KEY, JSON.stringify(filteredUploads));
}

const RETRY_DELAYS = [
  0, // Immediate first retry
  1000, // 1 second
  2000, // 2 seconds
  5000, // 5 seconds
  10000, // 10 seconds
  20000, // 20 seconds
  30000, // 30 seconds
  45000, // 45 seconds
  60000, // 1 minute
  90000, // 1.5 minutes
  120000, // 2 minutes
  180000, // 3 minutes
  300000, // 5 minutes
  600000, // 10 minutes
];
</file>

