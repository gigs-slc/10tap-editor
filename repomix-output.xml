import React, {useCallback, useMemo, useRef} from "react";
import {Text, View} from "react-native";
import BottomSheet from "@gorhom/bottom-sheet";
import UnsafeContainer from "@/common/generics/UnsafeContainer";
import {windowWidth} from "@/utils/window";
import {createStyleSheet, useStyles} from "react-native-unistyles";
import {Portal} from "react-native-portalize";
import {JoinedQuestion} from "@data/quiz_questions/types";
import QuizMarkdownText from "@/components/notes/insideScreens/Quizzes/QuizMarkdownText";

export default function HintSheet({questionObject, index, setIndex} : { questionObject: JoinedQuestion | null; index: number; setIndex: any; }) {
    const bottomSheetRef = useRef<BottomSheet>(null);
    const snapPoints = useMemo(() => ["50%"], []);
    const { styles, theme } = useStyles(stylesheet);

    const handleSheetChanges = useCallback((index: number) => {
        setIndex(index);
    }, [setIndex]);

    if (!questionObject) return null;

    return (
        <Portal>
            <BottomSheet
                ref={bottomSheetRef}
                index={index}
                backgroundStyle={styles.bottomSheetBackground}
                handleIndicatorStyle={styles.bottomSheetHandleIndicator}
                handleStyle={styles.bottomSheetHandle}
                enablePanDownToClose={true}
                snapPoints={snapPoints}
                onChange={handleSheetChanges}
            >
                <UnsafeContainer style={styles.container} >
                    <View style={styles.hintContainer}>
                        <Text style={styles.hintTitle}>Hint 💡</Text>
                        <QuizMarkdownText
                            content={questionObject.hint || ""}
                            fontSize={16}
                            fontFamily="Sans-Regular"
                            lineHeight={24}
                        />
                    </View>
                </UnsafeContainer>
            </BottomSheet>
        </Portal>
    );
}

