import React, { useState, useEffect } from 'react';
import { ScrollView, TextInput, Keyboard, SafeAreaView } from 'react-native';
import { languagesArray } from '@/common/data/languages';
import { moderateScale } from 'react-native-size-matters';
import { heavyHaptic } from '@/utils/haptic';
import LanguageSettingsRow from '@/components/settings/languageSettingsRow';
import { usePostHog } from 'posthog-react-native';
import { createStyleSheet, useStyles } from 'react-native-unistyles';
import UnsafeContainer from '@/common/generics/UnsafeContainer';
import BackHeader from '@/common/components/headers/backHeader';
import { router } from 'expo-router';
import { useUpdateCurrentStudentMutation } from "@data/student/hooks/useUpdateStudentMutation";

export default function ChangeLanguageScreen() {
    const { styles, theme } = useStyles(stylesheet);
    const [search, setSearch] = useState("");
    const [filteredLanguages, setFilteredLanguages] = useState(languagesArray);
    const posthog = usePostHog();
    const updateCurrentStudent = useUpdateCurrentStudentMutation();

    useEffect(() => {
        const filtered = languagesArray
            .filter(language =>
                language.name.toLowerCase().includes(search.toLowerCase())
            )
            .sort((a, b) => {
                // English
                if (a.code === 'en') return -1;
                if (b.code === 'en') return 1;
                // Spanish
                if (a.code === 'es') return -1;
                if (b.code === 'es') return 1;
                // Rest alphabetically
                return a.name.localeCompare(b.name);
            });
        setFilteredLanguages(filtered);
    }, [search]);

    const handlePress = async (languageCode: string) => {
        void heavyHaptic();
        const selectedLanguage = languagesArray.find(lang => lang.code === languageCode);
        posthog.capture('User changed language to', {
            languageCode: languageCode,
            languageName: selectedLanguage ? selectedLanguage.name : 'Unknown'
        });


        updateCurrentStudent.mutate({
            language_code: languageCode,
            language_name: selectedLanguage?.name || 'English'
        })

        router.back();
    };

    const handleScroll = () => {
        Keyboard.dismiss();
    };

    return (
        <UnsafeContainer>
            <SafeAreaView>
                <BackHeader title={'Change Language'} textStyle={{}} />
            </SafeAreaView>

            <TextInput
                value={search}
                onChangeText={setSearch}
                style={styles.textInput}
                placeholder={'Search language...'}
                placeholderTextColor={theme.colors.grays.PRIMARY}
            />

            <ScrollView
                style={styles.scrollView}
                showsVerticalScrollIndicator={false}
                onScrollBeginDrag={handleScroll}
            >
                {filteredLanguages.map((language) => (
                    <LanguageSettingsRow
                        key={language.code}
                        language={language}
                        handlePress={handlePress}
                    />
                ))}
            </ScrollView>
        </UnsafeContainer>
    );
}

const stylesheet = createStyleSheet((theme) => ({
    container: {
        flex: 1,
    },
    title: {
        fontSize: moderateScale(20),
        fontFamily: 'Sans-Bold',
        color: theme.colors.text.PRIMARY,
        marginVertical: 20,
        textAlign: 'center',
    },
    scrollView: {
        flex: 1,
        marginTop: 10,
    },
    textInput: {
        paddingVertical: 15,
        borderRadius: 15,
        alignSelf: 'center',
        width: '90%',
        paddingHorizontal: 20,
        color: theme.colors.text.PRIMARY,
        marginTop: moderateScale(25),
        fontSize: moderateScale(15),
        fontFamily: 'Sans-Medium',
        backgroundColor: theme.colors.background.SECONDARY,
    },
}));
</file>

