<file path="src/components/editor/EditorBridge.tsx">
import React, {useEffect, useRef, useState} from 'react';
import { SafeAreaView, View } from 'react-native';
import {
    RichText,
    Toolbar,
    useEditorBridge,
    CoreBridge,
    useBridgeState,
    DEFAULT_TOOLBAR_ITEMS
} from '@10play/tentap-editor';
import { createStyleSheet, useStyles } from 'react-native-unistyles';
import { useReanimatedKeyboardAnimation } from 'react-native-keyboard-controller';
import Animated, { useAnimatedStyle } from 'react-native-reanimated';
import {WebViewMessageEvent} from "react-native-webview";
import { editorHtml } from '@tap/build/editorHtml'
import {useSingleContentRowQuery} from "@data/content/hooks/useSingleContentRowQuery";
import { useCurrentStudentRowQuery} from "@data/student/hooks/useStudentRowQuery";
import { marked } from 'marked';
import modifyHtml from '@/utils/modifyHtml';
import {moderateScale} from "react-native-size-matters";
import {
    BlockquoteBridge,
    BoldBridge, BulletListBridge,
    CodeBridge, ColorBridge, HardBreakBridge, HeadingBridge, HighlightBridge,
    HistoryBridge,
    ItalicBridge, LinkBridge, ListItemBridge, OrderedListBridge,
    StrikeBridge, TaskListBridge,
    UnderlineBridge
} from "@10play/tentap-editor";
import {lightTheme} from "@/common/constants";
import {YJS_URL} from "@/common/environment";
import UnsafeContainer from '@/common/generics/UnsafeContainer';
import DocumentSkeletonLoader from './DocumentSkeletonLoader';
import UpdateRequiredScreen from './UpdateRequiredScreen';
import { getUserAccessToken } from '@/utils/auth';
import { useSetAtom } from 'jotai';
// import { TipTapImageBridge } from './editor/tiptap-utils/TipTapImageBridge';

interface EditorBridgeProps {
    content_id: string;
}

export const EditorBridge = ({ content_id }: EditorBridgeProps) => {

    const { data: currentNote, isPending: isContentPending } = useSingleContentRowQuery(content_id);
    const { data: student, isPending: isStudentPending } = useCurrentStudentRowQuery();
    const[isLoaded, setIsLoaded] = useState(false);
    const[isEditorReady, setIsEditorReady] = useState(false);

    const hasSetContent = useRef(false);
    const webEditorReady = useRef(false);
    const webViewRequestedData = useRef(false);

    const { styles, theme } = useStyles(stylesheet);

    const { height } = useReanimatedKeyboardAnimation()

    const toolbarAnim = useAnimatedStyle(() => ({
        bottom: -height.value,
    }));


    // Initialize the rich-text editor bridge using our prebuilt HTML (see editor-web bundle).
    const editor = useEditorBridge({
        editable: false,
        customSource: editorHtml,
    });

    const bridgeState = useBridgeState(editor);

    useEffect(() => {
        if (editor && isLoaded) {
            if (theme === lightTheme) {
                editor.webviewRef.current?.postMessage(JSON.stringify({
                    type: 'theme',
                    text: 'light'
                }));
            } else {
                editor.webviewRef.current?.postMessage(JSON.stringify({
                    type: 'theme',
                    text: 'dark'
                }));
            }
        }
    }, [theme, editor, isLoaded]);

    useEffect(() => {
        (async () => {
            if (editor && bridgeState.isReady && webEditorReady.current && !isContentPending && !currentNote?.yjs_base64 && currentNote?.markdown && !hasSetContent.current) {
                const html = await marked.parse(currentNote.markdown);
                const modifiedHtml = modifyHtml(html);
                // Set content through bridge (existing path)
                editor.setContent(modifiedHtml);
                // Also set a global for web to pick up if needed
                editor.webviewRef.current?.injectJavaScript(`window.initialHtml = ${JSON.stringify(modifiedHtml)}; true;`);
                hasSetContent.current = true;
            }
        })();
    }, [isContentPending, bridgeState.isReady, currentNote?.markdown]);

    // Keep old timed-send as a backup, but the new handshake will request data explicitly.
    useEffect(() => {
        if (webViewRequestedData.current && !isStudentPending && student && !isContentPending && currentNote) {
            (async () => {
                try {
                    const token = await getUserAccessToken();
                    const message = {
                        type: 'editorData',
                        content_id: content_id,
                        student_id: student?.student_id || '',
                        name: student?.full_name || 'Guest',
                        yjs_url: YJS_URL,
                        token: token,
                        pm_schema_version: currentNote.pm_schema_version
                    };
                    editor.webviewRef.current?.postMessage(JSON.stringify(message));
                    webViewRequestedData.current = false;
                } catch (e) {
                    console.error('[EditorBridge] Failed to send requested data:', e);
                }
            })();
        }
    }, [isStudentPending, student, isContentPending, currentNote, content_id]);

    useEffect(() => {
        if (isLoaded && !isStudentPending && student && !isContentPending && currentNote) {
            setTimeout(async () => {
                try {
                    const token = await getUserAccessToken();
                    const message = {
                        type: 'editorData',
                        content_id: content_id,
                        student_id: student?.student_id || '',
                        name: student?.full_name || 'Guest',
                        yjs_url: YJS_URL,
                        token: token,
                        pm_schema_version: currentNote.pm_schema_version
                    };
                    editor.webviewRef.current?.postMessage(JSON.stringify(message));
                } catch (e) {
                    console.error('[EditorBridge] Failed timer fallback send:', e);
                }
            }, 300)
        }
    }, [isStudentPending, isLoaded, student?.student_id, isContentPending, currentNote?.pm_schema_version]);

    if (isContentPending || isStudentPending) {
        return <SafeAreaView style={styles.container} />
    }

    // Check Schema
    if (currentNote && currentNote.pm_schema_version > 1) {
        return (
            <UnsafeContainer style={styles.unsafeContainer}>
                <UpdateRequiredScreen />
            </UnsafeContainer>
        );
    }

    return (
        <>
                <UnsafeContainer style={styles.unsafeContainer}>
                    <DocumentSkeletonLoader isVisible={!isEditorReady} />
                    <RichText
                        editor={editor}
                        exclusivelyUseCustomOnMessage={false}
                        onError={(error) => {
                            console.error('[WebView] Load error:', error);
                            // Fallback: ensure skeleton doesn't block forever if WebView errors
                            setIsEditorReady(true);
                        }}
                        onLoadEnd={() => {
                            setIsLoaded(true);
                            // Fallback for Android: sometimes 'editorReady' isn't received.
                            // Ensure we reveal the WebView even if the ready message is missed.
                            setTimeout(() => {
                                setIsEditorReady((prev) => prev || true);
                            }, 150);
                        }}
                        onMessage={(event : WebViewMessageEvent) => {
                            try {
                                const message = JSON.parse(event.nativeEvent.data);
                                if (message.type === 'editorReady') {
                                    // Web editor signaled readiness; reveal it shortly to avoid flash
                                    webEditorReady.current = true;
                                } else if (message.type === 'readyForEditorData') {
                                    webViewRequestedData.current = true;
                                    if (!isContentPending && currentNote && !isStudentPending && student) {
                                        (async () => {
                                            try {
                                                const token = await getUserAccessToken();
                                                const message = {
                                                    type: 'editorData',
                                                    content_id: content_id,
                                                    student_id: student?.student_id || '',
                                                    name: student?.full_name || 'Guest',
                                                    yjs_url: YJS_URL,
                                                    token: token,
                                                    pm_schema_version: currentNote.pm_schema_version
                                                };
                                                editor.webviewRef.current?.postMessage(JSON.stringify(message));
                                                webViewRequestedData.current = false;
                                            } catch (e) {
                                                console.error('[EditorBridge] Failed to send editorData:', e);
                                            }
                                        })();
                                    }
                                }
                            } catch (error) {
                                console.error('[WebView] Failed to parse message:', error);
                            }
                        }}
                        scrollEnabled={false}
                        style={[styles.richText, !isEditorReady && styles.hiddenWebView]}
                    />
                </UnsafeContainer>
            {/*<Animated.View style={[styles.toolbarWrapper, toolbarAnim]}>*/}
            {/*    <Toolbar editor={editor} items={[...DEFAULT_TOOLBAR_ITEMS]}/>*/}
            {/*</Animated.View>*/}
        </>
    );
};

const stylesheet = createStyleSheet((theme) => ({
    container: {
        flex: 1,
        backgroundColor: theme.colors.background.PRIMARY,
    },
    unsafeContainer: {
        flex: 1,
        backgroundColor: theme.colors.background.PRIMARY,
    },
    richText: {
        flex: 1,
        backgroundColor: theme.colors.background.PRIMARY,
    },
    keyboardAvoidingView: {
        position: 'absolute',
        width: '100%',
        bottom: 0
    },
    toolbarWrapper: {
        position: 'absolute',
        bottom: 0,
        backgroundColor: theme.colors.background.PRIMARY,
        borderTopWidth: 1,
        borderColor: theme.colors.background.SECONDARY,
    },
    hiddenWebView: {
        opacity: 0,
    },
}));
</file>

<file path="src/common/components/sheets/noteSettingsSheet.tsx">
import React, {useCallback, useEffect, useMemo, useRef, useState} from "react";
import {Share, Text, TouchableOpacity, View, TextInput, Keyboard} from "react-native";
import BottomSheet from "@gorhom/bottom-sheet";
import {moderateScale} from "react-native-size-matters";
import UnsafeContainer from "@/common/generics/UnsafeContainer";
import {windowWidth} from "@/utils/window";
import {createStyleSheet, useStyles} from "react-native-unistyles";
import LoadingModal from "@/common/components/modals/loadingModal";
import {heavyHaptic} from "@/utils/haptic";
import {NODE_EXPRESS_URL} from "@/common/environment";
import {getUserAccessToken} from "@/utils/auth";
import Toast from "react-native-toast-message";
import {Portal} from "react-native-portalize";
import AddNotesToFolderSheet from "@/common/components/sheets/addNotesToFolderSheet";
import {useRouter} from "expo-router";
import { useDebouncedCallback } from "use-debounce";
import {Folder} from "@/data/folders/types";
import { useUpdateContentMutation } from "@data/content/hooks/useUpdateContentMutation";
import {useSingleContentRowQuery} from "@data/content/hooks/useSingleContentRowQuery";
import {useFolderRowsQuery} from "@data/folders/hooks/useFolderRowsQuery";
import { useCreateCollaboratorMutation } from '@data/collaborator/hooks/useCreateCollaboratorMutation';
import * as FileSystem from 'expo-file-system';
import * as Sharing from 'expo-sharing';


export default function NoteSettingsSheet({content_id, index, setIndex} : { content_id: string; index: number; setIndex: any; noteTitle?: string }) {
    const bottomSheetRef = useRef<BottomSheet>(null);
    const { data: currentNote , isPending : notesLoading } = useSingleContentRowQuery(content_id);
    const { data: folderRows } = useFolderRowsQuery()
    const snapPoints = useMemo(() => ["80%"], []);
    const[loading, setLoading] = useState<boolean>(false);
    const { styles, theme } = useStyles(stylesheet);
    const [addNotesToFolderSheetIndex, setAddNotesToFolderSheetIndex] = useState(-1);
    const router = useRouter();
    const updateContent = useUpdateContentMutation();
    const createCollaborator = useCreateCollaboratorMutation();
    const [noteTitle, setNoteTitle] = useState<string>("");

    useEffect(() => {
        if (index < 0) {
            setNoteTitle("");
            Keyboard.dismiss();
            return;
        }
        if (!notesLoading) {
            setNoteTitle(currentNote?.content_title || "");
        }
    }, [index, currentNote, notesLoading]);

    const debouncedUpdate = useDebouncedCallback((newTitle: string) => {
        updateContent.mutate({
            content_id,
            content_title: newTitle
        });
    }, 700);

    const handleSheetChanges = useCallback((index: number) => {
        setIndex(index);
    }, [setIndex, notesLoading]);

    const findFolderRow = () : Folder | undefined => {
        if(!currentNote) return undefined;
        return folderRows?.find((folder : Folder) => folder.folder_id == currentNote.folder_id);
    }



    return (
        <Portal>
        <BottomSheet
            ref={bottomSheetRef}
            index={index}
            backgroundStyle={styles.bottomSheetBackground}
            handleIndicatorStyle={styles.bottomSheetHandleIndicator}
            handleStyle={styles.bottomSheetHandle}
            enablePanDownToClose={true}
            snapPoints={snapPoints}
            onChange={handleSheetChanges}
        >
            <LoadingModal visible={loading} message={'Processing...'}  />
            <UnsafeContainer style={styles.container} >
                <View style={styles.titleInputContainer}>
                    <TextInput
                        style={styles.titleInput}
                        value={noteTitle}
                        onChangeText={(text) => {
                            setNoteTitle(text);
                            debouncedUpdate(text);
                        }}
                        placeholder="Enter Note Title..."
                        placeholderTextColor={theme.colors.grays.SECONDARY}
                        returnKeyType="done"
                        onSubmitEditing={() => {
                            heavyHaptic();
                            debouncedUpdate.cancel();
                            updateContent.mutate({
                                content_id,
                                content_title: noteTitle
                            });
                        }}
                    />
                </View>
                <TouchableOpacity style={styles.addFolderButton} onPress={() => {
                    heavyHaptic();
                    setAddNotesToFolderSheetIndex(0);
                }}>
                    <Text style={styles.buttonText}>{currentNote?.folder_id ? `${findFolderRow()?.emoji} ${findFolderRow()?.title}` : "📁 Add to folder"}</Text>
                </TouchableOpacity>
                <TouchableOpacity style={styles.shareNoteButton} onPress={async () => {
                    heavyHaptic();
                    if(currentNote) {
                        bottomSheetRef.current?.close();
                        setIndex(-1);
                        await createCollaborator.mutateAsync({
                            email: null,
                            role: 'viewer',
                            object_id: currentNote.content_id,
                            object_type: 'content'
                        });
                        await Share.share({
                            url: `https://www.turbolearn.ai/notes/${currentNote.content_id}`
                        })
                    }
                }}>
                    <Text style={styles.buttonText}>🔗 Share note</Text>
                </TouchableOpacity>
                <TouchableOpacity style={styles.shareNoteButton} onPress={async () => {
                    heavyHaptic();
                    if(!currentNote) {
                        Toast.show({
                            type: 'error',
                            text1: 'No note selected',
                            topOffset: 50,
                        });
                        return;
                    }
                    
                    setLoading(true);
                    try {
                        const accessToken = await getUserAccessToken();
                        const filename = `${noteTitle || currentNote.content_title || 'note'}.pdf`;
                        const fileUri = `${FileSystem.documentDirectory}${filename}`;
                        
                        const response = await fetch(`${NODE_EXPRESS_URL}/generateLatestPDF`, {
                            method: 'POST',
                            headers: {
                                'Authorization': `Bearer ${accessToken}`,
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({
                                content_id: currentNote.content_id
                            }),
                        });
                        
                        if (!response.ok) {
                            throw new Error(`Failed to generate PDF: ${response.status}`);
                        }
                        
                        const arrayBuffer = await response.arrayBuffer();
                        const base64 = btoa(
                            new Uint8Array(arrayBuffer)
                                .reduce((data, byte) => data + String.fromCharCode(byte), '')
                        );
                        
                        await FileSystem.writeAsStringAsync(fileUri, base64, {
                            encoding: FileSystem.EncodingType.Base64,
                        });
                        
                        if (await Sharing.isAvailableAsync()) {
                            await Sharing.shareAsync(fileUri, {
                                mimeType: 'application/pdf',
                                dialogTitle: 'Save PDF',
                                UTI: 'com.adobe.pdf'
                            });
                        } else {
                            await Share.share({
                                url: fileUri,
                                title: filename,
                            });
                        }
                        
                        await FileSystem.deleteAsync(fileUri, { idempotent: true });
                        
                        bottomSheetRef.current?.close();
                        setIndex(-1);
                        
                    } catch (error) {
                        console.error('PDF Export Error:', error);
                        Toast.show({
                            type: 'error',
                            text1: 'Error generating PDF',
                            text2: error.message || 'Please try again later.',
                            topOffset: 50,
                        });
                    } finally {
                        setLoading(false);
                    }
                }}>
                    <Text style={styles.buttonText}>📄 Export to PDF</Text>
                </TouchableOpacity>
                <TouchableOpacity style={styles.deleteNoteButton} onPress={async () => {
                    heavyHaptic();
                    updateContent.mutate({
                        content_id,
                        is_deleted: true
                    });
                    bottomSheetRef.current?.close();
                    setIndex(-1);
                    router.navigate('/home');
                }}>
                    <Text style={styles.deleteNoteText}>🗑️ Delete note</Text>
                </TouchableOpacity>
            </UnsafeContainer>
        </BottomSheet>
            <AddNotesToFolderSheet content_id={content_id} index={addNotesToFolderSheetIndex} setIndex={setAddNotesToFolderSheetIndex}/>
        </Portal>
    );
}

const stylesheet = createStyleSheet((theme) => ({
    bottomSheetBackground: {
        backgroundColor: theme.colors.background.SECONDARY,
    },
    bottomSheetHandleIndicator: {
        backgroundColor: theme.colors.grays.PRIMARY,
    },
    bottomSheetHandle: {
        backgroundColor: theme.colors.background.SECONDARY,
    },
    container: {
        backgroundColor: theme.colors.background.SECONDARY,
    },
    titleInputContainer: {
        backgroundColor: theme.colors.background.SECONDARY,
        borderRadius: 10,
        borderWidth: 1,
        borderColor: theme.colors.grays.PRIMARY,
        paddingVertical: 7.5,
        marginVertical: 7,
        width: windowWidth * .9,
        alignSelf: 'center',
        paddingHorizontal: 15,
    },
    titleInput: {
        color: theme.colors.grays.SECONDARY,
        fontSize: moderateScale(14),
        fontFamily: 'Sans-Medium',
        paddingVertical: 15,
        width: '100%',
        textAlign: 'center'
    },
    addFolderButton: {
        backgroundColor: theme.colors.background.TERTIARY,
        borderRadius: 10,
        paddingVertical: 15,
        marginVertical: 7,
        width: windowWidth * .9,
        alignSelf: 'center'
    },
    deleteNoteButton: {
        backgroundColor: "#c95151",
        borderRadius: 10,
        paddingVertical: 15,
        marginVertical: 7,
        width: windowWidth * .9,
        alignSelf: 'center'
    },
    shareNoteButton: {
        backgroundColor: theme.colors.background.TERTIARY,
        borderRadius: 10,
        paddingVertical: 15,
        marginVertical: 7,
        width: windowWidth * .9,
        alignSelf: 'center'
    },
    deleteNoteText: {
        color: '#fff',
        fontSize: moderateScale(16),
        fontFamily: 'Sans-Medium',
        textAlign: 'center'
    },
    buttonText: {
        color: theme.colors.grays.SECONDARY,
        fontSize: moderateScale(16),
        fontFamily: 'Sans-Medium',
        textAlign: 'center'
    }
}))
</file>

<file path="src/components/notes/insideScreens/Quizzes/quizPage.tsx">
import {useEffect, useLayoutEffect} from "react";
import {ScrollView, Text, View} from "react-native";
import {createStyleSheet, useStyles} from "react-native-unistyles";
import {moderateVerticalScale} from "react-native-size-matters";
import Animated, {
    Easing,
    interpolateColor,
    useAnimatedStyle,
    useSharedValue,
    withTiming,
    cancelAnimation,
    FadeIn,
    FadeOut
} from "react-native-reanimated";
import {heavyHaptic} from "@/utils/haptic";
import {useState, useRef} from "react";
import ExplanationsSheet from "@/common/components/sheets/explanationsSheet";
import UnsafeContainer from "@/common/generics/UnsafeContainer";
import HintSheet from "@/common/components/sheets/hintSheet";
import TopicsModal from "@/common/components/modals/topicsModal";
import QuizGenerationErrorModal from "@/common/components/modals/quizGenerationErrorModal";
import {JoinedQuestion} from "@data/quiz_questions/types";
import {useTopicRowsQuery} from "@data/topics/hooks/useTopicRowsQuery";
import {useQuizRowsQuery} from "@data/quiz_questions/hooks/useQuizRowsQuery";
import {useUpdateQuizMutation} from "@data/quiz_questions/hooks/useUpdateQuizMutation";
import {useGenerateQuizQuestionsMutation} from "@data/quiz_questions/hooks/useGenerateQuestionMutation";
import {useQuestionQuery} from "@data/quiz_questions/hooks/useQuestionQuery";
import {useAtom} from "jotai/index";
import {isPayingOnWebAtom} from "@/utils/atoms";
import NotEnoughCreditsQuiz from "../NotEnoughCreditsScreens/notEnoughCreditsQuiz";
import {useIsMutating, useQueryClient} from "@tanstack/react-query";
import {windowWidth} from "@/utils/window";
import QuizLoader from "./QuizLoader";
import QuizMarkdownText from "@/components/notes/insideScreens/Quizzes/QuizMarkdownText";
import QuizAnswerChoice from "./QuizAnswerChoice";
import QuizNavigationButtons from "./QuizNavigationButtons";

export default function QuizPage({ contentID } : { contentID: string }) {
    const { styles, theme } = useStyles(stylesheet);
    const queryClient = useQueryClient();
    const { data: topics, isPending: isTopicsPending } = useTopicRowsQuery(contentID);
    const { data: quizzes, isPending: isQuizzesPending } = useQuizRowsQuery(contentID);
    const [isSubscribed] = useAtom(isPayingOnWebAtom);

    const [currentQuestionId, setCurrentQuestionId] = useState<string | null>(null);
    const [quizNotEnoughCredits, setQuizNotEnoughCredits] = useState<boolean>(false);
    const [prefetchCreditsError, setPrefetchCreditsError] = useState<boolean>(false);
    const [hasTriedInitialGeneration, setHasTriedInitialGeneration] = useState<boolean>(false);
    const [showErrorModal, setShowErrorModal] = useState<boolean>(false);
    const [hasUserDismissedError, setHasUserDismissedError] = useState<boolean>(false);
    const [selectedAnswerIndex, setSelectedAnswerIndex] = useState<number | undefined>(undefined);
    const [isWaitingForNextQuestion, setIsWaitingForNextQuestion] = useState<boolean>(false);

    const [hintSheetIndex, setHintSheetIndex] = useState(-1);
    const [isTopicsModalVisible, setIsTopicsModalVisible] = useState(false);
    const [explanationsSheetIndex, setExplanationsSheetIndex] = useState(-1);
    const correctAnswer = useSharedValue(0);
    const wrongAnswer = useSharedValue(0);
    const hintTextOpacity = useSharedValue(1);
    const prevQuestionId = useRef<string | null>(null);
    const updateQuestion = useUpdateQuizMutation();
    const generateQuiz = useGenerateQuizQuestionsMutation();
    const isGeneratingQuiz = useIsMutating({ mutationKey: ["generate-quiz-questions"] }) > 0;
    
    useEffect(() => {
        // When mutation errors, show the modal (but only if user hasn't dismissed it and we're actually waiting for new questions)
        if (generateQuiz.isError && !showErrorModal && !hasUserDismissedError && isWaitingForNextQuestion) {
            const errorMessage = generateQuiz.error?.message || 'Failed to generate quiz questions';
            
            if (errorMessage === 'NOT_ENOUGH_CREDITS') {
                setQuizNotEnoughCredits(true);
            } else {
                setShowErrorModal(true);
            }
        }
    }, [showErrorModal, hasUserDismissedError, isWaitingForNextQuestion, generateQuiz.isError, generateQuiz.error]);

    const { data: currentQuestion } = useQuestionQuery(currentQuestionId);
    const currentQuestionIndex = quizzes?.findIndex(q => q.question_id === currentQuestionId) ?? -1;
    const isCurrentQuestionAnswered = selectedAnswerIndex !== undefined;
    const shouldShowNextButton = isCurrentQuestionAnswered || (currentQuestion?.status !== "unanswered");

    useEffect(() => {
        if (quizzes && quizzes.length > 0 && !currentQuestionId) {
            const firstUnanswered = quizzes.find(q => q.status === "unanswered");
            setCurrentQuestionId(firstUnanswered ? firstUnanswered.question_id : quizzes[0].question_id);
        } else if (quizzes?.length === 0 && topics && topics.length > 0 && !isGeneratingQuiz && !prefetchCreditsError && !hasTriedInitialGeneration && !generateQuiz.isError) {
            setHasTriedInitialGeneration(true);
            generateQuiz.mutateAsync({
                content_id: contentID,
                topic_ids: topics.map(t => t.topic_id),
                is_user_subscribed: isSubscribed,
            }).catch((error) => {
                if (error.message === 'NOT_ENOUGH_CREDITS') {
                    setPrefetchCreditsError(true);
                    setQuizNotEnoughCredits(true);
                } else {
                    setShowErrorModal(true);
                }
            });
        }
    }, [quizzes, currentQuestionId, topics, isGeneratingQuiz, contentID, isSubscribed, prefetchCreditsError, hasTriedInitialGeneration, generateQuiz.isError]);


    useEffect(() => {
        if (!topics || !quizzes || !currentQuestion) return;

        const unansweredQuestions = quizzes.filter(q => q.status === "unanswered");
        const isLastUnanswered =
            unansweredQuestions.length === 0 ||
            (unansweredQuestions.length === 1 &&
                unansweredQuestions[0].question_id === currentQuestionId);
        const canGenerate = topics.length > 0 && isLastUnanswered && !isGeneratingQuiz && !prefetchCreditsError && !generateQuiz.isError;

        if (canGenerate) {
            generateQuiz.mutateAsync({
                content_id: contentID,
                topic_ids: topics.map(t => t.topic_id),
                is_user_subscribed: isSubscribed,
            }).catch((error) => {
                if (error.message === 'NOT_ENOUGH_CREDITS') {
                    setPrefetchCreditsError(true);
                } else {
                    // Show error modal for non-credit errors even during background prefetch
                    setShowErrorModal(true);
                }
            });
        }
    }, [quizzes, topics, currentQuestionId, currentQuestion, isGeneratingQuiz, isSubscribed, contentID, prefetchCreditsError]);

    useLayoutEffect(() => {
        if (currentQuestionId && currentQuestionId !== prevQuestionId.current) {
            cancelAnimation(correctAnswer);
            cancelAnimation(wrongAnswer);
            correctAnswer.value = 0;
            wrongAnswer.value = 0;
            setSelectedAnswerIndex(undefined);
            setIsWaitingForNextQuestion(false);

            hintTextOpacity.value = 1;

            prevQuestionId.current = currentQuestionId;
        }
    }, [currentQuestionId]);

    useEffect(() => {
        if (isWaitingForNextQuestion && !isGeneratingQuiz && quizzes) {
            const cachedQuizzes = queryClient.getQueryData<JoinedQuestion[]>([
                'questions', 'list', 'content', contentID,
            ]);
            const newQuestion =
                cachedQuizzes?.find(q => q.status === 'unanswered');
            if (newQuestion) {
                setCurrentQuestionId(newQuestion.question_id);
                setIsWaitingForNextQuestion(false);
            }
        }
    }, [isWaitingForNextQuestion, isGeneratingQuiz, quizzes, contentID, queryClient]);

    const handleNextQuizQuestion = () => {
        
        if (quizzes && currentQuestionIndex > 0) {
            setCurrentQuestionId(quizzes[currentQuestionIndex - 1].question_id);
            return;
        }

        const nextUnanswered = quizzes?.find(q => q.status === 'unanswered' && q.question_id !== currentQuestionId);
        if (nextUnanswered) {
            setCurrentQuestionId(nextUnanswered.question_id);
            return;
        }

        if (prefetchCreditsError) {
            setQuizNotEnoughCredits(true);
            return;
        }

        if (isGeneratingQuiz) {
            setIsWaitingForNextQuestion(true);
            return;
        }

        const cachedQuizzes = queryClient.getQueryData<JoinedQuestion[]>([
            'questions', 'list', 'content', contentID,
        ]);
        const newQuestion = cachedQuizzes?.find(q => q.status === 'unanswered' && !quizzes?.some(existing => existing.question_id === q.question_id));
        if (newQuestion) {
            setCurrentQuestionId(newQuestion.question_id);
            return;
        }

        if (
            topics &&
            topics.length > 0 &&
            currentQuestionIndex === 0
        ) {
            setIsWaitingForNextQuestion(true);
            generateQuiz
                .mutateAsync({
                    content_id: contentID,
                    topic_ids: topics.map(t => t.topic_id),
                    is_user_subscribed: isSubscribed,
                })
                .then(() => {
                    const newest = queryClient.getQueryData<JoinedQuestion[]>([
                        'questions', 'list', 'content', contentID,
                    ]);
                    if (newest?.length) {
                        setCurrentQuestionId(newest[0].question_id);
                    }
                    setIsWaitingForNextQuestion(false);
                })
                .catch((error) => {
                    setIsWaitingForNextQuestion(false);
                    if (error.message === 'NOT_ENOUGH_CREDITS') {
                        setQuizNotEnoughCredits(true);
                    } else {
                        setShowErrorModal(true);
                    }
                });
        }
    }

    const handlePreviousQuizQuestion = () => {
        if (quizzes && currentQuestionIndex < quizzes.length - 1) {
            setCurrentQuestionId(quizzes[currentQuestionIndex + 1].question_id);
        }
    }

    const hintTextAnimatedStyle = useAnimatedStyle(() => {
        return {
            opacity: hintTextOpacity.value
        };
    });

    const correctAnswerBackgroundAnimatedStyle = useAnimatedStyle(() => {
        return {
            backgroundColor: interpolateColor(
                correctAnswer.value,
                [0, 1],
                [theme.colors.background.SECONDARY, theme.colors.background.GREEN]
            ),
        };
    });

    const wrongAnswerBackgroundAnimatedStyle = useAnimatedStyle(() => {
        return {
            backgroundColor: interpolateColor(
                wrongAnswer.value,
                [0, 1],
                [theme.colors.background.SECONDARY, theme.colors.background.RED]
            ),
        };
    });

    if (quizNotEnoughCredits) return <NotEnoughCreditsQuiz />

    if (!currentQuestion || isQuizzesPending || (isWaitingForNextQuestion && !generateQuiz.isError) || currentQuestion.question_id !== currentQuestionId) {
        return <QuizLoader />;
    }

    const handleAnswerChoicePress = async (index : number) => {
        if (!isCurrentQuestionAnswered) {
            correctAnswer.value = withTiming(1, {
                duration: 150,
                easing: Easing.bezier(0.25, 0.1, 0.25, 1)
            });
            wrongAnswer.value = withTiming(1, {
                duration: 150,
                easing: Easing.bezier(0.25, 0.1, 0.25, 1)
            });
            setSelectedAnswerIndex(index);
        }
    }

    if(currentQuestion.mc_questions.explanation && currentQuestion.mc_questions.choices && currentQuestion.mc_questions.correct_answer){
        const correctAnswerIndex = currentQuestion.mc_questions.correct_answer.indexOf(true);
        
        return (
                <UnsafeContainer>
                <ScrollView contentContainerStyle={{alignItems: 'center', paddingBottom: 20}} showsVerticalScrollIndicator={false}>
                    <Animated.View 
                        key={currentQuestion.question_id}
                        entering={FadeIn.duration(300).delay(300).easing(Easing.out(Easing.cubic))}
                        exiting={FadeOut.duration(300).easing(Easing.in(Easing.cubic))}
                        style={styles.questionTitle}
                    >
                        <QuizMarkdownText
                            content={currentQuestion.question}
                            fontSize={13}
                            fontFamily="Sans-Medium"
                            textAlign="center"
                        />
                    </Animated.View>
                    {currentQuestion.mc_questions.choices.map((choice : string, index : number) => {
                        const isSelected = selectedAnswerIndex === index;
                        const isCorrect = correctAnswerIndex === index;

                        return <Animated.View
                            key={`${currentQuestion.question_id}-${index}`}
                            entering={FadeIn.duration(300).delay(300 + 50 * (index + 1)).easing(Easing.out(Easing.cubic))}
                            exiting={FadeOut.duration(300).easing(Easing.in(Easing.cubic))}
                        >
                            <QuizAnswerChoice
                                choice={choice}
                                index={index}
                                questionId={currentQuestion.question_id}
                                isSelected={isSelected}
                                isCorrect={isCorrect}
                                isCurrentQuestionAnswered={isCurrentQuestionAnswered}
                                correctAnswerStyle={correctAnswerBackgroundAnimatedStyle}
                                wrongAnswerStyle={wrongAnswerBackgroundAnimatedStyle}
                                onPress={handleAnswerChoicePress}
                            />
                        </Animated.View>
                    })}
                    <QuizNavigationButtons
                        currentQuestionIndex={currentQuestionIndex}
                        totalQuestions={quizzes?.length || 0}
                        isCurrentQuestionAnswered={isCurrentQuestionAnswered}
                        shouldShowNextButton={shouldShowNextButton}
                        hintTextAnimatedStyle={hintTextAnimatedStyle}
                        onPrevious={handlePreviousQuizQuestion}
                        onNext={async () => {
                            void heavyHaptic();
                            if (selectedAnswerIndex !== undefined && currentQuestion.status === "unanswered") {
                                updateQuestion.mutate({
                                    content_id: currentQuestion.content_id,
                                    question_id: currentQuestion.question_id,
                                    status: selectedAnswerIndex === correctAnswerIndex ? "correct" : "incorrect",
                                });
                            }
                            setHasUserDismissedError(false);
                            handleNextQuizQuestion();
                            setExplanationsSheetIndex(-1);
                        }}
                        onHintPress={() => {
                            if (isCurrentQuestionAnswered) {
                                setExplanationsSheetIndex(0);
                            } else {
                                setHintSheetIndex(0);
                            }
                        }}
                        onTopicsPress={() => setIsTopicsModalVisible(true)}
                    />
                </ScrollView>
                    <ExplanationsSheet
                        questionObject={currentQuestion}
                        index={explanationsSheetIndex}
                        setIndex={setExplanationsSheetIndex}
                        selectedAnswerIndex = {selectedAnswerIndex ?? -1}
                    />
                    <HintSheet
                        questionObject={currentQuestion}
                        index={hintSheetIndex}
                        setIndex={setHintSheetIndex}
                    />
                    <TopicsModal
                        visible={isTopicsModalVisible}
                        onClose={() => setIsTopicsModalVisible(false)}
                        topics={topics}
                    />
                    <QuizGenerationErrorModal
                        visible={showErrorModal}
                        onClose={() => {
                            setShowErrorModal(false);
                            setHasUserDismissedError(true);
                        }}
                        onRetry={() => {
                            setShowErrorModal(false);
                            setHasUserDismissedError(false);
                            generateQuiz.mutateAsync({
                                content_id: contentID,
                                topic_ids: topics?.map(t => t.topic_id) || [],
                                is_user_subscribed: isSubscribed,
                            }).catch((error) => {
                                if (error.message === 'NOT_ENOUGH_CREDITS') {
                                    setPrefetchCreditsError(true);
                                    setQuizNotEnoughCredits(true);
                                } else {
                                    setShowErrorModal(true);
                                }
                            });
                        }}
                    />
                </UnsafeContainer>
        )
    }
}

const stylesheet = createStyleSheet((theme) => ({
    questionTitle: {
        color: theme.colors.text.PRIMARY,
        fontSize: moderateVerticalScale(13),
        fontFamily: 'Sans-Medium',
        width: windowWidth * .95,
        textAlign: 'center',
        alignSelf: 'center',
        marginTop: 20,
        marginBottom: 10,
        lineHeight: 24
    },
}));
