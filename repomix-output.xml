import React, { useEffect, useState } from 'react';
import { router, useLocalSearchParams } from 'expo-router';
import Container from "@/common/generics/Container";
import BackHeader from "@/common/components/headers/backHeader";
import AudioUploadingModal from "@/common/components/modals/audioUploadingModal";
import { RecordingBackup, recordingBackupService } from "@/services/RecordingBackupService";
import { uploadAudioFileTUS } from "@/utils/tus";
import { insertContentMutation } from "@/data/content/mutations";
import { getUserID } from "@/utils/auth";
import uuid from "react-native-uuid";
import Toast from "react-native-toast-message";
import { cleanupWavFiles } from "@/utils/wavConcatenation";

export default function UploadRecording() {
  const { sessionId } = useLocalSearchParams<{ sessionId: string }>();
  const [loading, setLoading] = useState(true);
  const [uploadProgress, setUploadProgress] = useState(0);
  const [uploadedBytes, setUploadedBytes] = useState(0);
  const [totalBytes, setTotalBytes] = useState(0);

  useEffect(() => {
    if (sessionId) {
      handleUpload();
    } else {
      // No session ID provided, go back
      router.back();
    }
  }, [sessionId]);

  const handleUpload = async () => {
    try {
      setLoading(true);

      // Get the backup data
      const backup = recordingBackupService.getBackup(sessionId);
      if (!backup) {
        throw new Error("Backup not found");
      }

      // Get authentication
      const userId = await getUserID();
      if (!userId) {
        throw new Error("User ID not available");
      }

      // Get the audio file
      const audioFilePath = await recordingBackupService.getConsolidatedFileForBackup(backup);
      if (!audioFilePath) {
        throw new Error("No audio file found for backup");
      }

      const filePath = `${userId}/${uuid.v4()}.mp3`;
      
      await uploadAudioFileTUS(audioFilePath, filePath, null, false, {
        onProgress: (bytesUploaded, bytesTotal, progress) => {
          setUploadProgress(progress);
          setUploadedBytes(bytesUploaded);
          setTotalBytes(bytesTotal);
        },
        onError: (error) => {
          console.error("❌ Error uploading backup audio:", error);
          setLoading(false);
          Toast.show({
            type: "error",
            text1: "Upload Failed",
            text2: "Unable to upload recording",
            topOffset: 50,
          });
          // Navigate back after a delay
          setTimeout(() => router.back(), 2000);
        },
        onSuccess: async (fileLink: string) => {
          try {
            // Create content entry in database
            const contentUuid = uuid.v4() as string;
            
            await insertContentMutation({
              content_id: contentUuid,
              class_subject: "humanities",
              content_type: "audio",
              file_link: fileLink,
              student_id: userId,
              content_title: backup.metadata?.contentTitle || "Recovered Recording",
            });

            setLoading(false);

            // Clean up ALL recording files (segments + consolidated + recovered) after successful upload and processing
            try {
              const filesToCleanup = await recordingBackupService.getAllPotentialFilePathsForBackup(backup.sessionId);
              if (filesToCleanup.length > 0) {
                await cleanupWavFiles(filesToCleanup);
                console.log('✅ All recording files cleaned up:', filesToCleanup.length, 'files');
              }
            } catch (cleanupError) {
              console.warn('⚠️ Failed to cleanup recording files:', cleanupError);
            }

            // Remove the backup since it's been uploaded
            recordingBackupService.removeBackup(backup.sessionId);
            
            // Navigate to the notes page with the new content - no toast needed
            router.replace(`/home/${contentUuid}/notes`);
          } catch (dbError) {
            console.error("❌ Error creating content entry:", dbError);
            setLoading(false);
            Toast.show({
              type: "error", 
              text1: "Upload Successful",
              text2: "File uploaded but database error occurred",
              topOffset: 50,
            });
            // Navigate back after a delay
            setTimeout(() => router.back(), 2000);
          }
        }
      });
    } catch (error) {
      console.error("❌ Error in upload:", error);
      setLoading(false);
      Toast.show({
        type: "error",
        text1: "Upload Error",
        text2: "Unable to process recording",
        topOffset: 50,
      });
      // Navigate back after a delay
      setTimeout(() => router.back(), 2000);
    }
  };

  return (
    <Container>
      <AudioUploadingModal 
        visible={loading}  
        progress={uploadProgress} 
        totalBytes={totalBytes} 
        uploadedBytes={uploadedBytes}
      />
      <BackHeader title={'Uploading Recording'} textStyle={{}} />
    </Container>
  );
}
</file>

