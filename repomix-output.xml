import React, { useEffect, useRef } from 'react';
import { View, useColorScheme, Dimensions } from 'react-native';
import { createStyleSheet, useStyles } from 'react-native-unistyles';
import Animated, {
  useSharedValue,
  useAnimatedStyle,
  useFrameCallback,
} from 'react-native-reanimated';

const { width: screenWidth } = Dimensions.get('window');

interface SuperWhisperBarsVisualizerProps {
  isRecording: boolean;
  isPaused: boolean;
  audioLevel: number;
}

export default function SuperWhisperBarsVisualizer({
  isRecording,
  isPaused,
  audioLevel,
}: SuperWhisperBarsVisualizerProps) {
  const { styles, theme } = useStyles(stylesheet);
  const colorScheme = useColorScheme();

  // Bar configuration - matching web version exactly
  const barGap = 4;
  const barWidth = 2;
  const containerWidth = screenWidth; // Full screen width
  const barCount = Math.floor(containerWidth / (barWidth + barGap));
  const maxBarHeight = 50; // Increased for higher amplitude
  const minBarHeight = 1;
  
  // Create animated values for each bar with target heights for smoother animation
  const barHeights = useRef(
    Array.from({ length: barCount }, () => useSharedValue(minBarHeight))
  ).current;
  
  const targetHeights = useRef(
    Array.from({ length: barCount }, () => minBarHeight)
  ).current;
  
  
  // Frame counter for skipping frames
  const frameCounter = useSharedValue(0);
  
  // Use frame callback for smooth updates
  useFrameCallback((() => {
    'worklet';
    
    // Run every frame for smoother animation (removed frame skipping)
    frameCounter.value = frameCounter.value + 1;
    
    for (let i = 0; i < barCount; i++) {
      const position = i / barCount;
      
      // Calculate taper factor - only taper the outer 15% on each side
      let taperFactor = 1.0; // Full amplitude by default
      
      if (position < 0.15) {
        // Left side taper (0 to 0.15)
        taperFactor = position / 0.15;
      } else if (position > 0.85) {
        // Right side taper (0.85 to 1.0)
        taperFactor = (1.0 - position) / 0.15;
      }
      
      if (!isRecording || isPaused) {
        // Idle state - very subtle movement
        targetHeights[i] = minBarHeight + Math.sin(Date.now() * 0.001 + i * 0.3) * 2 * taperFactor;
      } else {
        // Recording state - create dramatic variation like SuperWhisper
        const rand = Math.random();
        let heightMultiplier: number;
        
        if (rand < 0.4) {
          // 40% chance of very small bars
          heightMultiplier = 0.05 + Math.random() * 0.15;
        } else if (rand < 0.6) {
          // 20% chance of small-medium bars
          heightMultiplier = 0.2 + Math.random() * 0.2;
        } else if (rand < 0.75) {
          // 15% chance of medium bars
          heightMultiplier = 0.4 + Math.random() * 0.2;
        } else if (rand < 0.9) {
          // 15% chance of medium-tall bars
          heightMultiplier = 0.6 + Math.random() * 0.3;
        } else {
          // 10% chance of very tall spikes
          heightMultiplier = 0.9 + Math.random() * 0.4;
        }
        
        // Calculate target height with dramatic variance
        const normalizedLevel = Math.max(0, Math.min(1, audioLevel));
        
        // Filter out quiet sounds completely (lower threshold for more sensitivity)
        if (normalizedLevel < 0.002) {
          targetHeights[i] = minBarHeight;
        } else {
          // Scale up the audio level since our RMS values are now much lower
          // Typical speech is 0.1-0.3, we want to map this to use full height range
          const scaledLevel = Math.min(normalizedLevel * 25, 1.0); // Increased from 15 to 25
          targetHeights[i] = Math.max(
            minBarHeight,
            scaledLevel * maxBarHeight * taperFactor * heightMultiplier * 3.0 // Increased from 2.5 to 3.0
          );
        }
      }
      
      // Smooth interpolation between current and target height
      const currentHeight = barHeights[i].value;
      const smoothingFactor = 0.08; // Lower for smoother animation
      const newHeight = currentHeight + (targetHeights[i] - currentHeight) * smoothingFactor;
      barHeights[i].value = newHeight;
    }
  }));
  
  // Get bar color based on state
  const getBarColor = () => {
    if (!isRecording && !isPaused) {
      return (theme as any).colors?.tints?.PRIMARY || theme.colors.text.PRIMARY;
    }
    
    if (isPaused) {
      return (theme as any).colors?.tints?.WARNING || '#FF9F0A';
    }
    
    return (theme as any).colors?.tints?.PRIMARY || theme.colors.text.PRIMARY;
  };
  
  // Create animated styles for each bar
  const barAnimatedStyles = barHeights.map((barHeight) =>
    useAnimatedStyle(() => ({
      height: barHeight.value,
    }))
  );
  
  // Calculate bar color once instead of calling getBarColor() in each map iteration
  const barColor = getBarColor();
  
  return (
    <View style={styles.container}>
      <View style={styles.barsContainer}>
        {barHeights.map((_, index) => (
          <Animated.View
            key={index}
            style={[
              styles.bar,
              {
                backgroundColor: barColor,
                width: barWidth,
                marginRight: index < barCount - 1 ? barGap : 0,
              },
              barAnimatedStyles[index],
            ]}
          />
        ))}
      </View>
      
      {/* Recording indicator */}
      {isRecording && (
        <View style={styles.recordingIndicator}>
          <Animated.View
            style={[
              styles.recordingDot,
              {
                backgroundColor: barColor,
              },
            ]}
          />
        </View>
      )}
    </View>
  );
}

const stylesheet = createStyleSheet((theme) => ({
  container: {
    width: '100%',
    height: 100,
    justifyContent: 'center',
    alignItems: 'center',
    position: 'relative',
    marginVertical: 15,
  },
  barsContainer: {
    flexDirection: 'row',
    alignItems: 'center', // Center for bidirectional bars
    justifyContent: 'center',
    height: 70,
    width: '100%', // Full width to match container
  },
  bar: {
    borderRadius: 1,
    minHeight: 2, // Minimum of 2 to show both directions
  },
  recordingIndicator: {
    position: 'absolute',
    top: 8,
    right: 15,
    zIndex: 10,
  },
  recordingDot: {
    width: 8,
