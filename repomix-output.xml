import {Linking} from "react-native";

export const initialNotesIDs = ["c0d6ae16-c07d-4081-96c4-2a836c0d41a9"];

export default function Home(){
    const { data: contentRows, isPending : contentRowsPending } = useContentRowsQuery(null);
    const { data: folderRows, isPending : folderRowsPending } = useFolderRowsQuery();
    const [session] = useAtom(sessionAtom);
    const { data: studentRow, isPending: studentRowPending } = useCurrentStudentRowQuery();
    queryClient.prefetchQuery({
        queryKey: ['current_student'],
        queryFn: () => getSingleStudentRowQuery(),
    });
    const[isPayingOnWeb, setIsPayingOnWeb] = useAtom(isPayingOnWebAtom);
    const[websitePresentationRequests, setWebsitePresentationRequests] = useAtom(websitePresentationRequestsAtom);
    const[websitePresentationLastShown, setWebsitePresentationLastShown] = useAtom(websitePresentationLastShownAtom);
    const[pressedContentID, setPressedContentID] = useState("");
    const[pressedFolderID, setPressedFolderID] = useState("");
    const [noteSettingsSheetIndex, setNoteSettingsSheetIndex] = useState(-1);
    const [folderSettingsSheetIndex, setFolderSettingsSheetIndex] = useState(-1);
    const [newFolderSheetIndex, setNewFolderSheetIndex] = useState(-1);
    const [loadingGone, setLoadingGone] = useState(false);
    const [websiteModalVisible, setWebsiteModalVisible] = useState(false);
    const opacity = useSharedValue(1);
    const[error, setError] = useState<null | string>(null);
    const { trackEvent }  = usePosthogLogic();
    const { styles, theme } = useStyles(stylesheet);

    useEffect(() => {
        let isSetup = false;
        
        const setupPlayer = async () => {
            try {
                if (!isSetup) {
                    await TrackPlayer.setupPlayer({
                        autoHandleInterruptions: true,
                    });
                    
                    await TrackPlayer.updateOptions({
                        capabilities: [
                            Capability.Play,
                            Capability.Pause,
                            Capability.Stop,
                            Capability.SeekTo,
                            Capability.SkipToNext,
                            Capability.SkipToPrevious,
                        ],
                        progressUpdateEventInterval: 1,
                        forwardJumpInterval: 10,
                        backwardJumpInterval: 10,
                    });
                    
                    TrackPlayer.reset();
                    isSetup = true;
                }
            } catch (error) {
                console.warn('TrackPlayer setup failed:', error);
            }
        };
        
        setupPlayer();
        
        return () => {
            TrackPlayer.reset();
        };
    }, []);

    useEffect(() => {
        trackEvent('mobile_user_viewed_dashboard_page', {});
        
        setTimeout(() => {
            SplashScreen.hideAsync();
        }, 750);

        // Single recovery check after the user has had time to authenticate and load the app
        const recoveryTimer = setTimeout(async () => {
            // If user just logged in, we should be careful about showing recovery alerts for old sessions
            // This prevents new users from seeing alerts for recordings from previous users
            if (session?.user) {
                // First, mark any legacy backups as belonging to other users to prevent cross-user contamination
                await recordingBackupService.markLegacyBackupsAsOtherUsers();
                
                // Then show recovery dialog for current user's recordings only
                recordingRecoveryService.showRecoveryDialog();
            }
        }, 2000);

        // Cleanup timeout on unmount
        return () => {
            clearTimeout(recoveryTimer);
        };
    }, [session?.user?.id]); // Add session user ID as dependency to re-run when user changes
    
    useEffect(() => {
        // Skip if student data is still loading
        if (studentRowPending) {
            return;
        }
        
        const shouldShowModal = () => {
            // Don't show if user has already accessed web
            if (studentRow?.has_accessed_web) {
                return false;
            }
            
            const requests = typeof websitePresentationRequests === 'number' ? websitePresentationRequests : 0;
            
            if (requests >= 3) {
                return false;
            }
            
            const lastShown = websitePresentationLastShown ? new Date(websitePresentationLastShown) : null;
            const now = new Date();
            
            if (!lastShown || isNaN(lastShown.getTime())) {
                return true;
            }
            
            const hoursSinceLastShown = Math.floor((now.getTime() - lastShown.getTime()) / (1000 * 60 * 60));
            return hoursSinceLastShown >= 24;
        };
        
        if (shouldShowModal()) {
            setTimeout(() => {
                setWebsiteModalVisible(true);
                setWebsitePresentationLastShown(new Date().toISOString());
                setWebsitePresentationRequests((prev) => {
                    const currentValue = typeof prev === 'number' ? prev : 0;
                    return currentValue + 1;
                });
            }, 2000);
        }
    }, [studentRow, studentRowPending, websitePresentationRequests, websitePresentationLastShown]);

    const fetchData = async () => {
        try {
            const isUserPayingOnWeb = await checkUserActiveSubscription();
            setIsPayingOnWeb(isUserPayingOnWeb);
        }
        catch (error : any) {
            setError(error.message);
        }
    }

    useEffect(() => {
        fetchData();
      }, []);
      
    useEffect(() => {
        if(!contentRowsPending && !folderRowsPending) {
            uncoverLoader();
        }
    }, [contentRowsPending, folderRowsPending]);

    const uncoverLoader = () => {
        setTimeout(() => {
            opacity.value = 0;
            setTimeout(() => {
                setLoadingGone(true)
            }, 250)
        }, 1000)
    }
    
    const handleWebsitePress = () => {
        Linking.openURL('https://turbo.ai');
        setWebsiteModalVisible(false);
    };
    
    const handleModalClose = () => {
        setWebsiteModalVisible(false);
    };


    if(error) {
        return (
            <Container>
                <Header />
                <View style={styles.line}/>
                <View style={{flex: 0.9, justifyContent: 'center', alignItems: 'center'}}>
                    <Text style={styles.errorText}>{error || "Unexpected error occurred!"}</Text>
                    <BasicButton text="Try Again" onPress={async () => {
                        setError(null);
                        setLoadingGone(false);
                        await fetchData();
                    }} backgroundColor={theme.colors.tints.SECONDARY}/>
                </View>
            </Container>
        );
    }

    return <UnsafeContainer>
        <View style={{ marginTop: Constants.statusBarHeight }} />
        <Header />
        <View style={styles.line}/>
        <NotesSubheader onCreateFolderPress={() => setNewFolderSheetIndex(0)} />
        <View style={styles.container}>
            <LegendList
                style={{ width: '100%' }}
                data={[
                    ...(folderRows || []).map(folder => ({ type: 'folder' as const, data: folder })),
                    ...(contentRows?.filter(note => !note.is_deleted) || []).map(content => ({ type: 'note' as const, data: content }))
                ]}
                keyExtractor={(item) => item.type === 'folder' ? `folder-${item.data.folder_id}` : `note-${item.data.content_id}`}
                showsVerticalScrollIndicator={false}
                contentContainerStyle={{ paddingBottom: 250, alignItems: 'center' }}
                estimatedItemSize={100}
                renderItem={({ item }) => {
                    if (item.type === 'folder') {
                        return (
                            <ViewFolderButton
                                folder={item.data}
                                handleThreeDots={(folder_id: string) => {
                                    setPressedFolderID(folder_id);
                                    setFolderSettingsSheetIndex(0);
                                }}
                            />
                        );
                    } else {
                        return (
                            <ViewNoteButton
                                content={item.data}
                                handleThreeDots={(content_id: string) => {
                                    setPressedContentID(content_id);
                                    setNoteSettingsSheetIndex(0);
                                }}
                            />
                        );
                    }
                }}
                ListEmptyComponent={ <ViewNoteButton
                    content={welcomeNoteContent as Content}
                    handleThreeDots={(content_id: string) => {
                        setPressedContentID(content_id);
                        setNoteSettingsSheetIndex(0);
                    }}
                />}
            />
        </View>
        <NewNoteButton />
        {loadingGone ? null : <HomeScreenNoteLoader opacity={opacity}/>}
        <NoteSettingsSheet 
            content_id={pressedContentID} 
            index={noteSettingsSheetIndex} 
            setIndex={setNoteSettingsSheetIndex}
        />
        <FolderSettingsSheet
            folder_id={pressedFolderID}
            index={folderSettingsSheetIndex}
            setIndex={setFolderSettingsSheetIndex}
        />
        <NewFolderSheet
            index={newFolderSheetIndex}
            setIndex={setNewFolderSheetIndex}
        />
        <WebsitePresentationModal
            visible={websiteModalVisible}
            onClose={handleModalClose}
            onWebsitePress={handleWebsitePress}
        />
    </UnsafeContainer>
}

const stylesheet = createStyleSheet((theme) => ({
    container: {
        flex: 1,
        width: windowWidth,
        alignSelf: 'center',
        alignItems: 'center'
    },
    line: {
        marginTop: 15,
        marginBottom: 15,
        width: windowWidth,
        borderWidth: 0.5,
        borderColor: theme.colors.grays.PRIMARY,
    },
    errorText: {
        marginBottom: 20,
        color: theme.colors.text.PRIMARY,
        fontSize: moderateScale(13),
        textAlign: 'center',
        width: windowWidth * .8,
        fontFamily: 'Sans-Regular',
    }
}))
</file>

