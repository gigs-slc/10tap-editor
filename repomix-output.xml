import React, {useCallback, useMemo, useRef, useState} from "react";
import BottomSheet, {BottomSheetFlatList} from "@gorhom/bottom-sheet";
import {Text, TouchableOpacity, View} from "react-native";
import {moderateScale} from "react-native-size-matters";
import {windowWidth} from "@/utils/window";
import {createStyleSheet, useStyles} from "react-native-unistyles";
import LoadingModal from "@/common/components/modals/loadingModal";
import Toast from "react-native-toast-message";
import {Folder} from "@/data/folders/types";
import { useFolderRowsQuery } from "@data/folders/hooks/useFolderRowsQuery";
import { useUpdateContentMutation } from "@data/content/hooks/useUpdateContentMutation";

export default function AddNotesToFolderSheet({content_id, index, setIndex} : { content_id: string; index: number; setIndex: any; }) {
    const bottomSheetRef = useRef<BottomSheet>(null);
    const { data: folderRows, isPending : folderRowsPending } = useFolderRowsQuery();
    const snapPoints = useMemo(() => ["80%"], []);
    const [loading, setLoading] = useState<boolean>(false);
    const { styles, theme } = useStyles(stylesheet);

    const handleSheetChanges = useCallback((index: number) => {
        setIndex(index);
    }, [setIndex]);

    const updateContentFolderID = useUpdateContentMutation();

    const handleFolderSelection = async (folder_id: string | null) => {
        try {
            setLoading(true);
            updateContentFolderID.mutate({
                content_id: content_id,
                folder_id: folder_id
            });

            Toast.show({
                type: 'success',
                text1: 'Note added to folder successfully'
            });

            setIndex(-1);
        } catch (error: any) {
            Toast.show({
                type: 'error',
                text1: 'Error adding note to folder',
                text2: error.message || 'An unexpected error occurred'
            });
        } finally {
            setLoading(false);
            bottomSheetRef.current?.close();
        }
    };

    const renderFolderItem = ({item}: {item: Folder}) => {
        return (
            <TouchableOpacity
                key={item.folder_id}
                style={styles.folderContainer}
                onPress={() => handleFolderSelection(item.folder_id)}
            >
                <Text style={styles.emoji}>{item.emoji}</Text>
                <Text style={styles.folderTitle}>{item.title}</Text>
            </TouchableOpacity>
        );
    };

    const keyExtractor = (item: Folder) => item.folder_id;

    return (
        <BottomSheet
            ref={bottomSheetRef}
            index={index}
            backgroundStyle={styles.bottomSheetBackground}
            handleIndicatorStyle={styles.bottomSheetHandleIndicator}
            handleStyle={styles.bottomSheetHandle}
            enablePanDownToClose={true}
            snapPoints={snapPoints}
            onChange={handleSheetChanges}
        >
            <LoadingModal visible={loading} message={'Saving note...'} />

            <View style={styles.headerContainer}>
                <Text style={styles.headerText}>Select Folder</Text>
            </View>

            <BottomSheetFlatList
                data={folderRows || []}
                renderItem={renderFolderItem}
                keyExtractor={keyExtractor}
                contentContainerStyle={{paddingBottom: 100}}
                showsVerticalScrollIndicator={false}
                ListHeaderComponent={
                    <TouchableOpacity
                        style={styles.folderContainer}
                        onPress={() => handleFolderSelection(null)}
                    >
                        <Text style={styles.emoji}>❌</Text>
                        <Text style={styles.folderTitle}>No Folder</Text>
                    </TouchableOpacity>
                }
                ListEmptyComponent={
                    folderRowsPending ? (
                        <Text style={styles.emptyText}>Loading folders...</Text>
                    ) : (
                        <Text style={styles.emptyText}>No folders found</Text>
                    )
                }
            />
        </BottomSheet>
    );
}

const stylesheet = createStyleSheet((theme) => ({
    bottomSheetBackground: {
        backgroundColor: theme.colors.background.TERTIARY,
    },
    bottomSheetHandleIndicator: {
        backgroundColor: theme.colors.grays.PRIMARY,
    },
    bottomSheetHandle: {
        backgroundColor: theme.colors.background.TERTIARY,
    },
    folderContainer: {
        width: windowWidth * .9,
        borderRadius: 15,
        flexDirection: "row",
        alignItems: 'center',
        backgroundColor: theme.colors.background.QUATERNARY,
        borderColor: theme.colors.background.QUATERNARY,
        marginVertical: 5,
        paddingVertical: 15,
        paddingHorizontal: 15,
        alignSelf: 'center',
        borderWidth: 1,
    },
    folderTitle: {
        fontFamily: 'Sans-Medium',
        fontSize: moderateScale(16),
        marginLeft: 10,
        color: theme.colors.text.PRIMARY,
    },
    headerContainer: {
        flexDirection: 'row',
        justifyContent: 'center',
        alignItems: 'center',
        paddingHorizontal: 20,
        paddingVertical: 15,
        borderBottomWidth: 1,
        borderBottomColor: theme.colors.background.QUATERNARY,
        marginBottom: 10,
    },
