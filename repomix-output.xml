import {useMutation, useQueryClient, UseMutationResult} from "@tanstack/react-query";
import {deletePodcastMutation} from "@data/podcast/mutations";
import {Podcast} from "@data/podcast/types";

export const useDeletePodcastMutation = (content_id: string): UseMutationResult<void, Error, string> => {
    const queryClient = useQueryClient();

    return useMutation({
        mutationFn: (podcast_id: string) => deletePodcastMutation(podcast_id),
        onMutate: async (podcast_id : string) => {
            await queryClient.cancelQueries({ queryKey: ['podcast', 'list', 'content', content_id] });
            await queryClient.cancelQueries({ queryKey: ['podcast', 'individual', podcast_id] });

            const previousPodcasts : Podcast[] | undefined = queryClient.getQueryData<Podcast[]>(['podcast', 'list', 'content', content_id]);
            const previousPodcast : Podcast | undefined = queryClient.getQueryData<Podcast>(['podcast', 'individual', podcast_id]);

            queryClient.setQueryData(
                ['podcast', 'list', 'content', content_id],
                (oldData: Podcast[] | undefined) => {
                    if (!oldData) return [];
                    return oldData.filter((podcast : Podcast) => podcast.podcast_id !== podcast_id);
                }
            );
            queryClient.removeQueries({ queryKey: ['podcast', 'individual', podcast_id] });

            return { previousPodcasts: previousPodcasts, previousPodcast: previousPodcast };
        },
        onError: (err, podcast_id, context) => {
            if (context?.previousPodcasts) {
                queryClient.setQueryData(['podcast', 'list', 'content', content_id], context.previousPodcasts);
            }
            if (context?.previousPodcast) {
                queryClient.setQueryData(['podcast', 'individual', podcast_id], context.previousPodcast);
            }
        },
        onSuccess: (_void, podcast_id) => {
            queryClient.setQueryData(
                ['podcast', 'list', 'content', podcast_id],
                (oldData: Podcast[] | undefined) => {
                    if (!oldData) return [];
                    return oldData.filter(podcast => podcast.podcast_id !== podcast_id);
