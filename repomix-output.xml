import React, { useEffect } from 'react';
import { View, Text, TouchableOpacity } from "react-native";
import { createStyleSheet, useStyles } from "react-native-unistyles";
import { moderateScale } from "react-native-size-matters";
import LottieView from "lottie-react-native";
import { windowWidth } from '@/utils/window';
import { useRealtimePodcastSubscription } from "@data/podcast/hooks/useRealtimePodcastSubscription";
import { usePodcastRowsQuery } from "@data/podcast/hooks/usePodcastRowsQuery";
import Animated, { 
    FadeIn,
    FadeInDown 
} from 'react-native-reanimated';

interface PodcastLoadingProps {
    podcast_id: string;
    content_id: string;
    onViewAllPodcasts?: () => void;
}

export default function PodcastLoading({ podcast_id, content_id, onViewAllPodcasts }: PodcastLoadingProps) {
    const { styles, theme } = useStyles(stylesheet);
    const { data: podcasts, refetch } = usePodcastRowsQuery(content_id);
    const hasOtherPodcasts = podcasts && podcasts.length > 0;

    useRealtimePodcastSubscription(podcast_id);

    // Temporary fallback: force-refetch periodically in case realtime subscription misses updates
    useEffect(() => {
        const intervalId = setInterval(() => {
            void refetch();
        }, 3000);

        return () => clearInterval(intervalId);
    }, [refetch]);


    return (
        <View style={styles.container}>
            <Animated.View 
                entering={FadeInDown.duration(800).springify()}
                style={styles.card}
            >
                <Animated.View 
                    entering={FadeIn.duration(600).delay(200)}
                    style={styles.headerContainer}
                >
                    <View style={styles.iconContainer}>
                        <View style={styles.iconBackground}>
                            <Text style={styles.podcastIcon}>🎙️</Text>
                        </View>
                    </View>
                    
                    <Text style={styles.loadingTitle}>Generating your podcast...</Text>
                </Animated.View>

                <Animated.View 
                    entering={FadeIn.duration(600).delay(400)}
                    style={styles.subtitleContainer}
                >
                    <Text style={styles.timeEstimate}>
                        Estimated time: 5-15 minutes.
                    </Text>
                </Animated.View>

                <Animated.View 
                    entering={FadeIn.duration(600).delay(600)}
                    style={styles.lottieWrapper}
                >
                    <View style={styles.lottieContainer}>
                        <LottieView
                            source={require("@/../assets/lottie/cooking.json")}
                            style={styles.lottieAnimation}
                            autoPlay
                            loop
                        />
                    </View>
                </Animated.View>
                
                {hasOtherPodcasts && onViewAllPodcasts && (
                    <Animated.View
                        entering={FadeIn.duration(600).delay(1000)}
                        style={styles.buttonContainer}
                    >
                        <TouchableOpacity 
                            style={styles.viewAllButton}
                            onPress={onViewAllPodcasts}
                            activeOpacity={0.8}
                        >
                            <Text style={styles.viewAllButtonText}>View All Podcasts</Text>
                        </TouchableOpacity>
                    </Animated.View>
                )}
            </Animated.View>
        </View>
    );
}

