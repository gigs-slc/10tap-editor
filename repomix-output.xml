<file path="src/data/student/hooks/useUpdateStudentMutation.ts">
import {useMutation, useQueryClient, UseMutationResult} from "@tanstack/react-query";
import {updateStudentMutation} from "@data/student/mutations";
import {Student, UpdateStudent} from "@data/student/types";

export const useUpdateCurrentStudentMutation = (): UseMutationResult<Student, Error, UpdateStudent> => {
    const queryClient = useQueryClient();

    return useMutation({
        mutationFn: (updatedStudent: UpdateStudent) => updateStudentMutation(updatedStudent),
        onMutate: async (updates: UpdateStudent) => {
            await queryClient.cancelQueries({ queryKey: ['current_student'] });

            const previousStudent : Student | undefined = queryClient.getQueryData<Student>(['current_student']);

            if (previousStudent) {
                const optimisticStudent : Student = { ...previousStudent, ...updates };

                queryClient.setQueryData(['current_student'], optimisticStudent);
            }

            return { previousStudent };
        },
        onError: (err, updates, context) => {
            if (context?.previousStudent) {
                queryClient.setQueryData(['current_student'], context.previousStudent);
            }
        },
        onSuccess: (updatedStudent : Student) => {
            queryClient.setQueryData(['current_student'], updatedStudent);
        }
    });
}
</file>

