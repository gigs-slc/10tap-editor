import useYProvider from 'y-partyserver/react';
import { ClarikaLightBase64, ClarikaRegularBase64, ClarikaMediumBase64, ClarikaBoldBase64, ClarikaHeavyBase64, ClarikaBlackBase64 } from './fontBase64';
import { getExtensions, ExtensionArgs } from '../tiptap-extensions';


const cursorColors: string[] = ['#FF5733', '#33FF57', '#3357FF', '#F1C40F', '#9B59B6'];
const randomColor: string = cursorColors[Math.floor(Math.random() * cursorColors.length)];

const themes = {
    light: {
        colors: {
            tints: {
                PRIMARY: '#9969fa',
                SECONDARY: '#9969fa',
