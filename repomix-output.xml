import {createStyleSheet, useStyles} from "react-native-unistyles";
import {windowWidth} from "@/utils/window";
import {moderateScale} from "react-native-size-matters";
import Animated, {useAnimatedStyle, useSharedValue, withTiming} from "react-native-reanimated";
import React, {useEffect} from "react";
import {Alert, TouchableOpacity} from "react-native";
import {Ionicons} from "@expo/vector-icons";
import {Text} from "@/common/generics/Text";
import {heavyHaptic} from "@/utils/haptic";

export default function AudioControls({isRecording, isPaused, startNewRecording, pauseRecording, resumeRecording, handleDiscard} : { isRecording : boolean; isPaused : boolean; startNewRecording : any, pauseRecording : any, resumeRecording : any, handleDiscard : any}) {
    const buttonOpacity = useSharedValue(1);
    const { styles, theme } = useStyles(stylesheet);

    const animatedStyle = useAnimatedStyle(() => {
        return {
            opacity: withTiming(buttonOpacity.value, { duration: 500 }),
        };
    });

    useEffect(() => {
        if (!isRecording) {
            buttonOpacity.value = 1;
        }
    }, [isRecording]);

    let buttonText = 'Start Recording';
    let iconName: 'mic-outline' | 'pause-outline' | 'play-outline'  = 'mic-outline';
    let iconPosition = 'left';

    if (isRecording && !isPaused) {
        buttonText = 'Pause Recording';
        iconName = 'pause-outline';
        iconPosition = 'left';
    } else if (isRecording && isPaused) {
        buttonText = 'Resume Recording';
        iconName = 'play-outline';
        iconPosition = 'left';
    }

    const handleButtonPress = async () => {
        if (!isRecording) {
            await startNewRecording();
        } else if (isRecording && !isPaused) {
            await pauseRecording();
        } else if (isRecording && isPaused) {
            await resumeRecording();
        }
    };

    const DiscardAudioButton = () => {
        if(!isRecording) return null;
        return <TouchableOpacity style={styles.discardAudioContainer} onPress={() => {
            heavyHaptic();
            Alert.alert('Are you sure you want to delete this recording?', '', [
                {
                    text: 'Delete Recording',
                    onPress: () => {
                        void handleDiscard();
                    },
                    style: 'destructive',
                },
                {
                    text: 'Cancel',
                    onPress: () => {

                    },
                }
            ])
        }}>
            <Ionicons name={"trash-outline"} size={20} color="#db5a5a" style={{ marginRight: 5 }} />
            <Text style={styles.discardAudioText}>Discard Audio</Text>
        </TouchableOpacity>
    }

    return (
        <Animated.View style={[styles.recordingButtonContainer, animatedStyle]}>
            <TouchableOpacity onPress={handleButtonPress} style={styles.recordingButton}>
                {iconPosition === 'left' && <Ionicons name={iconName} size={24} color={theme.colors.text.PRIMARY} style={{ marginRight: 10 }} />}
                <Text style={styles.recordingButtonText}>{buttonText}</Text>
                {iconPosition === 'right' && <Ionicons name={iconName} size={24} color={theme.colors.text.PRIMARY} style={{ marginLeft: 10 }} />}
            </TouchableOpacity>
            <DiscardAudioButton />
        </Animated.View>
    );
}

const stylesheet = createStyleSheet((theme) => ({
    recordingButtonContainer: {
        alignItems: 'center',
    },
    recordingButton: {
        flexDirection: 'row',
        alignItems: 'center',
        justifyContent: 'center',
        backgroundColor: theme.colors.background.SECONDARY,
        paddingVertical: 15,
        width: windowWidth * .9,
        borderRadius: 30,
    },
    recordingButtonText: {
        fontSize: moderateScale(16),
        fontFamily: 'Sans-Medium',
    },
    discardAudioContainer: {
        marginTop: 15,
        flexDirection: 'row',
        justifyContent: 'center',
        alignItems: 'center'
    },
