            style={styles.saveButton}
          />
        </View>

      {/* Instructions Modal */}
      <Modal
        visible={openInstructionsModal}
        transparent
        animationType="fade"
        onRequestClose={() => setOpenInstructionsModal(false)}
      >
        <TouchableOpacity
          style={styles.instructionsModalOverlay}
