import {Text, TouchableOpacity, View} from "react-native";
import Animated, {
    useAnimatedStyle,
    withTiming,
    interpolate
} from "react-native-reanimated";
import {createStyleSheet, useStyles} from "react-native-unistyles";
import {moderateVerticalScale} from "react-native-size-matters";
import Ionicons from "@expo/vector-icons/Ionicons";
import {heavyHaptic} from "@/utils/haptic";
import QuizArrow from "./QuizArrow";

const AnimatedTouchableOpacity = Animated.createAnimatedComponent(TouchableOpacity);

interface QuizNavigationButtonsProps {
    currentQuestionIndex: number;
    totalQuestions: number;
    isCurrentQuestionAnswered: boolean;
    shouldShowNextButton: boolean;
    hintTextAnimatedStyle: any;
    onPrevious: () => void;
    onNext: () => void;
    onHintPress: () => void;
    onTopicsPress: () => void;
}

export default function QuizNavigationButtons({
    currentQuestionIndex,
    totalQuestions,
    isCurrentQuestionAnswered,
    shouldShowNextButton,
    hintTextAnimatedStyle,
    onPrevious,
    onNext,
    onHintPress,
    onTopicsPress
}: QuizNavigationButtonsProps) {
    const { styles, theme } = useStyles(stylesheet);
    const canGoPrevious = currentQuestionIndex < totalQuestions - 1;
    
    const topicsAnimatedStyle = useAnimatedStyle(() => {
        const width = interpolate(
            shouldShowNextButton ? 1 : 0,
            [0, 1],
            [100, 50]
        );
        return {
            width: withTiming(width, { duration: 300 })
        };
    });
    
    return (
        <View style={styles.buttonRow}>
            <TouchableOpacity 
                style={[styles.arrowButton, !canGoPrevious && styles.disabledButton]}
                onPress={() => {
                    if (canGoPrevious) {
                        void heavyHaptic();
                        onPrevious();
                    }
                }}
            >
                <Ionicons 
                    name="chevron-back" 
                    size={moderateVerticalScale(24)} 
                    color={canGoPrevious ? theme.colors.text.PRIMARY : theme.colors.text.SECONDARY} 
                />
            </TouchableOpacity>
            <TouchableOpacity 
                style={styles.hintButton} 
                onPress={() => {
                    void heavyHaptic();
                    onHintPress();
                }}
            >
                <Animated.Text style={[styles.iconButtonText, hintTextAnimatedStyle]}>
                    {isCurrentQuestionAnswered ? 'Explain 🤔' : 'Hint 💡'}
                </Animated.Text>
            </TouchableOpacity>
            <AnimatedTouchableOpacity 
                style={[styles.topicsButton, topicsAnimatedStyle]}
                onPress={() => {
                    void heavyHaptic();
                    onTopicsPress();
                }}
            >
                <Text style={styles.iconButtonText}>
                    {shouldShowNextButton ? '📚' : 'Topics 📚'}
                </Text>
            </AnimatedTouchableOpacity>
            <QuizArrow 
                isAnswered={shouldShowNextButton}
                onPressNext={onNext}
            />
        </View>
    );
}

