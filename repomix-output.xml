<file path="src/data/folders/hooks/useInsertFolderMutation.ts">
import {useMutation, UseMutationResult, useQueryClient} from "@tanstack/react-query";
import {Folder, InsertFolder} from "@/data/folders/types";
import {insertFolderMutation} from "@/data/folders/mutations";

export const useInsertFolderMutation = () : UseMutationResult<Folder, Error, InsertFolder> => {
    const queryClient = useQueryClient();

    return useMutation({
        mutationFn: (newFolder: InsertFolder) => insertFolderMutation(newFolder),
        onMutate: async (newFolder: InsertFolder)  => {
            await queryClient.cancelQueries( { queryKey: ['folder', 'list'] });

            const previousFolders : Folder[] | undefined = queryClient.getQueryData<Folder[]>(['folder', 'list']);

            const optimisticFolder: Partial<Folder> = {
                ...newFolder,
                created_at: new Date().toISOString(),
            };

            queryClient.setQueryData(['folder', 'list'],
                (oldData: Folder[] | undefined) => {
                    if (!oldData) return [optimisticFolder as Folder]
                    return [optimisticFolder as Folder, ... oldData];
                }
            );
            queryClient.setQueryData(['folder', 'individual', newFolder.folder_id], optimisticFolder);

            return { previousFolders };

        },
        onError: (err, newFolder, context) => {
            if (context?.previousFolders) {
                queryClient.setQueryData(['folder', 'list'], context.previousFolders);
            }
            queryClient.removeQueries({ queryKey: ['folder', 'individual', newFolder.folder_id] });
        },
        onSuccess: (newFolder: Folder) => {
            queryClient.setQueryData(
                ['folder', 'list'],
                (oldData: Folder[] | undefined) => {
                    if (!oldData) return [newFolder];
                    return oldData.map(folder =>
                        folder.folder_id === newFolder.folder_id ? newFolder : folder
                    );
                }
            );
            queryClient.setQueryData(['folder', 'individual', newFolder.folder_id], newFolder);
        },
    })
}
</file>

