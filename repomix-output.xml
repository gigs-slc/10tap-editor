<file path="editor-web/styling/lists.css">
/* CSS Variables for turbo colors */
:root {
  --turbo: #6823FF;
  --turbo-hover: #5819E6;
}

/* List styling */

/* Bullet list (unordered) styling */
.tiptap ul {
    margin: 1em 0;
    padding-left: 1.5em;
    list-style-type: disc;
}

/* 9 levels of nested bullet lists */
.tiptap ul ul {
    list-style-type: circle;
}

.tiptap ul ul ul {
    list-style-type: square;
}

.tiptap ul ul ul ul {
    list-style-type: disc;
}

.tiptap ul ul ul ul ul {
    list-style-type: circle;
}

.tiptap ul ul ul ul ul ul {
    list-style-type: square;
}

.tiptap ul ul ul ul ul ul ul {
    list-style-type: disc;
}

.tiptap ul ul ul ul ul ul ul ul {
    list-style-type: circle;
}

.tiptap ul ul ul ul ul ul ul ul ul {
    list-style-type: square;
}

/* Ordered list styling - 9 levels */
.tiptap ol {
    margin: 1em 0;
    padding-left: 1.5em;
    list-style-type: decimal;
}

.tiptap ol ol {
    list-style-type: lower-alpha;
}

.tiptap ol ol ol {
    list-style-type: lower-roman;
}

.tiptap ol ol ol ol {
    list-style-type: decimal;
}

.tiptap ol ol ol ol ol {
    list-style-type: lower-alpha;
}

.tiptap ol ol ol ol ol ol {
    list-style-type: lower-roman;
}

.tiptap ol ol ol ol ol ol ol {
    list-style-type: decimal;
}

.tiptap ol ol ol ol ol ol ol ol {
    list-style-type: lower-alpha;
}

.tiptap ol ol ol ol ol ol ol ol ol {
    list-style-type: lower-roman;
}

/* List item styling */
.tiptap li {
    position: relative;
    margin: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    line-height: inherit;
}

/* Ensure paragraphs inside list items have no spacing */
.tiptap li p {
    margin: 0 !important;
    padding: 0 !important;
}

/* Remove any spacing from list item content */
.tiptap li > * {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
}

/* First and last child specific */
.tiptap li > *:first-child {
    margin-top: 0 !important;
}

.tiptap li > *:last-child {
    margin-bottom: 0 !important;
}

/* Task list styles to match regular lists */
.tiptap ul[data-type="taskList"] {
  list-style: none;
  /* Inherits padding and margin from .tiptap ul rule */
}

.tiptap ul[data-type="taskList"] li {
  display: flex;
  align-items: flex-start;
  /* Inherits margin-left from .tiptap li rule */
}

.tiptap ul[data-type="taskList"] li > label {
  flex: 0 0 auto;
  margin-right: 0.5rem;
  margin-top: 0.125rem;
  user-select: none;
  display: flex;
  align-items: center;
}

.tiptap ul[data-type="taskList"] li > div {
  flex: 1 1 auto;
}

/* Style the checkbox with turbo colors */
.tiptap ul[data-type="taskList"] input[type="checkbox"] {
  cursor: pointer;
  width: 1.125rem;
  height: 1.125rem;
  border-radius: 0.25rem;
  border: 2px solid #d1d5db;
  background-color: transparent;
  transition: all 0.15s ease;
  appearance: none;
  -webkit-appearance: none;
  position: relative;
}

.tiptap ul[data-type="taskList"] input[type="checkbox"]:hover {
  border-color: var(--turbo-hover);
}

.tiptap ul[data-type="taskList"] input[type="checkbox"]:focus-visible {
  outline: 2px solid var(--turbo);
  outline-offset: 2px;
}

.tiptap ul[data-type="taskList"] input[type="checkbox"]:checked {
  background-color: var(--turbo);
  border-color: var(--turbo);
}

.tiptap ul[data-type="taskList"] input[type="checkbox"]:checked::after {
  content: '';
  position: absolute;
  left: 0.275rem;
  top: 0.075rem;
  width: 0.25rem;
  height: 0.5rem;
  border: solid white;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}

/* Completed task text styling */
.tiptap ul[data-type="taskList"] li[data-checked="true"] > div {
  text-decoration: line-through;
  opacity: 0.6;
}

/* Nested task lists */
.tiptap ul[data-type="taskList"] ul[data-type="taskList"] {
  margin-top: 0.25rem;
  margin-bottom: 0.25rem;
  margin-left: 0;
  margin-right: 0;
}

/* Dark mode support */
@media (prefers-color-scheme: dark) {
  .tiptap ul[data-type="taskList"] input[type="checkbox"] {
    border-color: #4b5563;
  }
  
  .tiptap ul[data-type="taskList"] input[type="checkbox"]:hover {
    border-color: var(--turbo);
  }
  
  .tiptap ul[data-type="taskList"] input[type="checkbox"]:focus-visible {
    outline-color: var(--turbo);
  }
}

/* Nested list item spacing */
.tiptap li > ul,
.tiptap li > ol {
    margin: 0;
}

/* Indent each level progressively */
.tiptap li li {
    padding-left: 0.5em;
}

/* Custom bullet with Unicode characters */
.tiptap ul.custom-bullets {
    list-style: none;
}

.tiptap ul.custom-bullets li::before {
    content: "▸";
    color: #6823FF;
    font-weight: bold;
    display: inline-block;
    width: 1em;
    margin-left: -1em;
}
</file>

