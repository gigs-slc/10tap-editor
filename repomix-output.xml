            }
            .ProseMirror {
                background-color: ${currentTheme.colors.background.PRIMARY};
                color: ${currentTheme.colors.text.PRIMARY};
                padding: 0 20px 40px 20px;
                font-family: 'Clarika';
                font-weight: 400;
            }
            .ProseMirror h1, .ProseMirror h2, .ProseMirror h3, 
            .ProseMirror h4, .ProseMirror h5, .ProseMirror h6 {
                color: ${currentTheme.colors.text.PRIMARY};
                font-family: 'Clarika';
                font-weight: 700;
            }
            .ProseMirror h1 { font-weight: 900; }
            .ProseMirror h2 { font-weight: 800; }
            .ProseMirror h3 { font-weight: 700; }
            .ProseMirror strong, .ProseMirror b {
                font-weight: 700;
            }
            .ProseMirror a {
                color: ${currentTheme.colors.tints.PRIMARY};
            }
            .ProseMirror blockquote {
                border-left-color: ${currentTheme.colors.tints.PRIMARY};
                color: ${currentTheme.colors.grays.PRIMARY};
            }
            .ProseMirror code {
                background-color: ${currentTheme.colors.background.SECONDARY};
                color: ${currentTheme.colors.text.PRIMARY};
            }
            .ProseMirror pre {
                background-color: ${currentTheme.colors.background.TERTIARY};
                color: ${currentTheme.colors.text.PRIMARY};
            }
            .ProseMirror hr {
                border-color: ${currentTheme.colors.background.TERTIARY};
            }
            .ProseMirror table {
                border-color: ${currentTheme.colors.background.TERTIARY};
            }
            .ProseMirror th {
                background-color: ${currentTheme.colors.background.SECONDARY};
                border-color: ${currentTheme.colors.background.TERTIARY};
            }
            .ProseMirror td {
                border-color: ${currentTheme.colors.background.TERTIARY};
            }
            /* Code block styles */
            .tiptap .code-block select {
                background-color: ${currentTheme.colors.background.SECONDARY};
                color: ${currentTheme.colors.text.PRIMARY};
                border: 1px solid ${currentTheme.colors.background.TERTIARY};
            }
            /* Update syntax highlighting for dark theme */
            ${theme === 'dark' ? `
                .tiptap pre .hljs-comment,
                .tiptap pre .hljs-quote {
                    color: #8b949e;
                }
                .tiptap pre .hljs-keyword,
                .tiptap pre .hljs-selector-tag {
                    color: #79c0ff;
                }
            ` : ''}
        `;

        const existingStyle = document.getElementById('theme-styles');
        if (existingStyle) {
            existingStyle.remove();
        }
        
        document.head.appendChild(style);
        
        return () => {
            style.remove();
        };
    }, [theme]);

    React.useEffect(() => {
        const handleMessage = (event: MessageEvent) => {
            try {
                const data = JSON.parse(event.data);
                if (data.type === 'editorData') {
                    window.editorData = {
                        content_id: data.content_id,
                        student_id: data.student_id,
                        name: data.name,
                        yjs_url: data.yjs_url,
                        token: data.token,
                        pm_schema_version: data.pm_schema_version
                    };
                    setEditorData(window.editorData);
                    // Silent success; native side will drive visibility
                } else if (data.type === 'theme') {
                    setTheme(data.text as 'light' | 'dark');
                    // Theme applied
                }
            } catch (error) {
                // Ignore parse errors in production
            }
        };

        // React Native WebView can dispatch the message event on `document` (Android/iOS)
        // and sometimes on `window` depending on version. Listen to both.
        document.addEventListener('message', handleMessage as any);
        window.addEventListener('message', handleMessage);
        return () => {
            document.removeEventListener('message', handleMessage as any);
            window.removeEventListener('message', handleMessage);
        };
    }, []);

    window.ReactNativeWebView?.postMessage(
        JSON.stringify({
            type: "log",
            message: `[AdvancedEditor] Component rendered, editorData: ${JSON.stringify(editorData)}`,
        }),
    );

    if (!editorData) {
        return null;
    }

    return <EditorWithContent editorData={editorData} />;
};
</file>

