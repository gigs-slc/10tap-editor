import { queryClient } from '@/utils/reactQueryClient';
import { getSingleContentRowQuery } from '@data/content/queries';
import { getPodcastRowsQuery } from '@data/podcast/queries';
import { getPodcastSpeakersRowsQuery } from '@data/podcast_speakers/queries';
import { getTopicRowsQuery } from '@data/topics/queries';
import { getQuizRowsQuery } from '@data/quiz_questions/queries';
import FastImage from 'react-native-fast-image';


export const prefetchContentData = async (content_id: string, isSubscribed: boolean) => {
    const promises = [
        queryClient.prefetchQuery({
            queryKey: ['content', 'individual', content_id],
            queryFn: () => getSingleContentRowQuery(content_id),
        }),
        queryClient.prefetchQuery({
            queryKey: ['podcast', 'list', 'content', content_id],
            queryFn: () => getPodcastRowsQuery(content_id),
        }),
        queryClient.prefetchQuery({
            queryKey: ['podcast_speakers', 'list'],
            queryFn: () => getPodcastSpeakersRowsQuery(),
        }),
        queryClient.prefetchQuery({
            queryKey: ['topics', 'list', 'content', content_id],
            queryFn: () => getTopicRowsQuery(content_id),
        }),
        queryClient.prefetchQuery({
            queryKey: ['questions', 'list', 'content', content_id],
            queryFn: () => getQuizRowsQuery(content_id),
        }),
        // flashcards logic needed
    ];

    await Promise.all(promises);

    // Prefetch podcast speaker avatar images from cache
    const speakers = queryClient.getQueryData<Awaited<ReturnType<typeof getPodcastSpeakersRowsQuery>>>(['podcast_speakers', 'list']);
    if (speakers) {
        const speakerImageUrls = speakers
            .filter(speaker => 
                speaker.avatar_url && 
                speaker.avatar_url.trim() !== '' && 
                speaker.avatar_url !== 'n/a' &&
                (speaker.avatar_url.startsWith('http://') || speaker.avatar_url.startsWith('https://'))
            )
            .map(speaker => ({ uri: speaker.avatar_url! }));
        
        if (speakerImageUrls.length > 0) {
            FastImage.preload(speakerImageUrls);
        }
    }

    // Prefetch podcast cover images from cache
    const podcasts = queryClient.getQueryData<Awaited<ReturnType<typeof getPodcastRowsQuery>>>(['podcast', 'list', 'content', content_id]);
    if (podcasts) {
        const podcastCoverUrls = podcasts
            .filter(podcast => 
                podcast.cover_art_url && 
                podcast.cover_art_url.trim() !== '' && 
                podcast.cover_art_url !== 'n/a' &&
                (podcast.cover_art_url.startsWith('http://') || podcast.cover_art_url.startsWith('https://'))
            )
            .map(podcast => ({ uri: podcast.cover_art_url! }));
        
        if (podcastCoverUrls.length > 0) {
            FastImage.preload(podcastCoverUrls);
        }
    }
}

export const prefetchContentOnly = async (content_id: string) => {
    await queryClient.prefetchQuery({
        queryKey: ['content', 'individual', content_id],
        queryFn: () => getSingleContentRowQuery(content_id),
    });
};
</file>

