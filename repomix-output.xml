import {QueryClient, useQuery, useQueryClient, UseQueryResult} from "@tanstack/react-query";
import {getQuizRowsQuery} from "@data/quiz_questions/queries";
import {useEffect} from "react";
import {JoinedQuestion} from "@data/quiz_questions/types";

export const useQuizRowsQuery = (content_id: string) : UseQueryResult<JoinedQuestion[]> => {
    const queryClient : QueryClient = useQueryClient();
    const query = useQuery<JoinedQuestion[], Error>({
        queryKey: ['questions', 'list', 'content', content_id],
        queryFn: () : Promise<JoinedQuestion[]> => getQuizRowsQuery(content_id),
