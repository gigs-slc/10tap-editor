import Superwall from "expo-superwall/compat";
import { storage } from "@/utils/mmkv";
import * as Notifications from "expo-notifications";
import { getUserID } from "@/utils/auth";
import { OnboardingDataType } from "@/utils/atoms";
import Purchases from "react-native-purchases";
import { PostHog } from "posthog-react-native";
import { trackAdjustEvent } from "@/utils/general";
import { languagesArray } from "@/common/data/languages";
import { Student, UpdateStudent } from "@data/student/types";
import { getExpoNotificationToken } from "@/utils/notifications";

export const getStudentRow = async () => {
  const studentUUID: string = await getUserID();
  const { data, error } = await supabase
    .from("student")
    .select("*")
    .eq("student_id", studentUUID)
    .returns<Student[]>();
  if (error)
    throw new Error("Could not fetch student/university row: " + error.message);
  if (!data) throw new Error("Could not fetch student University row from DB");
  return data[0];
};

export const createStudentWithoutNames = async (
  email: string,
  userID: string,
  onboardingData: OnboardingDataType,
  posthog: PostHog
) => {
  void Superwall.shared.identify({ userId: userID });
  await Purchases.logIn(userID);
  await Purchases.setAttributes({ email: email });
  
  try {
    await Purchases.syncPurchases();
    console.log("Synced purchases after login for user:", userID);
  } catch (error) {
    console.error("Failed to sync purchases after login:", error);
  }
  trackAdjustEvent(0, "ewph2s");
  posthog.identify(userID, {
    email: email,
  });
  const token = await getExpoNotificationToken();
  const { error, data } = await supabase
    .from("student")
    .upsert({
      student_id: userID,
      expo_push_token: token || null,
      email: email,
      allow_notifs: storage.contains("expo-token"),
      user_type: onboardingData.userType || null,
      university_id: onboardingData.universityID || null,
      major: onboardingData.major || null,
      language_code: onboardingData.languageCode || "en",
      language_name: onboardingData.selectedLanguage || "English",
      has_accessed_mobile: true,
    })
    .select("*")
    .select("*")
    .returns<Student[]>();
  if (error) throw new Error("Error creating new student: " + error.message);
  return data[0];
};

export const createStudent = async (
  email: string,
  firstName: string,
  lastName: string,
  userID: string,
  onboardingData: OnboardingDataType,
  posthog: PostHog
) => {
  void Superwall.shared.identify({ userId: userID });
  await Purchases.logIn(userID);
  await Purchases.setAttributes({
    email: email,
    displayName: firstName + " " + lastName,
  });
  
  try {
    await Purchases.syncPurchases();
    console.log("Synced purchases after login for user:", userID);
  } catch (error) {
    console.error("Failed to sync purchases after login:", error);
  }
  trackAdjustEvent(0, "ewph2s");
  posthog.identify(userID, {
    email: email,
    name: firstName + " " + lastName,
  });
  const token = await getExpoNotificationToken();
  const { error, data } = await supabase
    .from("student")
    .upsert({
      student_id: userID,
      expo_push_token: token || null,
      email: email,
      full_name: firstName + " " + lastName,
      allow_notifs: storage.contains("expo-token"),
      user_type: onboardingData.userType || null,
      university_id: onboardingData.universityID || null,
      major: onboardingData.major || null,
      language_code: onboardingData.languageCode || "en",
      language_name: onboardingData.selectedLanguage || "English",
      has_accessed_mobile: true,
    })
    .select("*")
    .select("*")
    .returns<Student[]>();
  if (error) throw new Error("Error creating new student: " + error.message);
  return data[0];
};

export const updateStudent = async (
  student_id: string,
  updateObject: UpdateStudent,
  posthog: PostHog
): Promise<Student> => {
  void Superwall.shared.identify({ userId: student_id });
  await Purchases.logIn(student_id);
  await Purchases.setAttributes({
    posthogUserId: student_id,
  });
  
  try {
    await Purchases.syncPurchases();
    console.log("Synced purchases after updateStudent for user:", student_id);
  } catch (error) {
    console.error("Failed to sync purchases in updateStudent:", error);
  }
  trackAdjustEvent(0, "ewph2s");
  const { data, error } = await supabase
    .from("student")
    .update(updateObject)
    .eq("student_id", student_id)
    .select("*")
    .returns<Student[]>();
  if (error) throw new Error("Error updating student row: " + error.message);
  if (!data) throw new Error("Error updating student row");
  return data[0];
};

export const updateStudentExistingUser = async (
  studentRow: Student,
  onboardingData: OnboardingDataType,
  posthog: PostHog
) => {
  void Superwall.shared.identify({ userId: studentRow.student_id });
  await Purchases.logIn(studentRow.student_id);
  await Purchases.setAttributes({
    email: studentRow.email,
    displayName: studentRow.full_name,
  });
  
  try {
    await Purchases.syncPurchases();
    console.log("Synced purchases for existing user:", studentRow.student_id);
  } catch (error) {
    console.error("Failed to sync purchases for existing user:", error);
  }
  trackAdjustEvent(0, "ewph2s");
  posthog.identify(studentRow.student_id, {
    email: studentRow.email,
    name: studentRow.full_name,
  });
  const token = await getExpoNotificationToken();
  const languageCode =
    onboardingData.languageCode || studentRow.language_code || "en";
  const languageName =
    languagesArray.find((lang) => lang.code === languageCode)?.name ||
    "English";
  return await updateStudent(
    studentRow.student_id,
    {
      user_type: onboardingData.userType || null,
      university_id: onboardingData.universityID || null,
      major: onboardingData.major || null,
      expo_push_token: token || null,
      allow_notifs: storage.contains("expo-token"),
      language_code: languageCode,
      language_name: onboardingData.selectedLanguage || languageName,
      has_accessed_mobile: true,
    },
    posthog
  );
};

export const setStudentNotifications = async (
  userID: string,
  value: boolean
) => {
  const { error } = await supabase
    .from("student")
    .update({ allow_notifs: value })
    .eq("student_id", userID);
  if (error) console.error("Could not update user to disable notifications");
};
