import {usePostHog} from "posthog-react-native";
import {usePosthogLogic} from "@/hooks/usePosthogLogic";
import {Adjust, AdjustAttribution} from "react-native-adjust";
import {createStyleSheet, useStyles} from "react-native-unistyles";

interface PersonalizationBox {
    title: string;
    subtitle: string;
    emoji: string;
}

const sequentialDelay = 1750;

export default function PersonalizingExperienceScreen({ userData }: { userData: string }) {
    const [personalizationBoxes, setPersonalizationBoxes] = useState<PersonalizationBox[] | null>(null);
    const [showButton, setShowButton] = useState(false);
    const[isPayingOnWeb, setIsPayingOnWeb] = useAtom(isPayingOnWebAtom);
    const { trackEvent } = usePosthogLogic()
    const { styles } = useStyles(stylesheet);

    const changeScreens = async () => {
        router.replace('/home');
    };

    useEffect(() => {
        void getPersonalizationBoxes();
    }, []);

    useEffect(() => {
        if (personalizationBoxes && personalizationBoxes.length > 0) {
            const totalDelay = (personalizationBoxes.length - 1) * sequentialDelay + 500;
            const timer = setTimeout(() => {
                setShowButton(true);
            }, totalDelay);
            return () => clearTimeout(timer);
        }
    }, [personalizationBoxes]);

    const getPersonalizationBoxes = async () => {
        const isUserPayingOnWeb = await checkUserActiveSubscription();
        setIsPayingOnWeb(isUserPayingOnWeb);
        if(!personalizationBoxes){
            const plans: PersonalizationBox[] = await postGeneratePersonalizedOnboardingPlan(userData);
            setTimeout(() => {
                setPersonalizationBoxes(plans);
            }, 100)
        }
    };

    return (
        <View style={styles.root}>
            <StatusBar style="light" />
            {!personalizationBoxes ? (
                <Animated.View
                    entering={FadeInDown.duration(300)}
                    exiting={FadeOutDown.duration(500)}
                    style={styles.loaderContainer}
                >
                    <LottieView
                        source={require('@/../assets/lottie/loadingCircle.json')}
                        style={styles.loaderAnimation}
                        autoPlay
                        loop
                    />
                    <Text style={styles.loadingText}>Personalizing your experience...</Text>
                </Animated.View>
            ) : (
                <View style={styles.boxesContainer}>
                    <Animated.View entering={FadeInDown.duration(500)}>
                        <FastImage
                            source={require('../../../../assets/images/logoWhite.png')}
                            style={styles.logoStyleSecond}
                            resizeMode={FastImage.resizeMode.contain}
                        />
                        <View style={styles.logoStyleSecond} />
                    </Animated.View>
                    {personalizationBoxes.map((box, index) => (
                        <Animated.View
                            key={index}
                            entering={FadeInDown.delay(index * sequentialDelay).duration(500)}
                            style={styles.singleBoxContainer}
                        >
                            <Text style={styles.emoji}>{box.emoji}</Text>
                            <View style={styles.textContainer}>
                                <Text style={styles.title}>{box.title}</Text>
                                <Text style={styles.subtitle}>{box.subtitle}</Text>
                            </View>
                        </Animated.View>
                    ))}
                </View>
            )}
            {showButton && (
                <Animated.View 
                    style={styles.buttonContainer}
                    entering={FadeInDown.delay(1000).duration(500)}
                >
                    <BasicButton
                        onPress={async () => {
                            void heavyHaptic();
                            if(!isPayingOnWeb){
                                void Superwall.shared.register({ placement: "after_onboarding", feature: () => {
                                    router.navigate({
                                        pathname: '/home'
                                    })
                                }})
                            }
                            else {
                                router.replace({
                                    pathname: '/home'
                                })
                            }
                            trackEvent("mobile_user_pressed_get_started_end_of_onboarding_flow", {
                                is_paying_on_web: isPayingOnWeb
                            })
                            void Adjust.getAttribution((attribution : AdjustAttribution) => {
                                if(attribution){
                                    trackEvent("mobile_user_logged_adjust_ads_attribution", {
                                        ...attribution
                                    })
                                }
                                else {
                                    trackEvent("mobile_user_logged_NO_adjust_ads_attribution", {})
                                }
                            });
                        }}
                        text={'Get Started Now'}
                        backgroundColor={"rgba(0,0,0,0.3)"}
                    />
                </Animated.View>
            )}
        </View>
    );
}

